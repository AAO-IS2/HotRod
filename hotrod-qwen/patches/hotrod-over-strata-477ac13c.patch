+    int32_t* ids;
+    float* weights;
+    int n_tok;
+    int layer;
+    int row_base;
+    const uint8_t* mask;
+    int mask_lo;
+    float mask_edge;
+    int cost_lo;
+    const int* mctrl;
+    unsigned long long* mstats;
+    uint32_t* cost;
+    MaskEvs* mev;
+    const int32_t* mres;
+    const uint8_t* mring;
+    const uint8_t* mcheap;
+    float* row_shift;
+    const int32_t* res;
+    unsigned long long* rstats;
+    float* want;
+    int32_t* rows;
+    float* repl;
+    const uint8_t* rring;
+    const uint8_t* rcheap;
+    float cheap_margin;
+    int cheap_rank0;
+    int cheap_anytier;
+    unsigned long long* bstats;
+    const float* pair_c;
