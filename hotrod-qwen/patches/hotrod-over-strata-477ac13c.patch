+ROOT = os.environ.get("TRACE_ROOT", "/home/Projects/Strata-train")
+MIN_CODE, MIN_PROSE, MAX_CODE, MAX_PROSE = 2500, 3400, 9000, 12000   # characters: ~800 tokens up to ~4000 (code ~3 chars/token, prose ~4)
