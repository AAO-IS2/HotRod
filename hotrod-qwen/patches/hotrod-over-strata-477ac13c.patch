+    const std::vector<int32_t>& nf = g_sub_packer->fit_n();
+    if ((int) nf.size() == sub_tab_.layers && cudaMemcpy(sub_tab_.nfit, nf.data(), nf.size() * sizeof(int32_t), cudaMemcpyDefault) != cudaSuccess)
