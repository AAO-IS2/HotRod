+4.9 Force majeure. A party is not liable for delay or failure caused by an event beyond its reasonable control, provided it notifies the other party within five working days and uses reasonable endeavours to resume performance. If the event continues for more than sixty days, either party may terminate the affected Services on written notice without liability for the termination.
+
+4.10 Survival. Clauses 4.1 to 4.9 survive termination or expiry of this Agreement for any reason, for a period of six years from the date of termination, save that clause 4.7 survives for the period stated in it.
+"""
+
+
+def _build_prefill():
+    """The 13 conversations, read now (a missing source file stops here, loudly)."""
+    conv_a = [   # C++: one topic over four turns (one request, then three follow-ups)
+        ("cpp-prefill", _code("src/prefill/prefill.cpp", 3900) + "\n\nThis is part of Strata's prompt (prefill) code. Explain what the MoE block does for one chunk, step by step, and name the buffers it reads and writes. Answer in at most 300 words."),
+        ("cpp-prefill", "Which of those buffers are on the GPU and which are on the host? Answer as a short list."),
+        ("cpp-prefill", "Where could a race happen between the copy stream and the compute stream in this part? Give the reasoning in terms of the lines you have read."),
+        ("cpp-prefill", "Propose the smallest change that would let the router input be copied without a synchronisation, and say what it would cost."),
+    ]
+    conv_b = [   # Python: a serve module, two turns (one follow-up)
+        ("py-serve", _code("serve/prompt_cache.py", 0) + "\n\nSummarise what this module caches, how entries are keyed, and when they are evicted. Answer in at most 250 words."),
+        ("py-serve", "What happens when two requests share a prefix but differ in the last token? Walk through the code path."),
+    ]
+    conv_c = [   # documents: README, then docs/DETAILS.md (switch 1), then a legal clause list (switch 2)
+        ("readme", _prose("README.md", 0) + "\n\nExplain in plain words what this project is for and who it is for. Answer in at most 200 words."),
+        ("readme", "Which of the hardware requirements in that text would stop a PC with 16 GB of RAM from running it?"),
+        ("details", _prose("docs/DETAILS.md", 200) + "\n\nThis is a different document. What does it say about the expert cache, and which numbers does it give? Answer in at most 200 words."),
+        ("legal", LEGAL_CLAUSES + "\n\nThis is a different text, a supply agreement. Which clause limits liability, and what could a customer lose under it? Answer in at most 200 words."),
+    ]
+    conv_d = [   # self-written maths word problems, two turns
+        ("maths", MATHS_SET + "\nSolve problems 1 to 4 and show the working for each."),
+        ("maths", "Now solve problem 9 and explain why the answer is plausible."),
+    ]
+    conv_e = [   # self-written short story opening, two turns
+        ("story", STORY_OPENING + "\nContinue the story for about 250 words, in the same voice."),
+        ("story", "Now write the next scene from the point of view of Dennis Pascoe on the telephone, in about 120 words."),
+    ]
+    conv_f = [   # self-written email thread, two turns
+        ("email", EMAIL_THREAD + "\nDraft a reply to the last email on behalf of Priya Venkataraman, under 150 words."),
+        ("email", "Shorten that reply to two sentences."),
+    ]
+    conv_g = [("cpp-expert-cache", _code("src/core/expert_source.cpp", 5300) + "\n\nExplain the router trace: what one record contains and how a reader finds the token records. Answer in at most 250 words.")]
+    conv_h = [("py-mcp", _code("serve/mcp.py", 0) + "\n\nWhat tools does this module expose, and how does it check its arguments? Answer in at most 200 words.")]
+    conv_i = [("models", _prose("docs/MODELS.md", 0) + "\n\nWhich model variant suits a PC with 32 GB of RAM and an 8 GB graphics card, according to this text? Answer in at most 150 words.")]
+    conv_j = [   # a predictor note, two turns
+        ("predictor-notes", _prose("docs/PREDICTOR-EXPERIMENTS.md", 0) + "\n\nWhat did the experiments conclude about predicting the next experts? Name the measured numbers. Answer in at most 200 words."),
+        ("predictor-notes", "Which of those conclusions would you not trust from a single run, and why?"),
+    ]
+    conv_k = [("cpp-verify", _code("src/core/verify.cpp", 2000) + "\n\nWhat does the verifier do with the draft tokens? Answer in five numbered steps.")]
+    conv_l = [("py-images", _code("serve/images.py", 0) + "\n\nHow are uploaded images resized before they reach the model? Answer in at most 150 words.")]
+    conv_m = [("cpp-layer", _code("src/core/layer.cpp", 300) + "\n\nDescribe the MoE route step in this file and what it writes. Answer in at most 200 words.")]
+    return [conv_a, conv_b, conv_c, conv_d, conv_e, conv_f, conv_g, conv_h, conv_i, conv_j, conv_k, conv_l, conv_m]
+
+
+PREFILL = _build_prefill()
diff --git a/tools/predictor/trace_reader.py b/tools/predictor/trace_reader.py
new file mode 100644
index 000000000..22fc30ee1
--- /dev/null
+++ b/tools/predictor/trace_reader.py
@@ -0,0 +1,131 @@
+"""Reader for the STRATA_ROUTER_TRACE file.  Two formats, one reader:
+
+RTR1 (decode only): u32 'RTR1', then decode records  u32 step | u16 layer | u8 n_tok | u8 k | per token: u16[2560] bf16 input, i16[k] ids.
+Token records (both formats): u32 0 | u16 0xFFFF | u8 n_tok | u8 0 | i32[n_tok] token ids, written as each decode window is launched; they are
+paired with the windows in order (a pair whose row counts differ is left without tokens: `tok` -1).
+
+RTR2 (engine with STRATA_ROUTER_TRACE_PREFILL=1): u32 'RTR2', then the same records and two more kinds, all with a 12-byte header:
+  request  u32 request | u16 0xFFFE | u16 0 | u32 n_prompt          (written at the start of each prompt; decode windows after it belong to it)
+  prefill  u32 request | u16 0xFFFD | u16 layer | u16 n_tok | u8 k | u8 0, then per sampled prompt token:
+           i32 pos (absolute position in the conversation) | i32 token id | u16[2560] bf16 router input | i16[k] ids (the router's own top-k)
+"""
+import struct, sys
+import numpy as np
+
+H = 2560
+MARK_TOKENS, MARK_REQUEST, MARK_PREFILL = 0xFFFF, 0xFFFE, 0xFFFD
+
+
+def _is_rtr2(buf):
+    magic = bytes(buf[:4])
+    if magic not in (b"RTR1", b"RTR2"):
+        raise ValueError("bad magic %r: not a router trace" % magic)
+    return magic == b"RTR2"
+
+
+def iter_records(path, want_x=True):
+    """Yields one dict per record, in file order.  kind is 'decode', 'tokens', 'request' or 'prefill'; `request` is the number of the request the
+    record belongs to (0 before the first request record, and always 0 in an RTR1 file).
+      decode:  step, layer, n_tok, k, ids int16 [n_tok, k], x uint16 [n_tok, H] (None when want_x is False)
+      tokens:  tok int32 [n_tok]
+      request: n_prompt
+      prefill: layer, n_tok, k, pos int32 [n_tok], tok int32 [n_tok], ids int16 [n_tok, k], x uint16 [n_tok, H] (None when want_x is False)
+    A record cut off by the end of a still-growing file ends the iteration."""
+    buf = np.memmap(path, dtype=np.uint8, mode="r")
+    rtr2 = _is_rtr2(buf)
+    size, off, request = len(buf), 4, 0
+    while off + 8 <= size:
+        step, layer, nt, k = struct.unpack_from("<IHBB", buf, off)
+        if layer == MARK_TOKENS:
+            if off + 8 + nt * 4 > size:
+                return
+            tok = np.frombuffer(buf[off + 8:off + 8 + nt * 4].tobytes(), dtype=np.int32).copy()
+            yield dict(kind="tokens", request=request, tok=tok)
+            off += 8 + nt * 4
+        elif layer == MARK_REQUEST and rtr2:
+            if off + 12 > size:
+                return
+            request = step
+            yield dict(kind="request", request=request, n_prompt=struct.unpack_from("<I", buf, off + 8)[0])
+            off += 12
+        elif layer == MARK_PREFILL and rtr2:
+            req, _, lay, n, kk, _ = struct.unpack_from("<IHHHBB", buf, off)
+            dt = np.dtype([("pos", "<i4"), ("tok", "<i4"), ("x", "<u2", (H,)), ("ids", "<i2", (kk,))])
+            if off + 12 + n * dt.itemsize > size:
+                return
+            rows = np.frombuffer(buf[off + 12:off + 12 + n * dt.itemsize].tobytes(), dtype=dt)
+            yield dict(kind="prefill", request=req, layer=lay, n_tok=n, k=kk, pos=rows["pos"].copy(), tok=rows["tok"].copy(),
+                       ids=rows["ids"].copy(), x=rows["x"].copy() if want_x else None)
+            off += 12 + n * dt.itemsize
+        else:
+            dt = np.dtype([("x", "<u2", (H,)), ("ids", "<i2", (k,))])
+            if off + 8 + nt * dt.itemsize > size:
+                return                                  # a record cut by the end of a still-growing file
+            rows = np.frombuffer(buf[off + 8:off + 8 + nt * dt.itemsize].tobytes(), dtype=dt)
+            yield dict(kind="decode", request=request, step=step, layer=layer, n_tok=nt, k=k, ids=rows["ids"].copy(),
+                       x=rows["x"].copy() if want_x else None)
+            off += 8 + nt * dt.itemsize
+
+
+def read_trace(path, max_records=None, step_mod=1, want_x=True):
+    """Returns dict of arrays over TOKEN ROWS of the decode records: step, layer, pos (token index in its window), nt (window size), x (bf16 as uint16
+    [n, H]), ids int16 [n, k], tok int32 (the row's token id, -1 when the trace has no token records or the pairing failed); also tok_paired /
+    tok_mismatch (windows).  Prefill and request records are skipped (see iter_records).
+    want_x=False leaves x empty (the inputs are most of the file; tools that need only the routing skip them)."""
+    steps, layers, pos, nts, xs, ids = [], [], [], [], [], []
+    pending, step_tok = [], {}                      # token records not yet paired; step -> that window's token ids
+    paired = mismatch = 0
+    n_rec = 0
+    for r in iter_records(path, want_x=want_x):
+        if r["kind"] == "tokens":
+            pending.append(r["tok"])
+            continue
+        if r["kind"] != "decode":
+            continue
+        step, layer, nt = r["step"], r["layer"], r["n_tok"]
+        if layer == 0 and pending:                  # a new window: the oldest launch not yet paired is this one
+            toks = pending.pop(0)
+            if len(toks) == nt:
+                step_tok[step] = toks
+                paired += 1
+            else:
+                mismatch += 1
+        if step % step_mod != 0:                    # keep one decode window in step_mod: all 48 layers of a kept step stay together
+            continue
+        ids.append(r["ids"])
+        if want_x:
+            xs.append(r["x"])
+        steps.extend([step] * nt); layers.extend([layer] * nt); pos.extend(range(nt)); nts.extend([nt] * nt)
+        n_rec += 1
+        if max_records and n_rec >= max_records:
+            break
+    tok = np.array([int(step_tok[s][p]) if s in step_tok else -1 for s, p in zip(steps, pos)], np.int32)
+    return dict(step=np.array(steps, np.uint32), layer=np.array(layers, np.uint16), pos=np.array(pos, np.uint8), nt=np.array(nts, np.uint8),
+                x=np.concatenate(xs) if xs else np.zeros((0, H), np.uint16), ids=np.concatenate(ids) if ids else np.zeros((0, 10), np.int16),
+                records=n_rec, tok=tok, tok_paired=paired, tok_mismatch=mismatch)
+
+
+def bf16_to_f32(u):
+    return (u.astype(np.uint32) << 16).view(np.float32)
+
+
+if __name__ == "__main__":
+    d = read_trace(sys.argv[1])
+    print("records", d["records"], "token rows", len(d["layer"]), "| steps", len(set(d["step"].tolist())))
+    ls = np.bincount(d["layer"], minlength=48)
+    print("layers seen:", int((ls > 0).sum()), "of 48; rows per layer min/max", int(ls.min()), int(ls.max()))
+    print("token records: %d windows paired, %d with a different row count" % (d["tok_paired"], d["tok_mismatch"]))
+    print("window sizes:", {int(k): int(v) for k, v in zip(*np.unique(d["nt"], return_counts=True))})
+    ids = d["ids"]
+    print("ids range", int(ids.min()), int(ids.max()), "| distinct per row (10 expected):", int(np.mean([len(set(r.tolist())) for r in ids[:2000]])))
+    x = bf16_to_f32(d["x"][:2000])
+    print("x finite:", bool(np.isfinite(x).all()), "| mean |x| %.3f, max |x| %.1f" % (np.abs(x).mean(), np.abs(x).max()))
+    kinds = {}
+    prefill_rows = {}
+    for r in iter_records(sys.argv[1], want_x=False):
+        kinds[r["kind"]] = kinds.get(r["kind"], 0) + 1
+        if r["kind"] == "prefill":
+            prefill_rows[r["request"]] = prefill_rows.get(r["request"], 0) + r["n_tok"]
+    print("records by kind:", kinds)
+    if prefill_rows:
+        print("prefill token rows (layer records) per request:", prefill_rows)
