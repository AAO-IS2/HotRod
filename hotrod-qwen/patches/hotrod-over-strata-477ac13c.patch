+    bool on = false;
+    float margin = 0.0f, edge = -1.0f, budget = 0.0f;   // budget: STRATA_ROUTE_BUDGET (ranks below lo; 0 = off)
+    float budget_tail = 0.0f;   // STRATA_ROUTE_BUDGET_TAIL (ranks at or above lo; 0 = off)
