+            if not live:
+                for t in q:
+                    t.cancelled = True
+                q.clear()
+                return None
+            if p["value_order"]:
+                return min(live, key=lambda i: (q[i].layer, -q[i].meta["conf"], q[i].id))
+            return min(live, key=lambda i: (q[i].layer, -q[i].meta["from"], q[i].id))
+        if p["value_order"]:
