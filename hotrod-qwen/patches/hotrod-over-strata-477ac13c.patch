+            for (int r = 0; r < 10; ++r) m = fmaxf(m, l[my[r]]);
+            float ex[10], sum = 0.0f;
+            for (int r = 0; r < 10; ++r) { ex[r] = expf(l[my[r]] - m); sum += ex[r]; }
+            for (int r = 0; r < 10; ++r) weights[t * 10 + r] = ex[r] / sum;
+        }
+        for (int r = 0; r < 10; ++r) id[r] = my[r];
+    }
+}
