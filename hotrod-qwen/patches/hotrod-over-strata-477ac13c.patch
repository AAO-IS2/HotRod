index 000000000..c9e8b5184
--- /dev/null
+++ b/tools/predictor/pred_cpu_proxy.py
@@ -0,0 +1,70 @@
+"""How many of the CPU's rank 0-1 computations would a predictor avoid?  Proxy for the GPU residency: per layer, the 58 most frequent experts of the TRAINING part
+(58 x 48 = 2,784 ~ the 2,793 experts the 3060 holds in production).  The CPU computes a true rank 0-1 expert only when it is NOT resident.  A predictor
+admits K extra experts per layer (its top-K among the non-resident ones); the share of those CPU-bound rank 0-1 experts it covers = computations avoided.
+Comparators: 'static +K' = just keep the K next most frequent experts per layer resident (no prediction at all).  Test = the last 23% (other languages,
+summaries); the hot set and nothing else comes from the first 77%.  Their model (d=1) is used as published, never trained on our data."""
+import struct, sys, time
+import numpy as np
+import torch
+
+torch.set_num_threads(10)
+H, NL, E = 2560, 48, 512
+TRACE = "/mnt/nvme/strata-data/traces/trace1.bin"
+MODELS = "/mnt/nvme/ref/trace-dataset/models_linear"
+buf = np.memmap(TRACE, dtype=np.uint8, mode="r")
+off, recs = 4, []
+while off + 8 <= len(buf):
+    step, layer, nt, k = struct.unpack_from("<IHBB", buf, off)
+    rec = 8 + nt * (H * 2 + k * 2)
+    if off + rec > len(buf):
+        break
+    recs.append((step, layer, nt, off, k)); off += rec
+steps = {}
+for step, layer, nt, o, k in recs:
+    steps.setdefault(step, []).append((layer, nt, o, k))
+complete = sorted(s for s, v in steps.items() if len(v) == NL and len({nt for _, nt, _, _ in v}) == 1)
+N = sum(steps[s][0][1] for s in complete)
+X = np.zeros((N, NL, H), np.uint16); IDS = np.zeros((N, NL, 10), np.int16)
+tok = 0
+for s in complete:
+    for layer, nt, o, k in steps[s]:
+        p = o + 8
+        for t in range(nt):
+            X[tok + t, layer] = np.frombuffer(buf[p:p + H * 2], dtype=np.uint16); p += H * 2
+            IDS[tok + t, layer] = np.frombuffer(buf[p:p + k * 2], dtype=np.int16)[:10]; p += k * 2
+    tok += steps[s][0][1]
+W = torch.from_numpy(np.load("/mnt/nvme/strata-data/traces/routers_f32.npy"))
+f32 = lambda u: torch.from_numpy((u.astype(np.uint32) << 16).view(np.float32))
+cut = int(0.77 * N)
+tr, te = np.arange(cut), np.arange(cut, N)
+RES = 58
+KS = (1, 2, 4, 8)
+agg = {name: {K: [0, 0] for K in KS} for name in ("static +K", "reuse d=1", "theirs d=1", "reuse d=2")}
+base_total, base_cpu = 0, 0
+for l in range(2, 48):
+    cnt = np.bincount(IDS[tr, l].reshape(-1).astype(np.int64), minlength=E)
+    order = np.argsort(-cnt)
+    resident = np.zeros(E, bool); resident[order[:RES]] = True
+    true01 = torch.from_numpy(IDS[te, l, :2].astype(np.int64))                  # [n,2]
+    nonres = ~resident[true01.numpy()]                                           # [n,2] this rank 0-1 expert would go to the CPU
+    base_total += nonres.size; base_cpu += int(nonres.sum())
+    sd = torch.load(f"{MODELS}/L{l:02d}_d1_linear_state.pt", weights_only=True, map_location="cpu")
+    scores = {}
+    x1, x2 = f32(X[te, l - 1]), f32(X[te, l - 2])
+    scores["reuse d=1"] = x1 @ W[l].T
+    scores["theirs d=1"] = ((x1 - sd["mu_state"]) / sd["sd_state"]) @ sd["out.weight"][:E].T + sd["out.bias"][:E]
+    scores["reuse d=2"] = x2 @ W[l].T
+    scores["static +K"] = torch.from_numpy(cnt.astype(np.float32))[None, :].expand(len(te), E).clone()
+    for name, sc in scores.items():
+        sc = sc.clone()
+        sc[:, torch.from_numpy(resident)] = -1e30                                # only experts NOT already resident can be admitted
+        top = sc.topk(8, dim=1).indices
+        for K in KS:
+            hit = (true01[:, :, None] == top[:, None, :K]).any(2).numpy()        # [n,2]
+            agg[name][K][0] += int((hit & nonres).sum()); agg[name][K][1] += int(nonres.sum())
+print(f"hot set = {RES} most frequent experts per layer (train part); test = {len(te)} tokens of other languages / summaries")
+print(f"true rank 0-1 experts that are NOT resident (would go to the CPU): {base_cpu / base_total * 100:.1f}% of all rank 0-1 picks")
+print("share of those CPU computations AVOIDED when K extra experts per layer are admitted (K = predicted top-K among the non-resident):")
+print(f"   {'':12s} " + " ".join(f"K={K:<5d}" for K in KS))
+for name, v in agg.items():
+    print(f"   {name:12s} " + " ".join(f"{v[K][0] / max(v[K][1], 1) * 100:6.1f}%" for K in KS))
diff --git a/tools/predictor/pred_decay.py b/tools/predictor/pred_decay.py
new file mode 100644
index 000000000..7fad72174
--- /dev/null
+++ b/tools/predictor/pred_decay.py
@@ -0,0 +1,122 @@
+"""Weight-decay arm: the best cheap learner (lowrank-8/mse, stage-A settings) with AdamW decay on the correction parameters only.
+Trace: trace_tok.bin (as stage A).  Layers 8,16,24,32,40; d=1 and d=2; full stream; lo3 (true ranks 0-2 in predicted top-6).
+Decoupled decay: each step multiplies the correction by (1 - lr * wd) before the Adam step.
+Output: tools/predictor/online_decay.out
+"""
+import struct, time
+import numpy as np
+import torch
+
+torch.set_num_threads(4)
+torch.manual_seed(0)
+H, NL, E = 2560, 48, 512
+TRACE = "/mnt/nvme/strata-data/traces/trace_tok.bin"
+ROUTER = "/mnt/nvme/strata-data/traces/routers_f32.npy"
+OUT = "/home/Projects/Strata-train/tools/predictor/online_decay.out"
+LAYERS5 = [8, 16, 24, 32, 40]
+NEED = sorted({l - d for l in LAYERS5 for d in (1, 2)} | set(LAYERS5))
+SETTINGS = {1: (1e-3, (0.1, 16)), 2: (1e-3, (0.1, 64))}          # stage A: lowrank-8/mse, chosen lr and margin/K per d
+WDS = [0.0, 1e-4, 1e-3, 1e-2]
+B = 16
+t0 = time.time()
+log = lambda *a: print(f"[{time.time()-t0:5.0f}s]", *a, flush=True)
+
+buf = np.memmap(TRACE, dtype=np.uint8, mode="r")
+off, recs = 4, []
+while off + 8 <= len(buf):
+    step, layer, nt, k = struct.unpack_from("<IHBB", buf, off)
+    if layer == 0xFFFF:
+        off += 8 + nt * 4
+        continue
+    rec = 8 + nt * (H * 2 + k * 2)
+    if off + rec > len(buf):
+        break
+    recs.append((step, layer, nt, off, k))
+    off += rec
+steps = {}
+for step, layer, nt, o, k in recs:
+    steps.setdefault(step, []).append((layer, nt, o, k))
+complete = sorted(s for s, v in steps.items() if len(v) == NL and len({nt for _, nt, _, _ in v}) == 1)
+N = sum(steps[s][0][1] for s in complete)
+X = {l: np.zeros((N, H), np.uint16) for l in NEED}
+IDS = {l: np.zeros((N, 10), np.int16) for l in LAYERS5}
+tok = 0
+for s in complete:
+    for layer, nt, o, k in steps[s]:
+        if layer not in X:
+            continue
+        region = np.asarray(buf[o + 8:o + 8 + nt * (H * 2 + k * 2)]).reshape(nt, H * 2 + k * 2)
+        X[layer][tok:tok + nt] = np.ascontiguousarray(region[:, :H * 2]).view(np.uint16)
+        if layer in IDS:
+            IDS[layer][tok:tok + nt] = np.ascontiguousarray(region[:, H * 2:H * 2 + k * 2]).view(np.int16)[:, :10]
+    tok += steps[s][0][1]
+W = torch.from_numpy(np.load(ROUTER))
+f32 = lambda u: torch.from_numpy((u.astype(np.uint32) << 16).view(np.float32))
+SHIFT_AT = int(0.77 * N)
+log("loaded", N, "tokens")
+
+
+def metrics_lo3(logit, ids):
+    top = logit.topk(12, dim=1).indices
+    ids = ids.long()
+    return (ids[:, :3, None] == top[:, None, :6]).any(2).float().mean(1)
+
+
+def mse_loss(pred, Y, margin, K):
+    v, i = Y.topk(K, dim=1)
+    thr = v[:, -1:] - margin
+    pc = pred.gather(1, i)
+    dev = (pc - pc.mean(1, keepdim=True)) - (v - v.mean(1, keepdim=True))
+    mask = torch.ones_like(pred).scatter_(1, i, 0.0)
+    hinge = (torch.relu(pred - thr) * mask).sum(1) / (E - K)
+    return (dev ** 2).mean() + hinge.mean()
+
+
+def run(l, d, wd):
+    lr, cfg = SETTINGS[d]
+    xi = f32(X[l - d])
+    Y = f32(X[l]) @ W[l].T
+    ids = torch.from_numpy(IDS[l].astype(np.int64))
+    A = (torch.randn(8, H) * 1e-3).requires_grad_(True)
+    Bm = torch.zeros(E, 8, requires_grad=True)
+    opt = torch.optim.AdamW([A, Bm], lr=lr, weight_decay=wd)
+    base_router = W[l]
+    out = []
+    for i in range(0, N, B):
+        x, y, idr = xi[i:i + B], Y[i:i + B], ids[i:i + B]
+        with torch.no_grad():
+            base = x @ base_router.T
+            out.append(metrics_lo3(base + (x @ A.T) @ Bm.T, idr))
+        logit = x @ base_router.T + (x @ A.T) @ Bm.T
+        loss = mse_loss(logit, y, cfg[0], cfg[1])
+        opt.zero_grad()
+        loss.backward()
+        opt.step()
+    return torch.cat(out).numpy()
+
+
+with open(OUT, "w") as F:
+    def emit(*a):
+        print(*a, file=F, flush=True)
+    emit("DECAY ARM: lowrank-8/mse (stage-A settings), AdamW weight decay on the correction only, trace_tok.bin, layers "
+         f"{LAYERS5}, lo3 = true ranks 0-2 in predicted top-6 (%)")
+    for d in (1, 2):
+        lr, cfg = SETTINGS[d]
+        emit(f"\n--- d={d}, lr={lr:g}, margin={cfg[0]} K={cfg[1]}: first 2000 | before shift | after shift (mean over layers)")
+        reuse = {}
+        dec = {wd: {} for wd in WDS}
+        for l in LAYERS5:
+            xi = f32(X[l - d])
+            ids = torch.from_numpy(IDS[l].astype(np.int64))
+            with torch.no_grad():
+                reuse[l] = metrics_lo3(xi @ W[l].T, ids).numpy()
+            for wd in WDS:
+                dec[wd][l] = run(l, d, wd)
+            log(f"d={d} layer {l} done")
+
+        def row(arr):
+            return " | ".join(f"{np.mean([np.nanmean(arr[l][a:b]) for l in LAYERS5]) * 100:6.1f}" for a, b in ((0, 2000), (2000, SHIFT_AT), (SHIFT_AT, N)))
+        emit(f"   reuse (router)       {row(reuse)}")
+        for wd in WDS:
+            emit(f"   wd={wd:<8g}         {row(dec[wd])}")
+    log("written", OUT)
diff --git a/tools/predictor/pred_lead.py b/tools/predictor/pred_lead.py
new file mode 100644
index 000000000..ea6ac68ec
--- /dev/null
+++ b/tools/predictor/pred_lead.py
@@ -0,0 +1,181 @@
+"""STEP E: longer leads on trace_tok.bin.  Head = lowrank-8/mse (lr 1e-3, MSE settings per d: d=1 (0.1,16); d>=2 (0.1,64)), reuse = router.
+Heads at d = 3, 4, 6 for all target layers the lead allows (l >= d), plus d = 1 and 2 (needed for the cascade).
+Cascade (target layer l, l >= 4): the union of the d=4 head's top-3, the d=2 head's top-3 and the d=1 head's top-3, scored on the true
+routed ranks 0-2 of layer l: all ranks (catch) and the non-resident subset (true ranks 0-2 not routed at layer l within the last 32 tokens).
+Also the distinct guesses per token (union size), and those that are non-recent.
+Output: tools/predictor/online_lead.out
+"""
+import struct, time
+import numpy as np
+import torch
+
+torch.set_num_threads(4)
+torch.manual_seed(0)
+H, NL, E = 2560, 48, 512
+TRACE = "/mnt/nvme/strata-data/traces/trace_tok.bin"
+ROUTER = "/mnt/nvme/strata-data/traces/routers_f32.npy"
+OUT = "/home/Projects/Strata-train/tools/predictor/online_lead.out"
+SET = {1: (1e-3, (0.1, 16)), 2: (1e-3, (0.1, 64)), 3: (1e-3, (0.1, 64)), 4: (1e-3, (0.1, 64)), 6: (1e-3, (0.1, 64))}
+HEADS = [1, 2, 3, 4, 6]
+B = 16
+t0 = time.time()
+log = lambda *a: print(f"[{time.time()-t0:5.0f}s]", *a, flush=True)
+
+buf = np.memmap(TRACE, dtype=np.uint8, mode="r")
+off, recs = 4, []
+while off + 8 <= len(buf):
+    step, layer, nt, k = struct.unpack_from("<IHBB", buf, off)
+    if layer == 0xFFFF:
+        off += 8 + nt * 4
+        continue
+    rec = 8 + nt * (H * 2 + k * 2)
+    if off + rec > len(buf):
+        break
+    recs.append((step, layer, nt, off, k))
+    off += rec
+steps = {}
+for step, layer, nt, o, k in recs:
+    steps.setdefault(step, []).append((layer, nt, o, k))
+complete = sorted(s for s, v in steps.items() if len(v) == NL and len({nt for _, nt, _, _ in v}) == 1)
+N = sum(steps[s][0][1] for s in complete)
+X = {l: np.zeros((N, H), np.uint16) for l in range(NL)}
+IDS = {l: np.zeros((N, 10), np.int16) for l in range(NL)}
+tok = 0
+for s in complete:
+    for layer, nt, o, k in steps[s]:
+        region = np.asarray(buf[o + 8:o + 8 + nt * (H * 2 + k * 2)]).reshape(nt, H * 2 + k * 2)
+        X[layer][tok:tok + nt] = np.ascontiguousarray(region[:, :H * 2]).view(np.uint16)
+        IDS[layer][tok:tok + nt] = np.ascontiguousarray(region[:, H * 2:H * 2 + k * 2]).view(np.int16)[:, :10]
+    tok += steps[s][0][1]
+W = torch.from_numpy(np.load(ROUTER))
+f32 = lambda u: torch.from_numpy((u.astype(np.uint32) << 16).view(np.float32))
+SHIFT_AT = int(0.77 * N)
+log("loaded", N, "tokens")
+
+_REC = {}
+
+
+def REC(l):
+    if l not in _REC:
+        ids_np = IDS[l].astype(np.int64)
+        R = np.zeros((N, E), bool)
+        cnt = np.zeros(E, np.int64)
+        for t in range(N):
+            R[t] = cnt > 0
+            cnt[ids_np[t]] += 1
+            if t >= 32:
+                cnt[ids_np[t - 32]] -= 1
+        _REC[l] = torch.from_numpy(R)
+    return _REC[l]
+
+
+def metrics(logit, ids, rec):
+    ids = ids.long()
+    top = logit.topk(12, dim=1).indices
+    res = {}
+    for lo in (2, 3, 6):
+        res[f"lo{lo}"] = (ids[:, :lo, None] == top[:, None, :2 * lo]).any(2).float().mean(1)
+    p = logit.masked_fill(rec, -1e9).topk(4, dim=1).indices
+    pick = (p[:, :, None] == ids[:, None, :])
+    nr_true = ~rec.gather(1, ids)
+    res["mr4"] = (pick.any(1) & nr_true).float().sum(1) / nr_true.float().sum(1)
+    return res
+
+
+def mse_loss(pred, Y, margin, K):
+    v, i = Y.topk(K, dim=1)
+    thr = v[:, -1:] - margin
+    pc = pred.gather(1, i)
+    dev = (pc - pc.mean(1, keepdim=True)) - (v - v.mean(1, keepdim=True))
+    mask = torch.ones_like(pred).scatter_(1, i, 0.0)
+    hinge = (torch.relu(pred - thr) * mask).sum(1) / (E - K)
+    return (dev ** 2).mean() + hinge.mean()
+
+
+KEYS = ["lo2", "lo3", "lo6", "mr4"]
+
+
+def run_head(d, l):
+    lr, cfg = SET[d]
+    xi = f32(X[l - d])
+    Y = f32(X[l]) @ W[l].T
+    ids = torch.from_numpy(IDS[l].astype(np.int64))
+    rec = REC(l)
+    Wl = W[l]
+    A = (torch.randn(8, H) * 1e-3).requires_grad_(True)
+    Bm = torch.zeros(E, 8, requires_grad=True)
+    opt = torch.optim.Adam([A, Bm], lr=lr)
+    acc = {a: {k: [] for k in KEYS} for a in ("reuse", "lr")}
+    top3 = []
+    for i in range(0, N, B):
+        x, y, idr, rb = xi[i:i + B], Y[i:i + B], ids[i:i + B], rec[i:i + B]
+        with torch.no_grad():
+            lg_r = x @ Wl.T
+            lg_l = lg_r + (x @ A.T) @ Bm.T
+            for a, lg in (("reuse", lg_r), ("lr", lg_l)):
+                mm = metrics(lg, idr, rb)
+                for k in KEYS:
+                    acc[a][k].append(mm[k])
+            top3.append(lg_l.topk(3, dim=1).indices)
+        loss = mse_loss(lg_r + (x @ A.T) @ Bm.T, y, cfg[0], cfg[1])
+        opt.zero_grad()
+        loss.backward()
+        opt.step()
+    out = {a: {k: torch.cat(acc[a][k]).numpy() for k in KEYS} for a in acc}
+    out["top3"] = torch.cat(top3)
+    return out
+
+
+RES = {}
+for d in HEADS:
+    for l in range(d, NL):
+        RES[(d, l)] = run_head(d, l)
+    log(f"head d={d} done")
+
+with open(OUT, "w") as F:
+    def emit(*a):
+        print(*a, file=F, flush=True)
+    emit(f"STEP E: longer leads, trace_tok.bin ({N} decode tokens), lowrank-8/mse lr 1e-3, MSE settings per d "
+         f"(d=1: margin 0.1 K 16; d>=2: margin 0.1 K 64). Targets: every layer the lead allows.")
+    emit("NOTE: d=3, 4, 6 use the K=64 setting (the d=2 choice); not tuned for these leads.")
+    for d in (3, 4, 6):
+        layers = list(range(d, NL))
+        emit(f"\n=== d={d}: mean over layers {layers[0]}-{layers[-1]} (%): first 2000 | before shift | after shift ===")
+        for k in KEYS:
+            emit(f"--- {k}")
+            for a in ("reuse", "lr"):
+                vals = [np.mean([np.nanmean(RES[(d, l)][a][k][s:e]) for l in layers]) * 100 for s, e in ((0, 2000), (2000, SHIFT_AT), (SHIFT_AT, N))]
+                lab = "reuse" if a == "reuse" else "lowrank-8/mse"
+                emit(f"   {lab:14s} " + " | ".join(f"{v:6.1f}" for v in vals))
+
+    # cascade: target layers l >= 4, heads 1, 2, 4
+    cl = list(range(4, NL))
+    emit(f"\n=== cascade at lo3 (target layers {cl[0]}-{cl[-1]}; heads lowrank-8/mse, top-3 each) ===")
+    emit("catch = share of true ranks 0-2 in the set; NR = same over true ranks 0-2 not routed at the target layer within 32 tokens")
+    for name, heads in (("d=4 head alone", [4]), ("d=2 head alone", [2]), ("d=1 head alone", [1]), ("union d=4+d=2+d=1", [4, 2, 1])):
+        stats = {"catch": [], "NR": [], "distinct": [], "distinct_nonrecent": []}
+        for l in cl:
+            ids = torch.from_numpy(IDS[l].astype(np.int64))
+            rec = REC(l)
