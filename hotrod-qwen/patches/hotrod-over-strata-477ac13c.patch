diff --git a/tests/core/flag_order_test.cu b/tests/core/flag_order_test.cu
new file mode 100644
index 000000000..7c2df6a79
--- /dev/null
+++ b/tests/core/flag_order_test.cu
@@ -0,0 +1,125 @@
+// Flag B behind queued copies (PR #5096): an empty plan must not release a layer whose uploads are still in flight.
+// A delayed host function stands in for a slow DMA on the copy stream (it writes the "staging" word a while after it was
+// queued); a kernel plays the graph (waits for flag B >= value, then reads staging).  Run on every device found.
+#include "strata/core/flag_order.hpp"
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <thread>
+
+using strata::core::FlagRaise;
+using strata::core::flag_raise_max;
+using strata::core::raise_flag_b_ordered;
+
+static int failed = 0;
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #x); ++failed; } } while (0)
+#define CK(call) do { const cudaError_t e_ = (call); if (e_ != cudaSuccess) { std::fprintf(stderr, "%s: %s\n", #call, cudaGetErrorString(e_)); return 1; } } while (0)
+
+struct SlowCopy { volatile uint32_t* staging; uint32_t word; int ms; };
+static void slow_copy(void* p) {
+    SlowCopy* c = (SlowCopy*) p;
+    std::this_thread::sleep_for(std::chrono::milliseconds(c->ms));
+    *c->staging = c->word;   // the final writer of the buffer
+}
+
+__global__ void consumer(volatile uint32_t* flag, uint32_t want, volatile uint32_t* staging, volatile uint32_t* seen) {
+    while (*flag < want) {}
+    *seen = *staging;        // what the graph's PCIe group would read
+}
+
+static uint32_t rd(volatile uint32_t* p) { return __atomic_load_n((uint32_t*) p, __ATOMIC_SEQ_CST); }
+
+static int run_device(int dev) {
+    CK(cudaSetDevice(dev));
+    cudaStream_t copy, cs;
+    CK(cudaStreamCreateWithFlags(&copy, cudaStreamNonBlocking));
+    CK(cudaStreamCreateWithFlags(&cs, cudaStreamNonBlocking));
+    volatile uint32_t *flag_h, *staging_h, *seen_h;
+    CK(cudaHostAlloc((void**) &flag_h, 64, cudaHostAllocMapped));
+    CK(cudaHostAlloc((void**) &staging_h, 64, cudaHostAllocMapped));
+    CK(cudaHostAlloc((void**) &seen_h, 64, cudaHostAllocMapped));
+    volatile uint32_t *flag_d, *staging_d, *seen_d;
+    CK(cudaHostGetDevicePointer((void**) &flag_d, (void*) flag_h, 0));
+    CK(cudaHostGetDevicePointer((void**) &staging_d, (void*) staging_h, 0));
+    CK(cudaHostGetDevicePointer((void**) &seen_d, (void*) seen_h, 0));
+    FlagRaise slots[4] = {};
+    SlowCopy c0{staging_h, 0xAAu, 150};
+
+    // 1. nonempty plan (layer 0) followed by an empty plan (layer 1) while the copy is delayed
+    *flag_h = 0; *staging_h = 0; *seen_h = 0;
+    CK(cudaLaunchHostFunc(copy, slow_copy, &c0));                                // layer 0's upload, in flight
+    CK(raise_flag_b_ordered(true, copy, &slots[0], (uint32_t*) flag_h, 1));      // its completion flag (non-empty plan)
+    CK(raise_flag_b_ordered(true, copy, &slots[1], (uint32_t*) flag_h, 2));      // layer 1: empty plan, same copy stream
+    CHECK(rd(flag_h) == 0);                                                      // neither flag may rise before the delayed copy
+    consumer<<<1, 1, 0, cs>>>(flag_d, 1, staging_d, seen_d);                     // the graph's layer-0 group
+    CK(cudaStreamSynchronize(cs));
+    CHECK(rd(seen_h) == 0xAAu);                                                  // the consumer saw the final writer's bytes
+    CK(cudaStreamSynchronize(copy));
+    CHECK(rd(flag_h) == 2);
+
+    // 2. the negative control: a direct raise (the old empty-plan path) does release the consumer early
+    *flag_h = 0; *staging_h = 0; *seen_h = 0;
+    CK(cudaLaunchHostFunc(copy, slow_copy, &c0));
+    flag_raise_max((uint32_t*) flag_h, 2);                                       // what an unordered empty plan did
+    consumer<<<1, 1, 0, cs>>>(flag_d, 1, staging_d, seen_d);
+    CK(cudaStreamSynchronize(cs));
+    CHECK(rd(seen_h) == 0);                                                      // read before the copy landed: the bug the ordered raise removes
+    CK(cudaStreamSynchronize(copy));
+
+    // 3. nothing queued in this window: the flag rises at once
+    *flag_h = 0;
+    CK(raise_flag_b_ordered(false, copy, &slots[2], (uint32_t*) flag_h, 3));
+    CHECK(rd(flag_h) == 3);
+
+    // 4. the flag only rises: a late host function of an earlier layer does not lower it
+    *flag_h = 5;
+    CK(raise_flag_b_ordered(true, copy, &slots[3], (uint32_t*) flag_h, 4));
+    CK(cudaStreamSynchronize(copy));
+    CHECK(rd(flag_h) == 5);
+
+    // 5. an idle copy stream with copies_queued still set (the window's earlier copies finished): raised through the stream
+    *flag_h = 0;
+    CK(raise_flag_b_ordered(true, copy, &slots[0], (uint32_t*) flag_h, 6));
+    CK(cudaStreamSynchronize(copy));
+    CHECK(rd(flag_h) == 6);
+
+    // 6. through a graph: the consumer is captured and replayed twice, a fresh delayed copy each time
+    {
+        cudaGraph_t graph; cudaGraphExec_t exec;
+        CK(cudaStreamBeginCapture(cs, cudaStreamCaptureModeThreadLocal));
+        consumer<<<1, 1, 0, cs>>>(flag_d, 7, staging_d, seen_d);
+        CK(cudaStreamEndCapture(cs, &graph));
+        CK(cudaGraphInstantiate(&exec, graph, nullptr, nullptr, 0));
+        for (int rep = 0; rep < 2; ++rep) {
+            *flag_h = 0; *staging_h = 0; *seen_h = 0;
+            SlowCopy c{staging_h, 0x55u + (uint32_t) rep, 60};
+            CK(cudaLaunchHostFunc(copy, slow_copy, &c));
+            CK(raise_flag_b_ordered(true, copy, &slots[1], (uint32_t*) flag_h, 7));
+            CK(cudaGraphLaunch(exec, cs));
+            CK(cudaStreamSynchronize(cs));
+            CHECK(rd(seen_h) == 0x55u + (uint32_t) rep);
+            CK(cudaStreamSynchronize(copy));
+        }
+        CK(cudaGraphExecDestroy(exec));
+        CK(cudaGraphDestroy(graph));
+    }
+    CK(cudaStreamDestroy(copy));
+    CK(cudaStreamDestroy(cs));
+    CK(cudaFreeHost((void*) flag_h)); CK(cudaFreeHost((void*) staging_h)); CK(cudaFreeHost((void*) seen_h));
+    return 0;
+}
+
+int main() {
+    int n = 0;
+    CK(cudaGetDeviceCount(&n));
+    if (n == 0) { std::puts("flag_order_test: no device, skipped"); return 0; }
+    for (int d = 0; d < n; ++d) {
+        const int rc = run_device(d);
+        if (rc != 0) return rc;
+        std::printf("flag_order_test: device %d ok\n", d);
+    }
+    if (failed) { std::fprintf(stderr, "%d check(s) failed\n", failed); return 1; }
+    std::puts("flag_order_test: ok");
+    return 0;
+}
diff --git a/tests/core/la_cadence_test.cpp b/tests/core/la_cadence_test.cpp
new file mode 100644
index 000000000..36d8edc3e
--- /dev/null
+++ b/tests/core/la_cadence_test.cpp
@@ -0,0 +1,138 @@
+// tests/core/la_cadence_test.cpp - the look-ahead learner's training cadence (SPEC-adaptive-la change 2), CPU only.
+//
+// The rule is strata::kernels::la_cadence (include/strata/kernels/la_cadence.hpp): the same functions the device batch calls
+// (la_b_prep_k, la_b_decide_k) and the host gate (la_learn_post_launch) use.  Checked here:
+//   * the period: 4 windows after a freeze, 8 after 2,000 more picks, 16 after 4,000 more, never more;
+//   * the drop test: a recent block below the long-run rate (Newcombe 90%, >= 100 recent picks) sends the period back to 4;
+//     a stable block, or a short one, does not;
+//   * a scripted frozen (layer, dist): the windows it trains in, the period through a freeze, a doubling, the cap, a drop and a change;
+//   * the gate: a window with no trainer has no training launch; a window with one does; the legacy every-4th-batch rule is unchanged;
+//   * the scoring and the cadence step run in every window while the training is gated: the picks count every window, and a
+//     recent drop is seen in the window it happens, even when that window trains nothing;
+//   * a 50-window run with a frozen leader and no live set launches 12 training batches (the due windows), not 50.
+#include "strata/kernels/la_cadence.hpp"
+
+#include <cstdio>
+#include <string>
+#include <vector>
+
+namespace la = strata::kernels::la_cadence;
+
+namespace {
+int g_fail = 0;
+void check(bool ok, const std::string& what) {
+    std::printf("  %-96s %s\n", what.c_str(), ok ? "ok" : "FAIL");
+    if (!ok) ++g_fail;
+}
+
+// the hits of a block of n picks at rate p (rounded)
+unsigned long long hits_at(double p, unsigned long long n) { return (unsigned long long) (p * (double) n + 0.5); }
+}  // namespace
+
+int main() {
+    std::printf("la_cadence_test\n");
+
+    // 1. the period: from a base of 0 (a freeze at 0 picks), doubling each 2,000 picks, capped at 16
+    check(la::frozen_period(0, 0) == 4, "period 4 at the freeze (0 picks since the base)");
+    check(la::frozen_period(1999, 0) == 4, "period 4 just before 2,000 picks");
+    check(la::frozen_period(2000, 0) == 8, "period 8 at 2,000 picks");
+    check(la::frozen_period(3999, 0) == 8, "period 8 just before 4,000 picks");
+    check(la::frozen_period(4000, 0) == 16, "period 16 at 4,000 picks");
+    check(la::frozen_period(1000000, 0) == 16, "period stays at the cap of 16 far past 4,000 picks");
+    check(la::frozen_period(2000, 2000) == 4, "a base of 2,000 (a freeze at 2,000 picks) starts at 4 again");
+    check(la::frozen_period(4000, 2000) == 8, "from base 2,000: 8 at 4,000");
+    check(la::frozen_period(6000, 2000) == 16, "from base 2,000: 16 at 6,000");
+    check(la::frozen_period(100, 200) == 4, "picks below the base (a reset in between) read as 4, not a wrap");
+
+    // 2. the drop test
+    check(la::recent_drop(hits_at(0.9, 2000), 2000, hits_at(0.5, 500), 500), "a recent 50% block against a long-run 90% is a drop");
+    check(!la::recent_drop(hits_at(0.9, 2000), 2000, hits_at(0.9, 500), 500), "a recent block at the long-run rate is not a drop");
+    check(!la::recent_drop(hits_at(0.9, 2000), 2000, hits_at(0.88, 500), 500), "a 2-point dip over 500 picks is within the interval");
+    check(!la::recent_drop(hits_at(0.9, 2000), 2000, 0, 50), "a recent block of 50 picks (< 100) never drops");
+    check(!la::recent_drop(0, 0, 0, 500), "no long-run picks: no drop");
+
+    // 3. a scripted frozen (layer, dist): window w, picks, the recent block; it trains only in its due windows
+    la::State st{0, 0, 1};
+    la::set_frozen(st, 10, 2000);   // frozen at window 10 with 2,000 picks
+    check(st.due == 14 && st.per == 4 && st.base == 2000, "a freeze at window 10 (2,000 picks): due 14, period 4");
+    bool trained_early = false;
+    for (int w = 11; w < 14; ++w) {
+        trained_early |= la::trains_at(st.due, w);
+        la::after_window(st, w, false, 2000 + 10 * (w - 10), hits_at(0.9, 2000), 500, hits_at(0.9, 500));
+    }
+    check(!trained_early && st.due == 14, "the frozen leader does not train in windows 11-13 (their cadence steps still run)");
+    check(la::trains_at(st.due, 14), "the frozen leader trains in window 14");
+    la::after_window(st, 14, true, 2400, hits_at(0.9, 2400), 500, hits_at(0.9, 500));
+    check(st.due == 18 && st.per == 4, "stable after window 14 (400 picks since the base): due 18, period 4");
+    la::after_window(st, 18, true, 4100, hits_at(0.9, 4100), 500, hits_at(0.9, 500));
+    check(st.due == 26 && st.per == 8, "2,100 picks since the base at window 18: period 8, due 26");
+    la::after_window(st, 26, true, 6100, hits_at(0.9, 6100), 500, hits_at(0.9, 500));
+    check(st.due == 42 && st.per == 16, "4,100 picks since the base at window 26: period 16, due 42");
+    la::after_window(st, 42, true, 9000, hits_at(0.9, 9000), 500, hits_at(0.9, 500));
+    check(st.due == 58 && st.per == 16, "still at the cap of 16 at window 42: due 58");
+    la::after_window(st, 58, true, 9500, hits_at(0.9, 9500), 500, hits_at(0.4, 500));
+    check(st.due == 62 && st.per == 4 && st.base == 9500, "a recent drop (40% against 90%) at window 58: back to 4, due 62");
+    la::after_window(st, 59, false, 9510, hits_at(0.9, 9510), 500, hits_at(0.4, 500));
+    check(st.due == 62 && st.base == 9510, "a persisting drop at window 59 (not trained) keeps the due at 62, no stall");
+    la::set_live(st, 62);
+    check(st.per == 1 && st.due == 63 && la::trains_at(st.due, 63), "a change or reset (set_live): every window trains");
+
+    // 4. the gate: no trainer in the window, no launch; the gate's validity; the legacy rule
+    check(la::launch_needed(false, la::kNever, 5), "the gate not valid (no batch done yet): launch");
+    check(!la::launch_needed(true, la::kNever, 5), "valid gate, no set due ever: no launch");
+    check(!la::launch_needed(true, 9, 5), "valid gate, next trainer at window 9, this window 5: no launch");
+    check(la::launch_needed(true, 5, 5), "valid gate, trainer due this window: launch");
+    check(la::launch_needed(true, 4, 5), "valid gate, a trainer already due (late): launch");
+    check(la::legacy_trains(0) && !la::legacy_trains(1) && !la::legacy_trains(3) && la::legacy_trains(4) && la::legacy_trains(8),
+          "the legacy rule (STRATA_LA_CADENCE=0) trains every 4th batch: 0, 4, 8");
+
+    // 5. a run: one frozen leader, no live set, 50 windows.  Every window scores (picks += 10) and steps the cadence; the training
+    // launch happens only in the windows the gate lets through (the decide's next-training window, valid as the last batch is done)
+    {
+        la::State s2{0, 0, 1};
+        unsigned long long picks = 2000;   // frozen at window 0
+        la::set_frozen(s2, 0, picks);
+        int min_due = s2.due;
+        int launches = 0;
+        std::vector<int> when;
+        for (int w = 1; w <= 50; ++w) {
+            picks += 10;
+            const bool train = la::launch_needed(true, min_due, w);
+            if (train) {
+                ++launches;
+                when.push_back(w);
+            }
+            la::after_window(s2, w, train && la::trains_at(s2.due, w), picks, hits_at(0.9, picks), 500, hits_at(0.9, 500));
+            min_due = s2.due;
+        }
+        check(launches == 12 && when.size() >= 2 && when[0] == 4 && when[1] == 8,
+              "50 windows with a frozen leader: training launches at its due windows (4, 8, 12, ...), not every window");
+        check(picks == 2000 + 10 * 50, "the picks advance in every window (the scoring is not gated)");
+        std::printf("    (training launches in 50 windows: %d, first windows: %d %d %d)\n", launches, when.size() > 0 ? when[0] : -1,
+                    when.size() > 1 ? when[1] : -1, when.size() > 2 ? when[2] : -1);
+    }
+
+    // 6. a drop in a window that trains nothing is seen in that window: a frozen leader due at window 20 (next due 24), a recent block
+    // that goes to 0 hits at window 21: the base moves to the picks of window 21 and the due comes in no later than 25
+    {
+        la::State s3{0, 0, 1};
+        unsigned long long picks = 2000;
+        la::set_frozen(s3, 0, picks);
+        s3.due = 20;
+        s3.per = 4;
+        for (int w = 1; w <= 21; ++w) {
+            picks += 10;
+            const bool train = la::trains_at(s3.due, w);
+            const unsigned long long rec_hits = w < 21 ? hits_at(0.9, 500) : 0;
+            la::after_window(s3, w, train, picks, hits_at(0.9, picks), 500, rec_hits);
+            if (w == 20) check(s3.due == 24, "a trained window 20 (4 windows on): due 24");
+            if (w == 21) {
+                check(!train, "window 21 trains nothing (no training launch)");
+                check(s3.base == picks && s3.due <= 25, "the drop at window 21 is seen in that window: base moved, due <= 25");
+            }
+        }
+    }
+
+    std::printf("%s (%d failures)\n", g_fail == 0 ? "PASS" : "FAIL", g_fail);
+    return g_fail == 0 ? 0 : 1;
+}
diff --git a/tests/core/paired_test_test.cpp b/tests/core/paired_test_test.cpp
new file mode 100644
index 000000000..a28942218
--- /dev/null
+++ b/tests/core/paired_test_test.cpp
@@ -0,0 +1,280 @@
+// tests/core/paired_test_test.cpp - the on-line tuners' decision routine (include/strata/core/paired_test.hpp) on the CPU: no CUDA, no
+// engine.  (a) the A/A false-move rate over 10,000 simulated tests per sigma; (b) the power of a true 6% gain; (c) the quality veto;
+// (d) the sequential rule's edges (minimum pairs, keep, cap); (e) Welford against a two-pass computation; (f) the per-pair value;
+// (g) scripted sequences through the stage and step rules the tuners use (budget and mask).
+#include "strata/core/paired_test.hpp"
+
+#include <cmath>
+#include <cstdio>
+#include <random>
+#include <string>
+#include <vector>
+
+namespace pt = strata::core::paired;
+
+namespace {
+int g_fail = 0;
+void check(bool ok, const std::string& what) {
+    std::printf("  %-96s %s\n", what.c_str(), ok ? "ok" : "FAIL");
+    if (!ok) ++g_fail;
+}
+
+// One simulated test: pairs drawn from draw() until a decision or the cap.  Returns the verdict and the pairs used.
+struct SimResult {
+    pt::Verdict v;
+    long long pairs;
+};
+template <class Draw>
+SimResult simulate(const pt::Rule& r, Draw draw) {
+    pt::PairStats s;
+    for (long long k = 1;; ++k) {
+        s.add(draw());
+        const pt::Verdict v = pt::decide(s, r, false);
+        if (v != pt::Verdict::Continue) return {v, k};
+    }
+}
+
+const double kEffect = 0.03;   // STRATA_TUNE_MIN_EFFECT's default
+}  // namespace
+
+int main() {
+    std::printf("paired_test_test\n");
+    const pt::Rule budget = pt::budget_rule(kEffect);
+    const pt::Rule mask = pt::mask_rule(kEffect);
+
+    // (e) Welford against a two-pass mean and sample variance
+    {
+        std::mt19937_64 rng(7);
+        std::normal_distribution<double> nd(0.02, 0.05);
+        std::vector<double> xs;
+        pt::PairStats s;
+        for (int i = 0; i < 500; ++i) {
+            xs.push_back(nd(rng));
+            s.add(xs.back());
+        }
+        double m = 0.0;
+        for (double x : xs) m += x;
+        m /= (double) xs.size();
+        double v = 0.0;
+        for (double x : xs) v += (x - m) * (x - m);
+        v /= (double) (xs.size() - 1);
+        check(std::fabs(s.mean - m) < 1e-12 && std::fabs(s.var() - v) < 1e-12 && std::fabs(s.se() - std::sqrt(v / 500.0)) < 1e-12,
+              "Welford mean, variance and se match a two-pass computation (500 draws)");
+        pt::PairStats one;
+        one.add(0.5);
+        check(one.se() == 0.0 && one.mean == 0.5, "one pair: se 0 (no variance yet), mean is the pair");
+    }
+
+    // (f) the per-pair value
+    {
+        double d = 0.0;
+        check(pt::pair_diff(800.0, 10.0, 1000.0, 10.0, d) && std::fabs(d - std::log(1.25)) < 1e-12,
+              "pair value is ln(rate_cand / rate_base): 1000 tok in 10 s vs 800 tok in 10 s is ln(1.25)");
+        check(pt::pair_diff(800.0, 10.0, 600.0, 20.0, d) && std::fabs(d - std::log(0.375)) < 1e-12,
+              "pair value: a candidate at 30 tok/s (600 tok in 20 s) vs a base at 80 tok/s is ln(0.375)");
+        check(!pt::pair_diff(0.0, 10.0, 1000.0, 10.0, d) && !pt::pair_diff(800.0, 0.0, 1000.0, 10.0, d) &&
+                  !pt::pair_diff(800.0, 10.0, 0.0, 10.0, d) && !pt::pair_diff(800.0, 10.0, 1000.0, -1.0, d),
+              "a block with no committed tokens or no wall time is no pair");
+    }
+
+    // (d) the sequential rule's edges
+    {
+        pt::PairStats s;
+        pt::Verdict v = pt::Verdict::Continue;
+        for (int i = 0; i < 11; ++i) {
+            s.add(0.5);
+            v = pt::decide(s, budget, false);
+        }
+        check(v == pt::Verdict::Continue, "no decision before 12 pairs, even for a huge difference (11 pairs of +0.5)");
+        s.add(0.5);
+        v = pt::decide(s, budget, false);
+        check(v == pt::Verdict::Move, "a huge difference moves at the 12th pair (zero spread, mean - 2 se > delta)");
+
+        pt::PairStats z;
+        for (int i = 0; i < 12; ++i) z.add(0.0);
+        check(pt::decide(z, budget, false) == pt::Verdict::Keep, "zero difference keeps at the 12th pair (mean + 2 se < delta)");
+
+        pt::PairStats cap;
+        for (int i = 0; i < 160; ++i) cap.add((i % 2) ? 0.5 : -0.5);   // mean 0, sd 0.5: never decided
+        pt::Reason why = pt::Reason::None;
+        const pt::Verdict vc = pt::decide(cap, budget, false, &why);
+        check(vc == pt::Verdict::Keep && why == pt::Reason::Cap, "at the budget cap (160 pairs) an undecided test keeps");
+        pt::PairStats capm;
+        for (int i = 0; i < 240; ++i) capm.add((i % 2) ? 0.5 : -0.5);
+        check(pt::decide(capm, mask, false) == pt::Verdict::Keep && pt::decide(capm, mask, false) != pt::Verdict::Move &&
+                  pt::decide(cap, mask, false) == pt::Verdict::Continue,
+              "mask rule: 160 undecided pairs continue (cap 240), 240 keep");
+
+        // the minimum effect: a 2% gain with tight spread does not move, a 4% gain does
+        pt::PairStats two, four;
+        std::mt19937_64 rng(11);
+        std::normal_distribution<double> n2(std::log(1.02), 0.002), n4(std::log(1.04), 0.002);
+        pt::Verdict v2 = pt::Verdict::Continue, v4 = pt::Verdict::Continue;
+        for (int i = 0; i < 160 && v2 == pt::Verdict::Continue; ++i) {
+            two.add(n2(rng));
+            v2 = pt::decide(two, budget, false);
+        }
+        for (int i = 0; i < 160 && v4 == pt::Verdict::Continue; ++i) {
+            four.add(n4(rng));
+            v4 = pt::decide(four, budget, false);
+        }
+        check(v2 == pt::Verdict::Keep, "a true 2% gain (tight spread) is kept: below the 3% minimum effect");
+        check(v4 == pt::Verdict::Move, "a true 4% gain (tight spread) moves: above the 3% minimum effect");
+    }
+
+    // (a) A/A: two identical arms, pairs ~ N(0, sigma).  False-move rate over 10,000 tests per sigma (fixed seed).
+    std::printf("  A/A false-move rate, budget rule (10,000 tests per sigma, cap 160 pairs):\n");
+    for (double sigma : {0.02, 0.05, 0.1}) {
+        std::mt19937_64 rng(20261108ULL + (unsigned long long) (sigma * 1000));
+        std::normal_distribution<double> nd(0.0, sigma);
+        int moves = 0, capped = 0;
+        double pairs_sum = 0.0;
+        for (int t = 0; t < 10000; ++t) {
+            const SimResult r = simulate(budget, [&] { return nd(rng); });
+            if (r.v == pt::Verdict::Move) ++moves;
+            if (r.v == pt::Verdict::Keep && r.pairs == budget.cap) ++capped;
+            pairs_sum += (double) r.pairs;
+        }
+        const double rate = (double) moves / 10000.0;
+        std::printf("    sigma %.2f: false moves %d / 10000 = %.2f%%, capped %d, mean pairs %.1f\n", sigma, moves, 100.0 * rate, capped,
+                    pairs_sum / 10000.0);
+        char what[160];
+        std::snprintf(what, sizeof what, "A/A false-move rate <= 5%% at sigma %.2f (measured %.2f%%)", sigma, 100.0 * rate);
+        check(rate <= 0.05, what);
+    }
+
+    // (b) power: a true 6% gain (d ~ N(ln 1.06, 0.05)) moves before the cap in >= 80% of tests
+    {
+        std::mt19937_64 rng(4242);
+        std::normal_distribution<double> nd(std::log(1.06), 0.05);
+        int moves = 0, keeps = 0;
+        double pairs_sum = 0.0;
+        for (int t = 0; t < 10000; ++t) {
+            const SimResult r = simulate(budget, [&] { return nd(rng); });
+            if (r.v == pt::Verdict::Move) ++moves;
+            else ++keeps;
+            pairs_sum += (double) r.pairs;
+        }
+        const double power = (double) moves / 10000.0;
+        std::printf("    power, true 6%% gain at sigma 0.05: moves %d / 10000 = %.2f%% (keeps %d), mean pairs %.1f\n", moves, 100.0 * power,
+                    keeps, pairs_sum / 10000.0);
+        char what[160];
+        std::snprintf(what, sizeof what, "a true 6%% gain at sigma 0.05 moves in >= 80%% of tests (measured %.2f%%)", 100.0 * power);
+        check(power >= 0.80, what);
+    }
+
+    // (c) the quality veto
+    {
+        // a clear flip difference: 2 flips in 1000 tokens (base) vs 30 in 1000 (cand): the candidate's lower bound is above the base's upper
+        check(pt::quality_veto(2, 1000, 30, 1000, 200, 3), "quality veto: 30 vs 2 flips per 1000 tokens blocks the candidate");
+        // a 1.5x point rate with >= 3 flips, and the interval overlaps (10/10000 base vs 3/1000 cand: cand 0.3% vs 0.1%)
+        check(pt::quality_veto(10, 10000, 3, 1000, 200, 3), "quality veto: 3 flips at 3x the base's rate (>= 3 flips) blocks");
+        check(!pt::quality_veto(10, 10000, 2, 1000, 200, 3), "quality veto: 2 flips (under 3) at 2x the rate does not block");
+        check(!pt::quality_veto(20, 1000, 20, 1000, 200, 3), "quality veto: equal flip rates do not block");
+        check(!pt::quality_veto(0, 100, 5, 100, 200, 3), "quality veto: needs >= 200 committed tokens in both arms (none here)");
+
+        // the veto ends a test as a keep even when the candidate is 6% faster (a sequence of fast pairs)
+        pt::PairStats s;
+        for (int i = 0; i < 40; ++i) s.add(std::log(1.06));
+        pt::Reason why = pt::Reason::None;
+        const pt::Verdict blocked = pt::decide(s, budget, true, &why);
+        check(blocked == pt::Verdict::Keep && why == pt::Reason::Quality, "a faster candidate with the quality veto holding is kept");
+        check(pt::decide(s, budget, false) == pt::Verdict::Move, "the same pairs without the veto move (control)");
+    }
+
+    // (g) scripted sequences through the state rules
+    {
+        // budget: pair sequences per test -> (move?) through the DirState and BudgetStep the tuner uses (verify.cpp route_auto_test_done)
+        float b = 0.1f;
+        pt::DirState dir;
+        pt::BudgetStep step;
+        auto run_test = [&](const std::vector<double>& ds) -> bool {   // true: move
+            pt::PairStats s;
+            pt::Verdict v = pt::Verdict::Continue;
+            for (double d : ds) {
+                s.add(d);
+                v = pt::decide(s, budget, false);
+                if (v != pt::Verdict::Continue) break;
+            }
+            if (v == pt::Verdict::Continue) v = pt::Verdict::Keep;   // the tuner keeps when the pairs end without a decision
+            const bool won = v == pt::Verdict::Move;
+            const int d = dir.dir();
+            if (won) b = b * std::pow(step.step, (float) d);
+            step.update(won, d);
+            dir.update(won, d);
+            return won;
+        };
+        // 1. a clear win in the candidate's direction (+1) moves b up and keeps the direction first
+        std::vector<double> up(14, std::log(1.10));
+        check(run_test(up) && dir.first == 1 && dir.stage == 0 && b > 0.1f, "scripted: a clear win moves b up, direction +1 stays first");
+        // 2. a second clear win the same way grows the step (x1.25: 1.25 -> 1.5625)
+        const float s_before = step.step;
+        check(run_test(up) && step.step > s_before && step.last_win == 1, "scripted: a second win the same way grows the step");
+        // 3. noise: five tests of zero difference, b does not move, the first direction alternates every second test
+        const float b_mid = b;
+        const int first0 = dir.first;
+        std::vector<double> zero(14, 0.0);
+        bool any_move = false;
+        for (int t = 0; t < 2; ++t) any_move = any_move || run_test(zero);   // stage 0 keep, stage 1 keep: the round ends, first flips
+        check(!any_move && b == b_mid && dir.first == -first0 && dir.stage == 0, "scripted: noise keeps b and flips the first direction after both lost");
+        // 4. a loss shrinks the step toward 1.1
+        const float s_loss = step.step;
+        check(!run_test(zero) && step.step < s_loss && step.step >= 1.1f, "scripted: a keep shrinks the step toward 1.1 (never below)");
+        // 5. a zero difference decides keep at 12 pairs (no sign of a gain); b does not move
+        std::vector<double> flat(300, std::log(1.0));
+        check(!run_test(flat) && b == b_mid, "scripted: a zero difference keeps b");
+        // 5b. a noisy test that never decides keeps at the cap (alternating +-0.5 pairs: 160 pairs, no decision)
+        std::vector<double> noisy;
+        for (int i = 0; i < 200; ++i) noisy.push_back((i % 2) ? 0.5 : -0.5);
+        check(!run_test(noisy) && b == b_mid, "scripted: an undecided noisy test keeps b at the cap");
+        // 6. a quality-blocked candidate: 40 fast pairs, the veto holds: keep, the direction moves on
+        {
+            pt::PairStats s;
+            for (int i = 0; i < 40; ++i) s.add(std::log(1.10));
+            const pt::Verdict v = pt::decide(s, budget, true);
+            check(v == pt::Verdict::Keep, "scripted: the quality veto keeps a fast candidate (b unchanged by the verdict)");
+        }
+        std::printf("    scripted budget end: b %.4f, step %.3f, direction %d stage %d\n", (double) b, (double) step.step, dir.first, dir.stage);
+    }
+
+    {
+        // mask: a single move takes the candidate (no two-wins rule); a second move the same way doubles the step to 2; a keep halves it
+        pt::MaskStep ms;
+        ms.on_move(1);
+        check(ms.step == 1.0 && ms.last_move == 1, "scripted mask: the first move takes one step (no second win needed), last move +1");
+        ms.on_move(1);
+        check(ms.step == 2.0, "scripted mask: a second move the same way doubles the step");
+        ms.on_loss();
+        check(ms.step == 1.0, "scripted mask: a keep halves the step (floor 1)");
+        ms.on_loss();
+        check(ms.step == 1.0, "scripted mask: the step never falls below 1");
+        ms.on_move(-1);
+        check(ms.step == 1.0 && ms.last_move == -1, "scripted mask: a move in the other direction keeps the step and records -1");
+        pt::Rule r = pt::mask_rule(kEffect);
+        pt::PairStats s;
+        for (int i = 0; i < 12; ++i) s.add(std::log(1.08));
+        check(pt::decide(s, r, false) == pt::Verdict::Move, "scripted mask: a clear 8% gain moves the mask at 12 pairs");
+    }
+
+    {
+        // SPEC-recheck-cheap change 4: the cut guard (Wilson 90% of cuts per token; the candidate's lower bound above twice the base's upper)
+        check(pt::cut_veto(10, 1000, 60, 1000, 100), "cut guard: 6 cuts per 100 tok against 1 per 100 is blocked (lower bound above 2x the base's upper)");
+        check(!pt::cut_veto(10, 1000, 20, 1000, 100), "cut guard: 2 per 100 against 1 per 100 is not blocked (the bounds overlap at 2x)");
+        check(!pt::cut_veto(10, 1000, 60, 1000, 2000), "cut guard: under the token minimum in either arm nothing is blocked");
+        check(!pt::cut_veto(0, 1000, 0, 1000, 100), "cut guard: no cuts in either arm is not blocked");
+        check(!pt::cut_veto(5, 1000, 5, 1000, 100), "cut guard: equal rates are not blocked");
+        check(pt::cut_veto(30, 1000, 900, 1000, 100) && pt::cut_veto(0, 1000, 500, 1000, 100), "cut guard: a candidate far above the base is blocked, even from zero");
+        // the decision: a clear gain moves at 12 pairs unless the cut guard holds, then it is kept with reason Cuts; the quality veto wins over it
+        pt::Rule r = pt::budget_rule(0.03);
+        pt::PairStats s;
+        for (int i = 0; i < 12; ++i) s.add(std::log(1.10));
+        pt::Reason why = pt::Reason::None;
+        check(pt::decide(s, r, false, &why) == pt::Verdict::Move && why == pt::Reason::Move, "cuts: a clear gain moves when no guard holds");
+        check(pt::decide(s, r, false, &why, true) == pt::Verdict::Keep && why == pt::Reason::Cuts, "cuts: the cut guard keeps a clear gain (reason Cuts)");
+        check(pt::decide(s, r, true, &why, true) == pt::Verdict::Keep && why == pt::Reason::Quality, "cuts: the quality veto takes precedence over the cut guard");
+        check(pt::decide(s, r, false, &why, false) == pt::Verdict::Move, "cuts: an unblocked decision is unchanged by the new argument");
+    }
+
+    std::printf("paired_test_test: %s (%d failed)\n", g_fail ? "FAIL" : "ok", g_fail);
+    return g_fail ? 1 : 0;
+}
diff --git a/tests/core/risk_concentration_test.cpp b/tests/core/risk_concentration_test.cpp
new file mode 100644
index 000000000..3e934d342
--- /dev/null
+++ b/tests/core/risk_concentration_test.cpp
@@ -0,0 +1,85 @@
+// tests/core/risk_concentration_test.cpp - the per-row share of swap risk carried by the top events (CPU only).
+#include "strata/core/risk_concentration.hpp"
+
+#include <cmath>
+#include <cstdio>
+#include <string>
+
+using strata::core::risk::Concentration;
+using strata::core::risk::row_shares;
+using strata::core::risk::RowShares;
+
+namespace {
+int failures = 0;
+
+#define CHECK(cond, msg)                                                       \
+    do {                                                                       \
+        if (!(cond)) {                                                         \
+            std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, msg); \
+            ++failures;                                                        \
+        }                                                                      \
+    } while (0)
+
+bool near(double a, double b) { return std::fabs(a - b) < 1e-12; }
+
+void test_shares() {
+    RowShares e = row_shares({});
+    CHECK(e.events == 0 && near(e.top1, 0) && e.need50 == 0, "no events: all zero");
+
+    RowShares z = row_shares({0.0, 0.0});
+    CHECK(z.events == 2 && near(z.top1, 0) && z.need90 == 0, "no risk at all: shares 0, counts 0");
+
+    // total 10: sorted 4,2,1,1,1,1
+    RowShares r = row_shares({1, 4, 1, 2, 1, 1});
+    CHECK(near(r.top1, 0.4), "top1 = 4/10");
+    CHECK(near(r.top3, 0.7), "top3 = (4+2+1)/10");
+    CHECK(near(r.top10, 1.0), "fewer than 10 events: top10 is everything");
+    CHECK(r.need50 == 2, "50%: cumulative 4, 6 -> 2 events");
+    CHECK(r.need80 == 4, "80%: cumulative 4, 6, 7, 8 -> 4 events");
+    CHECK(r.need90 == 5, "90%: cumulative reaches 9 at 5 events");
+    CHECK(r.events == 6, "six events");
+
+    // a negative risk counts as zero
+    RowShares n = row_shares({-5, 2, 2});
+    CHECK(near(n.top1, 0.5) && near(n.top3, 1.0), "negative risk is 0 (shares of the rest)");
+
+    // ten events of equal risk: top10 = 1, top1 = 0.1
+    std::vector<double> eq(10, 1.0);
+    RowShares q = row_shares(eq);
+    CHECK(near(q.top1, 0.1) && near(q.top3, 0.3) && near(q.top10, 1.0), "equal risks spread evenly");
+    CHECK(q.need50 == 5 && q.need90 == 9, "equal risks: 5 for 50%, 9 for 90%");
+
+    // a single event carries everything
+    RowShares s = row_shares({3.0});
+    CHECK(near(s.top1, 1.0) && s.need50 == 1 && s.need90 == 1, "one event: share 1, need 1");
+}
+
+void test_groups_and_line() {
+    Concentration c;
+    CHECK(c.line().empty(), "no rows: no line");
+    c.add(row_shares({4, 2, 1, 1, 1, 1}), true);   // flipped: top1 0.4
+    c.add(row_shares({1, 1}), false);              // held: top1 0.5
+    CHECK(c.flipped.rows == 1 && c.held.rows == 1, "rows split by the verdict");
+    // share 0.4 -> decile 4; 0.5 -> decile 5; top10 share 1.0 -> decile 9
+    CHECK(c.flipped.hist_top1[4] == 1 && c.held.hist_top1[5] == 1, "top1 deciles");
+    CHECK(c.flipped.hist_top10[9] == 1 && c.held.hist_top10[9] == 1, "a share of 1.0 falls in the last decile");
+    const std::string line = c.line();
+    CHECK(line.find("swap risk concentration (cut rows 2)") != std::string::npos, "line head with the row count");
+    CHECK(line.find("events to carry 50/80/90%") != std::string::npos, "line names the 50/80/90 events");
+    CHECK(line.find("flipped 1 rows") != std::string::npos && line.find("held 1 rows") != std::string::npos, "line splits the groups");
+    c.reset();
+    CHECK(c.line().empty(), "reset clears the request");
+}
+
+}  // namespace
+
+int main() {
+    test_shares();
+    test_groups_and_line();
+    if (failures == 0) {
+        std::printf("risk_concentration_test: all checks passed\n");
+        return 0;
+    }
+    std::fprintf(stderr, "risk_concentration_test: %d check(s) failed\n", failures);
+    return 1;
+}
diff --git a/tests/core/serve_stop_bound_test.cpp b/tests/core/serve_stop_bound_test.cpp
new file mode 100644
index 000000000..de52aa298
--- /dev/null
+++ b/tests/core/serve_stop_bound_test.cpp
@@ -0,0 +1,35 @@
+// (asserts stay on in a Release build: the test is its own check)
+// Ported from upstream Strata 243fdb213 / 13eedf552 (#4677, by hanchengme), plus the on/off switch's cases.
+#undef NDEBUG
+#include "strata/core/serve_stop_bound.hpp"
+#include <cassert>
+#include <iostream>
+#include <vector>
+
+int main() {
+    int cases = 0;
+    // Independent reference: the existing emission loop, including its budget and EOS rules.
+    for (int accepted = 1; accepted <= 16; ++accepted)
+        for (int remaining = 1; remaining <= 18; ++remaining)
+            for (int eos = -1; eos < accepted; ++eos) {
+                std::vector<int> outputs(accepted);
+                for (int i = 0; i < accepted; ++i) outputs[i] = i == eos ? -1 : 100 + i;
+                std::vector<int> reference;
+                for (int i = 0; i < accepted && static_cast<int>(reference.size()) < remaining; ++i) {
+                    reference.push_back(outputs[i]);
+                    if (outputs[i] == -1) break;
+                }
+                const int kept = strata::core::serve_stop_bound(accepted, remaining, outputs.data(),
+                                                               [](int t) { return t == -1; });
+                assert(kept > 0 && kept <= accepted && kept <= remaining);
+                assert(std::vector<int>(outputs.begin(), outputs.begin() + kept) == reference);
+                // Unlike the old full-window commit, no unexposed input suffix enters the cached history.
+                assert(kept == static_cast<int>(reference.size()));
+                ++cases;
+            }
+    assert(strata::core::serve_stop_bound(4, 0, static_cast<const int*>(nullptr), [](int) { return false; }) == 0);
+    assert(strata::core::serve_stop_bound_on(nullptr));
+    assert(strata::core::serve_stop_bound_on("1"));
+    assert(!strata::core::serve_stop_bound_on("0"));
+    std::cout << "SUMMARY stop_bound cases=" << cases << " passed\n";
+}
diff --git a/tests/core/standin_pool_test.cpp b/tests/core/standin_pool_test.cpp
new file mode 100644
index 000000000..9065c2ef3
--- /dev/null
+++ b/tests/core/standin_pool_test.cpp
@@ -0,0 +1,276 @@
+// STRATA_STANDIN_LEARN's pooled estimates (include/strata/core/standin_pool.hpp), host only: the shrinkage, the readiness rule,
+// the parent groups rebuilt at load, the old table file's read, and the balance step.  With a path argument (a COPY of the live
+// table, e.g. data/standin-learn-*.bin copied to a temp dir) the same checks run on the real pairs, read only.
+#include "strata/core/standin_pool.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace sdp = strata::standin;
+
+static int g_fail = 0, g_pass = 0;
+#define CHECK(cond, ...)                                  \
+    do {                                                  \
+        if (cond) { ++g_pass; }                           \
+        else {                                            \
+            ++g_fail;                                     \
+            std::fprintf(stderr, "FAIL %s:%d: ", __FILE__, __LINE__); \
+            std::fprintf(stderr, __VA_ARGS__);            \
+            std::fprintf(stderr, "\n");                   \
+        }                                                 \
+    } while (0)
+
+// one scalar sample: y_s = 1, y_e = ratio (so the pair's c is the ratio)
+static void add_ratio(sdp::Pair& p, double ratio) {
+    p.num = sdp::kDecay * p.num + ratio;
+    p.den = sdp::kDecay * p.den + 1.0;
+    p.ee = sdp::kDecay * p.ee + ratio * ratio;
+    ++p.n;
+}
+static void add_ratio_group(sdp::Sums& g, double ratio) { sdp::add_sample(g, ratio, 1.0, ratio * ratio); }
+
+static void test_shrinkage() {
+    // a pair with one sample (c = 1.0) inside a parent group of 100 samples (c = 1.5): the parent's c, within 0.05
+    sdp::Pair one;
+    add_ratio(one, 1.0);
+    sdp::Sums layer;
+    for (int i = 0; i < 100; ++i) add_ratio_group(layer, 1.5);
+    const sdp::Est a = sdp::estimate(one, nullptr, &layer);
+    CHECK(a.pooled && a.ready, "one-sample pair with a ready layer parent: pooled %d ready %d", a.pooled, a.ready);
+    CHECK(std::fabs(a.c - 1.5) < 0.05, "one-sample pair takes the parent's c: got %.4f want ~1.5", a.c);
+    CHECK(std::fabs(a.c - 1.0) > 0.4, "one-sample pair moved toward the parent: got %.4f", a.c);
+
+    // 1,000 own samples at c = 1.0 with the same parent: its own c (within 0.01)
+    sdp::Pair many;
+    for (int i = 0; i < 1000; ++i) add_ratio(many, 1.0);
+    const sdp::Est b = sdp::estimate(many, nullptr, &layer);
+    CHECK(std::fabs(b.c - 1.0) < 0.01, "1000-sample pair keeps its own c: got %.4f want 1.0", b.c);
+
+    // no parent: the pair's own estimate, as before pooling (c = its own num / den)
+    const sdp::Est c0 = sdp::estimate(one, nullptr, nullptr);
+    CHECK(!c0.pooled && !c0.ready && std::fabs(c0.c - 1.0) < 1e-12, "no parent, one sample: not ready, own c (%d %d %.4f)", c0.pooled,
+          c0.ready, c0.c);
+    // the err of a perfect pair (y_s = y_e) is 0
+    const sdp::Est perfect = sdp::estimate(many, nullptr, nullptr);
+    CHECK(std::fabs(perfect.err) < 1e-6, "err of a perfect pair (no parent) is 0: got %.6f", perfect.err);
+}
+
+static void test_readiness_and_parent_choice() {
+    sdp::Pair p;
+    add_ratio(p, 1.0);
+    sdp::Sums g31, g32;
+    for (int i = 0; i < 31; ++i) add_ratio_group(g31, 1.5);
+    for (int i = 0; i < 32; ++i) add_ratio_group(g32, 1.5);
+    CHECK(!sdp::estimate(p, nullptr, &g31).ready, "a 31-sample parent is not a parent");
+    CHECK(sdp::estimate(p, nullptr, &g32).ready, "a 32-sample parent makes the pair ready");
+
+    sdp::Pair own;
+    for (int i = 0; i < 31; ++i) add_ratio(own, 1.0);
+    CHECK(!sdp::estimate(own, nullptr, nullptr).ready, "31 own samples, no parent: not ready");
+    add_ratio(own, 1.0);
+    CHECK(sdp::estimate(own, nullptr, nullptr).ready, "32 own samples: ready");
+
+    // (layer, e) group preferred over the layer; a short (layer, e) group falls back to the layer
+    sdp::Sums expert, layerB;
+    for (int i = 0; i < 32; ++i) add_ratio_group(expert, 1.2);
+    for (int i = 0; i < 32; ++i) add_ratio_group(layerB, 1.8);
+    const sdp::Est ex = sdp::estimate(p, &expert, &layerB);
+    CHECK(std::fabs(ex.c - 1.2) < 0.05, "expert group is the parent: c %.4f want ~1.2", ex.c);
+    sdp::Sums shortExpert;
+    for (int i = 0; i < 31; ++i) add_ratio_group(shortExpert, 1.2);
+    const sdp::Est fb = sdp::estimate(p, &shortExpert, &layerB);
+    CHECK(std::fabs(fb.c - 1.8) < 0.1, "short expert group falls back to the layer: c %.4f want ~1.8", fb.c);
+}
+
+static void test_rebuild_groups() {
+    std::unordered_map<uint64_t, sdp::Pair> pairs;
+    sdp::Pair a, b, c;
+    for (int i = 0; i < 40; ++i) add_ratio(a, 1.0);
+    for (int i = 0; i < 5; ++i) add_ratio(b, 1.0);
+    for (int i = 0; i < 7; ++i) add_ratio(c, 1.3);
+    pairs[sdp::pair_key(0, 5, 9)] = a;
+    pairs[sdp::pair_key(0, 5, 10)] = b;
+    pairs[sdp::pair_key(0, 6, 1)] = c;
+    std::vector<sdp::Sums> layer(3);
+    std::unordered_map<uint64_t, sdp::Sums> exp;
+    sdp::rebuild_groups(pairs, layer, exp);
+    CHECK(layer[0].n == 52, "layer 0 raw samples 52: got %lld", (long long) layer[0].n);
+    CHECK(layer[1].n == 0 && layer[2].n == 0, "layers without pairs stay empty");
+    CHECK(exp.count(sdp::expert_key(0, 5)) && exp[sdp::expert_key(0, 5)].n == 45, "expert (0,5) has 45 samples");
+    CHECK(exp.count(sdp::expert_key(0, 6)) && exp[sdp::expert_key(0, 6)].n == 7, "expert (0,6) has 7 samples");
+    const double wantW = sdp::decayed_weight(40) + sdp::decayed_weight(5) + sdp::decayed_weight(7);
+    CHECK(std::fabs(layer[0].w - wantW) < 1e-9, "layer weight is the pairs' decayed weights");
+    CHECK(std::fabs(exp[sdp::expert_key(0, 5)].w - (sdp::decayed_weight(40) + sdp::decayed_weight(5))) < 1e-9,
+          "expert weight is the decayed weight of its pairs");
+    // a single unit sample has weight 1 (the group's add_sample agrees with decayed_weight)
+    sdp::Sums one;
+    sdp::add_sample(one, 1.0, 1.0, 1.0);
+    CHECK(std::fabs(one.w - sdp::decayed_weight(1)) < 1e-12, "add_sample weight matches decayed_weight(1)");
+}
+
+// the old file format, written the way the saver wrote it
+static std::vector<uint8_t> make_old_table(int64_t layers, const std::vector<std::pair<uint64_t, sdp::Pair>>& recs, uint32_t declared) {
+    std::vector<uint8_t> out(16);
+    const uint32_t hd[4] = {sdp::kMagic, (uint32_t) layers, 512u, declared};
+    std::memcpy(out.data(), hd, 16);
+    for (const auto& kv : recs) {
+        const size_t at = out.size();
+        out.resize(at + 40);
+        const uint32_t n = (uint32_t) kv.second.n;
+        std::memcpy(out.data() + at, &kv.first, 8);
+        std::memcpy(out.data() + at + 8, &kv.second.num, 8);
+        std::memcpy(out.data() + at + 16, &kv.second.den, 8);
+        std::memcpy(out.data() + at + 24, &kv.second.ee, 8);
+        std::memcpy(out.data() + at + 32, &n, 4);
+        std::memcpy(out.data() + at + 36, &kv.second.c, 4);
+    }
+    return out;
+}
+
+static void test_old_table_loads() {
+    sdp::Pair p;
+    add_ratio(p, 1.25);
+    p.c = 1.25f;
+    const uint64_t k1 = sdp::pair_key(3, 100, 7), k2 = sdp::pair_key(3, 511, 511);
+    // a record with an out-of-range expert is skipped; the rest load
+    const sdp::Pair bad = p;
+    const uint64_t kbad = sdp::pair_key(3, 512, 1);
+    std::vector<uint8_t> buf = make_old_table(47, {{k1, p}, {kbad, bad}, {k2, p}}, 3);
+    std::vector<sdp::Loaded> out;
+    CHECK(sdp::parse_table(buf.data(), buf.size(), 47, out), "old-format table parses");
+    CHECK(out.size() == 2, "out-of-range record skipped: got %zu records", out.size());
+    CHECK(!out.empty() && out[0].key == k1 && out[0].p.n == 1 && std::fabs(out[0].p.c - 1.25f) < 1e-6 && std::fabs(out[0].p.num - p.num) < 1e-12,
+          "fields round-trip");
+    // a different model's layer count is refused
+    std::vector<sdp::Loaded> out2;
+    CHECK(!sdp::parse_table(buf.data(), buf.size(), 48, out2), "a table of another layer count is refused");
+    // a file cut short keeps its whole records
+    std::vector<uint8_t> cut(buf.begin(), buf.end() - 10);
+    std::vector<sdp::Loaded> out3;
+    CHECK(sdp::parse_table(cut.data(), cut.size(), 47, out3) && out3.size() == 1, "truncated last record is skipped (got %zu)", out3.size());
+    // not a table at all
+    std::vector<uint8_t> junk(64, 0x11);
+    std::vector<sdp::Loaded> out4;
+    CHECK(!sdp::parse_table(junk.data(), junk.size(), 47, out4), "junk is refused");
+}
+
+// The balance step: 12 experts in one layer, values from their errs; top decile +1, bottom -1; the two-round rule.
+static void test_balance_step() {
+    const int64_t layers = 1;
+    std::vector<double> best(512, -1.0);
+    std::vector<float> use(512, 1.0f), miss(512, 0.0f);
+    for (int e = 0; e < 12; ++e) best[(size_t) e] = 0.1 + 0.01 * e;   // expert 11 has the largest err (value)
+    std::vector<int8_t> state(512, 0);
+    std::vector<uint8_t> opp(512, 0);
+    sdp::balance_step(state, opp, best, use, miss, layers);
+    CHECK(state[11] == 1 && state[0] == -1, "round 1: the top expert kept (%d), the bottom given up (%d)", state[11], state[0]);
+    CHECK(state[5] == 0, "middle experts unchanged");
+    int plus = 0, minus = 0;
+    for (int e = 0; e < 512; ++e) { plus += state[(size_t) e] > 0; minus += state[(size_t) e] < 0; }
+    CHECK(plus == 1 && minus == 1, "one kept and one given up in a 12-expert layer (k = 1): %d %d", plus, minus);
+    // the values reversed: expert 11 is now the bottom. Its +1 holds for one more round (op 1), then goes to 0 (op 2)
+    for (int e = 0; e < 12; ++e) best[(size_t) e] = 0.1 + 0.01 * (11 - e);
+    sdp::balance_step(state, opp, best, use, miss, layers);
+    CHECK(state[11] == 1, "after 1 opposite round the state holds (+1)");
+    sdp::balance_step(state, opp, best, use, miss, layers);
+    CHECK(state[11] == 0, "after 2 opposite rounds the state goes to 0 (got %d)", state[11]);
+    // fewer than 10 ranked experts: no decision
+    std::vector<double> few(512, -1.0);
+    for (int e = 0; e < 9; ++e) few[(size_t) e] = 0.5;
+    std::vector<int8_t> st2(512, 0);
+    std::vector<uint8_t> op2(512, 0);
+    sdp::balance_step(st2, op2, few, use, miss, layers);
+    bool any = false;
+    for (const int8_t s : st2) any = any || s != 0;
+    CHECK(!any, "9 ranked experts make no decision");
+}
+
+// The live table copy (argv[1]): the old file loads, pooling makes more pairs ready than own counts, and the balance ranks
+// >= 10 experts in the layers that have data and keeps / gives up the top / bottom decile.  Read only.
+static int test_live(const char* path) {
+    std::ifstream f(path, std::ios::binary);
+    if (!f) { std::fprintf(stderr, "cannot open %s\n", path); return 1; }
+    std::vector<uint8_t> buf((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+    if (buf.size() < 16) { std::fprintf(stderr, "short file\n"); return 1; }
+    uint32_t hd[4] = {0, 0, 0, 0};
+    std::memcpy(hd, buf.data(), 16);
+    const int64_t layers = (int64_t) hd[1];
+    std::vector<sdp::Loaded> recs;
+    CHECK(sdp::parse_table(buf.data(), buf.size(), layers, recs), "live table parses (layers %lld, declared %u)", (long long) layers, hd[3]);
+    std::unordered_map<uint64_t, sdp::Pair> pairs;
+    for (const auto& r : recs) pairs[r.key] = r.p;
+    std::vector<sdp::Sums> layer_g((size_t) layers);
+    std::unordered_map<uint64_t, sdp::Sums> exp_g;
+    sdp::rebuild_groups(pairs, layer_g, exp_g);
+    int own = 0, pooled = 0;
+    std::vector<double> best((size_t) layers * 512, -1.0);
+    for (const auto& kv : pairs) {
+        const auto it = exp_g.find(sdp::expert_key((int64_t) (kv.first >> 40), (int64_t) ((kv.first >> 20) & 0xFFFFFu)));
+        const sdp::Sums* eg = it == exp_g.end() ? nullptr : &it->second;
+        const sdp::Sums* lg = &layer_g[(size_t) (kv.first >> 40)];
+        const sdp::Est es = sdp::estimate(kv.second, eg, lg);
+        if (kv.second.n >= sdp::kReady) ++own;
+        if (!es.ready) continue;
+        ++pooled;
+        const size_t i = (size_t) (kv.first >> 40) * 512 + (size_t) ((kv.first >> 20) & 0xFFFFFu);
+        if (best[i] < 0.0 || es.err < best[i]) best[i] = es.err;
+    }
+    std::printf("live: %zu pairs, own ready %d, pooled ready %d, experts pooled %zu\n", pairs.size(), own, pooled, exp_g.size());
+    CHECK(pooled >= own, "pooling never loses a ready pair: %d < %d", pooled, own);
+    std::vector<float> use((size_t) layers * 512, 1.0f), miss((size_t) layers * 512, 0.0f);
+    std::vector<int8_t> state((size_t) layers * 512, 0);
+    std::vector<uint8_t> opp((size_t) layers * 512, 0);
+    sdp::balance_step(state, opp, best, use, miss, layers);
+    int layers_ranked = 0, bad = 0;
+    for (int64_t l = 0; l < layers; ++l) {
+        int ranked = 0, plus = 0, minus = 0;
+        for (int e = 0; e < 512; ++e) {
+            if (best[(size_t) (l * 512 + e)] < 0.0) continue;
+            ++ranked;
+            plus += state[(size_t) (l * 512 + e)] > 0;
+            minus += state[(size_t) (l * 512 + e)] < 0;
+        }
+        if (ranked < 10) continue;
+        ++layers_ranked;
+        const int k = std::max(1, ranked / 10);
+        if (plus != k || minus != k) ++bad;
+    }
+    std::printf("live: %d layers with >= 10 ranked experts\n", layers_ranked);
+    CHECK(layers_ranked >= 1, "the balance ranks >= 10 experts in some layer with data");
+    CHECK(bad == 0, "every ranked layer keeps and gives up one decile (%d bad)", bad);
+    return g_fail == 0 ? 0 : 1;
+}
+
+// 9 Nov: the scale is the measured least-squares value, not clipped to [0.5, 2]; only a negative one is held at 0 (a weight)
+static int test_scale_unclipped() {
+    int bad = 0;
+    sdp::Pair p;
+    p.num = 38.0; p.den = 100.0; p.ee = 100.0; p.n = sdp::kReady;
+    const sdp::Est e = sdp::estimate(p, nullptr, nullptr);
+    if (!(e.ready && std::fabs(e.c - 0.38) < 1e-9)) { std::fprintf(stderr, "FAIL: scale 0.38 kept as measured (got %f)\n", e.c); ++bad; }
+    p.num = 300.0;
+    if (std::fabs(sdp::estimate(p, nullptr, nullptr).c - 3.0) > 1e-9) { std::fprintf(stderr, "FAIL: scale 3.0 kept (no upper clip)\n"); ++bad; }
+    p.num = -5.0;
+    if (sdp::estimate(p, nullptr, nullptr).c != 0.0) { std::fprintf(stderr, "FAIL: a negative scale is held at 0\n"); ++bad; }
+    return bad;
+}
+
+int main(int argc, char** argv) {
+    test_shrinkage();
+    test_readiness_and_parent_choice();
+    test_rebuild_groups();
+    test_old_table_loads();
+    test_balance_step();
+    g_fail += test_scale_unclipped();
+    if (argc > 1) test_live(argv[1]);
+    else std::printf("live table check skipped (no path given)\n");
+    std::printf("standin_pool_test: %d checks passed, %d failed\n", g_pass, g_fail);
+    return g_fail == 0 ? 0 : 1;
+}
