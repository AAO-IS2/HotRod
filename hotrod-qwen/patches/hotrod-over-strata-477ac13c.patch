diff --git a/include/strata/core/risk_concentration.hpp b/include/strata/core/risk_concentration.hpp
new file mode 100644
index 000000000..91ee47ece
--- /dev/null
+++ b/include/strata/core/risk_concentration.hpp
@@ -0,0 +1,42 @@
+// include/strata/core/risk_concentration.hpp - how concentrated a cut row's swap risk is (coordinator's counter, SPEC-substitute-fit stage 1a).
+//
+// At each cut the row's events carry risk x (w x gap, the mask-learn MaskEv list).  Per row this gives the share of the total risk the
+// top 1, top 3 and top 10 events carry, and how many events carry 50%, 80% and 90% of it.  Rows are kept apart by whether the exact
+// successor flipped (the verdict arrives at the successor's settle).  Histograms of the shares (deciles) are accumulated per group.
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace strata::core::risk {
+
+/// One cut row's concentration.  With no risk at all (total 0) the shares are 0 and the counts 0.
+struct RowShares {
+    int events = 0;                   ///< m: the row's events (all of them, risk 0 included)
+    double top1 = 0, top3 = 0, top10 = 0;
+    int need50 = 0, need80 = 0, need90 = 0;   ///< the fewest events (largest first) that carry that share of the total
+};
+
+/// x: the events' risks (any order, >= 0 expected; negatives count as 0).
+RowShares row_shares(const std::vector<double>& x);
+
+/// The request's accumulator: per group (flipped, not flipped) the row count, the sums, and the decile histograms of the three shares.
+struct Group {
+    int64_t rows = 0;
+    double sum_top1 = 0, sum_top3 = 0, sum_top10 = 0;
+    double sum_events = 0, sum_need50 = 0, sum_need80 = 0, sum_need90 = 0;
+    int64_t hist_top1[10] = {}, hist_top3[10] = {}, hist_top10[10] = {};   ///< decile bins: share 1.0 falls in the last bin
+};
+
+struct Concentration {
+    Group flipped, held;   ///< flipped: the exact successor's top-1 differed from the cut row's; held: it did not
+    /// Adds one row to its group.
+    void add(const RowShares& r, bool flipped_row);
+    /// The request-end line (no trailing newline).  Empty when no row was counted.
+    std::string line() const;
+    /// Clears the counts (the request's end).
+    void reset() { *this = Concentration{}; }
+};
+
+}  // namespace strata::core::risk
diff --git a/include/strata/core/route_control.hpp b/include/strata/core/route_control.hpp
new file mode 100644
index 000000000..64ba9b578
--- /dev/null
+++ b/include/strata/core/route_control.hpp
@@ -0,0 +1,67 @@
+// The control windows' rules (SPEC-control-windows), shared by verify.cpp and its CPU test (tests/core/route_control_test.cpp).
+// Pure functions only: no CUDA, no globals.
+//
+// A fragile control window (STRATA_FRAGILE_CTRL_EVERY) and a mask control window (STRATA_MASK_CTRL / STRATA_MASK_RESIDENT) are decided
+// before their decode window runs; the kernels read the flag at launch.  The fragile control is the one that wins a window: the mask
+// control waits for the next one and its cadence counter does not advance in a window the fragile control takes.
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+namespace strata::core {
+
+/// Cadence: counts one eligible window and is true on every `every`-th count (every <= 0: never, and the count is not advanced).
+inline bool route_ctrl_due(long long& count, long long every) {
+    if (every <= 0) return false;
+    return ++count % every == 0;
+}
+
+/// The first row r >= 1 of rows 0..n-1 that no stand-in moved (shift not above 0; a NaN shift counts as unmoved), or -1.  Row 0 is never
+/// a cut (a re-run would step the GDN / PLE state twice).
+inline int route_ctrl_first_unmoved(const float* shift, int n) {
+    for (int r = 1; r < n; ++r)
+        if (!(shift[r] > 0.0f)) return r;
+    return -1;
+}
+
+/// Wilson score interval at 90% (z = 1.645) for f flips in n re-checks: the flip rate's lower and upper bounds (0 and 1 when n is 0).
+inline void route_wilson90(long long f, long long n, double& lo, double& hi) {
+    if (n <= 0) {
+        lo = 0.0;
+        hi = 1.0;
+        return;
+    }
+    const double z = 1.645, z2 = z * z, nn = (double) n, p = (double) f / nn;
+    const double centre = p + z2 / (2.0 * nn);
+    const double half = z * std::sqrt(p * (1.0 - p) / nn + z2 / (4.0 * nn * nn));
+    const double den = 1.0 + z2 / nn;
+    lo = (centre - half) / den;
+    hi = (centre + half) / den;
+}
+
+/// The noise floor: Wilson 90% bounds of the flip rate of the first n entries of a control ring (true = flipped).
+/// Zero entries give [0, 1], so nothing above noise is shown before the ring holds a re-check.
+inline void route_ctrl_bounds(const bool* ring, int n, double& lo, double& hi) {
+    long long f = 0;
+    for (int i = 0; i < n; ++i)
+        if (ring[i]) ++f;
+    route_wilson90(f, n, lo, hi);
+}
+
+/// A k raise passes only when the flips are above the noise: the ring's flip-rate lower bound over the control's upper bound.
+inline bool route_k_raise_ok(double ring_lo, double ctrl_hi) { return ring_lo > ctrl_hi; }
+
+/// Which control kind a decode window is.  The fragile control comes first (fragile_due); the mask control needs its gate and its own
+/// cadence, and a fragile window does not advance the mask's counter (the mask control waits for the next window).
+struct WindowControl {
+    bool fragile;
+    bool mask;
+};
+inline WindowControl route_window_control(bool fragile_due, bool mask_gate, long long& mask_count, long long mask_every) {
+    WindowControl w{fragile_due, false};
+    w.mask = !fragile_due && mask_gate && route_ctrl_due(mask_count, mask_every);
+    return w;
+}
+
+}  // namespace strata::core
diff --git a/include/strata/core/serve_stop_bound.hpp b/include/strata/core/serve_stop_bound.hpp
new file mode 100644
index 000000000..29287f7b3
--- /dev/null
+++ b/include/strata/core/serve_stop_bound.hpp
@@ -0,0 +1,24 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+
+// Ported by hand from upstream Strata (f-0291 / #4677: 243fdb213 and its follow-up 13eedf552, patch and policy test by hanchengme).
+namespace strata::core {
+// A committed input row must correspond to an output the caller can expose.
+// The last exposed output remains the next unconsumed token, as in the scalar loop.
+template<class Token, class IsEos>
+int serve_stop_bound(int accepted, int64_t remaining, const Token* outputs, IsEos is_eos) {
+    const int count = static_cast<int>(std::min<int64_t>(accepted, std::max<int64_t>(0, remaining)));
+    for (int i = 0; i < count; ++i)
+        if (is_eos(outputs[i])) return i + 1;
+    return count;
+}
+
+// #4677: the bound is on by default on every backend; STRATA_SERVE_STOP_BOUND=0 (the variable's value, passed in)
+// turns it off.  It only limits which accepted rows enter the cached conversation: the tokens a request emits are the
+// same either way.
+inline bool serve_stop_bound_on(const char* env_value) {
+    return env_value == nullptr || std::strcmp(env_value, "0") != 0;
+}
+}
