+"""s17_table.py - the SPEC 17 HumanEval runs side by side (SPEC.md 18.1), rebuilt from the per-question result files.
+
+usage: s17_table.py [SPEC.md]   Reads /root/.claude/jobs/743230e4/tmp/bench_<arm>.json (HumanEval part) for the arms below, and
+replaces what stands between the S17-TABLE markers. For every answer without visible `content` it reports what the saved raw reply
+held (only the arms run after d0651db keep it): reasoning text, tool calls, or nothing.
+"""
+import json, os, sys
+
+T = "/root/.claude/jobs/743230e4/tmp"
+SPEC = sys.argv[1] if len(sys.argv) > 1 else os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))), "SPEC.md")
+START, END = "<!-- S17-TABLE-START -->", "<!-- S17-TABLE-END -->"
+ARMS = [("BC", "control (nothing replaced)", "old binary"),
+        ("B2", "ranks 2-9", "old binary"),
+        ("E1", "2-9 + rank 1 within 1 logit", "old binary"),
+        ("E2", "2-9 + rank 1 within 2 logits", "old binary"),
+        ("R1", "ranks 2-9, flag off, no floors in the request (B2's setup)", "SPEC 17 binary"),
+        ("P2", "floors 2,2,2, parts flag on", "SPEC 17 binary"),
+        ("P1", "floors 2,2,4, parts flag on", "SPEC 17 binary"),
+        ("P1b", "floors 2,2,4 again, whole reply kept", "SPEC 17 binary")]
+rows = ["| Arm | Setting | Binary | HumanEval pass | Unfenced answers | No visible content | Whole-request answer tok/s | State |",
+        "|---|---|---|---:|---:|---|---:|---|"]
+notes = []
+for arm, what, binary in ARMS:
+    f = f"{T}/bench_{arm}.json"
+    if not os.path.exists(f):
+        rows.append(f"| {arm} | {what} | {binary} | | | | | not run |")
+        continue
+    h = json.load(open(f))["humaneval"]
+    done = os.path.exists(f"{T}/ab_result_{arm}.json") or arm in ("BC", "B2", "E1", "E2")
+    nocont = [x for x in h if not x["text"].strip()]
+    rate = sum(x["tokens"] for x in h) / max(1e-9, sum(x["s"] for x in h))
+    rows.append(f"| {arm} | {what} | {binary} | {sum(x['ok'] for x in h)} / {len(h)} | {sum('```' not in x['text'] for x in h)} | "
+                f"{', '.join(x['task'].split('/')[1] for x in nocont) or 'none'} | {rate:.1f} | {'done' if done else 'running'} |")
+    for x in nocont:
+        raw = x.get("raw")
+        if raw is None:
+            notes.append(f"{arm} {x['task']}: {x['tokens']} tokens, no `content`; the raw reply was not kept (run before d0651db): UNVERIFIED")
+        else:
+            m = raw["message"]
+            notes.append(f"{arm} {x['task']}: {x['tokens']} tokens, finish `{raw['finish_reason']}`; reasoning_content {len((m.get('reasoning_content') or '').split())} words, "
+                         f"tool_calls {len(m.get('tool_calls') or [])}, content {len((m.get('content') or '').split())} words; "
+                         f"reasoning head: {(m.get('reasoning_content') or '')[:160]!r}")
+table = "\n".join(rows) + ("\n\n" + "\n".join("- " + n for n in notes) if notes else "")
+text = open(SPEC).read()
+a, b = text.index(START), text.index(END)
+open(SPEC, "w").write(text[:a + len(START)] + "\n" + table + "\n" + text[b:])
+print(table)
diff --git a/tools/linkbench/strata_ab.py b/tools/linkbench/strata_ab.py
new file mode 100644
index 000000000..2af321d85
--- /dev/null
+++ b/tools/linkbench/strata_ab.py
@@ -0,0 +1,230 @@
+"""Interleaved A/B of Strata server settings on one box, solid.cpp's method: arms alternate (A B A B), the two A runs are the
+identical-config control (the noise floor), the model files' page cache is dropped before every start, nothing else runs.
+
+Each arm: start serve/server.py with the arm's environment, wait until the model is loaded, run qwen_tps.py (chat endpoint,
+code / reasoning / prose prompts, thinking off), read the per-request "file tier I/O" lines the engine logs (bytes the OS
+read from storage against bytes of expert data the engine read), stop the server by exact PID.
+
+usage: strata_ab.py CONFIG_JSON LOGFILE OUT_JSON PORT ARM...   (ARM = NAME:ENV1=V1,ENV2=V2 ; NAME:- for no extra environment)
+"""
+import json, os, signal, subprocess, sys, time, urllib.request
+
+ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+TPS = os.environ.get("AB_TPS", "/root/.claude/jobs/743230e4/tmp/qwen_tps.py")   # AB_TPS=tools/linkbench/bench.py: accuracy on GSM8K / HumanEval instead of speed prompts
+MODEL_DIRS = ["/mnt/nvme/models/qwen38-flash-next/GSQ-RCO-IQ3_S/IQ3_S", "/mnt/nvme/strata-data/packs/iq3_s"]
+
+
+def drop_cache():
+    n = 0
+    for d in MODEL_DIRS:
+        for dp, _, fs in os.walk(d):
+            for f in fs:
+                try:
+                    fd = os.open(os.path.join(dp, f), os.O_RDONLY)
+                    os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
+                    os.close(fd)
+                    n += 1
+                except OSError:
+                    pass
+    return n
+
+
+def health(port):
+    try:
+        return json.loads(urllib.request.urlopen(f"http://127.0.0.1:{port}/health", timeout=5).read())
+    except Exception:
+        return {}
+
+
+def children(pid):
+    out = subprocess.run(["pgrep", "-P", str(pid)], capture_output=True, text=True).stdout.split()
+    return [int(x) for x in out]
+
+
+def stop(pid):
+    pids = [pid] + children(pid)
+    for p in pids:
+        try:
+            os.kill(p, signal.SIGTERM)
+        except OSError:
+            pass
+    end = time.time() + 90
+    while time.time() < end and any(os.path.exists(f"/proc/{p}") and open(f"/proc/{p}/stat").read().split()[2] != "Z" for p in pids):
+        time.sleep(1)
+    for p in pids:
+        try:
+            os.kill(p, signal.SIGKILL)
+        except OSError:
+            pass
+    time.sleep(5)
+
+
+def io_lines(text):
+    """(OS MB read, major faults, expert MB read) per request, from the engine's 'file tier I/O this request' lines."""
+    rows = []
+    for line in text.splitlines():
+        if "file tier I/O this request: the OS read" not in line:
+            continue
+        a = line.split("the OS read ")[1]
+        os_mb = float(a.split(" MB from storage")[0])
+        faults = int(a.split("(")[1].split(" major faults")[0])
+        exp_mb = float(a.split("for ")[1].split(" MB of expert reads")[0])
+        rows.append((os_mb, faults, exp_mb))
+    return rows
+
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+REPEATS = os.environ.get("AB_REPEATS", "3")   # timed requests per prompt kind (AB_REPEATS=1 for a short, watched first run)
+MEMORY_CAP_GB = int(os.environ.get("AB_CAP_GB", "24"))   # the server's memory cap (page cache included), no swap; the soft limit is 1 GB under
+MIN_AVAILABLE_MB = 1500       # stop the arm when less RAM than this is available
+MAX_SWAP_GROWTH_MB = 1500     # or when the swap in use has grown by more than this since the arm began
+VMSTAT_KEYS =("pswpin", "pswpout", "pgmajfault", "compact_stall", "compact_fail", "thp_fault_fallback")
+
+
+def vmstat():
+    out = {}
+    for line in open("/proc/vmstat"):
+        k, _, v = line.partition(" ")
+        if k in VMSTAT_KEYS:
+            out[k] = int(v)
+    return out
+
+
+def meminfo_mb(key):
+    for line in open("/proc/meminfo"):
+        if line.startswith(key + ":"):
+            return int(line.split()[1]) // 1024
+    return None
+
+
+def sha_of(path):
+    import hashlib
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for b in iter(lambda: f.read(1 << 22), b""):
+            h.update(b)
+    return h.hexdigest()[:16]
+
+
+def run_arm(name, env_extra, cfg, log, port):
+    # The install's config carries the default stand-in (STRATA_ROUTE_RESIDENT 1e30, ranks 2-9) in its "env", and the server applies a
+    # config's env OVER the process environment: an arm that sets its own, or the control (no setting, nothing replaced), would
+    # silently run 2-9. The arm runner therefore serves a copy of the config without those keys; the arm's environment decides.
+    c = json.load(open(cfg))
+    for k in [k for k in (c.get("env") or {}) if k.startswith("STRATA_ROUTE_RESIDENT")]:
+        c["env"].pop(k)
+    cfg_arm = f"/root/.claude/jobs/743230e4/tmp/ab_cfg_{name}.json"
+    json.dump(c, open(cfg_arm, "w"), indent=1)
+    cfg = cfg_arm
+    engine = json.load(open(cfg)).get("exe", "")
+    engine_sha = sha_of(engine) if engine and os.path.exists(engine) else None
+    dropped = drop_cache()
+    vm0 = vmstat()
+    swap_used0 = meminfo_mb("SwapTotal") - meminfo_mb("SwapFree")
+    start_size = os.path.getsize(log) if os.path.exists(log) else 0
+    env = dict(os.environ)
+    env.update(env_extra)
+    # The server runs in its own memory-capped systemd scope with NO swap (10 Oct 2026: two uncapped runs froze this 31 GB box
+    # and it had to be hard-reset): past the cap the kernel kills the server, not the machine. MEMORY_CAP_GB leaves the rest of
+    # the system (the shell, the editor, the kernel) about 7 GB.
+    unit = f"strata-ab-{name}-{int(time.time())}"
+    # AB_NO_HIGH=1: only the hard MemoryMax. MemoryHigh makes the kernel throttle the scope while it reclaims (the R1 trace showed
+    # 230,000 'high' events), so a run next to it measures the throttle as well as the engine.
+    cap = ["systemd-run", "--scope", "--quiet", f"--unit={unit}", "-p", f"MemoryMax={MEMORY_CAP_GB}G"]
+    if os.environ.get("AB_NO_HIGH") != "1":
+        cap += ["-p", f"MemoryHigh={MEMORY_CAP_GB - 1}G"]
+    cap += ["-p", "MemorySwapMax=0"]
+    srv = subprocess.Popen(cap + [ROOT + "/.venv/bin/python", ROOT + "/serve/server.py", "--engine", "strata", "--config", cfg, "--port", str(port)],
+                           cwd=ROOT, env=env, stdout=open("/root/.claude/jobs/743230e4/tmp/strata_ab_server.out", "w"), stderr=subprocess.STDOUT)
+    from memtrace import MemTrace   # where the memory goes, once a second (tools/linkbench/memtrace.py)
+    trace = MemTrace(unit, srv.pid, f"/root/.claude/jobs/743230e4/tmp/memtrace_{name}.csv").start()
+    # Memory guard (10 Oct 2026: a run on this 31 GB box thrashed swap until the machine hung and was reset): if the RAM left
+    # or the swap grown crosses a line at any moment of the arm, the server is stopped at once and the arm is void.
+    guard = {"tripped": None, "done": False}
+
+    def watch():
+        while not guard["done"]:
+            avail = meminfo_mb("MemAvailable")
+            grown = (meminfo_mb("SwapTotal") - meminfo_mb("SwapFree")) - swap_used0
+            if avail < MIN_AVAILABLE_MB or grown > MAX_SWAP_GROWTH_MB:
+                guard["tripped"] = f"MemAvailable {avail} MB, swap grown {grown} MB"
+                print(f"MEMORY GUARD tripped in arm {name}: {guard['tripped']} - stopping the server", flush=True)
+                stop(srv.pid)
+                return
+            time.sleep(1)
+
+    import threading
+    watcher = threading.Thread(target=watch, daemon=True)
+    watcher.start()
+    t0 = time.time()
+    while time.time() - t0 < 900 and not health(port).get("loaded"):
+        if srv.poll() is not None:
+            guard["done"] = True
+            trace.stop()
+            return {"arm": name, "error": "server died while loading", "memory_guard": guard["tripped"], "memtrace": trace.peaks()}
+        time.sleep(5)
+    if not health(port).get("loaded"):
+        guard["done"] = True
+        stop(srv.pid)
+        trace.stop()
+        return {"arm": name, "error": "not loaded in 15 minutes", "memory_guard": guard["tripped"], "memtrace": trace.peaks()}
+    load_s = time.time() - t0
+    # AB_MAX_TOKENS: answers cut at 256 tokens stop before the result (the reasoning prompt), so quality read from them is partial
+    p = subprocess.run([sys.executable, TPS, f"http://127.0.0.1:{port}", name, REPEATS, os.environ.get("AB_MAX_TOKENS", "256")],
+                       capture_output=True, text=True)
+    guard["done"] = True
+    watcher.join(timeout=30)
+    if guard["tripped"] is None:
+        stop(srv.pid)
+    else:
+        trace.stop()
+        return {"arm": name, "error": "void: memory guard tripped", "memory_guard": guard["tripped"], "memtrace": trace.peaks()}
+    trace.stop()
+    oom_events = trace.peaks().get("events_at_end", {})
+    with open(log, "rb") as f:
+        f.seek(start_size)
+        logtext = f.read().decode("utf-8", "replace")
+    kinds, tokens = {}, 0
+    for line in p.stdout.splitlines():
+        if "decode tok/s:" in line:
+            kind = line.split()[0]
+            rates = []   # a line without the median (a repeat that gave no figure) must not end the whole arm's result
+            for x in line.split("decode tok/s:")[1].split("median")[0].replace(",", " ").split():
+                try:
+                    rates.append(float(x))
+                except ValueError:
+                    break
+            kinds[kind] = rates
+            try:
+                tokens += sum(int(x) for x in line.split("(tokens [")[1].split("]")[0].replace(",", " ").split())
+            except (IndexError, ValueError):
+                pass
+    rows = io_lines(logtext)
+    allr = sorted(x for v in kinds.values() for x in v)
+    vm1 = vmstat()
+    kernel = {k: vm1[k] - vm0[k] for k in vm1}
+    kernel["swap_used_mb_before"] = swap_used0
+    kernel["swap_used_mb_after"] = meminfo_mb("SwapTotal") - meminfo_mb("SwapFree")
+    return {"arm": name, "env": env_extra, "engine_sha": engine_sha, "prefetch_on": "file tier io prefetch ON" in logtext,
+            "memtrace": trace.peaks(), "kernel_during_arm": kernel, "files_dropped": dropped, "load_s": round(load_s), "decode_tok_s": kinds,
+            "median_all": allr[len(allr) // 2] if allr else None, "tokens_timed": tokens,
+            "requests_logged": len(rows), "os_read_mb": round(sum(r[0] for r in rows), 1), "expert_read_mb": round(sum(r[2] for r in rows), 1),
+            "major_faults": sum(r[1] for r in rows),
+            "os_mb_per_token": round(sum(r[0] for r in rows) / tokens, 1) if tokens else None, "stdout": p.stdout[-1500:]}
+
+
+def main():
+    cfg, log, out, port = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])
+    results = []
+    for arm in sys.argv[5:]:
+        name, _, envs = arm.partition(":")
+        env_extra = {} if envs in ("", "-") else dict(kv.split("=", 1) for kv in envs.split(","))
+        print(f"=== arm {name} {env_extra}", flush=True)
+        r = run_arm(name, env_extra, cfg, log, port)
+        results.append(r)
+        json.dump(results, open(out, "w"), indent=1)
+        print(json.dumps({k: v for k, v in r.items() if k != "stdout"}), flush=True)
+    print("DONE", flush=True)
+
+
+main()
diff --git a/tools/placement/solve.py b/tools/placement/solve.py
new file mode 100644
index 000000000..03eddd1ae
--- /dev/null
+++ b/tools/placement/solve.py
@@ -0,0 +1,107 @@
+"""Offline expert placement for Strata-HotRod (the Taalas lesson: decide once, from real routing, where each expert lives).
+
+From a STRATA_ROUTER_TRACE recorded with the stand-ins OFF (the model's own top-k, rank order), each (layer, expert) gets a score: its picks at
+the exact ranks (below the stand-in floor: a miss there is a read) plus beta x its picks at the ranks the stand-ins serve (a miss there mostly
+takes a stand-in already on the card).  The best scores go to the card, the next to the RAM tier, the rest stay on the SSD.  The engine's
+expert profile (STRP v1, read by --expert-profile) is one global ranked list, so the layers get the slots their routing needs.
+
+  solve.py --train rt_train.bin --eval rt_eval.bin --card 2586 --ram 9202 [--profile old.bin] [--out new.bin]
+
+prints, for the eval trace, the exact-rank picks the card serves / the RAM tier serves / the SSD reads, for: the old profile, plain counts
+(every pick alike) and the rank-weighted score; --out writes the rank-weighted ranking as a profile."""
+import argparse
+import os
+import struct
+import sys
+
+import numpy as np
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "predictor"))
+from trace_reader import iter_records  # noqa: E402
+
+
+def counts(path, n_layers, n_expert, floor):
+    """[layer, expert] picks below the floor (exact) and at or above it (stand-in ranks), over the trace's decode records."""
+    ex = np.zeros((n_layers, n_expert), np.int64)
+    tl = np.zeros((n_layers, n_expert), np.int64)
+    for r in iter_records(path, want_x=False):
+        if r["kind"] != "decode":
+            continue
+        ids = np.asarray(r["ids"], np.int64)
+        lay = int(r["layer"])
+        if lay >= n_layers:
+            continue
+        for rank in range(ids.shape[1]):
+            col = ids[:, rank]
+            col = col[(col >= 0) & (col < n_expert)]
+            np.add.at(ex if rank < floor else tl, (lay, col), 1)
+    return ex, tl
+
+
+def read_profile(path, n_layers, n_expert):
+    """The ranked (layer, expert) list of an STRP v1 profile."""
+    b = open(path, "rb").read()
+    if b[:4] != b"STRP":
+        raise ValueError(path + " is not an STRP profile")
+    version, nl, ne, want, n = struct.unpack_from("<5I", b, 4)
+    if version != 1 or nl != n_layers or ne != n_expert:
+        raise ValueError(f"{path}: version {version}, {nl} x {ne} (want 1, {n_layers} x {n_expert})")
+    pairs = np.frombuffer(b, dtype="<u2", count=2 * n, offset=24).reshape(n, 2)   # (u16 layer, u16 expert) pairs
+    return [(int(l), int(e)) for l, e in pairs]
+
+
+def write_profile(path, n_layers, n_expert, ranked, want):
+    with open(path, "wb") as f:
+        f.write(b"STRP" + struct.pack("<5I", 1, n_layers, n_expert, want, len(ranked)))
+        f.write(np.asarray(ranked, dtype="<u2").tobytes())   # (u16 layer, u16 expert) pairs, as read_expert_profile reads them
+
+
+def ranking(score):
+    """Every (layer, expert), best score first (ties: lower layer, then lower expert)."""
+    nl, ne = score.shape
+    flat = score.reshape(-1)
+    order = np.lexsort((np.arange(flat.size), -flat))
+    return [(int(i // ne), int(i % ne)) for i in order]
+
+
+def evaluate(ranked, ex_eval, card, ram):
+    """The eval trace's exact-rank picks served by the card, by the RAM tier, and read from the SSD, for a static placement."""
+    tier = np.full(ex_eval.shape, 2, np.int8)
+    for i, (l, e) in enumerate(ranked):
+        tier[l, e] = 0 if i < card else 1 if i < card + ram else 2
+    tot = ex_eval.sum()
+    return [float(ex_eval[tier == t].sum()) / max(1, tot) for t in (0, 1, 2)], int(tot)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--train", required=True)
+    ap.add_argument("--eval", required=True)
+    ap.add_argument("--card", type=int, required=True, help="the card's expert slots")
+    ap.add_argument("--ram", type=int, required=True, help="the experts the RAM tier holds")
+    ap.add_argument("--layers", type=int, default=48)
+    ap.add_argument("--experts", type=int, default=512)
+    ap.add_argument("--floor", type=int, default=3, help="ranks below it are exact (the stand-in floor)")
+    ap.add_argument("--beta", type=float, default=0.25, help="the weight of a pick at a stand-in rank")
+    ap.add_argument("--profile", help="the current profile, for comparison")
+    ap.add_argument("--out", help="write the rank-weighted ranking here (STRP v1)")
+    a = ap.parse_args()
+    ex_tr, tl_tr = counts(a.train, a.layers, a.experts, a.floor)
+    ex_ev, _ = counts(a.eval, a.layers, a.experts, a.floor)
+    arms = {}
+    if a.profile:
+        arms["current profile"] = read_profile(a.profile, a.layers, a.experts)
+    arms["plain counts"] = ranking((ex_tr + tl_tr).astype(np.float64))
+    arms[f"rank-weighted (beta {a.beta})"] = ranking(ex_tr + a.beta * tl_tr)
+    print(f"train: {int(ex_tr.sum() + tl_tr.sum())} picks; eval: {int(ex_ev.sum())} exact-rank picks; card {a.card}, RAM {a.ram} experts")
+    print(f"{'placement':28} {'card':>7} {'RAM':>7} {'SSD':>7}")
+    for name, ranked in arms.items():
+        (c, r, s), _ = evaluate(ranked, ex_ev, a.card, a.ram)
+        print(f"{name:28} {100 * c:6.1f}% {100 * r:6.1f}% {100 * s:6.1f}%")
+    if a.out:
+        write_profile(a.out, a.layers, a.experts, arms[f"rank-weighted (beta {a.beta})"], a.layers * a.experts)
+        print("wrote", a.out)
+
+
+if __name__ == "__main__":
+    main()
