+            why = "the expert pointer table";
+        if (why.empty()) {
+            for (int e = 0; e < 512; ++e)
+                h_ptr_[e] = (unsigned long long) (h_slot_[e] >= 0 ? experts_ + (size_t) h_slot_[e] * blob : zd + (size_t) e * blob);
+            if (cudaMemcpy(d_ptr_, h_ptr_, 512 * sizeof(unsigned long long), cudaMemcpyHostToDevice) != cudaSuccess) why = "the expert pointer table copy";
+        }
+        if (why.empty()) {
+            zc_h_ = zh;
+            zc_d_ = zd;
+            zc_on_ = true;
+            ::close(fd);
+            std::fprintf(stderr, "strata mtp: STRATA_MTP_ZC: the drafter's %d non-resident experts are read from %.0f MiB of pinned RAM (exact, no stand-ins); a rank 0-1 miss is promoted into a slot from RAM\n",
+                         512 - n, (double) total / 1048576.0);
+        } else {
+            if (zh) cudaFreeHost(zh);
+            if (h_ptr_) { cudaFreeHost(h_ptr_); h_ptr_ = nullptr; }
+            if (d_ptr_) { cudaFree(d_ptr_); d_ptr_ = nullptr; }
+            (void) cudaGetLastError();
+            if (slots_default_) {   // the default never takes stand-ins: without the RAM copy the whole drafter goes on the GPU
+                std::fprintf(stderr, "strata mtp: the drafter's RAM copy failed (%s): all 512 experts on the GPU\n", why.c_str());
+                ::close(fd);
+                cudaFree(experts_);
+                experts_ = nullptr;
+                vram_ -= (uint64_t) n * blob;
+                slots_n_ = 0;
+                slots_default_ = false;
+                return true;
+            }
+            std::fprintf(stderr, "strata mtp: STRATA_MTP_ZC off (%s): the stand-in mode stays\n", why.c_str());
+        }
+        if (const char* iv = std::getenv("STRATA_MTP_ZC_INSTALLS"); iv != nullptr) zc_installs_ = std::max(0, std::min(64, std::atoi(iv)));
+    }
+    if (zc_on_) {   // the zero-copy mode: no loader (its line above says what the non-resident experts are)
+        std::fprintf(stderr, "strata mtp: STRATA_MTP_SLOTS=%d: %d of 512 drafter experts on the GPU (%.0f MiB, %.0f MiB freed)\n",
+                     n, n, (double) n * (double) blob / 1048576.0, (double) (512 - n) * (double) blob / 1048576.0);
+        return true;
+    }
+    slot_ld_ = new MtpSlotLoader();   // owns fd from here (slot_stop closes it)
+    slot_ld_->fd = fd;
+    slot_ld_->h_slot = h_slot_;
+    slot_ld_->pending = &pending_;
+    slot_ld_->loads = la_loads();
+    for (uint8_t*& b : slot_ld_->buf) {
+        if (cudaHostAlloc((void**) &b, blob, cudaHostAllocDefault) != cudaSuccess) { err = "mtp: the loader's buffers"; return false; }
+    }
+    slot_ld_->th = std::thread(slot_loader_main, slot_ld_);
+    std::fprintf(stderr, "strata mtp: STRATA_MTP_SLOTS=%d: %d of 512 drafter experts on the GPU (%.0f MiB, %.0f MiB freed), a rank 0-1 miss loads its expert, other misses take a stand-in\n",
+                 n, n, (double) n * (double) blob / 1048576.0, (double) (512 - n) * (double) blob / 1048576.0);
+    return true;
+#endif
+}
+
+// The host's share of a round, first thing in draft / chain_launch / draft_first.  Only when the drafter's stream is idle: then
+// every copy and every map write is ordered before the next launch, so a slot is never evicted while a copy into it is pending.
+void MtpDrafter::slot_service() {
+#if !defined(_WIN32) && !defined(STRATA_GPU_METAL)
+    if (slots_n_ <= 0 || (slot_ld_ == nullptr && !zc_on_) || cs_ == nullptr) return;
+    if (cudaStreamQuery(cs_) != cudaSuccess) return;   // busy: skip this round
+    if (zc_on_) { slot_service_zc(); return; }
+    MtpSlotLoader& L = *slot_ld_;
+    const size_t blob = strata::kernels::cpu::BLOB;
+    bool installed = false;
+    {
+        std::lock_guard<std::mutex> lk(L.mu);
+        for (int b = 0; b < MtpSlotLoader::kBufs; ++b)   // a: the copies that have finished
+            if (L.state[b] == MtpSlotLoader::kCopying) L.state[b] = MtpSlotLoader::kFree;
+        for (int b = 0; b < MtpSlotLoader::kBufs; ++b) {   // b: the ready ones into slots, CLOCK for the victim
+            if (L.state[b] != MtpSlotLoader::kReady) continue;
+            const int e = L.exp_of[b];
+            if (e < 0 || e >= 512) { L.state[b] = MtpSlotLoader::kFree; continue; }
+            pending_[(size_t) e] = false;
+            if (L.bad[b] || h_slot_[e] >= 0) { L.state[b] = MtpSlotLoader::kFree; continue; }
+            int slot = -1;
+            while (slot < 0) {
+                const int s = clock_hand_;
+                clock_hand_ = (s + 1) % slots_n_;
+                if (ref_h_[s] != 0) ref_h_[s] = 0;
+                else slot = s;
+            }
+            if (cudaMemcpyAsync(experts_ + (size_t) slot * blob, L.buf[b], blob, cudaMemcpyHostToDevice, cs_) != cudaSuccess) {
+                L.state[b] = MtpSlotLoader::kFree;
+                continue;
+            }
+            const int old = expert_of_[(size_t) slot];
+            if (old >= 0) h_slot_[old] = -1;
+            h_slot_[e] = slot;
+            expert_of_[(size_t) slot] = e;
+            ref_h_[slot] = 1;   // a fresh install gets one pass of the hand: it was just missed at rank 0-1, so it is wanted
+            L.state[b] = MtpSlotLoader::kCopying;
+            ++slot_loads_;
+            installed = true;
+        }
+        if (installed && cudaMemcpyAsync(d_slot_, h_slot_, 512 * sizeof(int32_t), cudaMemcpyHostToDevice, cs_) != cudaSuccess)
+            std::fprintf(stderr, "strata mtp slots: the slot map copy failed\n");
+#if !defined(STRATA_GPU_METAL)
+        if (installed && la_mtp_on_ && strata::kernels::la_mtp_res_row() != nullptr)   // the learner's copy of the map (its batch reads it, after this stream's work)
+            cudaMemcpyAsync(strata::kernels::la_mtp_res_row(), d_slot_, 512 * sizeof(int32_t), cudaMemcpyDeviceToDevice, cs_);
+#endif
+        L.cv.notify_all();   // frees above wake the loader
+    }
+    // d: the rank 0-1 misses the kernel wrote since the last round (the stream is idle: nothing writes them now)
+    const unsigned int n_want = *(volatile unsigned int*) want_n_h_;
+    const unsigned int lim = std::min(n_want, 4096u);
+    if (lim > want_read_) {
+        std::lock_guard<std::mutex> lk(L.mu);
+        for (unsigned int i = want_read_; i < lim; ++i) {
+            const int e = want_h_[i];
+            if (e < 0 || e >= 512 || h_slot_[e] >= 0 || pending_[(size_t) e]) continue;
+            pending_[(size_t) e] = true;
+            L.req.push_back(e);
+        }
+        L.cv.notify_all();
+    }
+    *(volatile unsigned int*) want_n_h_ = 0;
+    want_read_ = 0;
+    ++slot_rounds_;
+    if (slot_rounds_ % 512 == 0) print_slot_stats(st_h_, slot_rounds_, slot_loads_);
+#endif
+}
+
+// STRATA_MTP_ZC: slot_service's share in the zero-copy mode (the stream is idle).  The rank 0-1 misses the kernel wrote are installed from the
+// pinned RAM copy, at most zc_installs_ per round, CLOCK for the victim.  Each copy is queued on cs_ before the next round's graph; the victim's
+// pointer goes to RAM in the same update, so no group points at a slot while it is overwritten.
+void MtpDrafter::slot_service_zc() {
+#if !defined(_WIN32) && !defined(STRATA_GPU_METAL)
+    const size_t blob = strata::kernels::cpu::BLOB;
+    const unsigned int n_want = *(volatile unsigned int*) want_n_h_;
+    const unsigned int lim = std::min(n_want, 4096u);
+    std::vector<uint8_t> seen(512, 0);
+    int installs = 0;
+    for (unsigned int i = want_read_; i < lim && installs < zc_installs_; ++i) {
+        const int e = want_h_[i];
+        if (e < 0 || e >= 512 || h_slot_[e] >= 0 || seen[(size_t) e]) continue;
+        seen[(size_t) e] = 1;
+        int slot = -1;
+        while (slot < 0) {
+            const int s = clock_hand_;
+            clock_hand_ = (s + 1) % slots_n_;
+            if (ref_h_[s] != 0) ref_h_[s] = 0;
+            else slot = s;
+        }
+        if (cudaMemcpyAsync(experts_ + (size_t) slot * blob, zc_h_ + (size_t) e * blob, blob, cudaMemcpyHostToDevice, cs_) != cudaSuccess) {
+            (void) cudaGetLastError();
+            continue;
+        }
+        const int old = expert_of_[(size_t) slot];
+        if (old >= 0) {
+            h_slot_[old] = -1;
+            h_ptr_[old] = (unsigned long long) (zc_d_ + (size_t) old * blob);
+        }
+        h_slot_[e] = slot;
+        h_ptr_[e] = (unsigned long long) (experts_ + (size_t) slot * blob);
+        expert_of_[(size_t) slot] = e;
+        ref_h_[slot] = 1;   // a fresh install gets one pass of the hand, as in the loader mode
+        ++slot_loads_;
+        ++installs;
+    }
+    if (installs > 0) {
+        if (cudaMemcpyAsync(d_slot_, h_slot_, 512 * sizeof(int32_t), cudaMemcpyHostToDevice, cs_) != cudaSuccess ||
+            cudaMemcpyAsync(d_ptr_, h_ptr_, 512 * sizeof(unsigned long long), cudaMemcpyHostToDevice, cs_) != cudaSuccess)
+            std::fprintf(stderr, "strata mtp slots: the slot map copy failed\n");
+#if !defined(STRATA_GPU_METAL)
+        if (la_mtp_on_ && strata::kernels::la_mtp_res_row() != nullptr)   // the learner's copy of the map (as in the loader mode)
+            cudaMemcpyAsync(strata::kernels::la_mtp_res_row(), d_slot_, 512 * sizeof(int32_t), cudaMemcpyDeviceToDevice, cs_);
+#endif
+    }
+    *(volatile unsigned int*) want_n_h_ = 0;
+    want_read_ = 0;
+    ++slot_rounds_;
+    if (slot_rounds_ % 512 == 0) print_slot_stats(st_h_, slot_rounds_, slot_loads_);
+#endif
+}
+
+void MtpDrafter::slot_stop() {
+#if !defined(_WIN32) && !defined(STRATA_GPU_METAL)
+    if (slots_n_ > 0 && st_h_ != nullptr) print_slot_stats(st_h_, slot_rounds_, slot_loads_);
+    if (slot_ld_ == nullptr) return;
+    {
+        std::lock_guard<std::mutex> lk(slot_ld_->mu);
+        slot_ld_->stop = true;
+    }
+    slot_ld_->cv.notify_all();
+    if (slot_ld_->th.joinable()) slot_ld_->th.join();
+    if (slot_ld_->fd >= 0) ::close(slot_ld_->fd);
+    for (uint8_t* p : slot_ld_->buf) if (p) cudaFreeHost(p);
+    delete slot_ld_;
+    slot_ld_ = nullptr;
+#endif
+}
+
+// STRATA_MTP_LA: the switch.  On needs the slots and the learner (la_mtp_alloc), and round graphs not yet captured (their label is in them).
+bool MtpDrafter::set_la_mtp(bool on) {
+#if defined(_WIN32) || defined(STRATA_GPU_METAL)
+    return !on;   // no slot loader here
+#else
+    if (!on) {
+        la_mtp_on_ = false;
+        if (slot_ld_ != nullptr) {
+            std::lock_guard<std::mutex> lk(slot_ld_->mu);
+            slot_ld_->pred_h = nullptr;
+        }
+        return true;
+    }
+    if (zc_on_) { std::fprintf(stderr, "strata mtp: the look-ahead learner needs the loader thread: STRATA_MTP_ZC has none\n"); return false; }
+    if (slots_n_ <= 0 || slot_ld_ == nullptr || !strata::kernels::la_mtp_active()) return false;
+    for (cudaGraphExec_t e : round_exec_) if (e != nullptr) return false;
+    for (cudaGraphExec_t e : round_exec_c_) if (e != nullptr) return false;
+    const OnDevice on_device(device_);
+    la_mtp_on_ = true;
+    {
+        std::lock_guard<std::mutex> lk(slot_ld_->mu);
+        slot_ld_->pred_h = strata::kernels::la_mtp_pred_host();
+        slot_ld_->loads = la_loads();
+    }
+    if (strata::kernels::la_mtp_res_row() != nullptr)
+        cudaMemcpy(strata::kernels::la_mtp_res_row(), d_slot_, 512 * sizeof(int32_t), cudaMemcpyDeviceToDevice);
+    return true;
+#endif
+}
+
+int MtpDrafter::la_loads() {
+    static const int v = [] {
+        const char* e = std::getenv("STRATA_MTP_LA_LOADS");
+        return e != nullptr ? std::max(0, std::min(16, std::atoi(e))) : 4;
+    }();
+    return v;
+}
+
+// STRATA_MTP_LA: a round's entry, after its slot service and before its graph: the previous round's batch when this stream is idle (its label
+// is written and its copies are done), then this round's source row.  The round's label follows in its graph.
+bool MtpDrafter::la_mtp_entry(int a, std::string& err) {
+#if defined(_WIN32) || defined(STRATA_GPU_METAL)
+    (void) a;
+    (void) err;
+    return true;
+#else
+    if (!la_mtp_on_) return true;
+    try {
+        if (la_label_ready_ && cudaStreamQuery(cs_) == cudaSuccess) {
+            strata::kernels::la_mtp_batch();
+            la_label_ready_ = false;
+        }
+        strata::kernels::la_mtp_take_source(a, cs_);
+    } catch (const std::exception& e) {
+        err = std::string("mtp look-ahead learner: ") + e.what();
+        return false;
+    }
+    la_label_ready_ = true;
+    return true;
+#endif
+}
