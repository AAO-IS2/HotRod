+"""Extract every layer's router (ffn_gate_inp.weight, [n_embd=2560 -> 512]) from the Qwen GGUF into one float32 file for the analysis: routers_f32.npy [48, 512, 2560]."""
+import sys
+import numpy as np
+from gguf import GGUFReader, GGMLQuantizationType
+
+P = "/mnt/nvme/models/qwen38-flash-next/GSQ-RCO-IQ3_S/IQ3_S/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf"
+r = GGUFReader(P, "r")
+by = {t.name: t for t in r.tensors}
+W = []
+for l in range(48):
+    t = by[f"blk.{l}.ffn_gate_inp.weight"]
+    if l == 0:
+        print("router tensor:", list(t.shape), t.tensor_type.name)
+    a = np.asarray(t.data)
+    if t.tensor_type == GGMLQuantizationType.BF16:
+        a = (a.view(np.uint16).astype(np.uint32) << 16).view(np.float32)
+    a = a.astype(np.float32).reshape(512, 2560)          # gguf shape [2560, 512] = 512 rows of 2560
+    W.append(a)
+W = np.stack(W)
+np.save("/mnt/nvme/strata-data/traces/routers_f32.npy", W)
+print("saved", W.shape, W.dtype, "| |W| mean %.4f" % np.abs(W).mean())
diff --git a/tools/predictor/sim_readahead.py b/tools/predictor/sim_readahead.py
new file mode 100644
index 000000000..39b2a6e4d
--- /dev/null
+++ b/tools/predictor/sim_readahead.py
@@ -0,0 +1,201 @@
+"""A model of the decode's read-ahead and the drive, to compare the read-ahead settings (STRATA_IO_PF_THREADS, STRATA_IO_EDF,
+STRATA_IO_PF_YIELD, STRATA_LA_MODEL) before a run on the GPU.  It is NOT the engine: no kernels run.  It replays what
+expert_source.cpp does with a layer's guesses and demand reads against a drive that shares its bandwidth among the reads in flight.
+
+Per decode window, per MoE layer L:
+  1. the GPU reaches L (doorbell); the host queues the look-ahead's guesses for L+1 (dist 1) and L+2 (dist 2)
+  2. the host needs L's cold rank 0-1 experts (not in VRAM, not in RAM): a landed guess costs nothing, one in flight is waited for,
+     a queued or unpredicted one is read by the host now (a demand read)
+  3. the CPU computes the layer's misses, the GPU finishes the layer and reaches L+1
+The drive: B bytes/s shared equally by every read in flight (O_DIRECT, one blob per read).  Guesses run on `workers` threads.
+
+Parameters default to the 19-21 Oct measurements in docs/perf-ideas.md (RTX 3060 box, PCIe 3.0 NVMe 3.3 GB/s, IQ3_S 2.33 MB experts)
+and tools/predictor (top-2 recall of rank 0-1: router reuse 55.3% at dist 1, 46.5% at dist 2; the published model 67.5-71.7% at dist 1).
+usage: python sim_readahead.py [--cold 0.27] [--windows 400] [--seed 1]"""
+import argparse
+import random
+
+BLOB = 2.33e6
+
+
+class Drive:
+    def __init__(s, bw, workers, edf, yield_):
+        s.bw, s.workers, s.edf, s.yield_ = bw, workers, edf, yield_
+        s.t = 0.0
+        s.active = {}          # key -> [remaining bytes, is_guess]
+        s.staged = set()       # keys whose read has finished
+        s.queue = []           # guesses: [layer, key, window, from_layer]
+        s.cur = (-1, -1)       # (window, layer) the host routes now
+        s.demand_active = 0
+        s.read_guess = s.read_demand = 0
+        s.stale = 0
+
+    def guesses_in_flight(s):
+        return sum(1 for v in s.active.values() if v[1])
+
+    def try_start(s):
+        while s.queue:
+            if s.guesses_in_flight() >= s.workers or (s.yield_ and s.demand_active):
+                return
+            w, l = s.cur
+            if s.edf:
+                before = len(s.queue)
+                s.queue = [q for q in s.queue if q[2] == w and q[0] > l]
+                s.stale += before - len(s.queue)
+                if not s.queue:
+                    return
+                i = min(range(len(s.queue)), key=lambda j: (s.queue[j][0], -s.queue[j][3], j))
+            else:
+                i = len(s.queue) - 1   # the newest first
+            q = s.queue.pop(i)
+            if q[1] in s.staged or q[1] in s.active:
+                continue
+            s.active[q[1]] = [BLOB, True]
+            s.read_guess += 1
+
+    def advance(s, until=None, done=None):
+        """Runs the drive to time `until`, or until done() holds (checked at each completion)."""
+        while True:
+            if done is not None and done():
+                return
+            n = len(s.active)
+            if n == 0:
+                if until is None:
+                    raise RuntimeError("waiting on nothing")
+                s.t = max(s.t, until)
+                return
+            rate = s.bw / n
+            dt = min(v[0] for v in s.active.values()) / rate
+            if until is not None and s.t + dt >= until:
+                for v in s.active.values():
+                    v[0] -= (until - s.t) * rate
+                s.t = until
+                return
+            s.t += dt
+            fin = []
+            for k, v in s.active.items():
+                v[0] -= dt * rate
+                if v[0] <= 1.0:
+                    fin.append(k)
+            for k in fin:
+                del s.active[k]
+                s.staged.add(k)
+            s.try_start()
+
+    def demand(s, keys):
+        """The host reads what it needs and has not got; returns the counts by what the read-ahead had done."""
+        got = {"landed": 0, "in_flight": 0, "queued": 0, "unpredicted": 0}
+        need = []
+        queued = {q[1] for q in s.queue}
+        for k in keys:
+            if k in s.staged:
+                got["landed"] += 1
+            elif k in s.active:
+                got["in_flight"] += 1
+                need.append(k)
+            else:
+                got["queued" if k in queued else "unpredicted"] += 1
+                s.queue = [q for q in s.queue if q[1] != k]
+                s.active[k] = [BLOB, False]
+                s.read_demand += 1
+                need.append(k)
+        if need:
+            s.demand_active += 1
+            s.advance(done=lambda: all(k in s.staged for k in need))
+            s.demand_active -= 1
+            s.try_start()
+        return got
+
+
+def run(a, threads=None, edf=False, yield_=False, r1=0.553, r2=0.465, wrong_scale=1.0, label=""):
+    rng = random.Random(a.seed)
+    d = Drive(a.bw, threads or a.workers, edf, yield_)   # STRATA_IO_PF_THREADS: one guess read per thread
+    # wrong guesses per layer and dist, sized so that the baseline uses ~35% of what it reads ahead (measured 32-41%)
+    wrong1 = a.cold * a.wrong * wrong_scale
+    wrong2 = a.cold * a.wrong
+    wait_total = cpu_total = 0.0
+    counts = {"landed": 0, "in_flight": 0, "queued": 0, "unpredicted": 0}
+    t0 = 0.0
+
+    def pois(lam):
+        n, p, x = 0, 1.0, rng.random()
+        import math
+        e = math.exp(-lam)
+        while True:
+            p *= rng.random() if n else x
+            if p < e:
+                return n
+            n += 1
+
+    for w in range(a.windows):
+        miss = [[(w, L, e) for e in rng.sample(range(512), pois(a.cold))] for L in range(48)]
+        pred1 = [[k for k in miss[L] if rng.random() < r1] for L in range(48)]
+        pred2 = [[k for k in pred1[L] if rng.random() < r2 / r1] for L in range(48)]   # a dist-2 hit is usually a dist-1 hit too
+        for L in range(48):
+            d.advance(until=d.t)
+            d.cur = (w, L)
+            for dist, preds, wr in ((1, pred1, wrong1), (2, pred2, wrong2)):
+                T = L + dist
+                if T >= 48:
+                    continue
+                g = list(preds[T]) + [(w, T, 1000 + rng.randrange(10**6)) for _ in range(pois(wr))]
+                rng.shuffle(g)
+                for k in g:
+                    d.queue.append([T, k, w, L])
+            d.try_start()
+            ts = d.t
+            got = d.demand(miss[L])
+            for k in counts:
+                counts[k] += got[k]
+            wait_total += d.t - ts
+            cpu = a.cpu_layer + a.cpu_miss * len(miss[L])
+            cpu_total += cpu
+            d.advance(until=d.t + cpu + a.gpu_layer)
+        d.advance(until=d.t + a.window_extra)    # commit, draft, sampling: the drive keeps reading
+    windows_ms = (d.t - t0) / a.windows * 1e3
+    n_miss = sum(counts.values())
+    used = counts["landed"] + counts["in_flight"]
+    return dict(label=label, window_ms=windows_ms, wait_ms=wait_total / a.windows * 1e3, tok_s=a.tok_window / (windows_ms / 1e3),
+                landed=counts["landed"] / n_miss, in_flight=counts["in_flight"] / n_miss, queued=counts["queued"] / n_miss,
+                unpred=counts["unpredicted"] / n_miss, used_share=used / max(1, d.read_guess), mb_window=(d.read_guess + d.read_demand) * BLOB / 1e6 / a.windows)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--cold", type=float, default=0.27, help="cold rank 0-1 experts (from the drive) per layer of a window (~13 a window)")
+    ap.add_argument("--wrong", type=float, default=1.1, help="wrong guesses per right one per dist (sets the read-ahead's used share)")
+    ap.add_argument("--bw", type=float, default=3.3e9)
+    ap.add_argument("--workers", type=int, default=8)
+    ap.add_argument("--gpu-layer", dest="gpu_layer", type=float, default=0.52e-3, help="GPU time per layer after the host's rows (25 ms / 48)")
+    ap.add_argument("--cpu-layer", dest="cpu_layer", type=float, default=0.15e-3)
+    ap.add_argument("--cpu-miss", dest="cpu_miss", type=float, default=0.25e-3)
+    ap.add_argument("--window-extra", dest="window_extra", type=float, default=4e-3)
+    ap.add_argument("--tok-window", dest="tok_window", type=float, default=3.3)
+    ap.add_argument("--windows", type=int, default=400)
+    ap.add_argument("--seed", type=int, default=1)
+    a = ap.parse_args()
+    model = dict(r1=0.69, wrong_scale=(1 - 0.69) / (1 - 0.553))   # the published predictor at dist 1 (67.5-71.7%); fewer wrong guesses
+    arms = [
+        run(a, label="today (8 threads, newest first)"),
+        run(a, edf=True, label="EDF"),
+        run(a, threads=2, label="PF_THREADS=2"),
+        run(a, threads=1, label="PF_THREADS=1"),
+        run(a, threads=1, edf=True, label="PF_THREADS=1 + EDF"),
+        run(a, threads=1, yield_=True, label="PF_THREADS=1 + YIELD"),
+        run(a, threads=1, edf=True, yield_=True, label="PF_THREADS=1 + EDF + YIELD"),
+        run(a, **model, label="LA_MODEL alone"),
+        run(a, threads=1, yield_=True, **model, label="PF_THREADS=1 + YIELD + LA_MODEL"),
+        run(a, threads=1, edf=True, yield_=True, **model, label="PF_THREADS=1 + EDF + YIELD + LA_MODEL"),
+        run(a, r1=1.0, r2=1.0, wrong_scale=0.0, label="(bound: every miss predicted, no wrong guess)"),
+    ]
+    base = arms[0]
+    print(f"cold rank 0-1 misses {a.cold:.2f} a layer ({a.cold * 48:.0f} a window), drive {a.bw / 1e9:.1f} GB/s, {a.windows} windows\n")
+    print(f"{'arm':44s} {'tok/s':>6} {'vs today':>8} {'window':>7} {'read wait':>9}  {'landed':>6} {'reading':>7} {'queued':>6} {'unpred':>6}  {'RA used':>7} {'MB/win':>6}")
+    for r in arms:
+        print(f"{r['label']:44s} {r['tok_s']:6.1f} {(r['tok_s'] / base['tok_s'] - 1) * 100:+7.1f}% {r['window_ms']:6.1f}ms {r['wait_ms']:7.2f}ms"
+              f"  {r['landed'] * 100:5.0f}% {r['in_flight'] * 100:6.0f}% {r['queued'] * 100:5.0f}% {r['unpred'] * 100:5.0f}%"
+              f"  {r['used_share'] * 100:6.0f}% {r['mb_window']:6.0f}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/predictor/test_export_la_model.py b/tools/predictor/test_export_la_model.py
new file mode 100644
index 000000000..ac8a8a043
--- /dev/null
+++ b/tools/predictor/test_export_la_model.py
@@ -0,0 +1,148 @@
+"""Tests for pt_reader.py and export_la_model.py: the torch-free reader against torch's own files, the published tar's layout,
+the engine file's layout and the fold, and that a file with another global is refused.  Needs torch only to WRITE the test files
+(skipped without it).
+
+usage: python test_export_la_model.py
+"""
+import io
+import os
+import pickle
+import struct
+import tarfile
+import tempfile
+import zipfile
+
+import numpy as np
+
+import export_la_model as ex
+import pt_reader
+
+try:
+    import torch
+except ImportError:
+    torch = None
+
+H, E = 64, 512
+
+
+def state(seed, extra_rows=8):
+    """A layer's state as the published files hold it: out.weight [512 + extra, H] (the first 512 are the routing logits),
+    out.bias, mu_state [1, H], sd_state [1, H]."""
+    g = torch.Generator().manual_seed(seed)
+    from collections import OrderedDict
+    return OrderedDict([("out.weight", torch.randn(E + extra_rows, H, generator=g)), ("out.bias", torch.randn(E + extra_rows, generator=g)),
+                        ("mu_state", torch.randn(1, H, generator=g)), ("sd_state", torch.rand(1, H, generator=g) + 0.5)])
+
+
+def test_reader_matches_torch():
+    with tempfile.TemporaryDirectory() as d:
+        sd = state(1)
+        sd["half"] = torch.randn(3, 5).half()
+        sd["bf16"] = torch.randn(4).bfloat16()
+        sd["strided"] = torch.randn(6, 7).t()                     # a non-contiguous view
+        sd["scalar"] = torch.tensor(2.5)
+        p = os.path.join(d, "s.pt")
+        torch.save(sd, p)
+        got = pt_reader.load(p)
+        assert list(got) == list(sd)
+        for k, v in sd.items():
+            ref = v.float().numpy() if v.dtype == torch.bfloat16 else v.numpy()
+            assert got[k].shape == ref.shape and np.array_equal(got[k], ref), k
+        with open(p, "rb") as f:                                   # a file object, as the tar gives
+            assert np.array_equal(pt_reader.load(f)["out.bias"], sd["out.bias"].numpy())
+
+
+def test_reader_refuses_other_globals():
+    with tempfile.TemporaryDirectory() as d:
+        p = os.path.join(d, "evil.pt")
+        with zipfile.ZipFile(p, "w") as z:
+            z.writestr("archive/data.pkl", pickle.dumps(os.system))   # a global outside the allow-list
+        try:
+            pt_reader.load(p)
+            raise AssertionError("a file with os.system was read")
+        except pickle.UnpicklingError:
+            pass
+
+
+def tensor_pt(path, size, stride, offset=0, numel=4):
+    """A torch.save zip by hand (no torch): one float tensor of `size` / `stride` / `offset` over a storage of `numel` floats."""
+    s = lambda t: b"X" + struct.pack("<I", len(t)) + t.encode()          # BINUNICODE
+    i = lambda v: b"J" + struct.pack("<i", v)                              # BININT
+    tup = lambda vals: b"(" + b"".join(i(v) for v in vals) + b"t"          # MARK ... TUPLE
+    pkl = (b"\x80\x02" + b"ctorch._utils\n_rebuild_tensor_v2\n" + b"("
+           + b"(" + s("storage") + b"ctorch\nFloatStorage\n" + s("0") + s("cpu") + i(numel) + b"tQ"   # BINPERSID
+           + i(offset) + tup(size) + tup(stride) + b"\x89" + b"tR.")      # requires_grad False, REDUCE, STOP
+    with zipfile.ZipFile(path, "w") as z:
+        z.writestr("archive/data.pkl", pkl)
+        z.writestr("archive/data/0", np.arange(numel, dtype=np.float32).tobytes())
+
+
+def test_reader_refuses_a_tensor_past_its_storage():
+    with tempfile.TemporaryDirectory() as d:
+        p = os.path.join(d, "ok.pt")
+        tensor_pt(p, (2, 2), (2, 1))
+        assert np.array_equal(pt_reader.load(p), np.arange(4, dtype=np.float32).reshape(2, 2))
+        for size, stride, offset in (((100,), (1,), 0), ((2, 2), (2, 1), 1), ((4,), (-1,), 0)):
+            tensor_pt(p, size, stride, offset)
+            try:
+                pt_reader.load(p)
+                raise AssertionError(f"a tensor {size} / {stride} past its storage was read")
+            except pickle.UnpicklingError:
+                pass
+
+
+def check_out(path, states, layers):
+    with open(path, "rb") as f:
+        assert f.read(4) == b"LAM1" and struct.unpack("<III", f.read(12)) == (layers, E, H)
+        for l in range(layers):
+            present = f.read(1)[0]
+            assert present == (1 if l in states else 0), l
+            if not present:
+                continue
+            w = (np.frombuffer(f.read(E * H * 2), np.uint16).astype(np.uint32) << 16).view(np.float32).reshape(E, H)
+            b = np.frombuffer(f.read(E * 4), np.float32)
+            sd = {k: v.double().numpy() for k, v in states[l].items()}
+            W, mu, s = sd["out.weight"][:E], sd["mu_state"].reshape(-1), sd["sd_state"].reshape(-1)
+            assert np.allclose(w, W / s, rtol=1e-2, atol=1e-2)                       # bf16 of the folded matrix
+            assert np.allclose(b, sd["out.bias"][:E] - (W / s) @ mu, rtol=1e-5, atol=1e-4)
+        assert f.read() == b""
+
+
+def test_export_from_folder_and_tar():
+    layers = 6
+    states = {l: state(10 + l) for l in (1, 2, 4, 5)}            # layer 3 missing: the router stays its look-ahead there
+    with tempfile.TemporaryDirectory() as d:
+        folder = os.path.join(d, "models_linear")
+        os.makedirs(folder)
+        torch.save(state(99, extra_rows=600), os.path.join(folder, "L00_d1_linear_state.pt"))   # layer 0: never written
+        for l, sd in states.items():
+            torch.save(sd, os.path.join(folder, f"L{l:02d}_d1_linear_state.pt"))
+        with open(os.path.join(folder, "L01_d1_linear_state.json"), "w") as f:
+            f.write("{}")                                           # the tar's .json companions are ignored
+        out1 = os.path.join(d, "a.bin")
+        ex.main([folder, out1, "--layers", str(layers), "--hidden", str(H)])
+        check_out(out1, states, layers)
+        tar = os.path.join(d, "197_models_d48_linear.tar")
+        with tarfile.open(tar, "w") as t:                           # flat, as the published tar is
+            for fn in sorted(os.listdir(folder)):
+                t.add(os.path.join(folder, fn), arcname=fn)
+        out2 = os.path.join(d, "b.bin")
+        ex.main([tar, out2, "--layers", str(layers), "--hidden", str(H)])
+        assert open(out1, "rb").read() == open(out2, "rb").read()
+        empty = os.path.join(d, "empty")
+        os.makedirs(empty)
+        try:
+            ex.main([empty, os.path.join(d, "c.bin"), "--layers", str(layers), "--hidden", str(H)])
+            raise AssertionError("an empty folder made a file")
+        except SystemExit:
+            assert not os.path.exists(os.path.join(d, "c.bin")) and not os.path.exists(os.path.join(d, "c.bin.tmp"))
+
+
+if __name__ == "__main__":
+    for name, fn in list(globals().items()):
+        if name.startswith("test_"):
+            if torch is None and name not in ("test_reader_refuses_other_globals", "test_reader_refuses_a_tensor_past_its_storage"):
+                print("skipped (no torch)", name)
+                continue
+            fn()
+            print("ok", name)
diff --git a/tools/predictor/test_token_table_check.py b/tools/predictor/test_token_table_check.py
new file mode 100644
index 000000000..6175b48e5
--- /dev/null
+++ b/tools/predictor/test_token_table_check.py
@@ -0,0 +1,80 @@
+"""Tests for trace_reader's token records and token_table_check.py, on small synthetic traces (no GPU, no model).
+
+usage: python test_token_table_check.py
+"""
+import os
+import struct
+import tempfile
+
+import numpy as np
+
+import token_table_check as ttc
+from trace_reader import H, read_trace
+
+LAYERS = 4
+
+
+def write_trace(path, windows, with_tokens=True, bad_window=None, rng=None):
+    """`windows`: lists of token ids.  Layer 0 routes by the token (its experts are a fixed function of the id), layers 1-3 at random.
+    Written in the engine's order: the token record when the window is launched, then the window's 4 layer records."""
+    rng = rng or np.random.default_rng(0)
+    with open(path, "wb") as f:
+        f.write(b"RTR1")
+        for step, toks in enumerate(windows, start=1):
+            if with_tokens:
+                rec_toks = toks + [7] if step == bad_window else toks          # a launch whose row count differs from its window
+                f.write(struct.pack("<IHBB", 0, 0xFFFF, len(rec_toks), 0))
+                f.write(np.array(rec_toks, np.int32).tobytes())
+            for layer in range(LAYERS):
+                f.write(struct.pack("<IHBB", step, layer, len(toks), 10))
+                for t in toks:
+                    f.write(np.zeros(H, np.uint16).tobytes())
+                    if layer == 0:
+                        ids = [(t * 7 + j * 13) % 512 for j in range(10)]
+                    else:
+                        ids = rng.choice(512, 10, replace=False).tolist()
+                    f.write(np.array(ids, np.int16).tobytes())
+
+
+def test_reader_pairs_tokens():
+    with tempfile.TemporaryDirectory() as d:
+        p = os.path.join(d, "t.bin")
+        windows = [[1, 2, 3], [4, 5], [6, 7, 8, 9]]
+        write_trace(p, windows, bad_window=2)
+        r = read_trace(p, want_x=False)
+        assert r["tok_paired"] == 2 and r["tok_mismatch"] == 1, (r["tok_paired"], r["tok_mismatch"])
+        assert len(r["x"]) == 0 and len(r["ids"]) == LAYERS * 9
+        m = r["step"] == 3
+        assert sorted(set(r["tok"][m].tolist())) == [6, 7, 8, 9]
+        assert (r["tok"][r["step"] == 2] == -1).all()                   # the mismatched window keeps no tokens
+        assert (r["tok"][(r["step"] == 1) & (r["layer"] == 2)] == [1, 2, 3]).all()
+        full = read_trace(p)                                            # with the inputs: same rows
+        assert full["x"].shape == (LAYERS * 9, H) and (full["tok"] == r["tok"]).all()
+
+
+def test_old_trace_has_no_tokens():
+    with tempfile.TemporaryDirectory() as d:
+        p = os.path.join(d, "t.bin")
+        write_trace(p, [[1, 2], [3, 4]], with_tokens=False)
+        r = read_trace(p, want_x=False)
+        assert r["tok_paired"] == 0 and (r["tok"] == -1).all() and r["records"] == 2 * LAYERS
+
+
+def test_table_finds_token_routing():
+    rng = np.random.default_rng(1)
+    with tempfile.TemporaryDirectory() as d:
+        p = os.path.join(d, "t.bin")
+        windows = [rng.integers(0, 40, size=4).tolist() for _ in range(300)]   # 40 distinct tokens: all seen in training
+        write_trace(p, windows, rng=rng)
+        res = ttc.check(read_trace(p, want_x=False), [0, 3], train_share=0.7)
+        assert res[0]["seen"] > 0.99
+        assert res[0]["table"][2] > 0.99, res[0]                        # layer 0 follows the token: the table is exact
+        assert res[0]["table"][2] > res[0]["freq"][2] + 0.5
+        assert res[3]["table"][8] < 0.2, res[3]                         # layer 3 is random: no table can find it
+
+
+if __name__ == "__main__":
+    for name, fn in list(globals().items()):
+        if name.startswith("test_"):
+            fn()
+            print("ok", name)
