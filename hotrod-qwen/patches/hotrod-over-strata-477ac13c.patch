+
+// Step 0 of stage 2: every record's x, y_s and y_e must come back as their own inputs, at distinct layers, with no swap and no zeroing.
+// Records of several layers (0, 5, 47 of the 48-layer pack), distinct non-zero vectors per record and per field; the stored y_e of each
+// tag-1 record must be non-zero, so a zeroed or swapped field fails the exact comparison below.
+void test_round_trip_distinct() {
+    using namespace strata::core::subfit;
+    const uint32_t N = 2560, L = 48;
+    const std::string path = tmp_path("distinct");
+    std::filesystem::remove(path);
+    std::string err;
+    const uint16_t layers[] = {0, 5, 47, 0};
+    auto fill = [&](std::vector<float>& v, int rec, int field) {
+        v.assign(N, 0.0f);
+        for (uint32_t i = 0; i < N; ++i)   // distinct per (record, field, index); never zero
+            v[i] = 0.001f * (float) (i + 1) * (float) (rec + 1) + 0.5f * (float) field + (i % 3 == 0 ? -0.25f : 0.125f);
+    };
+    std::vector<float> x, ys, ye;
+    {
+        SampleWriter w;
+        CHECK(w.open(path, N, L, err), ("open: " + err).c_str());
+        for (int r = 0; r < 4; ++r) {
+            fill(x, r, 0);
+            fill(ys, r, 1);
+            fill(ye, r, 2);
+            if (r == 2) {
+                CHECK(w.write_probe(layers[r], (uint16_t) (400 + r), (uint8_t) r, 0.25f + 0.0625f * (float) r, x.data(), ye.data()),
+                      "tag 2 written");
+            } else {
+                CHECK(w.write_stand_in(layers[r], (uint16_t) (100 + r), (uint16_t) (200 + r), (uint8_t) (r + 2), x.data(), ys.data(), ye.data()),
+                      "tag 1 written");
+            }
+        }
+    }
+    SampleReader rd;
+    CHECK(rd.open(path, err), ("reopen: " + err).c_str());
+    for (int r = 0; r < 4; ++r) {
+        Record got;
+        CHECK(rd.next(got, err), "a record is read");
+        if (r == 2) {
+            CHECK(got.tag == 2 && got.layer == layers[r] && got.e == 402 && got.rank == 2, "tag 2 fields as written");
+            CHECK(got.w == 0.25f + 0.0625f * 2.0f, "tag 2 w exact");
+            fill(x, r, 0);
+            fill(ye, r, 2);
+            bool ok = got.x.size() == N && got.ye.size() == N && got.ys.empty();
+            for (uint32_t i = 0; ok && i < N; ++i) ok = got.x[i] == bf(x[i]) && got.ye[i] == bf(ye[i]);
+            CHECK(ok, "tag 2: x and y_e are the bf16 of their own inputs (no swap, no zeroing)");
+            continue;
+        }
+        CHECK(got.tag == 1 && got.layer == layers[r] && got.e == 100 + r && got.s == 200 + r && got.rank == r + 2,
+              "tag 1 fields as written (layer, e, s, rank)");
+        fill(x, r, 0);
+        fill(ys, r, 1);
+        fill(ye, r, 2);
+        bool ok = got.x.size() == N && got.ys.size() == N && got.ye.size() == N;
+        for (uint32_t i = 0; ok && i < N; ++i) ok = got.x[i] == bf(x[i]) && got.ys[i] == bf(ys[i]) && got.ye[i] == bf(ye[i]);
+        CHECK(ok, "tag 1: x, y_s and y_e are the bf16 of their own inputs (no swap, no zeroing)");
+        double ye_energy = 0.0;
+        for (float v : got.ye) ye_energy += (double) v * (double) v;
+        CHECK(ye_energy > 1.0, "tag 1: the stored y_e is not zero");
+    }
+    Record tail;
+    CHECK(!rd.next(tail, err) && err.empty(), "clean end after four records");
+    std::filesystem::remove(path);
+}
+
+}  // namespace
+
+int main() {
+    test_bf16();
+    test_env();
+    test_round_trip();
+    test_round_trip_distinct();
+    test_append_and_header();
+    test_cap_and_never_opened();
+    if (failures == 0) {
+        std::printf("subfit_samples_test: all checks passed\n");
+        return 0;
+    }
+    std::fprintf(stderr, "subfit_samples_test: %d check(s) failed\n", failures);
+    return 1;
+}
diff --git a/tests/cuda/subfit_apply_test.cu b/tests/cuda/subfit_apply_test.cu
new file mode 100644
index 000000000..e7dbf39cc
--- /dev/null
+++ b/tests/cuda/subfit_apply_test.cu
@@ -0,0 +1,208 @@
+// tests/cuda/subfit_apply_test.cu - SPEC-substitute-fit stage 2 step 3: subfit_apply against a CPU reference (GPU; compiled, not run on the
+// serving machine).  Random parts, x, A, B, c, LUT, orig, ids and flags; the kernel's output must equal the reference in both modes:
+//   - mode all: every row/slot with orig >= 0, LUT >= 0 is corrected (flags ignored);
+//   - mode dynamic: only the flagged ones.
+// Rows with orig = -1, or LUT = -1, must come out untouched; orig and flag are reset to -1 / 0 by the launch.  Exit 77 without a CUDA device.
+#include "strata/kernels/subfit_apply.hpp"
+
+#include <cuda_fp16.h>
+#include <cuda_runtime.h>
+
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <vector>
+
+using strata::kernels::SubfitApplyArgs;
+
+namespace {
+
+int failures = 0;
+
+#define CHECK(cond, msg)                                                       \
+    do {                                                                       \
+        if (!(cond)) {                                                         \
+            std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, msg); \
+            ++failures;                                                        \
+        }                                                                      \
+    } while (0)
+
+constexpr int kN = 256, kR = 16, kK = 10, kRows = 6, kSlots = 12, kLayer = 1, kLayers = 2, kE = 512;
+
+uint16_t to16(float f) { return __half_as_ushort(__float2half(f)); }
+float from16(uint16_t h) { return __half2float(__ushort_as_half(h)); }
+
+// CPU reference of one layer's apply, exactly the kernel's rule
+void reference(std::vector<float>& parts, const std::vector<float>& x, const std::vector<int32_t>& ids, const std::vector<int16_t>& orig,
+               const std::vector<uint8_t>& flag, const std::vector<int16_t>& lut, const std::vector<uint16_t>& A, const std::vector<uint16_t>& B,
+               const std::vector<float>& c, int mode) {
+    for (int row = 0; row < kRows; ++row) {
+        std::vector<float> z(kR, 0.0f);
+        for (int m = 0; m < kR; ++m)
+            for (int j = 0; j < kN; ++j) z[(size_t) m] += from16(A[(size_t) m * kN + j]) * x[(size_t) row * kN + j];
+        for (int k = 0; k < kK; ++k) {
+            const int idx = row * kK + k;
+            const int e = orig[(size_t) idx], s = ids[(size_t) idx];
+            int slot = -1;
+            if (e >= 0 && e < kE && s >= 0 && s < kE) slot = lut[(size_t) e * kE + s];
+            if (slot < 0) continue;
+            if (!(mode == 2 || flag[(size_t) idx] != 0)) continue;
+            float* p = &parts[((size_t) row * kK + k) * kN];
+            for (int j = 0; j < kN; ++j) {
+                float v = 0.0f;
+                for (int m = 0; m < kR; ++m) v += from16(B[((size_t) slot * kN + j) * kR + m]) * z[(size_t) m];
+                p[j] = c[(size_t) slot] * p[j] + v;
+            }
+        }
+    }
+}
+
+bool run_case(int mode, uint32_t seed, bool fitted_layer) {
+    std::mt19937 g(seed);
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+    std::uniform_real_distribution<float> ud(0.0f, 1.0f);
+    std::vector<float> parts((size_t) kRows * kK * kN), x((size_t) kRows * kN);
+    for (float& v : parts) v = nd(g);
+    for (float& v : x) v = nd(g);
+    std::vector<uint16_t> A((size_t) kR * kN), B((size_t) kSlots * kN * kR);
+    for (auto& v : A) v = to16(0.1f * nd(g));
+    for (auto& v : B) v = to16(0.1f * nd(g));
+    std::vector<float> c(kSlots), resid(kSlots, 0.5f);
+    for (float& v : c) v = 0.5f + ud(g);
+    // the full LUT of the layer (-1 everywhere but a few fitted pairs); the orig / ids / flags of the rows
+    std::vector<int16_t> lut((size_t) kLayers * kE * kE, -1);
+    std::vector<int16_t> lut_l((size_t) kE * kE, -1);
+    for (int i = 0; i < kSlots; ++i) {
+        const int e = (int) (g() % kE), s = (int) (g() % kE);
+        lut_l[(size_t) e * kE + s] = (int16_t) i;
+    }
+    if (fitted_layer)
+        for (size_t i = 0; i < lut_l.size(); ++i) lut[(size_t) kLayer * kE * kE + i] = lut_l[i];
+    std::vector<int16_t> orig((size_t) kRows * kK, -1);
+    std::vector<int32_t> ids((size_t) kRows * kK);
+    std::vector<uint8_t> flag((size_t) kRows * kK, 0);
+    for (int row = 0; row < kRows; ++row)
+        for (int k = 0; k < kK; ++k) {
+            const size_t idx = (size_t) row * kK + k;
+            ids[idx] = (int32_t) (g() % kE);
+            const int r = ud(g) < 0.6f ? (int) (g() % kE) : -1;   // some slots substituted (orig = the pick)
+            orig[idx] = (int16_t) r;
+            flag[idx] = (uint8_t) (ud(g) < 0.5f ? 1 : 0);
+            // make some substituted slots fitted: place (orig, ids) on a LUT entry of the layer
+            if (r >= 0 && ud(g) < 0.5f) {
+                const int slot = (int) (g() % kSlots);
+                ids[idx] = (int32_t) (g() % kE);
+                lut_l[(size_t) r * kE + ids[idx]] = (int16_t) slot;
+                if (fitted_layer) lut[(size_t) kLayer * kE * kE + (size_t) r * kE + ids[idx]] = (int16_t) slot;
+            }
+        }
+    // the reference's view of the layer's LUT
+    const std::vector<int16_t> ref_lut = fitted_layer ? lut_l : std::vector<int16_t>((size_t) kE * kE, (int16_t) -1);
+    std::vector<float> want = parts;
+    reference(want, x, ids, orig, flag, ref_lut, A, B, c, mode);
+    // device
+    float *d_parts = nullptr, *d_x = nullptr, *d_c = nullptr, *d_resid = nullptr;
+    int32_t* d_ids = nullptr;
+    int16_t *d_orig = nullptr, *d_lut = nullptr;
+    uint8_t* d_flag = nullptr;
+    uint16_t *d_A = nullptr, *d_B = nullptr;
+    int32_t* d_nfit = nullptr;
+    strata::kernels::SubfitTables t;
+    bool ok = strata::kernels::subfit_tables_alloc(t, kLayers, kSlots, kN, kR);
+    CHECK(ok, "the tables allocate");
+    if (!ok) return false;
+    cudaMalloc(&d_parts, parts.size() * sizeof(float));
+    cudaMalloc(&d_x, x.size() * sizeof(float));
+    cudaMalloc(&d_ids, ids.size() * sizeof(int32_t));
+    cudaMalloc(&d_orig, orig.size() * sizeof(int16_t));
+    cudaMalloc(&d_flag, flag.size());
+    cudaMalloc(&d_lut, lut.size() * sizeof(int16_t));
+    cudaMalloc(&d_nfit, sizeof(int32_t));
+    cudaMemcpy(d_parts, parts.data(), parts.size() * sizeof(float), cudaMemcpyHostToDevice);
+    cudaMemcpy(d_x, x.data(), x.size() * sizeof(float), cudaMemcpyHostToDevice);
+    cudaMemcpy(d_ids, ids.data(), ids.size() * sizeof(int32_t), cudaMemcpyHostToDevice);
+    cudaMemcpy(d_orig, orig.data(), orig.size() * sizeof(int16_t), cudaMemcpyHostToDevice);
+    cudaMemcpy(d_flag, flag.data(), flag.size(), cudaMemcpyHostToDevice);
+    cudaMemcpy(d_lut, lut.data(), lut.size() * sizeof(int16_t), cudaMemcpyHostToDevice);
+    const int32_t nf = fitted_layer ? 1 : 0;
+    cudaMemcpy(d_nfit, &nf, sizeof nf, cudaMemcpyHostToDevice);
+    // the table: A (layer 0 slot), B and c, resid
+    cudaMemcpy(t.A + (size_t) kLayer * kR * kN, A.data(), A.size() * sizeof(uint16_t), cudaMemcpyHostToDevice);
+    cudaMemcpy(t.B, B.data(), B.size() * sizeof(uint16_t), cudaMemcpyHostToDevice);
+    cudaMemcpy(t.c, c.data(), c.size() * sizeof(float), cudaMemcpyHostToDevice);
+    cudaMemcpy(t.lut + (size_t) kLayer * kE * kE, lut_l.data(), lut_l.size() * sizeof(int16_t), cudaMemcpyHostToDevice);
+    cudaMemcpy(t.nfit + kLayer, &nf, sizeof nf, cudaMemcpyHostToDevice);
+    (void) d_resid;
+    (void) d_c;
+    SubfitApplyArgs a;
+    a.parts = d_parts;
+    a.x = d_x;
+    a.ids = d_ids;
+    a.orig = d_orig;
+    a.flag = d_flag;
+    a.lut = t.lut + (size_t) kLayer * kE * kE;
+    a.A = t.A + (size_t) kLayer * kR * kN;
+    a.B = t.B;
+    a.c = t.c;
+    a.nfit = t.nfit + kLayer;
+    a.r = kR;
+    a.N = kN;
+    a.K = kK;
+    a.n = kRows;
+    a.mode = mode;
+    strata::kernels::subfit_apply(a, nullptr);
+    cudaError_t err = cudaDeviceSynchronize();
+    CHECK(err == cudaSuccess, "the kernel runs");
+    std::vector<float> got(parts.size());
+    cudaMemcpy(got.data(), d_parts, got.size() * sizeof(float), cudaMemcpyDeviceToHost);
+    std::vector<int16_t> orig_after(orig.size());
+    std::vector<uint8_t> flag_after(flag.size());
+    cudaMemcpy(orig_after.data(), d_orig, orig.size() * sizeof(int16_t), cudaMemcpyDeviceToHost);
+    cudaMemcpy(flag_after.data(), d_flag, flag.size(), cudaMemcpyDeviceToHost);
+    double worst = 0.0;
+    for (size_t i = 0; i < got.size(); ++i) worst = std::fmax(worst, std::fabs((double) got[i] - (double) want[i]));
+    CHECK(worst < 1e-3, "the device output equals the reference");
+    // rows with orig = -1 or LUT = -1 are untouched: the reference left them, so the same comparison covers it; check directly too
+    bool untouched = true;
+    for (int row = 0; row < kRows; ++row)
+        for (int k = 0; k < kK; ++k) {
+            const int idx = row * kK + k;
+            const int e = orig[(size_t) idx], s = ids[(size_t) idx];
+            const bool fit = e >= 0 && e < kE && s >= 0 && s < kE && lut_l[(size_t) e * kE + s] >= 0 && fitted_layer;
+            const bool use = fit && (mode == 2 || flag[(size_t) idx] != 0);
+            if (!use)
+                for (int j = 0; j < kN; ++j)
+                    if (got[((size_t) row * kK + k) * kN + j] != parts[((size_t) row * kK + k) * kN + j]) untouched = false;
+        }
+    CHECK(untouched, "rows with no fitted pair (or not flagged in dynamic mode) are untouched");
+    bool reset = true;
+    for (int16_t v : orig_after) reset = reset && v == -1;
+    for (uint8_t v : flag_after) reset = reset && v == 0;
+    CHECK(reset, "orig and flag are consumed (reset)");
+    cudaFree(d_parts);
+    cudaFree(d_x);
+    cudaFree(d_ids);
+    cudaFree(d_orig);
+    cudaFree(d_flag);
+    cudaFree(d_lut);
+    cudaFree(d_nfit);
+    strata::kernels::subfit_tables_free(t);
+    return true;
+}
+
+}  // namespace
+
+int main() {
+    int devices = 0;
+    if (cudaGetDeviceCount(&devices) != cudaSuccess || devices < 1) {
+        std::printf("subfit_apply_test: no CUDA device, skipped\n");
+        return 77;
+    }
+    run_case(2, 1, true);    // all
+    run_case(1, 2, true);    // dynamic
+    run_case(1, 3, false);   // dynamic, layer without fit: a no-op
+    run_case(2, 4, false);   // all, layer without fit: a no-op
+    if (failures == 0) std::printf("subfit_apply_test: all checks passed\n");
+    return failures == 0 ? 0 : 1;
+}
diff --git a/tests/platform/drive_kind_test.cpp b/tests/platform/drive_kind_test.cpp
new file mode 100644
index 000000000..ee43e5590
--- /dev/null
+++ b/tests/platform/drive_kind_test.cpp
@@ -0,0 +1,48 @@
+// drive_kind_test: which kind of drive a path is on (Linux: sysfs, with partitions and LVM volumes followed down to
+// their disk). The two paths are this PC's: the NVMe that holds the model packs, and /home (LVM on a SATA SSD). A path
+// that does not exist is skipped; a path that does and gets the wrong kind fails.
+#include "strata/platform/direct_file.hpp"
+
+#include <cstdio>
+#include <filesystem>
+
+using namespace strata::platform;
+
+namespace {
+int failures = 0;
+
+const char* name(DriveKind k) {
+    switch (k) {
+        case DriveKind::Nvme: return "Nvme";
+        case DriveKind::Ssd: return "Ssd";
+        case DriveKind::Hdd: return "Hdd";
+        default: return "Unknown";
+    }
+}
+
+void expect(const char* path, DriveKind want) {
+    std::error_code ec;
+    if (!std::filesystem::exists(path, ec)) {
+        std::printf("skip %s (missing)\n", path);
+        return;
+    }
+    const DriveKind got = drive_kind(path);
+    std::printf("%s: %s (want %s)\n", path, name(got), name(want));
+    if (got != want) {
+        std::fprintf(stderr, "FAILED %s:%d: drive_kind(%s) is %s, want %s\n", __FILE__, __LINE__, path, name(got),
+                     name(want));
+        ++failures;
+    }
+}
+}  // namespace
+
+int main() {
+    expect("/mnt/nvme/strata-data/packs/iq3_s/experts.bin", DriveKind::Nvme);
+    expect("/home/models", DriveKind::Ssd);
+    if (drive_kind("/no/such/path/for/drive_kind") != DriveKind::Unknown) {
+        std::fprintf(stderr, "FAILED %s:%d: a missing path is not Unknown\n", __FILE__, __LINE__);
+        ++failures;
+    }
+    std::printf("%s\n", failures == 0 ? "drive_kind_test: ok" : "drive_kind_test: FAILED");
+    return failures == 0 ? 0 : 1;
+}
diff --git a/tests/prefill/mmq_ids_margin_test.cpp b/tests/prefill/mmq_ids_margin_test.cpp
new file mode 100644
index 000000000..9fe43e702
--- /dev/null
+++ b/tests/prefill/mmq_ids_margin_test.cpp
@@ -0,0 +1,102 @@
+// The MMQ row-table margin (PR #5108): every index the stream-k fixup and the main kernel can read stays inside the table.
+// No GPU: the reads are enumerated from the layout the way mul_mat_q_stream_k_fixup computes them
+// (ids_dst[col_low + jt*J + j], jt < ceil(max_rows / J), j < J, col_low = the expert's first row).
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <random>
+#include <vector>
+
+#include "strata/prefill/mmq_ids_margin.hpp"
+
+using namespace strata::prefill::mmq;
+
+static int failed = 0;
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #x); ++failed; } } while (0)
+
+// the highest index (exclusive) one launch can read: bounds has n + 1 entries, max_rows the widest expert, J any tile width
+static int64_t fixup_read_end(const std::vector<int64_t>& bounds, int64_t max_rows, int J) {
+    const int64_t tiles = (max_rows + J - 1) / J;
+    int64_t end = 0;
+    for (size_t e = 0; e + 1 < bounds.size(); ++e)
+        end = std::max(end, bounds[e] + tiles * J);              // every expert's fixup reads whole tiles from its first row
+    return end;
+}
+static int64_t main_read_end(const std::vector<int64_t>& bounds, int J) {
+    int64_t end = 0;
+    for (size_t e = 0; e + 1 < bounds.size(); ++e)
+        if (bounds[e + 1] > bounds[e]) end = std::max(end, bounds[e + 1] + J - 1);   // up to J - 1 rows after the expert's last
+    return end;
+}
+
+int main() {
+    // the constants follow ggml's loop J = 8 .. 128
+    CHECK(kMmqTileColsMax == 128 && kMmqTileColsStep == 8);
+
+    // arithmetic: roundup(max_rows, J) + J
+    int64_t m = -1;
+    CHECK(mmq_ids_margin_rows(0, 128, &m) && m == 128);
+    CHECK(mmq_ids_margin_rows(1, 128, &m) && m == 256);
+    CHECK(mmq_ids_margin_rows(128, 128, &m) && m == 256);
+    CHECK(mmq_ids_margin_rows(129, 128, &m) && m == 384);
+    CHECK(mmq_ids_margin_rows(3072, 128, &m) && m == 3200);
+    CHECK(mmq_ids_margin_rows(3072, 8, &m) && m == 3080);
+    CHECK(mmq_ids_table_rows(30720, 3072) == 30720 + 3200);
+    CHECK(mmq_ids_table_rows(0, 0) == 128);
+
+    // checked arithmetic: nothing wraps to a small table
+    m = 77;
+    CHECK(!mmq_ids_margin_rows(-1, 128, &m) && m == 77);
+    CHECK(!mmq_ids_margin_rows(10, 0, &m) && !mmq_ids_margin_rows(10, -8, &m));
+    CHECK(!mmq_ids_margin_rows(INT64_MAX, 128, &m));
+    CHECK(!mmq_ids_margin_rows(INT64_MAX - 100, 128, &m));
+    CHECK(mmq_ids_table_rows(UINT64_MAX - 5, 10) == 0);
+    CHECK(mmq_ids_table_rows(10, (uint64_t) INT64_MAX + 1) == 0);
+    CHECK(mmq_ids_table_rows(UINT64_MAX, 0) == 0);
+
+    // synthetic layouts: the table is T*K rows + the margin, T tokens, K = 10 experts per token; late experts, empty tiles
+    const int64_t K = 10;
+    std::mt19937_64 rng(5108);
+    for (int iter = 0; iter < 2000; ++iter) {
+        const int64_t T = 1 + (int64_t) (rng() % (iter < 1000 ? 70 : 4096));
+        const int NE = 1 + (int) (rng() % 64);
+        std::vector<int64_t> cnt((size_t) NE, 0);
+        int64_t left = T * K, widest = 0;
+        // experts take at most one row per token; some are empty, the last ones often are
+        for (int e = 0; e < NE && left > 0; ++e) {
+            const int64_t c = std::min<int64_t>({(int64_t) (rng() % ((uint64_t) T + 1)), T, left});
+            cnt[(size_t) e] = c;
+            left -= c;
+        }
+        // whatever is left goes to experts that still have room (the rows must add up to T*K when they can)
+        for (int e = 0; e < NE && left > 0; ++e) {
+            const int64_t room = T - cnt[(size_t) e], c = std::min(room, left);
+            cnt[(size_t) e] += c;
+            left -= c;
+        }
+        std::vector<int64_t> bounds{0};
+        int64_t total = 0;
+        for (int64_t c : cnt) { total += c; bounds.push_back(total); widest = std::max(widest, c); }
+        CHECK(widest <= T);
+        const int64_t table = (int64_t) mmq_ids_table_rows((uint64_t) total, (uint64_t) T);
+        for (int J = kMmqTileColsStep; J <= kMmqTileColsMax; J += kMmqTileColsStep) {
+            // the launch uses max_rows = the widest expert here; the margin is sized for max_rows <= T
+            CHECK(fixup_read_end(bounds, widest, J) <= table);
+            CHECK(fixup_read_end(bounds, T, J) <= table);       // even a launch whose grid is sized for T
+            CHECK(main_read_end(bounds, J) <= table);
+        }
+    }
+
+    // the exact table of before the fix does fail on the late-expert layout the PR found (the guard this test pins)
+    {
+        const int64_t T = 100;
+        std::vector<int64_t> bounds{0, 100, 200, 200, 200};      // two real experts, then two empty late ones at row T*2
+        const int64_t exact = 200;
+        CHECK(fixup_read_end(bounds, 100, 128) > exact);
+        CHECK(fixup_read_end(bounds, 100, 128) <= (int64_t) mmq_ids_table_rows(200, (uint64_t) T));
+    }
+
+    if (failed) { std::fprintf(stderr, "%d check(s) failed\n", failed); return 1; }
+    std::puts("mmq_ids_margin_test: ok");
+    return 0;
+}
diff --git a/tests/program/adaptive_range_test.cpp b/tests/program/adaptive_range_test.cpp
new file mode 100644
index 000000000..67e39ea4a
--- /dev/null
+++ b/tests/program/adaptive_range_test.cpp
@@ -0,0 +1,102 @@
+// The adaptive tier's copy-in range (PR #4844): which swaps of a round step 3 marks resident.  No GPU: the rounds are
+// walked as generate.cpp walks them, and each swap is a counter that says whether it was copied in and whether it was marked.
+#include <cstdio>
+#include <vector>
+
+#include "strata/program/adaptive_range.hpp"
+
+using strata::program::AdaptiveCopyRange;
+
+static int failed = 0;
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #x); ++failed; } } while (0)
+
+struct Round {
+    size_t total;
+    std::vector<int> copied, marked;
+    explicit Round(size_t n) : total(n), copied(n, 0), marked(n, 0) {}
+    static bool all(const std::vector<int>& v) { for (int x : v) if (x != 1) return false; return true; }
+};
+
+// the serial loop: plan (clear + next_batch), copy the batch, step 3 marks it, repeat while more() (the arena's cap)
+static void serial_round(AdaptiveCopyRange& r, Round& rd, size_t batch) {
+    r.clear();
+    r.next_batch(rd.total, batch);
+    for (;;) {
+        for (size_t i = r.lo; i < r.hi; ++i) ++rd.copied[i];
+        for (size_t i = r.landed_begin(false); i < r.landed_end(false, rd.total); ++i) ++rd.marked[i];
+        if (!r.more(rd.total)) break;
+        r.next_batch(rd.total, batch);
+    }
+}
+
+int main() {
+    // the serial loop covers every swap once, whatever the cap, including zero swaps and one swap
+    for (size_t total : {(size_t) 0, (size_t) 1, (size_t) 2, (size_t) 5, (size_t) 8, (size_t) 64})
+        for (size_t batch : {(size_t) 0, (size_t) 1, (size_t) 2, (size_t) 3, (size_t) 7, (size_t) 8, (size_t) 100}) {
+            AdaptiveCopyRange r;
+            Round rd(total);
+            serial_round(r, rd, batch);
+            CHECK(Round::all(rd.copied) && Round::all(rd.marked));
+            CHECK(r.bi == total && r.hi == total);
+        }
+
+    // a batch never runs past the list, even for a cap near the size_t limit
+    {
+        AdaptiveCopyRange r;
+        r.next_batch(5, (size_t) -1);
+        CHECK(r.lo == 0 && r.hi == 5 && r.bi == 5);
+        r.next_batch(5, 2);                     // asked again after the end: an empty batch at the end
+        CHECK(r.lo == 5 && r.hi == 5 && !r.more(5));
+    }
+
+    // the lost experts of #4844: a round planned on the pipelined loop whose loop drained before step 3 is marked on the
+    // serial rule.  An earlier serial round left [lo, hi) at its last batch.
+    {
+        AdaptiveCopyRange r;
+        Round first(5);
+        serial_round(r, first, 2);              // leaves lo = 4, hi = 5, bi = 5
+        CHECK(r.lo == 4 && r.hi == 5);
+
+        // the old plan (nothing set for a pipelined round): step 3 on the serial rule marks only the stale range
+        {
+            AdaptiveCopyRange stale = r;
+            Round pl(7);
+            for (size_t i = 0; i < pl.total; ++i) ++pl.copied[i];                       // a_in copied all of them at the gaps
+            for (size_t i = stale.landed_begin(false); i < stale.landed_end(false, pl.total); ++i) ++pl.marked[i];
+            CHECK(!Round::all(pl.marked));                                              // the bug this test pins
+        }
+
+        // the fix: the pipelined plan names the whole round
+        Round pl(7);
+        r.whole_round(pl.total);
+        for (size_t i = 0; i < pl.total; ++i) ++pl.copied[i];
+        for (size_t i = r.landed_begin(false); i < r.landed_end(false, pl.total); ++i) ++pl.marked[i];   // the drained tick: serial rule
+        CHECK(Round::all(pl.marked));
+        CHECK(!r.more(pl.total));                                                       // and no second batch is posted
+        // the same round finished on the pipelined rule marks the same range
+        CHECK(r.landed_begin(true) == r.landed_begin(false) && r.landed_end(true, pl.total) == r.landed_end(false, pl.total));
+    }
+
+    // one swap, and an empty round, on the pipelined plan
+    {
+        AdaptiveCopyRange r;
+        r.next_batch(9, 4);
+        r.whole_round(1);
+        CHECK(r.landed_begin(false) == 0 && r.landed_end(false, 1) == 1 && !r.more(1));
+        r.whole_round(0);
+        CHECK(r.landed_begin(false) == 0 && r.landed_end(false, 0) == 0 && !r.more(0));
+    }
+
+    // a serial round that follows a pipelined one starts clean
+    {
+        AdaptiveCopyRange r;
+        r.whole_round(6);
+        Round rd(3);
+        serial_round(r, rd, 2);
+        CHECK(Round::all(rd.copied) && Round::all(rd.marked));
+    }
+
+    if (failed) { std::fprintf(stderr, "%d check(s) failed\n", failed); return 1; }
+    std::puts("adaptive_range_test: ok");
+    return 0;
+}
diff --git a/tests/tools/subfit_fit_math_test.cpp b/tests/tools/subfit_fit_math_test.cpp
new file mode 100644
index 000000000..5ee598afc
--- /dev/null
+++ b/tests/tools/subfit_fit_math_test.cpp
@@ -0,0 +1,218 @@
+// tests/tools/subfit_fit_math_test.cpp - SPEC-substitute-fit stage 1b: the fit's linear algebra on synthetic data (CPU only).
+// Covers: Cholesky solve, the ridge regression recovers a known map, the Jacobi eigen-decomposition, the randomized rank truncation,
+// the held-out split, the scalar fit, and the candidate search (best cosine, the sample's own expert excluded).
+#include "fit_math.hpp"
+
+#include <cmath>
+#include <cstdio>
+#include <random>
+#include <vector>
+
+using namespace subfit_fit;
+
+namespace {
+int failures = 0;
+
+#define CHECK(cond, msg)                                                       \
+    do {                                                                       \
+        if (!(cond)) {                                                         \
+            std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, msg); \
+            ++failures;                                                        \
+        }                                                                      \
+    } while (0)
+
+std::vector<double> randn(size_t n, std::mt19937_64& rng, double sd = 1.0) {
+    std::normal_distribution<double> g(0.0, sd);
+    std::vector<double> v(n);
+    for (double& x : v) x = g(rng);
+    return v;
+}
+
+double frob(const std::vector<double>& a) {
+    double s = 0;
+    for (double x : a) s += x * x;
+    return std::sqrt(s);
+}
+
+double diff_frob(const std::vector<double>& a, const std::vector<double>& b) {
+    double s = 0;
+    for (size_t i = 0; i < a.size(); ++i) s += (a[i] - b[i]) * (a[i] - b[i]);
+    return std::sqrt(s);
+}
+
+// y = M h with M (N x F) row-major
+std::vector<double> matvec(const std::vector<double>& M, int N, int F, const double* h) {
+    std::vector<double> y((size_t) N, 0.0);
+    for (int i = 0; i < N; ++i)
+        for (int a = 0; a < F; ++a) y[(size_t) i] += M[(size_t) i * F + a] * h[a];
+    return y;
+}
+
+void test_cholesky() {
+    // A = [[4,2],[2,3]], B = A X with X = [[1,0],[0,2]]
+    std::vector<double> A = {4, 2, 2, 3};
+    std::vector<double> B = {4, 4, 2, 6};   // A X: column 0 = (4,2), column 1 = (4,6)
+    CHECK(cholesky_solve(A, 2, B, 2), "SPD matrix solves");
+    CHECK(std::fabs(B[0] - 1) < 1e-12 && std::fabs(B[1]) < 1e-12 && std::fabs(B[2]) < 1e-12 && std::fabs(B[3] - 2) < 1e-12,
+          "Cholesky recovers X");
+    std::vector<double> bad = {1, 2, 2, 1};   // indefinite
+    std::vector<double> rhs = {1, 1};
+    CHECK(!cholesky_solve(bad, 2, rhs, 1), "an indefinite matrix is refused");
+}
+
+void test_ridge_recovers_map() {
+    std::mt19937_64 rng(7);
+    const int n = 400, F = 6, N = 9;
+    std::vector<double> M = randn((size_t) N * F, rng);
+    std::vector<double> H = randn((size_t) n * F, rng);
+    std::vector<double> R((size_t) n * N, 0.0);
+    for (int i = 0; i < n; ++i) {
+        const std::vector<double> y = matvec(M, N, F, &H[(size_t) i * F]);
+        for (int j = 0; j < N; ++j) R[(size_t) i * N + j] = y[(size_t) j];
+    }
+    std::vector<double> Mhat;
+    CHECK(ridge_fit(H, R, n, F, N, 1e-9, Mhat), "ridge solves");
+    CHECK(diff_frob(Mhat, M) / frob(M) < 1e-6, "noise-free data: the known map is recovered");
+
+    // with noise the fit is still close, and a large lambda shrinks it
+    std::vector<double> Rn = R;
+    std::normal_distribution<double> g(0.0, 0.5);
+    for (double& v : Rn) v += g(rng);
+    std::vector<double> M1, M2;
+    CHECK(ridge_fit(H, Rn, n, F, N, 1e-6, M1), "ridge with noise");
+    CHECK(ridge_fit(H, Rn, n, F, N, 1e4, M2), "ridge with a large lambda");
+    CHECK(diff_frob(M1, M) / frob(M) < 0.1, "noisy data: the map is still close");
+    CHECK(frob(M2) < 0.5 * frob(M1), "a large lambda shrinks the map");
+}
+
+void test_eig() {
+    // symmetric 3x3 with known eigenvalues 1, 3, 5 (A = Q diag Q^T for a rotation Q): use [[3,1,0],[1,3,0],[0,0,5]] -> 4, 2, 5
+    std::vector<double> A = {3, 1, 0, 1, 3, 0, 0, 0, 5};
+    std::vector<double> ev, V;
+    eig_sym(A, 3, ev, V);
+    CHECK(std::fabs(ev[0] - 5) < 1e-9 && std::fabs(ev[1] - 4) < 1e-9 && std::fabs(ev[2] - 2) < 1e-9, "eigenvalues, descending");
+    // A v = lambda v for each column
+    bool ok = true;
+    for (int j = 0; j < 3; ++j)
+        for (int i = 0; i < 3; ++i) {
+            double av = 0;
+            for (int k = 0; k < 3; ++k) av += A[(size_t) i * 3 + k] * V[(size_t) k * 3 + j];
+            if (std::fabs(av - ev[(size_t) j] * V[(size_t) i * 3 + j]) > 1e-9) ok = false;
+        }
+    CHECK(ok, "eigenvectors satisfy A v = lambda v");
+}
+
+void test_truncate() {
+    std::mt19937_64 rng(11);
+    const int N = 40, F = 25;
+    // an exact rank-3 matrix: truncation to 3 reproduces it, to 2 does not
+    std::vector<double> P = randn((size_t) N * 3, rng), Q = randn((size_t) 3 * F, rng);
+    std::vector<double> M((size_t) N * F, 0.0);
+    for (int i = 0; i < N; ++i)
+        for (int a = 0; a < F; ++a)
+            for (int k = 0; k < 3; ++k) M[(size_t) i * F + a] += P[(size_t) i * 3 + k] * Q[(size_t) k * F + a];
+    std::vector<double> T3, T2;
+    truncate_rank(M, N, F, 3, 5, T3);
+    truncate_rank(M, N, F, 2, 5, T2);
+    CHECK(diff_frob(T3, M) / frob(M) < 1e-8, "rank-3 matrix is reproduced by a rank-3 truncation");
+    CHECK(diff_frob(T2, M) / frob(M) > 1e-2, "rank-2 truncation of a rank-3 matrix loses something");
+
+    // a full-rank matrix: the error of a rank-r truncation is close to the sum of the discarded singular values squared (eig of M^T M)
+    std::vector<double> G((size_t) F * F, 0.0);
+    std::vector<double> Mr = randn((size_t) N * F, rng);
+    for (int a = 0; a < F; ++a)
+        for (int b = 0; b < F; ++b) {
+            double s = 0;
+            for (int i = 0; i < N; ++i) s += Mr[(size_t) i * F + a] * Mr[(size_t) i * F + b];
+            G[(size_t) a * F + b] = s;
+        }
+    std::vector<double> ev, V;
+    eig_sym(G, F, ev, V);
+    const int r = 5;
+    double tail = 0;
+    for (int j = r; j < F; ++j) tail += ev[(size_t) j];
+    std::vector<double> Tr;
+    truncate_rank(Mr, N, F, r, 3, Tr);
+    const double err2 = diff_frob(Tr, Mr) * diff_frob(Tr, Mr);
+    CHECK(err2 <= 1.25 * tail && err2 >= 0.8 * tail, "randomized rank-5 error is near the optimal tail energy");
+    truncate_rank(Mr, N, F, F, 3, Tr);
+    CHECK(diff_frob(Tr, Mr) < 1e-12, "full rank returns the matrix");
+}
+
+void test_scalar_and_split() {
+    std::vector<double> ys = {1, 2, 3, 4};
+    std::vector<double> ye = {2, 4, 6, 8};   // ye = 2 ys
+    CHECK(std::fabs(best_scalar(ys, ye, 2, 2) - 2.0) < 1e-12, "best scalar of an exact 2x");
+    std::vector<double> zero = {0, 0, 0, 0};
+    CHECK(best_scalar(zero, ye, 2, 2) == 0.0, "no energy: scalar 0");
+    CHECK(half_of(0) == 0 && half_of(1) == 1 && half_of(10) == 0 && half_of(7) == 1, "even / odd held-out split");
+    CHECK(std::fabs(cosine(ys.data(), ye.data(), 4) - 1.0) < 1e-12, "cosine of parallel vectors");
+}
+
+// The candidate search: the best cosine against y_e over candidate outputs, the sample's own expert excluded.
+// (The same rule the tool applies; here with plain vectors so the test does not need the pack.)
+int best_candidate(const std::vector<std::vector<double>>& outs, const std::vector<int>& ids, const std::vector<double>& ye, int own) {
+    int best = -1;
+    double bc = -2.0;
+    for (size_t i = 0; i < outs.size(); ++i) {
+        if (ids[i] == own) continue;
+        const double c = cosine(outs[i].data(), ye.data(), (int) ye.size());
+        if (c > bc) {
+            bc = c;
+            best = ids[i];
+        }
+    }
+    return best;
+}
+
+void test_candidates() {
+    const int N = 8;
+    std::vector<double> ye(N);
+    for (int i = 0; i < N; ++i) ye[(size_t) i] = std::sin((double) i + 1.0);
+    std::vector<std::vector<double>> outs;
+    std::vector<int> ids;
+    for (int c = 0; c < 6; ++c) {   // noise candidates with ids 10..15
+        std::vector<double> o(N);
+        for (int i = 0; i < N; ++i) o[(size_t) i] = std::cos((double) (c * 7 + i));
+        outs.push_back(o);
+        ids.push_back(10 + c);
+    }
+    outs.push_back(ye);   // candidate 99 matches y_e exactly
+    ids.push_back(99);
+    CHECK(best_candidate(outs, ids, ye, 5) == 99, "the best cosine candidate is chosen");
+    CHECK(best_candidate(outs, ids, ye, 99) != 99, "the sample's own expert is excluded from the search");
+}
+
+void test_mode_arithmetic() {
+    CHECK(std::fabs(residual_all(0.75) - 0.5) < 1e-12, "ALL: sqrt(1 - g)");
+    CHECK(std::fabs(residual_all(0.0) - 1.0) < 1e-12, "no gain: residual 1");
+    CHECK(std::fabs(residual_all(1.0)) < 1e-12, "full gain: residual 0");
+    CHECK(std::fabs(residual_all(1.7)) < 1e-12 && std::fabs(residual_all(-0.3) - 1.0) < 1e-12, "g is clipped to [0, 1]");
+    CHECK(std::fabs(residual_dynamic(0.8, 0.75) - 0.6) < 1e-12, "DYNAMIC: (1 - f) + f sqrt(1 - g) = 0.2 + 0.4");
+    CHECK(std::fabs(residual_dynamic(1.0, 0.75) - residual_all(0.75)) < 1e-12, "f = 1 is ALL");
+    CHECK(std::fabs(residual_dynamic(0.0, 0.75) - 1.0) < 1e-12, "f = 0 is no correction");
+    // the gain kept by DYNAMIC against ALL is f
+    const double ra = residual_all(0.6), rd = residual_dynamic(0.8, 0.6);
+    CHECK(std::fabs((1.0 - rd) / (1.0 - ra) - 0.8) < 1e-12, "gain kept by DYNAMIC is f of ALL's");
+    CHECK(std::fabs(moves_share(3, 10) - 0.3) < 1e-12, "moves share: refused over moves");
+    CHECK(moves_share(12, 10) == 1.0, "moves share is at most 1");
+    CHECK(moves_share(0, 0) == 0.0, "no moves: 0");
+}
+
+}  // namespace
+
+int main() {
+    test_mode_arithmetic();
+    test_cholesky();
+    test_ridge_recovers_map();
+    test_eig();
+    test_truncate();
+    test_scalar_and_split();
+    test_candidates();
+    if (failures == 0) {
+        std::printf("subfit_fit_math_test: all checks passed\n");
+        return 0;
+    }
+    std::fprintf(stderr, "subfit_fit_math_test: %d check(s) failed\n", failures);
+    return 1;
+}
diff --git a/tools/drafter/dflash_offline.py b/tools/drafter/dflash_offline.py
new file mode 100644
index 000000000..e13a246f0
--- /dev/null
+++ b/tools/drafter/dflash_offline.py
@@ -0,0 +1,231 @@
+"""Would the DFlash 2 drafter beat the MTP on this PC?  Replays it offline on an engine trace (22 Oct 2026).
+
+The drafter: incoai/Qwen3.8-Flash-Next-DFlash2 (Inco AI, 19 Oct 2026; 5 small layers, 1.2 GB in bf16), trained on the completed outputs of
+layers 5, 15, 25, 35 and 45 averaged over the four hyper-connection streams.  It drafts a whole block in one pass from those features
+of the context and the block's first token; a selector picks one path through its top-16 candidates.
+
+The engine's STRATA_DRAFT_TRACE=<file> records, for every verify window, its rows' tokens, the model's pick after each row and the
+residual after those layers (src/core/verify.cpp).  From it this script rebuilds each request's text and the features of every position,
+then
+  * measures today's drafting (the MTP, and prompt lookup where it fired): tokens per window = accepted drafts + 1, over the windows
+    that generate (the prompt's windows are left out);
+  * replays the drafter over the same text, round by round as z-lab's dflash_generate runs it (the context's features, the block's
+    first token, mask tokens after it), and counts what greedy verification would accept: tokens per round.
+Greedy decoding is lossless, so the replay sees exactly the text a DFlash run would have produced; trace greedy requests only.
+
+Record the trace (on the box; one GPU; greedy; the prompt through the verify windows so its features are traced too - no --prefill):
+    STRATA_DRAFT_TRACE=/mnt/nvme/strata-data/traces/draft1.bin  <the usual engine command without --prefill>
+Download (once):
+    hf download incoai/Qwen3.8-Flash-Next-DFlash2 --local-dir dflash2
+    hf download Qwen/Qwen3.8-Flash-Next model-00130-of-00131.safetensors model-00131-of-00131.safetensors --local-dir qwen-head
+      (the token embedding and the output head the drafter shares with the model: 4.2 GB)
+    python -m pip install "dflash[local]" safetensors
+Run:
+    python dflash_offline.py draft1.bin --drafter dflash2 --head qwen-head --block 4 8
+Without --drafter it only parses the trace and prints today's numbers.
+"""
+import argparse
+import os
+import struct
+import sys
+
+import numpy as np
+
+
+def read_trace(path):
+    """-> (layers, n_embd, records): records are dicts pos0, T, tokens, picks, feats (uint16 bf16 [T, L * n_embd])."""
+    with open(path, "rb") as f:
+        buf = f.read()
+    if len(buf) < 16 or buf[:4] != b"DFT1":
+        raise ValueError("not a STRATA_DRAFT_TRACE file")
+    L, N, _hc = struct.unpack_from("<III", buf, 4)
+    layers = list(struct.unpack_from("<%di" % L, buf, 16))
+    off = 16 + 4 * L
+    recs = []
+    while off + 12 <= len(buf):
+        pos0, T = struct.unpack_from("<qi", buf, off)
+        size = 12 + 8 * T + 2 * T * L * N
+        if T < 1 or off + size > len(buf):
+            break                                   # a window cut by the end of a still-growing file
+        p = off + 12
+        tokens = np.frombuffer(buf, np.int32, T, p); p += 4 * T
+        picks = np.frombuffer(buf, np.int32, T, p); p += 4 * T
+        feats = np.frombuffer(buf, np.uint16, T * L * N, p).reshape(T, L * N)
+        recs.append(dict(pos0=pos0, T=T, tokens=tokens, picks=picks, feats=feats))
+        off += size
+    return layers, N, recs
+
+
+def accepted(rec):
+    """Drafts the window's verification kept: rows 1.. that equal the model's pick after the row before."""
+    a = 0
+    while a + 1 < rec["T"] and rec["tokens"][a + 1] == rec["picks"][a]:
+        a += 1
+    return a
+
+
+def sequences(recs):
+    """Split the windows into requests (a window that starts before the previous one is a new request) and rebuild each:
+    dict(tokens [n] int32 committed text, feats [n, L*N] uint16, first, gen_start, windows (that request's records), gen_windows)."""
+    groups, cur = [], []
+    for r in recs:
+        if cur and r["pos0"] < cur[-1]["pos0"]:
+            groups.append(cur)
+            cur = []
+        cur.append(r)
+    if cur:
+        groups.append(cur)
+    out = []
+    for g in groups:
+        first = g[0]["pos0"]
+        last = g[-1]
+        end = last["pos0"] + accepted(last) + 1           # the last window commits rows 0..accepted
+        n = end - first
+        D = g[0]["feats"].shape[1]
+        toks = np.full(n, -1, np.int32)
+        feats = np.zeros((n, D), np.uint16)
+        for r in g:                                       # later windows rewrite the positions rejected drafts held
+            lo = r["pos0"] - first
+            k = min(r["T"], n - lo)
+            if k <= 0 or lo < 0:
+                continue
+            toks[lo:lo + k] = r["tokens"][:k]
+            feats[lo:lo + k] = r["feats"][:k]
+        # the first generating window: from it on, every window starts with the pick its predecessor made after the row before
+        def cont(i):
+            a, b = g[i - 1], g[i]
+            j = b["pos0"] - a["pos0"] - 1
+            return 0 <= j < a["T"] and b["tokens"][0] == a["picks"][j]
+        k0 = len(g)
+        while k0 - 1 >= 1 and cont(k0 - 1):
+            k0 -= 1
+        if k0 == 1 and first > 0:                         # no prompt windows traced (--prefill): the first window generates too
+            k0 = 0
+        gen_windows = g[k0:] if k0 < len(g) else []
+        gen_start = gen_windows[0]["pos0"] - first if gen_windows else n
+        out.append(dict(tokens=toks, feats=feats, first=first, gen_start=gen_start, windows=g, gen_windows=gen_windows))
+    return out
+
+
+def today_stats(seqs):
+    """Tokens per generating window today (accepted drafts + 1) and the windows' sizes."""
+    per, sizes = [], []
+    for s in seqs:
+        for r in s["gen_windows"]:
+            per.append(accepted(r) + 1)
+            sizes.append(r["T"])
+    return dict(windows=len(per), tokens_per_window=float(np.mean(per)) if per else 0.0,
+                mean_size=float(np.mean(sizes)) if sizes else 0.0)
+
+
+def replay(seq, propose, block, max_rounds=None):
+    """Rounds as dflash_generate runs them, over the committed text.  propose(ctx_lo, ctx_hi, start, anchor, block) returns block - 1
+    draft tokens for positions start+1..; the context features new to the drafter are those of [ctx_lo, ctx_hi).  -> tokens per round."""
+    toks = seq["tokens"]
+    n = len(toks)
+    s = seq["gen_start"]
+    if s == 0:                                            # no prompt features traced (--prefill): the first position is the context
+        s = 1
+    ctx = 0
+    produced_all = []
+    while s + 1 < n and (max_rounds is None or len(produced_all) < max_rounds):
+        b = min(block, n - s)
+        draft = propose(ctx, s, s, int(toks[s]), b)
+        acc = 0
+        while acc < b - 1 and int(draft[acc]) == int(toks[s + 1 + acc]):
+            acc += 1
+        produced = min(acc + 1, n - s - 1)
+        produced_all.append(produced)
+        ctx = s
+        s += produced
+    return produced_all
+
+
+def load_dflash(drafter_dir, head_dir, layers, device):
+    """The drafter, the embedding and the head, once (z-lab's dflash package; imported here so parsing needs no torch)."""
+    import torch
+    from dflash.model import DFlash2DraftModel, _draft_value
+    from safetensors import safe_open
+
+    model = DFlash2DraftModel.from_pretrained(drafter_dir, torch_dtype=torch.bfloat16).to(device).eval()
+    want = list(model.target_layer_ids)
+    if want != list(layers):
+        print("NOTE: the drafter reads layers %s, the trace holds %s - the replay feeds the trace's as they are" % (want, layers))
+    tensors = {}
+    for fn in sorted(os.listdir(head_dir)):
+        if fn.endswith(".safetensors"):
+            with safe_open(os.path.join(head_dir, fn), "pt", device="cpu") as f:
+                for name in ("model.language_model.embed_tokens.weight", "lm_head.weight"):
+                    if name in f.keys():
+                        tensors[name] = f.get_tensor(name).to(device=device, dtype=torch.bfloat16)
+    if len(tensors) != 2:
+        raise SystemExit("--head: the token embedding and lm_head were not found in %s" % head_dir)
+    embed = tensors["model.language_model.embed_tokens.weight"]
+    head = torch.nn.Linear(embed.shape[1], embed.shape[0], bias=False, device=device, dtype=torch.bfloat16)
+    head.weight.data = tensors["lm_head.weight"]
+    return dict(model=model, embed=embed, head=head, scale=float(_draft_value(model.config, "input_embedding_scale", 1.0)),
+                mask_id=int(model.mask_token_id), device=device)
+
+
+def make_dflash_proposer(st, seq):
+    """A proposer over one request's features, with its own draft cache."""
+    import torch
+    import torch.nn.functional as F
+    from dflash.model import _crop_to, _make_cache
+
+    model, embed, head, scale, mask_id, device = st["model"], st["embed"], st["head"], st["scale"], st["mask_id"], st["device"]
+    feats = torch.from_numpy((seq["feats"].astype(np.uint32) << 16).view(np.float32))   # bf16 bits -> float32 [n, L*N]
+    cache = _make_cache(model.config)
+
+    @torch.inference_mode()
+    def propose(ctx_lo, ctx_hi, start, anchor, block):
+        th = feats[ctx_lo:ctx_hi].to(device=device, dtype=torch.bfloat16)[None]
+        ids = torch.full((1, block), mask_id, dtype=torch.long, device=device)
+        ids[0, 0] = anchor
+        noise = F.embedding(ids, embed) * scale
+        pos = torch.arange(start - th.shape[1], start + block, device=device)[None]
+        hidden = model(target_hidden=th, noise_embedding=noise, position_ids=pos, past_key_values=cache, use_cache=True)[:, 1 - block:, :]
+        _crop_to(cache, start)
+        draft, _, _ = model.propose(hidden, ids[:, 0], head, 0.0)
+        return draft[0].tolist()
+
+    return propose
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("trace")
+    ap.add_argument("--drafter", help="the downloaded incoai/Qwen3.8-Flash-Next-DFlash2 folder")
+    ap.add_argument("--head", help="folder with the model's shards holding embed_tokens and lm_head")
+    ap.add_argument("--block", type=int, nargs="+", default=[4, 8], help="block sizes to replay (4 = Inco's test, 8 = trained)")
+    ap.add_argument("--max-rounds", type=int, default=None)
+    ap.add_argument("--device", default="cuda")
+    a = ap.parse_args()
+    layers, N, recs = read_trace(a.trace)
+    seqs = sequences(recs)
+    print("trace: %d windows, %d requests, layers %s, n_embd %d" % (len(recs), len(seqs), layers, N))
+    for i, s in enumerate(seqs):
+        print("  request %d: positions %d..%d, generated from %d (%d generating windows)%s" % (
+            i, s["first"], s["first"] + len(s["tokens"]) - 1, s["first"] + s["gen_start"], len(s["gen_windows"]),
+            "" if s["first"] == 0 else "  (no prompt features: run without --prefill)"))
+    t = today_stats(seqs)
+    print("today (MTP and lookup): %.2f tokens per window over %d generating windows, mean window %.2f tokens" % (
+        t["tokens_per_window"], t["windows"], t["mean_size"]))
+    if not a.drafter:
+        return
+    if not a.head:
+        sys.exit("--head is needed with --drafter")
+    st = load_dflash(a.drafter, a.head, layers, a.device)
+    for block in a.block:
+        rounds = []
+        for s in seqs:
+            if s["gen_start"] >= len(s["tokens"]) - 1:
+                continue
+            rounds += replay(s, make_dflash_proposer(st, s), block, a.max_rounds)
+        if rounds:
+            print("DFlash 2, block %d: %.2f tokens per round over %d rounds (today: %.2f per window)" % (
+                block, float(np.mean(rounds)), len(rounds), t["tokens_per_window"]))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/drafter/test_dflash_offline.py b/tools/drafter/test_dflash_offline.py
new file mode 100644
index 000000000..f00138b97
--- /dev/null
+++ b/tools/drafter/test_dflash_offline.py
@@ -0,0 +1,136 @@
+"""Tests for dflash_offline.py's trace parsing, today's numbers and the replay loop, on synthetic STRATA_DRAFT_TRACE files
+(no GPU, no model, no download).
+
+usage: python test_dflash_offline.py
+"""
+import os
+import struct
+import tempfile
+
+import numpy as np
+
+import dflash_offline as dfo
+
+L, N = 5, 8          # a tiny "hidden size": the format does not care
+
+
+def feat(pos):
+    """A position's features, recognisable in the rebuilt request: every value is the position (as bf16 bits)."""
+    return np.full(L * N, pos & 0x7FFF, np.uint16)
+
+
+def emulate(text, prompt, accepts, T=4, rng=None):
+    """The windows an engine writes for one request: the prompt in windows of T rows, then generating windows whose drafts the
+    model accepts `accepts[i]` of (the rest of the window wrong).  -> list of (pos0, tokens, picks, feats)."""
+    rng = rng or np.random.default_rng(0)
+    wrong = lambda: int(rng.integers(50_000, 60_000))
+    wins = []
+    for p0 in range(0, prompt, T):
+        rows = list(range(p0, min(p0 + T, prompt)))
+        toks = [text[p] for p in rows]
+        picks = [text[p + 1] if p + 1 == prompt else wrong() for p in rows]    # only the last prompt row's pick is kept
+        wins.append((p0, toks, picks, [feat(p) for p in rows]))
+    s, i = prompt, 0
+    while s + 1 < len(text) and i < len(accepts):
+        a = min(accepts[i], T - 1, len(text) - s - 2)
+        toks = [text[s]] + [text[s + 1 + j] for j in range(a)] + [wrong() for _ in range(T - 1 - a)]
+        picks = [text[s + 1 + j] for j in range(a + 1)] + [wrong() for _ in range(T - 1 - a)]
+        wins.append((s, toks, picks, [feat(s + j) for j in range(T)]))   # rejected rows hold the features of wrong tokens too
+        s += a + 1
+        i += 1
+    return wins
+
+
+def write(path, requests):
+    with open(path, "wb") as f:
+        f.write(b"DFT1" + struct.pack("<III", L, N, 4) + struct.pack("<%di" % L, 5, 15, 25, 35, 45))
+        for wins in requests:
+            for pos0, toks, picks, feats in wins:
+                f.write(struct.pack("<qi", pos0, len(toks)))
+                f.write(np.array(toks, np.int32).tobytes() + np.array(picks, np.int32).tobytes())
+                f.write(np.stack(feats).astype(np.uint16).tobytes())
+
+
+def test_parse_rebuild_and_today():
+    text = list(range(100, 140))
+    accepts = [3, 0, 2, 3, 1, 3, 3, 0, 2]
+    with tempfile.TemporaryDirectory() as d:
+        p = os.path.join(d, "t.bin")
+        write(p, [emulate(text, 10, accepts), emulate(list(range(200, 220)), 6, [1, 1, 1])])
+        layers, n_embd, recs = dfo.read_trace(p)
+        assert layers == [5, 15, 25, 35, 45] and n_embd == N
+        seqs = dfo.sequences(recs)
+        assert len(seqs) == 2
+        s = seqs[0]
+        assert s["gen_start"] == 10, s["gen_start"]
+        n = len(s["tokens"])
+        assert list(s["tokens"]) == text[:n], "the committed text is rebuilt (rejected drafts rewritten)"
+        assert all(int(s["feats"][q][0]) == q for q in range(n)), "every position keeps its committed row's features"
+        assert len(s["gen_windows"]) == len(accepts)
+        t = dfo.today_stats(seqs[:1])
+        assert abs(t["tokens_per_window"] - (np.mean(accepts) + 1)) < 1e-9, t
+        assert seqs[1]["gen_start"] == 6 and list(seqs[1]["tokens"]) == list(range(200, 200 + len(seqs[1]["tokens"])))
+
+
+def test_replay_counts_what_greedy_accepts():
+    text = list(range(100, 160))
+    with tempfile.TemporaryDirectory() as d:
+        p = os.path.join(d, "t.bin")
+        write(p, [emulate(text, 12, [3] * 30)])
+        seq = dfo.sequences(dfo.read_trace(p)[2])[0]
+        toks = seq["tokens"]
+        n = len(toks)
+        seen = []
+
+        def oracle(ctx_lo, ctx_hi, start, anchor, block):          # always right: every round yields the whole block
+            assert anchor == toks[start] and ctx_hi == start and ctx_lo <= ctx_hi
+            seen.append((ctx_lo, ctx_hi))
+            return [int(toks[start + 1 + j]) if start + 1 + j < n else -1 for j in range(block - 1)]
+
+        rounds = dfo.replay(seq, oracle, 4)
+        assert sum(rounds) == n - 1 - seq["gen_start"], (sum(rounds), n, seq["gen_start"])
+        assert all(r == 4 for r in rounds[:-1])
+        assert seen[0] == (0, 12), "the first round gets the whole prompt's features"
+        assert all(seen[i][0] == seen[i - 1][1] for i in range(1, len(seen))), "each round adds only the positions the last one committed"
+
+        def first_right(ctx_lo, ctx_hi, start, anchor, block):     # only the first draft right: 2 tokens a round
+            return [int(toks[start + 1])] + [-1] * (block - 2)
+
+        rounds = dfo.replay(seq, first_right, 8)
+        assert all(r == 2 for r in rounds[:-1]) and sum(rounds) == n - 1 - seq["gen_start"]
+
+
+def test_trace_without_prompt_features():
+    text = list(range(300, 330))
+    wins = [w for w in emulate(text, 8, [2] * 10) if w[0] >= 8]   # a --prefill run: the prompt's windows are not in the trace
+    with tempfile.TemporaryDirectory() as d:
+        p = os.path.join(d, "t.bin")
+        write(p, [wins])
+        seq = dfo.sequences(dfo.read_trace(p)[2])[0]
+        assert seq["first"] == 8 and seq["gen_start"] == 0
+        rounds = dfo.replay(seq, lambda lo, hi, st, an, b: [-1] * (b - 1), 4)
+        assert all(r == 1 for r in rounds)
+
+
+def test_cut_file_and_bad_magic():
+    with tempfile.TemporaryDirectory() as d:
+        p = os.path.join(d, "t.bin")
+        write(p, [emulate(list(range(100, 130)), 8, [1] * 5)])
+        full = len(dfo.read_trace(p)[2])
+        with open(p, "r+b") as f:
+            f.truncate(os.path.getsize(p) - 10)
+        assert len(dfo.read_trace(p)[2]) == full - 1
+        with open(p, "wb") as f:
+            f.write(b"RTR1" + bytes(40))
+        try:
+            dfo.read_trace(p)
+            raise AssertionError("a router trace was taken for a draft trace")
+        except ValueError:
+            pass
+
+
+if __name__ == "__main__":
+    for name, fn in list(globals().items()):
+        if name.startswith("test_"):
+            fn()
+            print("ok", name)
