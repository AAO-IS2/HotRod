+// tests/core/subfit_apply_host_test.cpp - SPEC-substitute-fit stage 2, steps 2-5: the host side, CPU only (no GPU).
+// Covers: the shift rule (subfit_rule::decide) in every mode, against the old cap rule for mode off and fit-less pairs (the same
+// function the router kernels call); the upload packer (LUT writes, the mirror and fitted counts, fp16 slot B, residual factor) driven
+// by a real learner through a fit and a revoke; the fp16 feature matrix the apply kernel reads.
+#include "strata/core/subfit_learn.hpp"
+#include "strata/core/subfit_rule.hpp"
+
+#include <cmath>
+#include <cstdio>
+#include <limits>
+#include <random>
+#include <vector>
+
+using namespace strata::core::subfit_learn;
+namespace rule = strata::core::subfit_rule;
+
+namespace {
+
+int failures = 0;
+
+#define CHECK(cond, msg)                                                       \
+    do {                                                                       \
+        if (!(cond)) {                                                         \
+            std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, msg); \
+            ++failures;                                                        \
+        }                                                                      \
+    } while (0)
+
+constexpr int N = 32, R = 16, NL = 2;
+constexpr float kInf = std::numeric_limits<float>::infinity();
+
+// the learner test's synthetic world: y_e = c y_s + Bt z (+ noise), z = A_l x with the learner's own features
+struct World {
+    std::mt19937 g;
+    std::vector<float> A;
+    std::vector<float> Bt;
+    World(uint32_t seed, float bscale) : g(seed), Bt((size_t) N * R) {
+        features(0, N, R, 1, A);
+        std::normal_distribution<float> nd(0.0f, 1.0f);
+        for (float& v : Bt) v = bscale * nd(g);
+    }
+    void sample(std::vector<float>& x, std::vector<float>& ys) {
+        std::normal_distribution<float> nd(0.0f, 1.0f);
+        x.resize(N);
+        ys.resize(N);
+        for (float& v : x) v = nd(g);
+        for (float& v : ys) v = nd(g);
+    }
+    void make_ye(const std::vector<float>& x, const std::vector<float>& ys, float c, bool noise, float sign, std::vector<float>& ye) {
+        std::normal_distribution<float> nd(0.0f, 1.0f);
+        ye.assign(N, 0.0f);
+        if (noise) {
+            for (float& v : ye) v = nd(g);
+            return;
+        }
+        std::vector<float> z(R, 0.0f);
+        for (int k = 0; k < R; ++k)
+            for (int j = 0; j < N; ++j) z[(size_t) k] += A[(size_t) k * N + j] * x[(size_t) j];
+        for (int j = 0; j < N; ++j) {
+            float acc = c * ys[(size_t) j] + 0.02f * nd(g);
+            for (int k = 0; k < R; ++k) acc += Bt[(size_t) j * R + k] * z[(size_t) k];
+            ye[(size_t) j] = sign * acc;
+        }
+    }
+};
+
+Config cfg() {
+    Config c;
+    c.ladder = false;   // these tests cover the pair level alone (subfit_ladder_test covers the ladder)
+    c.n = N;
+    c.rank = R;
+    c.max_pairs = 64;
+    c.max_fitted = 512;
+    c.seed = 1;
+    c.n_layers = NL;
+    return c;
+}
+
+Changes request(Learner& L, World& w, int layer, int e, int s, int count, float c, bool noise, float sign = 1.0f) {
+    std::vector<float> x, ys, ye;
+    for (int i = 0; i < count; ++i) {
+        w.sample(x, ys);
+        w.make_ye(x, ys, c, noise, sign, ye);
+        L.add_sample(layer, e, s, x.data(), ys.data(), ye.data());
+    }
+    return L.refit();
+}
+
+// ---- the shift rule
+void test_rule() {
+    // mode off, no fit: exactly the old cap rule (refused iff shift + plain > cap; a row with no cap never refuses)
+    std::mt19937 g(7);
+    std::uniform_real_distribution<float> u(0.0f, 2.0f);
+    int checked = 0;
+    for (int i = 0; i < 20000; ++i) {
+        const float shift = u(g), plain = u(g), cap = u(g) * 2.0f;
+        for (int capped = 0; capped < 2; ++capped) {
+            const rule::Move m = rule::decide(shift, capped ? cap : kInf, capped != 0, plain, false, 1.0f, rule::kModeOff);
+            const bool old_take = !(capped && shift + plain > cap);
+            CHECK(m.take == old_take, "mode off, no fit: the decision is the old cap rule");
+            CHECK(!m.corrected && (m.take ? m.add == plain : m.add == 0.0f), "mode off: the shift added is plain (0 when refused)");
+            ++checked;
+        }
+    }
+    // a fitted pair in mode off is not corrected either (the mode is the switch)
+    CHECK(!rule::decide(0.0f, 0.5f, true, 9.0f, true, 0.3f, rule::kModeOff).corrected, "mode off ignores the fit");
+    CHECK(!rule::decide(0.0f, 0.5f, true, 9.0f, true, 0.3f, rule::kModeOff).take, "mode off: a fitted move past the cap is still refused");
+    // mode flip: corrected only in the flip re-check's window; outside it the move is exactly as mode off
+    CHECK(rule::decide(0.0f, kInf, false, 2.0f, true, 0.3f, rule::kModeFlip, true).corrected, "flip: a fitted move in the re-check window is corrected");
+    CHECK(std::fabs(rule::decide(0.0f, kInf, false, 2.0f, true, 0.3f, rule::kModeFlip, true).add - 0.6f) < 1e-6f, "flip: its shift is plain x resid");
+    CHECK(!rule::decide(0.0f, kInf, false, 2.0f, true, 0.3f, rule::kModeFlip, false).corrected, "flip: outside the window the move is plain");
+    CHECK(!rule::decide(0.0f, kInf, false, 2.0f, false, 1.0f, rule::kModeFlip, true).corrected, "flip: an unfitted move is never corrected");
+    CHECK(!rule::decide(0.0f, 0.5f, true, 9.0f, true, 0.3f, rule::kModeFlip, false).take, "flip: outside the window the cap refuses as mode off");
+
+    // dynamic: under the cap, a fitted move is plain; past the cap it is taken corrected, adding plain x resid
+    rule::Move m = rule::decide(0.1f, 1.0f, true, 0.4f, true, 0.25f, rule::kModeDynamic);
+    CHECK(m.take && !m.corrected && m.add == 0.4f, "dynamic: under the cap a fitted move is plain");
+    m = rule::decide(0.8f, 1.0f, true, 0.4f, true, 0.25f, rule::kModeDynamic);
+    CHECK(m.take && m.corrected && std::fabs(m.add - 0.1f) < 1e-6f, "dynamic: past the cap a fitted move is corrected, adds plain x resid");
+    // dynamic: past the cap, a pair with no fit is refused (today's behaviour)
+    m = rule::decide(0.8f, 1.0f, true, 0.4f, false, 1.0f, rule::kModeDynamic);
+    CHECK(!m.take && !m.corrected && m.add == 0.0f, "dynamic: past the cap an unfitted pair is refused");
+    // dynamic, uncapped row: nothing is refused and nothing is corrected
+    m = rule::decide(5.0f, kInf, false, 0.4f, true, 0.25f, rule::kModeDynamic);
+    CHECK(m.take && !m.corrected && m.add == 0.4f, "dynamic: an uncapped row takes the move plain");
+
+    // all: every fitted move is taken corrected, no cap test; an unfitted one keeps the cap
+    m = rule::decide(0.0f, 0.5f, true, 0.4f, true, 0.5f, rule::kModeAll);
+    CHECK(m.take && m.corrected && std::fabs(m.add - 0.2f) < 1e-6f, "all: a fitted move under the cap is corrected");
+    m = rule::decide(9.0f, 0.5f, true, 0.4f, true, 0.5f, rule::kModeAll);
+    CHECK(m.take && m.corrected, "all: a fitted move past the cap is corrected, not refused");
+    m = rule::decide(9.0f, 0.5f, true, 0.4f, false, 0.5f, rule::kModeAll);
+    CHECK(!m.take, "all: an unfitted move past the cap is refused");
+    m = rule::decide(0.0f, kInf, false, 0.4f, true, 0.5f, rule::kModeAll);
+    CHECK(m.take && m.corrected, "all: a fitted move on an uncapped row is corrected");
+    std::printf("shift rule: %d old-rule cases agree\n", checked);
+}
+
+// ---- the packer, through a real learner
+void test_packer() {
+    Learner L(cfg());
+    UploadPacker P(NL);
+    World learn(11, 0.5f), flip(11, 0.5f);
+
+    // a fresh packer's mirror is all -1 and the counts are 0
+    CHECK(P.lut().size() == table_size(NL), "packer: the mirror holds the three levels (pairs, experts, layers)");
+    CHECK(P.lut()[UploadPacker::lut_index(1, 511, 511)] == -1, "packer: a fresh mirror is -1");
+    CHECK(P.fit_n()[0] == 0 && P.fit_n()[1] == 0, "packer: a fresh count is 0");
+    CHECK(UploadPacker::lut_index(1, 2, 3) == ((size_t) 1 * 512 + 2) * 512 + 3, "packer: the index is (layer*512+e)*512+s");
+
+    // fit (0, 1, 2) over two requests; the packer's writes carry the slot's fp16 B and c and the residual
+    request(L, learn, 0, 1, 2, 100, 0.8f, false);
+    Changes c2 = request(L, learn, 0, 1, 2, 100, 0.8f, false);
+    CHECK(L.fitted(0, 1, 2), "packer test: the pair fits");
+    std::vector<LutWrite> lw;
+    std::vector<SlotWrite> sw;
+    P.pack(c2, lw, sw);
+    CHECK(!lw.empty() && !sw.empty(), "packer: the fit gives LUT writes and a slot write");
+    const int slot = L.lookup(0, 1, 2);
+    CHECK(P.lut()[UploadPacker::lut_index(0, 1, 2)] == slot, "packer: the mirror holds the learner's slot for the pair");
+    CHECK(P.fit_n()[0] == 1 && P.fit_n()[1] == 0, "packer: the fitted count of layer 0 is 1");
+    bool saw_lut = false;
+    for (const LutWrite& w : lw)
+        if (w.index == UploadPacker::lut_index(0, 1, 2) && w.value == slot) saw_lut = true;
+    CHECK(saw_lut, "packer: the LUT write is (index of (0,1,2), slot)");
+    const SlotWrite* s0 = nullptr;
+    for (const SlotWrite& w : sw)
+        if (w.slot == slot) s0 = &w;
+    CHECK(s0 != nullptr && !s0->freed, "packer: the fitted slot is written, not freed");
+    if (s0 != nullptr) {
+        const std::vector<float>* B = L.pair_b(0, 1, 2);
+        CHECK(B != nullptr && s0->b.size() == (size_t) N * R, "packer: the slot's B is N x r");
+        bool same = B != nullptr && s0->b.size() == B->size();
+        for (size_t i = 0; same && i < B->size(); ++i) same = s0->b[i] == f32_to_f16((*B)[i]);
+        CHECK(same, "packer: the slot's B is the learner's B in fp16");
+        double c_used = 0, c_raw = 0, gain = 0;
+        bool is_fit = false;
+        L.pair_info(0, 1, 2, c_used, c_raw, gain, is_fit);
+        CHECK(std::fabs(s0->c - (float) c_used) < 1e-6f, "packer: the slot's c is the pair's used scalar");
+        CHECK(s0->resid > 0.0f && s0->resid < 1.0f, "packer: the residual factor is in (0, 1) for a fitted pair");
+        CHECK(std::fabs(s0->resid - std::sqrt(1.0 - gain)) < 1e-5, "packer: the residual is sqrt(1 - held-out gain)");
+    }
+
+    // the mirror equals the learner's lookup on every key of the layers (the learner is the reference)
+    bool mirror_ok = true;
+    for (int l = 0; l < NL; ++l)
+        for (int e = 0; e < 512; ++e)
+            for (int s = 0; s < 512; ++s)
+                if (P.lut()[UploadPacker::lut_index(l, e, s)] != (int16_t) L.lookup(l, e, s)) mirror_ok = false;
+    CHECK(mirror_ok, "packer: the mirror equals the learner's lookup for every key");
+
+    // all_fitted() of a fresh packer gives the same state (the upload at start after a load)
+    UploadPacker P2(NL);
+    std::vector<LutWrite> lw2;
+    std::vector<SlotWrite> sw2;
+    P2.pack(L.all_fitted(), lw2, sw2);
+    CHECK(P2.lut() == P.lut() && P2.fit_n() == P.fit_n(), "packer: the full upload gives the same mirror and counts");
+
+    // revoke: the map flips, the pair is freed; its LUT entry goes back to -1, its count to 0, and the slot is written freed
+    Changes c3 = request(L, flip, 0, 1, 2, 100, 0.8f, false, -1.0f);
+    if (!L.fitted(0, 1, 2)) {
+        std::vector<LutWrite> lw3;
+        std::vector<SlotWrite> sw3;
+        P.pack(c3, lw3, sw3);
+        CHECK(P.lut()[UploadPacker::lut_index(0, 1, 2)] == -1, "packer: a revoked pair's LUT entry is -1");
+        CHECK(P.fit_n()[0] == 0, "packer: a revoked pair leaves the layer's count at 0");
+        bool freed = false;
+        for (const SlotWrite& w : sw3)
+            if (w.freed && w.slot == slot) freed = true;
+        CHECK(freed, "packer: the freed slot is written as freed (no B)");
+    } else {
+        std::fprintf(stderr, "note: the revoke did not happen in this run; the freed-slot check was skipped\n");
+    }
+
+    // out-of-range changes are dropped, not written
+    Changes bad;
+    bad.lut.push_back(LutChange{NL, 0, 0, 3});
+    bad.lut.push_back(LutChange{0, 512, 0, 3});
+    std::vector<LutWrite> lw4;
+    std::vector<SlotWrite> sw4;
+    P.pack(bad, lw4, sw4);
+    CHECK(lw4.empty(), "packer: out-of-range LUT changes are dropped");
+}
+
+// ---- the feature matrix as the device reads it
+void test_features_f16() {
+    Learner L(cfg());
+    const std::vector<uint16_t> h = L.features_f16(1);
+    std::vector<float> A;
+    features(1, N, R, 1, A);
+    CHECK(h.size() == A.size() && h.size() == (size_t) N * R, "features_f16: r x N values");
+    bool same = h.size() == A.size();
+    for (size_t i = 0; same && i < A.size(); ++i) same = h[i] == f32_to_f16(A[i]);
+    CHECK(same, "features_f16: the learner's features in fp16");
+}
+
+}  // namespace
+
+int main() {
+    test_rule();
+    test_packer();
+    test_features_f16();
+    if (failures == 0) std::printf("subfit_apply_host_test: all checks passed\n");
+    return failures == 0 ? 0 : 1;
+}
diff --git a/tests/core/subfit_ladder_test.cpp b/tests/core/subfit_ladder_test.cpp
new file mode 100644
index 000000000..cee4772ea
--- /dev/null
+++ b/tests/core/subfit_ladder_test.cpp
@@ -0,0 +1,224 @@
+// tests/core/subfit_ladder_test.cpp - SPEC-substitute-fit stage 2, the fallback ladder and the shadow-sample queue, CPU only.
+// Covers: a layer group fits while every pair is thin and a never-seen pair then uses the layer's slot; a (layer, expert) group is
+// used before the layer's; a dense pair uses its own slot first; nothing is used when nothing fits (noise); the packer writes the
+// expert and layer slots into their regions; save/load keeps the ladder; the queue evaluates in the background, counts failures,
+// drops without an evaluator and past its cap.
+#include "strata/core/subfit_learn.hpp"
+#include "strata/core/subfit_shadow.hpp"
+
+#include <cmath>
+#include <cstdio>
+#include <filesystem>
+#include <random>
+#include <string>
+#include <vector>
+
+using namespace strata::core::subfit_learn;
+namespace sh = strata::core::subfit_shadow;
+
+namespace {
+
+int failures = 0;
+#define CHECK(cond, msg)                                                       \
+    do {                                                                       \
+        if (!(cond)) {                                                         \
+            std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, msg); \
+            ++failures;                                                        \
+        }                                                                      \
+    } while (0)
+
+constexpr int N = 32, R = 16, NL = 2;
+
+Config cfg() {
+    Config c;
+    c.n = N;
+    c.rank = R;
+    c.n_layers = NL;
+    c.max_pairs = 64;
+    c.max_experts = 64;
+    return c;
+}
+
+// y_e = c y_s + B z(x) + small noise, with z the learner's own features of layer `l` (a learnable map), or pure noise
+struct Map {
+    std::vector<float> A, B;   // A: R x N (layer's features), B: N x R
+    float c;
+    Map(int layer, uint32_t seed, float c_) : B((size_t) N * R), c(c_) {
+        features(layer, N, R, 1, A);
+        std::mt19937 g(seed);
+        std::normal_distribution<float> nd(0.0f, 1.0f);
+        for (float& v : B) v = 2.0f * nd(g);
+    }
+    void make(std::mt19937& g, std::vector<float>& x, std::vector<float>& ys, std::vector<float>& ye, bool noise) const {
+        std::normal_distribution<float> nd(0.0f, 1.0f);
+        x.resize(N); ys.resize(N); ye.assign(N, 0.0f);
+        for (float& v : x) v = nd(g);
+        for (float& v : ys) v = nd(g);
+        if (noise) { for (float& v : ye) v = nd(g); return; }
+        std::vector<float> z(R, 0.0f);
+        for (int k = 0; k < R; ++k)
+            for (int j = 0; j < N; ++j) z[(size_t) k] += A[(size_t) k * N + j] * x[(size_t) j];
+        for (int j = 0; j < N; ++j) {
+            float v = c * ys[(size_t) j];
+            for (int k = 0; k < R; ++k) v += B[(size_t) j * R + k] * z[(size_t) k];
+            ye[(size_t) j] = v + 0.01f * nd(g);
+        }
+    }
+};
+
+void test_layer_fits_while_pairs_thin() {
+    Learner L(cfg());
+    Map m(0, 7, 0.8f);
+    std::mt19937 g(1);
+    std::vector<float> x, ys, ye;
+    // 400 samples spread over 400 different (e, s) pairs: every pair has 1 sample, the layer group has 400
+    for (int i = 0; i < 400; ++i) {
+        m.make(g, x, ys, ye, false);
+        L.add_sample(0, i % 200, 200 + (i % 300) % 300, x.data(), ys.data(), ye.data());
+        if (i % 50 == 49) L.refit();
+    }
+    L.refit();
+    CHECK(L.level_used(0, 5, 401) == 2, "a never-seen pair uses its layer's slot when only the layer group fits");
+    CHECK(L.lookup(0, 5, 401) >= 0, "the layer's slot is a real slot");
+    CHECK(L.level_used(1, 5, 401) == -1, "another layer (no samples) has no slot");
+    const Summary s = L.summary();
+    CHECK(s.fitted_lv[2] == 1 && s.fitted_lv[0] == 0, "one layer group fitted, no pair fitted");
+}
+
+void test_expert_before_layer_and_pair_first() {
+    Learner L(cfg());
+    Map m(0, 11, 0.5f);
+    std::mt19937 g(2);
+    std::vector<float> x, ys, ye;
+    // expert 3: 300 samples over many substitutes (its group fits); pair (3, 300): 200 of them (fits too); the layer group sees all
+    for (int i = 0; i < 300; ++i) {
+        m.make(g, x, ys, ye, false);
+        const int s = i < 200 ? 300 : 301 + i % 10;   // (10 other substitutes: the pair cap must not evict the dense pair)
+        L.add_sample(0, 3, s % 512, x.data(), ys.data(), ye.data());
+        if (i % 25 == 24) L.refit();
+    }
+    L.refit();
+    CHECK(L.level_used(0, 3, 300) == 0, "a dense fitted pair uses its own slot");
+    CHECK(L.level_used(0, 3, 50) == 1, "an unseen substitute of a fitted expert group uses the expert's slot before the layer's");
+    CHECK(L.level_used(0, 9, 50) == 2, "another expert falls back to the layer's slot");
+    CHECK(L.lookup(0, 3, 300) != L.lookup(0, 3, 50), "pair and expert slots differ");
+}
+
+void test_noise_uses_nothing() {
+    Learner L(cfg());
+    Map m(0, 13, 0.0f);
+    std::mt19937 g(3);
+    std::vector<float> x, ys, ye;
+    for (int i = 0; i < 400; ++i) {
+        m.make(g, x, ys, ye, true);
+        L.add_sample(0, i % 20, 100 + i % 7, x.data(), ys.data(), ye.data());
+    }
+    L.refit();
+    CHECK(L.level_used(0, 1, 101) == -1, "no level is used when nothing fits (noise)");
+    CHECK(L.summary().fitted == 0, "nothing fitted on noise");
+}
+
+void test_packer_regions_and_persistence() {
+    UploadPacker P(NL);
+    Changes ch;
+    ch.lut.push_back(LutChange{1, 7, kAny, 5});
+    ch.lut.push_back(LutChange{1, kAny, kAny, 6});
+    ch.lut.push_back(LutChange{0, 2, 3, 4});
+    std::vector<LutWrite> lw;
+    std::vector<SlotWrite> sw;
+    P.pack(ch, lw, sw);
+    CHECK(lw.size() == 3, "three LUT writes");
+    CHECK(lw[0].index == (size_t) NL * 512 * 512 + 1 * 512 + 7, "the expert slot's index is in the expert region");
+    CHECK(lw[1].index == (size_t) NL * 512 * 512 + (size_t) NL * 512 + 1, "the layer slot's index is in the layer region");
+    CHECK(lw[2].index == ((size_t) 0 * 512 + 2) * 512 + 3, "the pair's index is unchanged");
+    CHECK(P.fit_n()[1] == 2 && P.fit_n()[0] == 1, "fitted counts per layer include the expert and layer slots");
+    CHECK(table_size(NL) == (size_t) NL * 512 * 512 + (size_t) NL * 512 + (size_t) NL, "table size");
+
+    Learner L(cfg());
+    Map m(1, 17, 0.7f);
+    std::mt19937 g(4);
+    std::vector<float> x, ys, ye;
+    for (int i = 0; i < 400; ++i) {
+        m.make(g, x, ys, ye, false);
+        L.add_sample(1, i % 150, 300 + i % 100, x.data(), ys.data(), ye.data());
+        if (i % 25 == 24) L.refit();
+    }
+    L.refit();
+    const int lv = L.level_used(1, 4, 499), slot = L.lookup(1, 4, 499);
+    CHECK(lv >= 1, "a pooled level fitted before saving");
+    const std::string path = (std::filesystem::temp_directory_path() / "subfit_ladder_test.bin").string();
+    std::string err;
+    CHECK(L.save(path, 42, err), "save");
+    Learner L2(cfg());
+    CHECK(L2.load(path, 42, err), err.c_str());
+    CHECK(L2.level_used(1, 4, 499) == lv && L2.lookup(1, 4, 499) == slot, "the ladder survives save/load");
+    std::filesystem::remove(path);
+}
+
+void test_pair_admission() {
+    Config c = cfg();
+    c.pair_min_seen = 5;
+    Learner L(c);
+    Map m(0, 21, 0.6f);
+    std::mt19937 g(9);
+    std::vector<float> x, ys, ye;
+    for (int i = 0; i < 4; ++i) { m.make(g, x, ys, ye, false); L.add_sample(0, 1, 2, x.data(), ys.data(), ye.data()); }
+    double cu, cr, gn; bool f;
+    CHECK(!L.pair_info(0, 1, 2, cu, cr, gn, f), "a pair seen 4 times (min 5) has no group yet");
+    CHECK(L.pair_info(0, 1, kAny, cu, cr, gn, f), "its expert group learns from the start");
+    m.make(g, x, ys, ye, false); L.add_sample(0, 1, 2, x.data(), ys.data(), ye.data());
+    CHECK(L.pair_info(0, 1, 2, cu, cr, gn, f), "the 5th sighting admits the pair");
+}
+
+void test_queue() {
+    sh::Queue q;
+    sh::Item it;
+    it.layer = 1; it.e = 2; it.s = 3;
+    it.x.assign(N, 1.5f);
+    it.ye.assign(N, 0.0f);
+    q.push(sh::Item(it));
+    CHECK(q.take_stats().dropped == 1, "without an evaluator an item is dropped");
+    q.set_eval([](int layer, int s, const float* x, float* ys) {
+        if (s == 99) return false;
+        for (int j = 0; j < N; ++j) ys[j] = 2.0f * x[j] + (float) layer;
+        return true;
+    }, false);
+    for (int i = 0; i < 10; ++i) q.push(sh::Item(it));
+    sh::Item bad = it;
+    bad.s = 99;
+    q.push(std::move(bad));
+    CHECK(q.drain_for_tests(5000), "the worker drains the queue");
+    const auto done = q.take_done();
+    CHECK(done.size() == 10, "ten finished samples");
+    CHECK(!done.empty() && std::fabs(done[0].ys[0] - 4.0f) < 1e-6f, "the evaluator's y_s is kept");
+    const sh::Stats st = q.take_stats();
+    CHECK(st.queued == 11 && st.evaluated == 10 && st.failed == 1, "queued / evaluated / failed counts");
+    sh::Item ny = it;
+    ny.need_ye = true;
+    ny.ye.clear();
+    q.push(std::move(ny));
+    CHECK(q.drain_for_tests(5000), "drains the y_e item");
+    const auto d2 = q.take_done();
+    CHECK(d2.size() == 1 && d2[0].ye.size() == (size_t) N && std::fabs(d2[0].ye[0] - 4.0f) < 1e-6f, "need_ye: the worker computes y_e = e(x) too");
+    CHECK(!sh::cpu_ye_env(nullptr) && sh::cpu_ye_env("1") && !sh::cpu_ye_env("0"), "cpu y_e env: off by default");
+    q.set_paused(true);
+    q.push(sh::Item(it));
+    CHECK(!q.drain_for_tests(200), "paused: the item waits");
+    q.set_paused(false);
+    CHECK(q.drain_for_tests(5000), "resumed: the item is evaluated");
+    CHECK(q.take_done().size() == 1, "one finished after the resume");
+    CHECK(sh::per_cut_env(nullptr) == sh::kDefaultPerCut && sh::per_cut_env("0") == 0 && sh::per_cut_env("999") == 256, "env");
+}
+
+}  // namespace
+
+int main() {
+    test_layer_fits_while_pairs_thin();
+    test_expert_before_layer_and_pair_first();
+    test_noise_uses_nothing();
+    test_packer_regions_and_persistence();
+    test_pair_admission();
+    test_queue();
+    if (failures == 0) std::printf("subfit_ladder_test: all checks passed\n");
+    return failures == 0 ? 0 : 1;
+}
diff --git a/tests/core/subfit_learn_test.cpp b/tests/core/subfit_learn_test.cpp
new file mode 100644
index 000000000..2e505fa08
--- /dev/null
+++ b/tests/core/subfit_learn_test.cpp
@@ -0,0 +1,302 @@
+// tests/core/subfit_learn_test.cpp - SPEC-substitute-fit stage 2, step 1: the live learner, CPU only.
+// Covers: env parsing, fp16 round trip, the feature matrix, the streaming ridge (recovers a known B, exactly at lambda 0 and within
+// the shrinkage at 0.1), the held-out gate (a learnable pair fits, a noise pair is refused, a pair whose map changes is revoked),
+// eviction (least recently sampled, a fitted victim frees its slot), the slot cap and the lookup table, and the save/load round trip.
+#include "strata/core/subfit_learn.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <filesystem>
+#include <functional>
+#include <random>
+#include <string>
+#include <vector>
+
+using namespace strata::core::subfit_learn;
+
+namespace {
+
+int failures = 0;
+
+#define CHECK(cond, msg)                                                       \
+    do {                                                                       \
+        if (!(cond)) {                                                         \
+            std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, msg); \
+            ++failures;                                                        \
+        }                                                                      \
+    } while (0)
+
+constexpr int N = 32, R = 16, NL = 2;
+
+// A synthetic world: y_e = c * y_s + Bt z (+ noise), z = A_l x with the learner's own features.
+struct World {
+    std::mt19937 g;
+    std::vector<float> A;        // R x N, the learner's features of layer 0
+    std::vector<float> Bt;       // N x R, the true correction
+    World(uint32_t seed, float bscale) : g(seed), Bt((size_t) N * R) {
+        features(0, N, R, 1, A);
+        std::normal_distribution<float> nd(0.0f, 1.0f);
+        for (float& v : Bt) v = bscale * nd(g);
+    }
+    void sample(std::vector<float>& x, std::vector<float>& ys) {
+        std::normal_distribution<float> nd(0.0f, 1.0f);
+        x.resize(N);
+        ys.resize(N);
+        for (float& v : x) v = nd(g);
+        for (float& v : ys) v = nd(g);
+    }
+    std::vector<float> z(const std::vector<float>& x) const {
+        std::vector<float> out(R, 0.0f);
+        for (int k = 0; k < R; ++k)
+            for (int j = 0; j < N; ++j) out[(size_t) k] += A[(size_t) k * N + j] * x[(size_t) j];
+        return out;
+    }
+};
+
+// y_e = sign * (c y_s + Bt z + small noise) for the learnable map (sign -1 is a map that changes sign), or independent noise
+void make_ye(World& w, const std::vector<float>& x, const std::vector<float>& ys, float c, bool noise, float sign, std::vector<float>& ye) {
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+    ye.assign(N, 0.0f);
+    if (noise) {
+        for (float& v : ye) v = nd(w.g);
+        return;
+    }
+    const std::vector<float> z = w.z(x);
+    for (int j = 0; j < N; ++j) {
+        float acc = c * ys[(size_t) j] + 0.02f * nd(w.g);
+        for (int k = 0; k < R; ++k) acc += w.Bt[(size_t) j * R + k] * z[(size_t) k];
+        ye[(size_t) j] = sign * acc;
+    }
+}
+
+Config cfg(int max_pairs = 64, int max_fitted = 512) {
+    Config c;
+    c.ladder = false;   // these tests cover the pair level alone (subfit_ladder_test covers the ladder)
+    c.n = N;
+    c.rank = R;
+    c.max_pairs = max_pairs;
+    c.max_fitted = max_fitted;
+    c.seed = 1;
+    c.n_layers = NL;
+    return c;
+}
+
+// one request: `count` samples of a pair, then the request end's refit
+Changes request(Learner& L, World& w, int layer, int e, int s, int count, float c, bool noise, float sign = 1.0f) {
+    std::vector<float> x, ys, ye;
+    for (int i = 0; i < count; ++i) {
+        w.sample(x, ys);
+        make_ye(w, x, ys, c, noise, sign, ye);
+        L.add_sample(layer, e, s, x.data(), ys.data(), ye.data());
+    }
+    return L.refit();
+}
+
+void test_env_and_fp16() {
+    CHECK(apply_env(nullptr) == Apply::Dynamic, "apply unset: dynamic");
+    CHECK(apply_env("off") == Apply::Off && apply_env("all") == Apply::All && apply_env("dynamic") == Apply::Dynamic, "apply names");
+    CHECK(apply_env("bogus") == Apply::Dynamic, "apply other value: dynamic");
+    CHECK(std::string(apply_name(Apply::All)) == "all", "apply name");
+    CHECK(rank_env(nullptr) == 16 && rank_env("8") == 8 && rank_env("0") == 16 && rank_env("99") == 32, "rank env");
+    CHECK(pairs_env(nullptr) == kDefaultPairs && pairs_env("64") == 64 && pairs_env("-1") == kDefaultPairs, "pairs env");
+    CHECK(!ladder_env(nullptr) && ladder_env("1") && !ladder_env("0"), "ladder env: off unless =1 (pairs only by default)");
+    CHECK(f16_to_f32(f32_to_f16(1.0f)) == 1.0f && f16_to_f32(f32_to_f16(-2.5f)) == -2.5f, "fp16 exact values");
+    CHECK(f16_to_f32(f32_to_f16(0.0f)) == 0.0f, "fp16 zero");
+    bool rel_ok = true;
+    for (int i = 1; i < 4000; ++i) {
+        const float v = std::sin((float) i) * std::pow(10.0f, (float) (i % 9) - 4.0f);
+        const float b = f16_to_f32(f32_to_f16(v));
+        if (std::fabs(b - v) > std::fabs(v) * (1.0f / 1024.0f) + 1e-7f) rel_ok = false;   // half an ulp: 2^-11 relative for normals
+    }
+    CHECK(rel_ok, "fp16 round trip within 2^-11 relative (normal range)");
+    CHECK(std::isinf(f16_to_f32(f32_to_f16(1e6f))), "fp16 overflow goes to infinity");
+    const float sub = f16_to_f32(f32_to_f16(3.0e-6f));
+    CHECK(sub > 0.0f && std::fabs(sub - 3.0e-6f) < 6e-8f, "fp16 subnormal close to the input");
+}
+
+void test_features() {
+    std::vector<float> a, b, c;
+    features(3, N, R, 7, a);
+    features(3, N, R, 7, b);
+    features(4, N, R, 7, c);
+    CHECK(a == b, "features: deterministic for a layer and seed");
+    CHECK(a != c, "features: different layers differ");
+    double ms = 0.0;
+    for (float v : a) ms += (double) v * (double) v;
+    ms /= (double) a.size();
+    CHECK(std::fabs(ms * N - 1.0) < 0.15, "features: entries scaled so E[a^2] = 1/N");
+}
+
+void test_ridge_recovers_b() {
+    World w(5, 0.5f);
+    const float c_true = 0.8f;
+    std::vector<double> ZtZ((size_t) R * R, 0.0);
+    std::vector<float> ZtYe((size_t) R * N, 0.0f), ZtYs((size_t) R * N, 0.0f);
+    std::vector<float> x, ys, ye;
+    for (int i = 0; i < 3000; ++i) {
+        w.sample(x, ys);
+        make_ye(w, x, ys, c_true, false, 1.0f, ye);
+        // (the 0.02 noise of make_ye is part of the data here: the exact-recovery bound is loose enough for it)
+        const std::vector<float> z = w.z(x);
+        for (int k = 0; k < R; ++k) {
+            for (int m = 0; m < R; ++m) ZtZ[(size_t) k * R + m] += (double) z[k] * (double) z[m];
+            for (int j = 0; j < N; ++j) {
+                ZtYe[(size_t) k * N + j] += z[k] * ye[(size_t) j];
+                ZtYs[(size_t) k * N + j] += z[k] * ys[(size_t) j];
+            }
+        }
+    }
+    // exact at lambda 0: the target is exactly B_true z
+    std::vector<float> B;
+    CHECK(ridge_solve(ZtZ.data(), ZtYe.data(), ZtYs.data(), c_true, R, N, 0.0, B), "ridge at lambda 0 solves");
+    double err = 0.0, den = 0.0;
+    for (size_t i = 0; i < B.size(); ++i) {
+        err += (double) (B[i] - w.Bt[i]) * (double) (B[i] - w.Bt[i]);
+        den += (double) w.Bt[i] * (double) w.Bt[i];
+    }
+    CHECK(std::sqrt(err / den) < 1e-3, "ridge recovers the known B (relative error < 1e-3 at lambda 0)");
+    // with the learner's lambda (0.1 trace / r) the solution must satisfy the regularised normal equations exactly:
+    // (ZtZ + lam I) b_j = T_j for every output j, where T_j = ZtYe_j - c ZtYs_j (the fit is shrunk, so B itself is not Bt)
+    std::vector<float> Bs;
+    CHECK(ridge_solve(ZtZ.data(), ZtYe.data(), ZtYs.data(), c_true, R, N, 0.1, Bs), "ridge at lambda 0.1 solves");
+    double trace = 0.0;
+    for (int k = 0; k < R; ++k) trace += ZtZ[(size_t) k * R + k];
+    const double lam = 0.1 * trace / R;
+    double worst = 0.0, scale = 0.0;
+    for (int j = 0; j < N; ++j) {
+        for (int k = 0; k < R; ++k) {
+            double lhs = lam * (double) Bs[(size_t) j * R + k], rhs = 0.0;
+            for (int m = 0; m < R; ++m) lhs += ZtZ[(size_t) k * R + m] * (double) Bs[(size_t) j * R + m];
+            rhs = (double) ZtYe[(size_t) k * N + j] - c_true * (double) ZtYs[(size_t) k * N + j];
+            worst = std::max(worst, std::fabs(lhs - rhs));
+            scale = std::max(scale, std::fabs(rhs));
+        }
+    }
+    CHECK(worst <= 1e-4 * scale, "ridge at lambda 0.1 satisfies (ZtZ + lam I) B = T (normal equations)");
+    // no samples: no fit
+    std::vector<double> zero((size_t) R * R, 0.0);
+    std::vector<float> none;
+    CHECK(!ridge_solve(zero.data(), ZtYe.data(), ZtYs.data(), c_true, R, N, 0.1, none), "ridge with no statistics refuses");
+}
+
+void test_gate() {
+    Learner L(cfg());
+    World learn(11, 0.5f), noise_w(12, 0.0f), flip(11, 0.5f);
+    // learnable pair (0, 1, 2): fitted after two requests of 25 held-out samples each (the second request's gate sees 32)
+    Changes c1 = request(L, learn, 0, 1, 2, 100, 0.8f, false);
+    CHECK(!L.fitted(0, 1, 2), "learnable pair: not fitted before the gate has 32 held-out samples");
+    (void) c1;
+    Changes c2 = request(L, learn, 0, 1, 2, 100, 0.8f, false);
+    CHECK(L.fitted(0, 1, 2), "learnable pair: fitted after its held-out gain passes 0.20");
+    CHECK(L.lookup(0, 1, 2) >= 0, "learnable pair: has a device slot");
+    double c_used = 0, c_raw = 0, gain = 0;
+    bool is_fit = false;
+    CHECK(L.pair_info(0, 1, 2, c_used, c_raw, gain, is_fit), "pair info");
+    CHECK(std::fabs(c_raw - 0.8) < 0.1 && std::fabs(c_used - 0.8) < 0.1, "learnable pair: the scalar recovers 0.8");
+    CHECK(gain >= 0.20, "learnable pair: the recent held-out gain is at least 0.20");
+    bool slot_change_seen = false;
+    for (const SlotChange& sc : c2.slots)
+        if (sc.slot >= 0 && sc.layer == 0 && sc.e == 1 && sc.s == 2 && sc.b.size() == (size_t) N * R) slot_change_seen = true;
+    CHECK(slot_change_seen, "the fitted pair's slot is uploaded with its fp16 B (N x r)");
+
+    // noise pair (0, 3, 4): its held-out gain stays below the bar, so it is refused
+    for (int i = 0; i < 3; ++i) request(L, noise_w, 0, 3, 4, 100, 0.0f, true);
+    CHECK(!L.fitted(0, 3, 4), "noise pair: refused (held-out gain below 0.20)");
+    CHECK(L.lookup(0, 3, 4) == -1, "noise pair: no slot");
+
+    // revoke: the learnable pair's map changes sign; its held-out samples (scored by the old fit) fall below 0.10
+    request(L, flip, 0, 1, 2, 100, 0.8f, false, -1.0f);
+    CHECK(!L.fitted(0, 1, 2), "a pair whose map changes is revoked");
+    CHECK(L.lookup(0, 1, 2) == -1, "a revoked pair frees its slot");
+}
+
+void test_eviction_and_slots() {
+    Learner L(cfg(3, 2));
+    World w(21, 0.5f);
+    request(L, w, 0, 10, 11, 60, 1.0f, false);
+    request(L, w, 0, 10, 12, 60, 1.0f, false);
+    request(L, w, 0, 10, 13, 60, 1.0f, false);
+    CHECK(L.pair_count() == 3, "three pairs kept");
+    // a fourth pair evicts the least recently sampled (10, 11)
+    request(L, w, 0, 10, 14, 4, 1.0f, false);
+    CHECK(L.pair_count() == 3, "the cap holds at three pairs");
+    double c_used = 0, c_raw = 0, gain = 0;
+    bool f = false;
+    CHECK(!L.pair_info(0, 10, 11, c_used, c_raw, gain, f), "the least recently sampled pair is evicted");
+    CHECK(L.pair_info(0, 10, 12, c_used, c_raw, gain, f), "the others stay");
+
+    // slot cap: three learnable pairs, two slots; the third stays fitted and unslotted
+    Learner S(cfg(64, 2));
+    World sw(31, 0.5f);
+    for (int round = 0; round < 3; ++round) {
+        request(S, sw, 1, 5, 6, 100, 0.9f, false);
+        request(S, sw, 1, 5, 7, 100, 0.9f, false);
+        request(S, sw, 1, 5, 8, 100, 0.9f, false);
+    }
+    const Summary sm = S.summary();
+    CHECK(sm.fitted == 3, "three learnable pairs fitted");
+    CHECK(S.slots_used() == 2, "two slots used of two");
+    CHECK(sm.unslotted == 1, "one fitted pair has no slot (the table is full)");
+    int slotted = 0;
+    for (int s = 6; s <= 8; ++s)
+        if (S.lookup(1, 5, s) >= 0) ++slotted;
+    CHECK(slotted == 2, "the lookup gives a slot to two pairs");
+    {
+        std::vector<int> got;
+        for (int s = 6; s <= 8; ++s)
+            if (S.lookup(1, 5, s) >= 0) got.push_back(S.lookup(1, 5, s));
+        CHECK(got.size() == 2 && got[0] != got[1] && got[0] < 2 && got[1] < 2 && got[0] >= 0 && got[1] >= 0,
+              "the two slotted pairs have distinct slots in 0..1");
+    }
+    CHECK(S.lookup(9, 5, 7) == -1 && S.lookup(1, 600, 7) == -1 && S.lookup(-1, 0, 0) == -1, "out-of-range keys give -1");
+    const Changes all = S.all_fitted();
+    CHECK(all.slots.size() == 2 && all.lut.size() == 2, "the full upload carries the slotted pairs");
+}
+
+void test_save_load() {
+    const std::string path = (std::filesystem::temp_directory_path() / "subfit_learn_test.bin").string();
+    std::filesystem::remove(path);
+    std::string err;
+    Learner L(cfg());
+    World w(41, 0.5f);
+    request(L, w, 0, 2, 3, 100, 0.7f, false);
+    request(L, w, 0, 2, 3, 100, 0.7f, false);
+    request(L, w, 1, 4, 5, 60, 0.7f, false);   // not yet fitted (too few held-out samples)
+    CHECK(L.save(path, 77, err), ("save: " + err).c_str());
+    Learner M(cfg());
+    CHECK(!M.load(path, 78, err), "another model's fingerprint is refused");
+    CHECK(M.load(path, 77, err), ("load: " + err).c_str());
+    CHECK(M.fitted(0, 2, 3) == L.fitted(0, 2, 3) && M.fitted(0, 2, 3), "the fit comes back");
+    CHECK(M.lookup(0, 2, 3) == L.lookup(0, 2, 3) && M.lookup(0, 2, 3) >= 0, "the slot comes back");
+    CHECK(M.pair_count() == L.pair_count(), "the pair count comes back");
+    const std::vector<float>* b1 = L.pair_b(0, 2, 3);
+    const std::vector<float>* b2 = M.pair_b(0, 2, 3);
+    CHECK(b1 != nullptr && b2 != nullptr && *b1 == *b2, "B comes back exactly");
+    double c1 = 0, r1 = 0, g1 = 0, c2 = 0, r2 = 0, g2 = 0;
+    bool f1 = false, f2 = false;
+    L.pair_info(1, 4, 5, c1, r1, g1, f1);
+    M.pair_info(1, 4, 5, c2, r2, g2, f2);
+    CHECK(c1 == c2 && r1 == r2 && g1 == g2 && f1 == f2, "the stats of the unfitted pair come back exactly");
+    // a learner loaded from the file keeps learning: the next refit runs without error on the same pair
+    request(M, w, 0, 2, 3, 40, 0.7f, false);
+    CHECK(M.fitted(0, 2, 3), "a loaded fit stays fitted under more samples of the same map");
+    std::filesystem::remove(path);
+}
+
+}  // namespace
+
+int main() {
+    test_env_and_fp16();
+    test_features();
+    test_ridge_recovers_b();
+    test_gate();
+    test_eviction_and_slots();
+    test_save_load();
+    if (failures == 0) {
+        std::printf("subfit_learn_test: all checks passed\n");
+        return 0;
+    }
+    std::fprintf(stderr, "subfit_learn_test: %d check(s) failed\n", failures);
+    return 1;
+}
