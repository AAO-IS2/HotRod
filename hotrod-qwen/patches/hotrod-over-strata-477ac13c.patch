--- /dev/null
+++ b/tools/linkbench/bench.py
@@ -0,0 +1,118 @@
+"""bench.py - accuracy of a running Strata server on GSM8K and HumanEval (10 Oct 2026), for the stand-in / speed trade-off.
+
+Why these two: a one-letter multiple-choice answer is produced by the prompt pass (exact routing), so it would never touch the
+stand-ins; both of these make the model decode a long answer. Greedy (temperature 0). Same questions for every arm
+(fetch_bench.py). Each question's answer, correctness and time are saved so the answers can be READ: a score is a screen,
+never the verdict (SPEC.md 15).
+
+usage: bench.py URL NAME REPEATS MAX_TOKENS     (called by strata_ab.py when AB_TPS points here; REPEATS and MAX_TOKENS ignored)
+env:   BENCH_SETS (default /root/.claude/jobs/743230e4/tmp/bench_sets.json), BENCH_N_GSM, BENCH_N_HE (use the first N)
+"""
+import json, os, subprocess, sys, tempfile, time, urllib.request
+
+url, name = sys.argv[1], sys.argv[2]
+SETS = os.environ.get("BENCH_SETS", "/root/.claude/jobs/743230e4/tmp/bench_sets.json")
+OUT = f"/root/.claude/jobs/743230e4/tmp/bench_{name}.json"   # the arm name decides the file: a thinking run needs its own arm name
+sets = json.load(open(SETS))
+n_gsm = int(os.environ.get("BENCH_N_GSM", len(sets["gsm8k"])))
+n_he = int(os.environ.get("BENCH_N_HE", len(sets["humaneval"])))
+
+
+THINK = os.environ.get("BENCH_THINK") == "1"   # the model thinks (inside <think>) before it answers: the reasoning task, scored on the final answer
+
+
+NO_CAP = 30000   # no limit on an answer's length except the context window (32,768 tokens): the user's rule, an answer ends when the model ends it
+
+
+def ask(prompt, max_tokens=None):
+    body = {"messages": [{"role": "user", "content": prompt}], "max_tokens": NO_CAP, "temperature": 0, "stream": False}
+    if not THINK:
+        body.update({"reasoning_effort": "none", "chat_template_kwargs": {"enable_thinking": False}})
+    headers = {"Content-Type": "application/json"}
+    if os.environ.get("BENCH_API_KEY"):   # a server started with --api-key (21 Oct: the benchmark on the LAN server itself)
+        headers["Authorization"] = "Bearer " + os.environ["BENCH_API_KEY"]
+    req = urllib.request.Request(url + "/v1/chat/completions", data=json.dumps(body).encode(), headers=headers)
+    t0 = time.time()
+    with urllib.request.urlopen(req, timeout=3600) as r:
+        d = json.loads(r.read())
+    # the whole reply is kept (10 Oct 2026: "are these really empty?"): the server files reasoning text under `reasoning_content` and
+    # tool calls under `tool_calls`, so an empty `content` is not yet an empty answer
+    global LAST_RAW
+    LAST_RAW = {"message": d["choices"][0]["message"], "finish_reason": d["choices"][0].get("finish_reason"), "usage": d.get("usage")}
+    return d["choices"][0]["message"]["content"] or "", (d.get("usage") or {}).get("completion_tokens", 0), time.time() - t0
+
+
+LAST_RAW = None
+
+
+def number_after_answer(text):
+    """The number on the last 'Answer:' line (digits, one sign, one point; thousands commas dropped)."""
+    k = text.rfind("Answer:")
+    if k < 0:
+        return None
+    s, out = text[k + len("Answer:"):].strip(), ""
+    for ch in s:
+        if ch.isdigit() or (ch in "-." and not out.count(ch)) or ch == ",":
+            if ch != ",":
+                out += ch
+        elif out:
+            break
+    try:
+        return float(out.rstrip("."))
+    except ValueError:
+        return None
+
+
+def gsm_truth(answer):
+    return float(answer.split("####")[-1].strip().replace(",", ""))
+
+
+def code_block(text):
+    k = text.find("```python")
+    if k < 0:
+        k = text.find("```")
+        if k < 0:
+            return text
+        k += 3
+    else:
+        k += len("```python")
+    e = text.find("```", k)
+    return text[k:e if e >= 0 else len(text)]
+
+
+def run_tests(prompt, code, test, entry):
+    head = "\n".join(l for l in prompt.splitlines() if l.startswith(("import ", "from ")))
+    prog = f"{head}\n{code}\n\n{test}\n\ncheck({entry})\n"
+    with tempfile.TemporaryDirectory() as d:
+        path = os.path.join(d, "t.py")
+        open(path, "w").write(prog)
+        try:
+            p = subprocess.run([sys.executable, "-I", path], cwd=d, capture_output=True, text=True, timeout=20)
+            return p.returncode == 0, p.stderr[-300:]
+        except subprocess.TimeoutExpired:
+            return False, "timeout"
+
+
+res = {"gsm8k": [], "humaneval": []}
+tok = sec = 0.0
+for i, q in enumerate(sets["gsm8k"][:n_gsm]):
+    text, n, dt = ask(q["question"] + "\n\nSolve it step by step, then finish with a final line of the form: Answer: <number>", 700)
+    got, want = number_after_answer(text), gsm_truth(q["answer"])
+    ok = got is not None and abs(got - want) < 1e-6
+    res["gsm8k"].append({"i": i, "ok": ok, "got": got, "want": want, "tokens": n, "s": round(dt, 1), "text": text, "raw": LAST_RAW})
+    tok += n
+    sec += dt
+    print(f"gsm8k {i + 1}/{n_gsm} {'ok' if ok else 'WRONG'} (want {want}, got {got}) {n} tokens {dt:.0f}s", flush=True)
+    json.dump(res, open(OUT, "w"))
+for i, q in enumerate(sets["humaneval"][:n_he]):
+    text, n, dt = ask("Complete the following Python function. Reply with the complete function in one ```python code block.\n\n" + q["prompt"], 700)
+    ok, err = run_tests(q["prompt"], code_block(text), q["test"], q["entry_point"])
+    res["humaneval"].append({"i": i, "task": q["task_id"], "ok": ok, "err": err, "tokens": n, "s": round(dt, 1), "text": text, "raw": LAST_RAW})
+    tok += n
+    sec += dt
+    print(f"humaneval {i + 1}/{n_he} {q['task_id']} {'pass' if ok else 'FAIL'} {n} tokens {dt:.0f}s", flush=True)
+    json.dump(res, open(OUT, "w"))
+g = sum(x["ok"] for x in res["gsm8k"])
+h = sum(x["ok"] for x in res["humaneval"])
+print(f"BENCH {name}: gsm8k {g}/{len(res['gsm8k'])}  humaneval {h}/{len(res['humaneval'])}  "
+      f"{tok / max(sec, 1e-9):.1f} answer tokens/s overall (prompt time included)", flush=True)
diff --git a/tools/linkbench/bench_table.py b/tools/linkbench/bench_table.py
new file mode 100644
index 000000000..41946547f
--- /dev/null
+++ b/tools/linkbench/bench_table.py
@@ -0,0 +1,89 @@
+"""bench_table.py - rebuilds the benchmark scores table in SPEC.md (section 18) from the sweep's result files and the engine log.
+
+usage: bench_table.py [SPEC.md]   (default: SPEC.md at the repository root)
+Reads /root/.claude/jobs/743230e4/tmp/bench_<arm>.json (written per question by bench.py), ab_result_bench.json (the first chain: arm BC)
+and ab_result_bench2.json (the second chain), plus the engine log, whose per-request lines give the time to the first token (prompt
+reading) and the decode speed; replaces what stands between the two markers. A finished arm is one that has an entry in a result file.
+"""
+import json, os, re, statistics, sys
+
+T = "/root/.claude/jobs/743230e4/tmp"
+LOG = "/home/Projects/Strata/strata-iq3_s.log"
+MARK = "strata verify: window up to"
+SPEC = sys.argv[1] if len(sys.argv) > 1 else os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))), "SPEC.md")
+START, END = "<!-- BENCH-TABLE-START -->", "<!-- BENCH-TABLE-END -->"
+# arm, what it replaces (ranks lo-9 are replaced, with the router's top picks 0..lo-1 exact; "edge" = a fractional floor)
+ARMS = [("BC", "control (nothing replaced)"), ("B2", "ranks 2-9"),
+        ("E1", "2-9, rank 1 only by a substitute within 1 logit (the edge, margin 1)"),
+        ("E2", "2-9, rank 1 only within 2 logits (edge margin 2)"), ("E4", "2-9, rank 1 only within 4 logits (edge margin 4)"),
+        ("B1", "ranks 1-9 (rank 1 at any distance)"), ("BC2", "control, second copy (the noise floor)"), ("B0", "ranks 0-9"),
+        ("B6", "ranks 6-9"), ("B4", "ranks 4-9"), ("B9", "rank 9 only"), ("B8", "ranks 8-9"), ("B7", "ranks 7-9"),
+        ("B5", "ranks 5-9"), ("B3", "ranks 3-9")]
+done, chain2 = {}, []
+for p in (f"{T}/ab_result_bench.json", f"{T}/ab_result_bench2.json"):
+    if os.path.exists(p):
+        for d in json.load(open(p)):
+            done[d["arm"]] = d
+            if p.endswith("bench2.json"):
+                chain2.append(d["arm"])
+
+req_re = re.compile(r"prompt (\d+) tokens = \d+ reused \+ \d+ read in (\d+) ms.*?, (\d+) generated in (\d+) ms \(([\d.]+) tok/s\)")
+
+
+def log_split():
+    """arm -> (median time to first token s, median decode tok/s) for requests of 100+ tokens, from the engine log. The log holds one
+    section per server start, in order: ..., BC, then the second chain's arms (the last one may be running)."""
+    if not os.path.exists(LOG):
+        return {}
+    sections = open(LOG, errors="replace").read().split(MARK)[1:]
+    started = re.findall(r"^=== arm (\w+)", open(f"{T}/ab_run_bench2.log").read(), re.M) if os.path.exists(f"{T}/ab_run_bench2.log") else []
+    running = started[-1] if started and started[-1] not in chain2 else None
+    # an arm that has just started has not served anything yet: its section holds no request lines, or does not exist at all
+    # (the arm's own file appears with its first answered question: until then the last section is the last finished arm's)
+    if running and not os.path.exists(f"{T}/bench_{running}.json"):
+        running = None
+    elif running and sections and not req_re.search(sections[-1]):
+        sections = sections[:-1]
+        running = None
+    end = len(sections) - (1 if running else 0)
+    by_arm = {}
+    for i, a in enumerate(chain2):
+        by_arm[a] = sections[end - len(chain2) + i]
+    # the old chain's killed B2 never reached the engine's marker, so BC sits directly before the second chain's first arm
+    if "BC" in done and end - len(chain2) - 1 >= 0:
+        by_arm["BC"] = sections[end - len(chain2) - 1]
+    if running:
+        by_arm[running] = sections[-1]
+    out = {}
+    for a, sec in by_arm.items():
+        rows = [(int(m.group(2)) / 1000.0, float(m.group(5))) for l in sec.splitlines()
+                for m in [req_re.search(l)] if m and int(m.group(3)) >= 100]
+        if rows:
+            out[a] = (statistics.median(r[0] for r in rows), statistics.median(r[1] for r in rows))
+    return out
+
+
+split = log_split()
+rows = ["| Arm | Replaced | GSM8K correct | HumanEval pass | Decode tok/s (median) | First token (s, median) | Whole-request tok/s | Longest answer (tokens) | State |",
+        "|---|---|---:|---:|---:|---:|---:|---:|---|"]
+for arm, what in ARMS:
+    f = f"{T}/bench_{arm}.json"
+    if not os.path.exists(f):
+        rows.append(f"| {arm} | {what} | | | | | | | pending |")
+        continue
+    d = json.load(open(f))
+    g, h = d["gsm8k"], d["humaneval"]
+    tok = sum(x["tokens"] for x in g + h)
+    sec = sum(x["s"] for x in g + h)
+    finished = arm in done and not done[arm].get("error")
+    state = "done" if finished else ("void: " + str(done[arm].get("error") or done[arm].get("memory_guard")) if arm in done else "running")
+    longest = max([x["tokens"] for x in g + h] or [0])
+    ttft, dec = split.get(arm, (None, None))
+    rows.append(f"| {arm} | {what} | {sum(x['ok'] for x in g)} / {len(g)} | {sum(x['ok'] for x in h)} / {len(h)} | "
+                f"{'' if dec is None else f'{dec:.1f}'} | {'' if ttft is None else f'{ttft:.1f}'} | "
+                f"{tok / max(sec, 1e-9):.1f} | {longest} | {state} |")
+table = "\n".join(rows)
+text = open(SPEC).read()
+a, b = text.index(START), text.index(END)
+open(SPEC, "w").write(text[:a + len(START)] + "\n" + table + "\n" + text[b:])
+print(table)
