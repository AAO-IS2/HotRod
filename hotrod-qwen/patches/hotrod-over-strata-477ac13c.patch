@@ -0,0 +1,244 @@
+"""STEP D: prefill topic test on trace-prefill.bin (RTR2).  Layers 8,16,24,32,40; d=1 and d=2; learner = lowrank-8/mse (stage-A settings).
+Requests are processed in file order; request i (1-based) belongs to conversation CONV_OF[i] (trace_prompts.PREFILL turn counts).
+Arms (all scored on the request's DECODE tokens before learning on them; decode is exact in this trace):
+  reuse     the plain router
+  b         global learner, trained online on decode only
+  c         global learner, trained on each request's prefill rows (every 4th prompt token) before that request's decode, then online on decode
+  d         c plus a per-request part (lowrank-4), reset to zero at each request start, trained on that request's prefill and decode
+  e         global learner trained on requests 1-18 (conversations 1-8, prefill + decode), frozen, scored on requests 19-24 (conversations 9-13)
+Metrics: lo2 / lo3 / lo6 (true ranks 0-1 / 0-2 / 0-5 inside predicted top-4 / top-6 / top-12) and non-resident p1, p2, p4, mr4.
+Residency proxy: as in pred_online.py, over the decode stream in request order.  Prefill is not scored.
+Output: tools/predictor/online_prefill.out
+"""
+import sys, time
+import numpy as np
+import torch
+
+sys.path.insert(0, "/home/Projects/Strata-train/tools/predictor")
+from trace_reader import iter_records
+
+torch.set_num_threads(4)
+torch.manual_seed(0)
+H, NL, E = 2560, 48, 512
+TRACE = "/mnt/nvme/strata-data/traces/trace-prefill.bin"
+ROUTER = "/mnt/nvme/strata-data/traces/routers_f32.npy"
+OUT = "/home/Projects/Strata-train/tools/predictor/online_prefill.out"
+LAYERS5 = [8, 16, 24, 32, 40]
+NEED = sorted({l - d for l in LAYERS5 for d in (1, 2)} | set(LAYERS5))
+SET = {1: (1e-3, (0.1, 16)), 2: (1e-3, (0.1, 64))}              # stage A: lowrank-8/mse lr and (margin, K) per d
+PER_RANK = 4
+B = 16
+LOS = (2, 3, 6)
+FLOORS = [f"lo{lo}" for lo in LOS]
+NRM = ["p1", "p2", "p4", "mr4"]
+METRICS = FLOORS + NRM
+SPLIT_REQ = 10   # the 24-request plan (requests 1-18 = conversations 1-8) is not in the trace: requests 1-10 train (e), 11-15 are scored
+CONV_TURNS = [4, 2, 4, 2, 2, 2, 1, 1, 1, 2, 1, 1, 1]            # trace_prompts.PREFILL turn counts, conversations a..m
+CONV_OF = [c + 1 for c, n in enumerate(CONV_TURNS) for _ in range(n)]
+CONV_LETTER = "abcdefghijklm"
+t0 = time.time()
+log = lambda *a: print(f"[{time.time()-t0:5.0f}s]", *a, flush=True)
+
+# ---- load (decode and prefill rows of the layers in NEED; request records give the request order)
+dec, pre, reqs, cur = {}, {}, [], None
+for r in iter_records(TRACE, want_x=True):
+    k = r["kind"]
+    if k == "request":
+        cur = r["request"]
+        reqs.append(cur)
+        dec[cur], pre[cur] = {}, {}
+    elif cur is None:
+        continue
+    elif k == "decode" and r["layer"] in NEED:
+        dec[cur].setdefault(r["layer"], []).append((r["x"], r["ids"]))
+    elif k == "prefill" and r["layer"] in NEED:
+        pre[cur][r["layer"]] = (r["pos"], r["x"], r["ids"])
+log(f"requests in file order: {len(reqs)} of {sum(CONV_TURNS)} planned (the trace is incomplete: its last write stopped after request {len(reqs)})", reqs)
+
+Dx, Di, Px, Pi, Pp = {}, {}, {}, {}, {}
+for i, q in enumerate(reqs):
+    Dx[q], Di[q], Px[q], Pi[q], Pp[q] = {}, {}, {}, {}, {}
+    lens = {l: sum(c[0].shape[0] for c in dec[q][l]) for l in NEED}
+    assert len(set(lens.values())) == 1, (q, lens)
+    for l in NEED:
+        Dx[q][l] = np.concatenate([c[0] for c in dec[q][l]])
+        Di[q][l] = np.concatenate([c[1] for c in dec[q][l]])[:, :10]
+        pos, x, ids = pre[q][l]
+        o = np.argsort(pos, kind="stable")
+        Px[q][l], Pi[q][l], Pp[q][l] = x[o], ids[o][:, :10], pos[o]
+    ps = {l: Pp[q][l].tolist() for l in NEED}
+    assert all(ps[l] == ps[NEED[0]] for l in NEED), f"request {q}: prefill positions differ across layers"
+W = torch.from_numpy(np.load(ROUTER))
+f32 = lambda u: torch.from_numpy((u.astype(np.uint32) << 16).view(np.float32))
+T = {q: Dx[q][NEED[0]].shape[0] for q in reqs}
+NP = {q: Px[q][NEED[0]].shape[0] for q in reqs}
+log("decode tokens per request:", [T[q] for q in reqs])
+log("prefill rows per request:", [NP[q] for q in reqs])
+
+
+def metrics(logit, ids, rec):
+    ids = ids.long()
+    top = logit.topk(12, dim=1).indices
+    res = {}
+    for lo in (2, 3, 6):
+        res[f"lo{lo}"] = (ids[:, :lo, None] == top[:, None, :2 * lo]).any(2).float().mean(1)
+    p = logit.masked_fill(rec, -1e9).topk(4, dim=1).indices
+    pick = (p[:, :, None] == ids[:, None, :])
+    hit = pick.any(2) & ~rec.gather(1, p)
+    res["p1"] = hit[:, :1].float().mean(1)
+    res["p2"] = hit[:, :2].float().sum(1) / 2
+    res["p4"] = hit.float().sum(1) / 4
+    nr_true = ~rec.gather(1, ids)
+    res["mr4"] = (pick.any(1) & nr_true).float().sum(1) / nr_true.float().sum(1)
+    return res
+
+
+class Part:
+    def __init__(self, kind, r):
+        if kind == "lowrank":
+            self.A = (torch.randn(r, H) * 1e-3).requires_grad_(True)
+            self.B = torch.zeros(E, r, requires_grad=True)
+            self.params = [self.A, self.B]
+
+    def delta(self, x):
+        return (x @ self.A.T) @ self.B.T
+
+
+def mse_loss(pred, Y, margin, K):
+    v, i = Y.topk(K, dim=1)
+    thr = v[:, -1:] - margin
+    pc = pred.gather(1, i)
+    dev = (pc - pc.mean(1, keepdim=True)) - (v - v.mean(1, keepdim=True))
+    mask = torch.ones_like(pred).scatter_(1, i, 0.0)
+    hinge = (torch.relu(pred - thr) * mask).sum(1) / (E - K)
+    return (dev ** 2).mean() + hinge.mean()
+
+
+class Lrn:
+    """Learner on the real router Wl: parts is a list of ranks (lowrank); the last part can be replaced per request."""
+    def __init__(self, Wl, lr, cfg, ranks):
+        self.Wl, self.lr, self.cfg = Wl, lr, cfg
+        self.parts, self.opts = [], []
+        for r in ranks:
+            self.add(r)
+
+    def add(self, r):
+        p = Part("lowrank", r)
+        self.parts.append(p)
+        self.opts.append(torch.optim.Adam(p.params, lr=self.lr))
+
+    def replace(self, idx, r):
+        self.parts[idx] = Part("lowrank", r)
+        self.opts[idx] = torch.optim.Adam(self.parts[idx].params, lr=self.lr)
+
+    def logits(self, x):
+        out = x @ self.Wl.T
+        for p in self.parts:
+            out = out + p.delta(x)
+        return out
+
+    def learn(self, x, Y):
+        loss = mse_loss(self.logits(x), Y, self.cfg[0], self.cfg[1])
+        for o in self.opts:
+            o.zero_grad()
+        loss.backward()
+        for o in self.opts:
+            o.step()
+
+
+ARMS = ["reuse", "b", "c", "d", "e"]
+RES = {}
+for d in (1, 2):
+    lr, cfg = SET[d]
+    for l in LAYERS5:
+        Wl = W[l]
+        rec_stream = np.zeros((sum(T.values()), E), bool)
+        ids_stream = np.concatenate([Di[q][l] for q in reqs]).astype(np.int64)
+        cnt = np.zeros(E, np.int64)
+        for t in range(ids_stream.shape[0]):
+            rec_stream[t] = cnt > 0
+            cnt[ids_stream[t]] += 1
+            if t >= 32:
+                cnt[ids_stream[t - 32]] -= 1
+        rec_stream = torch.from_numpy(rec_stream)
+        L = {"b": Lrn(Wl, lr, cfg, [8]), "c": Lrn(Wl, lr, cfg, [8]), "d": Lrn(Wl, lr, cfg, [8, PER_RANK]),
+             "e": Lrn(Wl, lr, cfg, [8])}
+        acc = {a: {m: [] for m in METRICS} for a in ARMS}
+        pos_in_req, req_of = [], []
+        off = 0
+        for qi, q in enumerate(reqs):
+            n_dec, n_pre = T[q], NP[q]
+            xd, yd = f32(Dx[q][l - d]), f32(Dx[q][l]) @ Wl.T
+            idd = torch.from_numpy(Di[q][l].astype(np.int64))
+            xp, yp = f32(Px[q][l - d]), f32(Px[q][l]) @ Wl.T
+            rec = rec_stream[off:off + n_dec]
+            e_trains = qi < SPLIT_REQ
+            # per-request part: fresh at each request start
+            L["d"].replace(1, PER_RANK)
+            # prefill training for c, d (and e while it is still training)
+            for i in range(0, n_pre, B):
+                xb, yb = xp[i:i + B], yp[i:i + B]
+                L["c"].learn(xb, yb)
+                L["d"].learn(xb, yb)
+                if e_trains:
+                    L["e"].learn(xb, yb)
+            # decode: score every arm, then learn on the batch
+            for i in range(0, n_dec, B):
+                xb, idb, rb = xd[i:i + B], idd[i:i + B], rec[i:i + B]
+                with torch.no_grad():
+                    outs = {"reuse": xb @ Wl.T, **{a: L[a].logits(xb) for a in ("b", "c", "d", "e")}}
+                    for a, lg in outs.items():
+                        mm = metrics(lg, idb, rb)
+                        for m in METRICS:
+                            acc[a][m].append(mm[m])
+                for a in ("b", "c", "d"):
+                    L[a].learn(xb, yd[i:i + B])
+                if e_trains:
+                    L["e"].learn(xb, yd[i:i + B])
+            pos_in_req.append(np.arange(n_dec))
+            req_of.append(np.full(n_dec, qi))
+            off += n_dec
+        RES[(d, l)] = {a: {m: torch.cat(acc[a][m]).numpy() for m in METRICS} for a in ARMS}
+        RES[(d, l)]["_pos"] = np.concatenate(pos_in_req)
+        RES[(d, l)]["_req"] = np.concatenate(req_of)
+        log(f"d={d} layer {l} done")
+
+# ---- report
+POS = None
+with open(OUT, "w") as F:
+    def emit(*a):
+        print(*a, file=F, flush=True)
+    emit(f"STEP D: prefill topic test, trace-prefill.bin, {len(reqs)} requests (of 24 planned; the trace stopped after request {len(reqs)}), "
+         f"layers {LAYERS5}, lowrank-8/mse (stage-A settings per d), decode tokens scored before learning.")
+    emit(f"(e) substitute split: requests 1-{SPLIT_REQ} train the global part and freeze it, requests {SPLIT_REQ + 1}-{len(reqs)} are scored. "
+         "The planned conversation split (1-18 vs 19-24) cannot be used: the trace does not contain those requests.")
+    emit("request -> conversation (planned order, not verified against the trace): " +
+         ", ".join(f"{i+1}:{CONV_LETTER[CONV_OF[i]-1]}" for i in range(len(reqs))))
+    names = {"reuse": "reuse (router)", "b": "b global, decode only", "c": "c global + prefill",
+             "d": "d global + prefill + per-request r4", "e": f"e frozen global (1-{SPLIT_REQ} trained)"}
+
+    def block(title, d, sel_fn, arms):
+        emit(f"\n=== d={d} {title} ===")
+        emit(f"{'':32s}" + " ".join(f"{m:>7s}" for m in METRICS))
+        for a in arms:
+            vals = []
+            for m in METRICS:
+                vals.append(np.mean([np.nanmean(RES[(d, l)][a][m][sel_fn(RES[(d, l)])]) for l in LAYERS5]) * 100)
+            emit(f"   {names[a]:30s}" + " ".join(f"{v:7.1f}" for v in vals))
+
+    for d in (1, 2):
+        block("all decode tokens of requests 1-24 (mean over layers, %)", d, lambda R: np.ones(len(R["_pos"]), bool), ARMS[:4])
+        block("first 100 decode tokens of each request, requests 1-24 (%)", d, lambda R: R["_pos"] < 100, ARMS[:4])
+        block(f"requests {SPLIT_REQ + 1}-{len(reqs)}, all decode tokens: plain router vs frozen global (e) (%)", d,
+              lambda R: R["_req"] >= SPLIT_REQ, ["reuse", "e"])
+        block(f"requests {SPLIT_REQ + 1}-{len(reqs)}, first 100 decode tokens each (%)", d,
+              lambda R: (R["_req"] >= SPLIT_REQ) & (R["_pos"] < 100), ["reuse", "e"])
+        emit(f"\n--- d={d} per request, lo3 over all decode tokens (mean over layers, %) ---")
+        emit(f"{'req conv':10s}" + " ".join(f"{a:>9s}" for a in ARMS))
+        for qi in range(len(reqs)):
+            row = []
+            for a in ARMS:
+                v = np.mean([np.nanmean(RES[(d, l)][a]["lo3"][RES[(d, l)]["_req"] == qi]) for l in LAYERS5]) * 100
+                row.append(v)
+            emit(f"{qi+1:3d} {CONV_LETTER[CONV_OF[qi]-1]:>5s}   " + " ".join(f"{v:9.1f}" for v in row))
+    log("written", OUT)
diff --git a/tools/predictor/pred_transfer.py b/tools/predictor/pred_transfer.py
new file mode 100644
index 000000000..b20cda811
--- /dev/null
+++ b/tools/predictor/pred_transfer.py
@@ -0,0 +1,97 @@
+"""Transfer test: the published per-layer LINEAR predictors (aswinkumar99/qwen3.8-flash-next-expert-traces, d=1, trained on the NVFP4 checkpoint's activations)
+run on OUR engine's router inputs (IQ3_S).  Arms at d = 1 on both test splits (IN, SHIFT):
+   reuse     layer l's real router on x_{l-1}
+   theirs    their model L{l}: z = (x_{l-1} - mu)/sd ; logits = z @ out.weight[:512].T + out.bias[:512]
+   theirs+ft their weights fine-tuned on OUR training split (listwise KD against our own router's softmax, Adam, 3 epochs)
+Loading is weights_only=True (the pickles only reference OrderedDict/FloatStorage/_rebuild_tensor_v2: checked)."""
+import struct, sys, time
+import numpy as np
+import torch
+
+torch.set_num_threads(10)
+H, NL, E = 2560, 48, 512
+TRACE = "/mnt/nvme/strata-data/traces/trace1.bin"
+MODELS = "/mnt/nvme/ref/trace-dataset/models_linear"
+t0 = time.time()
+log = lambda *a: print(f"[{time.time()-t0:5.0f}s]", *a, flush=True)
+
+buf = np.memmap(TRACE, dtype=np.uint8, mode="r")
+off, recs = 4, []
+while off + 8 <= len(buf):
+    step, layer, nt, k = struct.unpack_from("<IHBB", buf, off)
+    rec = 8 + nt * (H * 2 + k * 2)
+    if off + rec > len(buf):
+        break
+    recs.append((step, layer, nt, off, k))
+    off += rec
+steps = {}
+for step, layer, nt, o, k in recs:
+    steps.setdefault(step, []).append((layer, nt, o, k))
+complete = sorted(s for s, v in steps.items() if len(v) == NL and len({nt for _, nt, _, _ in v}) == 1)
+N = sum(steps[s][0][1] for s in complete)
+X = np.zeros((N, NL, H), np.uint16)
+IDS = np.zeros((N, NL, 10), np.int16)
+STEP_OF = np.zeros(N, np.int64)
+tok = 0
+for s in complete:
+    for layer, nt, o, k in steps[s]:
+        p = o + 8
+        for t in range(nt):
+            X[tok + t, layer] = np.frombuffer(buf[p:p + H * 2], dtype=np.uint16); p += H * 2
+            IDS[tok + t, layer] = np.frombuffer(buf[p:p + k * 2], dtype=np.int16)[:10]; p += k * 2
+    STEP_OF[tok:tok + steps[s][0][1]] = s
+    tok += steps[s][0][1]
+W = torch.from_numpy(np.load("/mnt/nvme/strata-data/traces/routers_f32.npy"))
+f32 = lambda u: torch.from_numpy((u.astype(np.uint32) << 16).view(np.float32))
+log("loaded", N, "tokens")
+
+blk = (STEP_OF - STEP_OF.min()) // 40
+te_in = (blk % 5 == 4)
+te_shift = np.arange(N) >= int(0.77 * N)
+splits = {"IN": (np.where(~te_in)[0], np.where(te_in)[0]), "SHIFT": (np.where(~te_shift)[0], np.where(te_shift)[0])}
+
+
+def metrics(score, ids):
+    top = score.topk(10, dim=1).indices.numpy()
+    ids = ids.astype(np.int64)
+    out = {f"r01@{K}": float((ids[:, :2, None] == top[:, None, :K]).any(2).mean()) for K in (2, 4, 8)}
+    out["r03@8"] = float((ids[:, :4, None] == top[:, None, :8]).any(2).mean())
+    out["cov10"] = float(np.mean([(len(set(a) & set(b)) / 10.0) for a, b in zip(top.tolist(), ids.tolist())]))
+    return out
+
+
+def theirs(l, xin):
+    sd = torch.load(f"{MODELS}/L{l:02d}_d1_linear_state.pt", weights_only=True, map_location="cpu")
+    mu, s = sd["mu_state"], sd["sd_state"]
+    return sd["out.weight"][:E].clone(), sd["out.bias"][:E].clone(), mu, s
+
+
+KEYS = ("r01@2", "r01@4", "r01@8", "r03@8", "cov10")
+for split, (tr, te) in splits.items():
+    agg = {"reuse": [], "theirs": [], "theirs+ft": []}
+    for l in range(1, 48):
+        Wo, bo, mu, sd = theirs(l, None)
+        Xte = f32(X[te, l - 1]).reshape(len(te), H)
+        ids_te = IDS[te, l]
+        agg["reuse"].append(metrics(Xte @ W[l].T, ids_te))
+        agg["theirs"].append(metrics(((Xte - mu) / sd) @ Wo.T + bo, ids_te))
+        # fine-tune their weights on our training split: listwise distillation from OUR router
+        Wf, bf = Wo.clone().requires_grad_(True), bo.clone().requires_grad_(True)
+        opt = torch.optim.Adam([Wf, bf], lr=2e-4)
+        Xtr = f32(X[tr, l - 1]).reshape(len(tr), H)
+        Ztr = (Xtr - mu) / sd
+        Ytr = torch.softmax(f32(X[tr, l]).reshape(len(tr), H) @ W[l].T, dim=1)
+        for ep in range(3):
+            perm = torch.randperm(len(tr))
+            for i in range(0, len(tr), 512):
+                b = perm[i:i + 512]
+                loss = -(Ytr[b] * torch.log_softmax(Ztr[b] @ Wf.T + bf, dim=1)).sum(1).mean()
+                opt.zero_grad(); loss.backward(); opt.step()
+        with torch.no_grad():
+            agg["theirs+ft"].append(metrics(((Xte - mu) / sd) @ Wf.T + bf, ids_te))
+        if l % 8 == 0:
+            log(split, "layer", l, "done")
+    print(f"\n{split}: d=1, mean over layers 1..47")
+    print(f"   {'':12s} " + " ".join(f"{k:>7}" for k in KEYS))
+    for name, rows in agg.items():
+        print(f"   {name:12s} " + " ".join(f"{np.mean([r[k] for r in rows]) * 100:7.1f}" for k in KEYS), flush=True)
diff --git a/tools/predictor/promote_check.py b/tools/predictor/promote_check.py
new file mode 100644
index 000000000..57714085a
--- /dev/null
+++ b/tools/predictor/promote_check.py
@@ -0,0 +1,264 @@
+"""Offline check of idle-drive RAM-tier promotions on a STRATA_ROUTER_TRACE file (RTR1, see trace_reader.py).
+
+Question (docs/perf-ideas.md, 22 Oct, "Idle time as waste"): if the drive's idle time in each decode window promoted experts into the
+RAM tier, chosen by a recency or frequency rule, what share of those promotions would a later window have read cold - and how many
+cold reads would the decode save net of what the promotions evict?
+
+Replay, window by window (a trace `step` is one decode window), per MoE layer:
+  * the decode NEEDS the distinct experts its tokens pick at ranks 0..need_ranks-1 (rank 0-1 exact; ranks 2-9 take stand-ins)
+  * VRAM tier: per layer the `vram` experts with the highest decayed routing count (all ten ranks, as the card's swap rounds see
+    them), refreshed every window within a swap budget - an approximation of the adaptive tier
+  * RAM tier: `ram` experts in all, first filled with the most-routed experts of the first `warm_share` of the trace (the profile-ranked
+    fixed tier); an expert needed and in neither tier is a COLD read (the drive)
+  * promotions: after each window, up to `budget` experts not in VRAM or RAM are read into the RAM tier (what the drive's idle time
+    holds: ~15-22 a window on the RTX 3060 box), chosen by the rule; when the tier is full each one evicts the RAM expert with the
+    lowest decayed count.  They land `lag` windows later.
+Reported per rule: promotions a window, the USEFUL share (a promoted expert needed while still promoted, before eviction - the sysim
+`fill_useful`), cold reads saved and cold reads caused by evictions (a later need of an evicted expert), and the net change.
+
+usage: python promote_check.py trace1.bin [--hidden 2560] [--vram 58] [--ram 4400] [--budget 15] [--max-windows N]
+       python promote_check.py --synthetic out.bin   (writes a small test trace with locality, hidden size 8)
+"""
+import argparse
+import heapq
+import mmap
+import random
+import struct
+import sys
+from collections import defaultdict
+
+RULES = ("recency", "frequency", "recency+frequency")
+
+
+def read_windows(path, hidden, need_ranks, max_windows=None):
+    """Yields (step, {layer: (need set, all-ranks list)}) per decode window; the bf16 inputs are skipped, never loaded."""
+    with open(path, "rb") as f:
+        mm = mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ)
+        if mm[:4] != b"RTR1":
+            sys.exit("not an RTR1 trace")
+        off, size = 4, len(mm)
+        cur, layers, n = None, {}, 0
+        while off + 8 <= size:
+            step, layer, nt, k = struct.unpack_from("<IHBB", mm, off)
+            rec = 8 + nt * (hidden * 2 + k * 2)
+            if off + rec > size:
+                break
+            if cur is not None and step != cur:
+                yield cur, layers
+                n += 1
+                if max_windows and n >= max_windows:
+                    return
+                layers = {}
+            cur = step
+            p = off + 8
+            need, every = set(), []
+            for _ in range(nt):
+                p += hidden * 2
+                ids = struct.unpack_from(f"<{k}h", mm, p)
+                p += k * 2
+                need.update(e for e in ids[:need_ranks] if e >= 0)
+                every.extend(e for e in ids if e >= 0)
+            layers[layer] = (need, every)
+            off += rec
+        if cur is not None and layers:
+            yield cur, layers
+
+
+def replay(windows, a, rule):
+    decay = a.decay
+    inc = [1.0]
+    cnt = defaultdict(float)                 # (layer, expert) -> decayed count of ALL ranks (the card's view)
+    need_cnt = defaultdict(float)            # (layer, expert) -> decayed count of needed picks (rank 0..need-1)
+    last_need = {}                           # (layer, expert) -> window index of its last need
+    vram = defaultdict(set)
+    n_warm = max(1, int(len(windows) * a.warm_share))
+    tally = defaultdict(int)
+    for _, layers in windows[:n_warm]:
+        for l, (need, every) in layers.items():
+            for e in every:
+                tally[(l, e)] += 1
+    # the card and the RAM tier start as the profile ranks them: per layer its most-routed experts on the card, the next ones in RAM
+    per_layer = defaultdict(list)
+    for (l, e), c in tally.items():
+        per_layer[l].append((c, e))
+    for l, lst in per_layer.items():
+        lst.sort(reverse=True)
+        vram[l] = set(e for _, e in lst[:a.vram])
+    ram = set(k for k, _ in sorted(((k, c) for k, c in tally.items() if k[1] not in vram[k[0]]), key=lambda kv: -kv[1])[:a.ram])
+    # the RAM tier's eviction order: a lazy min-heap of (count, need count, key) - counts only grow between renormalisations, so an
+    # entry whose stored counts still match is the true minimum (stale ones are pushed again with their current counts)
+    ram_heap = [(cnt[k], need_cnt[k], k) for k in ram]
+    heapq.heapify(ram_heap)
+
+    def evict_min():
+        while ram_heap:
+            c, n, k = heapq.heappop(ram_heap)
+            if k not in ram:
+                continue
+            if (cnt[k], need_cnt[k]) != (c, n):
+                heapq.heappush(ram_heap, (cnt[k], need_cnt[k], k))
+                continue
+            return k
+        return next(iter(ram))
+    promoted = {}                            # key -> window it landed (promoted and still in RAM)
+    pending = []                             # (land window, key)
+    st = dict(windows=0, cold=0, promotions=0, useful=0, saved=0, caused=0)
+    used_once = set()                        # (key, landing window): a promotion counted useful once
+    evicted_by_promo = {}                    # key -> window evicted (by a promotion), for "caused" accounting
+    for wi, (_, layers) in enumerate(windows):
+        while pending and pending[0][0] <= wi:   # promotions landing now
+            _, key = heapq.heappop(pending)
+            if key in ram or key in vram[key[0]]:
+                continue
+            if len(ram) >= a.ram:            # evict the lowest decayed count (never the one landing)
+                victim = evict_min()
+                ram.discard(victim)
+                promoted.pop(victim, None)
+                evicted_by_promo[victim] = wi
+            ram.add(key)
+            heapq.heappush(ram_heap, (cnt[key], need_cnt[key], key))
+            promoted[key] = wi
+            if wi >= n_warm:                 # scored: the useful share's denominator (warm-up promotions are not)
+                st["promotions"] += 1
+        if wi >= n_warm:
+            st["windows"] += 1
+        for l, (need, every) in layers.items():
+            for e in need:
+                key = (l, e)
+                if e in vram[l]:
+                    continue
+                if key in ram:
+                    if key in promoted and wi >= n_warm:
+                        st["saved"] += 1
+                        if promoted[key] >= n_warm and (key, promoted[key]) not in used_once:
+                            used_once.add((key, promoted[key]))
+                            st["useful"] += 1
+                    continue
+                if wi >= n_warm:
+                    st["cold"] += 1
+                    if key in evicted_by_promo and wi - evicted_by_promo[key] <= a.horizon:
+                        st["caused"] += 1
+        # counts (decayed lazily: an increment that grows by 1/decay a window), then the VRAM tier's swap round
+        inc[0] /= decay
+        if inc[0] > 1e100:
+            for d in (cnt, need_cnt):
+                for k in d:
+                    d[k] /= inc[0]
+            inc[0] = 1.0
+            ram_heap[:] = [(cnt[k], need_cnt[k], k) for k in ram]   # the stored counts are in the old units
+            heapq.heapify(ram_heap)
+        for l, (need, every) in layers.items():
+            for e in every:
+                cnt[(l, e)] += inc[0]
+            for e in need:
+                need_cnt[(l, e)] += inc[0]
+                last_need[(l, e)] = wi
+        swaps = a.swaps
+        floor = 2.0 * inc[0] * decay          # "a decayed count of 2 or more", in this window's units
+        cand = sorted(((cnt[k], k) for k in cnt if k[1] not in vram[k[0]] and cnt[k] >= floor), reverse=True)
+        for c, (l, e) in cand:
+            if swaps <= 0:
+                break
+            if len(vram[l]) >= a.vram:
+                victim = min(vram[l], key=lambda x: cnt[(l, x)])
+                if cnt[(l, victim)] * a.min_gain >= c:
+                    continue
+                vram[l].discard(victim)
+            vram[l].add(e)
+            swaps -= 1
+        # promotions for the drive's idle time in the next window: candidates not in VRAM or RAM
+        if rule == "recency":
+            score = {k: -(wi - w) for k, w in last_need.items() if wi - w <= a.recent}
+        elif rule == "frequency":
+            score = {k: v for k, v in need_cnt.items() if v >= 0.5 * inc[0]}
+        else:   # recency+frequency: the decayed need count, only experts needed recently
+            score = {k: need_cnt[k] for k, w in last_need.items() if wi - w <= a.recent}
+        cands = heapq.nlargest(a.budget + len(pending), (k for k in score if k not in ram and k[1] not in vram[k[0]]), key=score.get)
+        queued = {k for _, k in pending}
+        for k in cands[:a.budget]:
+            if k not in queued:
+                heapq.heappush(pending, (wi + a.lag, k))
+    n_prom_eval = max(1, st["promotions"])
+    w = max(1, st["windows"])
+    return dict(rule=rule, prom_w=st["promotions"] / max(1, st["windows"]), useful=st["useful"] / n_prom_eval,
+                saved_w=st["saved"] / w, caused_w=st["caused"] / w, cold_w=st["cold"] / w)
+
+
+def baseline(windows, a):
+    q = argparse.Namespace(**vars(a))
+    q.budget = 0
+    return replay(windows, q, "frequency")["cold_w"]
+
+
+def synthetic(path, n_windows=1500, layers=48, experts=512, k=10, hidden=8, seed=7):
+    """Routing with locality: each layer has a slowly drifting topic set (Zipf inside it) plus noise; 3 tokens a window."""
+    rng = random.Random(seed)
+    topics = [[rng.sample(range(experts), 40) for _ in range(6)] for _ in range(layers)]
+    with open(path, "wb") as f:
+        f.write(b"RTR1")
+        topic = 0
+        for w in range(n_windows):
+            if rng.random() < 0.01:
+                topic = rng.randrange(6)
+            nt = 3
+            for l in range(layers):
+                f.write(struct.pack("<IHBB", w, l, nt, k))
+                for _ in range(nt):
+                    f.write(b"\x00" * hidden * 2)
+                    ids = []
+                    while len(ids) < k:
+                        e = topics[l][topic][min(39, int(rng.paretovariate(1.2)) - 1)] if rng.random() < 0.8 else rng.randrange(experts)
+                        if e not in ids:
+                            ids.append(e)
+                    f.write(struct.pack(f"<{k}h", *ids))
+    print(f"wrote {path}: {n_windows} windows, {layers} layers, hidden {hidden}")
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("trace", nargs="?")
+    ap.add_argument("--synthetic", metavar="OUT")
+    ap.add_argument("--hidden", type=int, default=2560)
+    ap.add_argument("--need-ranks", dest="need_ranks", type=int, default=2, help="ranks the decode must compute exactly (2: ranks 0-1)")
+    ap.add_argument("--vram", type=int, default=58, help="VRAM experts per layer (2,793 on the 3060 card / 48)")
+    ap.add_argument("--ram", type=int, default=4400, help="RAM tier size in experts (10 GiB / 2.33 MB)")
+    ap.add_argument("--warm-share", dest="warm_share", type=float, default=0.2, help="share of the trace that ranks the fixed RAM tier")
+    ap.add_argument("--budget", type=int, nargs="*", default=[5, 10, 15, 22], help="promotions a window (the drive's idle time)")
+    ap.add_argument("--lag", type=int, default=1, help="windows until a promotion lands")
+    ap.add_argument("--decay", type=float, default=0.7, help="the adaptive tier's decay a window")
+    ap.add_argument("--swaps", type=int, default=12, help="VRAM swaps a window")
+    ap.add_argument("--min-gain", dest="min_gain", type=float, default=1.5)
+    ap.add_argument("--recent", type=int, default=8, help="recency window (windows) for the recency rules")
+    ap.add_argument("--horizon", type=int, default=64, help="a cold read within this many windows of an eviction counts as caused by it")
+    ap.add_argument("--max-windows", dest="max_windows", type=int)
+    a = ap.parse_args()
+    if a.synthetic:
+        synthetic(a.synthetic)
+        return
+    if not a.trace:
+        ap.error("a trace file, or --synthetic OUT")
+    windows = list(read_windows(a.trace, a.hidden, a.need_ranks, a.max_windows))
+    budgets = a.budget
+    print(f"{a.trace}: {len(windows)} decode windows; VRAM {a.vram} a layer, RAM tier {a.ram}, needed ranks 0-{a.need_ranks - 1}; "
+          f"the first {a.warm_share:.0%} ranks the fixed tier and is not scored\n")
+    base = baseline(windows, a)
+    print(f"no promotions: {base:.2f} cold reads a window\n")
+    print(f"{'rule':18s} {'budget':>6} {'promoted/win':>12} {'useful':>7} {'saved/win':>9} {'caused/win':>10} {'net cold/win':>12} {'change':>7}")
+    best = None
+    for rule in RULES:
+        for b in budgets:
+            a.budget = b
+            r = replay(windows, a, rule)
+            net = r["cold_w"]
+            print(f"{rule:18s} {b:6d} {r['prom_w']:12.1f} {r['useful'] * 100:6.1f}% {r['saved_w']:9.2f} {r['caused_w']:10.2f} {net:12.2f} "
+                  f"{(net / base - 1) * 100 if base else 0:+6.1f}%")
+            if best is None or net < best[2]:
+                best = (rule, b, net, r["useful"])
+    if best and base:
+        print(f"\nbest: {best[0]}, {best[1]} a window: cold reads {base:.2f} -> {best[2]:.2f} a window, {best[3] * 100:.0f}% of promotions useful")
+        print(f"into the simulator: python tools/sysim/sysim.py --set idle_fill=1 fill_useful={best[3]:.2f} fill_chunk=290000 "
+              f"(or, as fewer cold misses: cold_share={0.2 * best[2] / base:.3f})")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/predictor/pt_reader.py b/tools/predictor/pt_reader.py
new file mode 100644
index 000000000..5f6e6b349
--- /dev/null
+++ b/tools/predictor/pt_reader.py
@@ -0,0 +1,70 @@
+"""Reads a PyTorch .pt state file (the zip format torch.save writes) into numpy arrays without torch.
+
+Only plain tensors in (Ordered)dicts are understood, the same allow-list torch.load(weights_only=True) checks for these files
+(OrderedDict, the typed storages, _rebuild_tensor_v2); any other global in the pickle is refused, so a hostile file cannot run
+code.  Used by export_la_model.py, so setup can turn the published expert predictors into the engine's file without torch.
+"""
+import collections
+import io
+import pickle
+import zipfile
+
+import numpy as np
+
+_DTYPES = {"FloatStorage": np.float32, "DoubleStorage": np.float64, "HalfStorage": np.float16, "LongStorage": np.int64,
+           "IntStorage": np.int32, "ShortStorage": np.int16, "CharStorage": np.int8, "ByteStorage": np.uint8,
+           "BoolStorage": np.bool_, "BFloat16Storage": "bf16"}
+
+
+class _Storage:
+    def __init__(self, name):
+        self.name = name
+
+
+def _rebuild_tensor_v2(storage, offset, size, stride, *_):
+    a = storage
+    # as_strided does not check its bounds: a size, stride or offset past the storage would read memory outside it
+    if not isinstance(a, np.ndarray) or not isinstance(offset, int) or offset < 0 or \
+            len(size) != len(stride) or any(not isinstance(v, int) or v < 0 for v in (*size, *stride)):
+        raise pickle.UnpicklingError("refused tensor record")
+    if not size:
+        if offset >= a.size:
+            raise pickle.UnpicklingError("refused tensor record: past its storage")
+        return a[offset].copy()
+    if 0 not in size and offset + sum((n - 1) * s for n, s in zip(size, stride)) >= a.size:
+        raise pickle.UnpicklingError("refused tensor record: past its storage")
+    item = a.itemsize
+    return np.lib.stride_tricks.as_strided(a[offset:], shape=tuple(size), strides=tuple(s * item for s in stride)).copy()
+
+
+class _Unpickler(pickle.Unpickler):
+    def __init__(self, f, zf, prefix):
+        super().__init__(f)
+        self.zf, self.prefix = zf, prefix
+
+    def find_class(self, module, name):
+        if module == "collections" and name == "OrderedDict":
+            return collections.OrderedDict
+        if module == "torch" and name in _DTYPES:
+            return _Storage(name)
+        if module == "torch._utils" and name == "_rebuild_tensor_v2":
+            return _rebuild_tensor_v2
+        raise pickle.UnpicklingError(f"refused global {module}.{name}: not a plain tensor file")
+
+    def persistent_load(self, pid):
+        kind, stype, key, _loc, numel = pid[:5]
+        if kind != "storage" or not isinstance(stype, _Storage):
+            raise pickle.UnpicklingError("refused storage record")
+        raw = self.zf.read(f"{self.prefix}data/{key}")
+        dt = _DTYPES[stype.name]
+        if dt == "bf16":
+            return (np.frombuffer(raw, np.uint16).astype(np.uint32) << 16).view(np.float32)[:numel]
+        return np.frombuffer(raw, dt)[:numel]
+
+
+def load(src):
+    """`src`: a path or a binary file object of a torch.save zip.  -> its dict, tensors as numpy arrays (bf16 as float32)."""
+    with zipfile.ZipFile(src) as zf:
+        pkl = next(n for n in zf.namelist() if n.endswith("data.pkl"))
+        prefix = pkl[: -len("data.pkl")]
+        return _Unpickler(io.BytesIO(zf.read(pkl)), zf, prefix).load()
