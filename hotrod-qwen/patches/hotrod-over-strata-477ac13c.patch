diff --git a/include/strata/kernels/subfit_apply.hpp b/include/strata/kernels/subfit_apply.hpp
new file mode 100644
index 000000000..70234f6a7
--- /dev/null
+++ b/include/strata/kernels/subfit_apply.hpp
@@ -0,0 +1,79 @@
+// include/strata/kernels/subfit_apply.hpp - SPEC-substitute-fit stage 2, steps 2-5: the device side of the per-pair corrections.
+//
+// Pieces:
+//   - SubfitRoute: what the router kernels (native_router.cu) need per call: the group's orig / flag rows (written by the route kernels,
+//     consumed by subfit_apply), the layer's LUT (e*512+s -> slot or -1), the per-slot residual, and the mode (1 dynamic, 2 all).
+//     All null / 0 = no wiring: the kernels do exactly what they did before the learner.
+//   - subfit_apply: one launch per layer, after the experts and their join, before the combine (verify.cpp).  For each row and slot k
+//     with orig >= 0, LUT[l][orig*512+ids] = slot >= 0 and (mode all or the slot's flag): z = A_l x_row (x = the layer's MoE input),
+//     parts[row,k] = c * parts[row,k] + B z.  It also clears orig and flag for the rows it reads (they are consumed).  The launch is
+//     made whenever the mode is on (the window graph is captured once); the device count nfit[l] skips a layer with no fitted slot.
+//   - subfit_tables_alloc: the device tables (LUT, A, B, c, resid, nfit).  Writes are cudaMemcpy calls made between windows.
+//
+// Layouts: parts [rows][K][N] float, raw expert outputs (before the router weight); x [rows][N] float (mixed_); ids [rows][K] int32;
+// orig [rows][K] int16 (-1: not substituted); flag [rows][K] uint8; lut [512*512] int16 for the layer; A [r][N] fp16; B [slots][N][r]
+// fp16 (B[j*r+m]); c [slots] float; resid [slots] float; nfit [1] int32.
+#pragma once
+
+#include "strata/core/subfit_rule.hpp"
+
+#include <cstddef>
+#include <cstdint>
+
+namespace strata::kernels {
+
+/// The router kernels' view of the learner (per call; nullptr members = off).
+struct SubfitRoute {
+    int16_t* orig = nullptr;        ///< [rows][10] (this call's row base): the router's pick of a substituted slot, -1 otherwise
+    uint8_t* flag = nullptr;        ///< [rows][10] (this call's row base): 1 = the move is corrected
+    const int16_t* lut = nullptr;   ///< this layer's LUT [512*512]: e*512+s -> slot, or -1
+    const float* resid = nullptr;   ///< [slots]: the held-out residual sqrt(E1/E0) of each slot's pair
+    int mode = 0;                   ///< strata::core::subfit_rule::kModeDynamic (1) or kModeAll (2); 0 = off
+    const int16_t* elut = nullptr;  ///< the fallback ladder: this layer's (layer, expert) slots [512] (used when the pair's LUT is -1)
+    const int16_t* llut = nullptr;  ///< ... then this layer's own slot [1]
+    // shadow samples (the learner on): every substitution of a row into list [rows][list_cap][4] (layer, rank, true pick, stand-in),
+    // reservoir-sampled past list_cap; list_n [rows] counts them (the host resets it each decode window).  nullptr: no list.
+    int32_t* list = nullptr;
+    uint32_t* list_n = nullptr;
+    int list_cap = 0;
+    uint32_t salt = 0;              ///< mixed into the reservoir's hash (the window count)
+    const int32_t* gate = nullptr;  ///< the learner's device gate; gate[4] = 1 in a flip re-check's exact window (mode flip reads it)
+};
+
+struct SubfitApplyArgs {
+    float* parts = nullptr;             ///< [n][K][N], this call's rows
+    const float* x = nullptr;           ///< [n][N] the layer's MoE input (mixed_) of this call's rows
+    const int32_t* ids = nullptr;       ///< [n][K] the picks after the substitutions
+    int16_t* orig = nullptr;            ///< [n][K] consumed (reset to -1)
+    uint8_t* flag = nullptr;            ///< [n][K] consumed (reset to 0)
+    const int16_t* lut = nullptr;       ///< this layer's LUT
+    const uint16_t* A = nullptr;        ///< this layer's A (r x N, fp16)
+    const uint16_t* B = nullptr;        ///< all slots' B (slots x N x r, fp16)
+    const float* c = nullptr;           ///< [slots]
+    const int32_t* nfit = nullptr;      ///< this layer's fitted count (device): 0 = nothing to apply
+    const int16_t* elut = nullptr;      ///< the ladder: this layer's expert slots [512], then its layer slot [1] (nullable)
+    const int16_t* llut = nullptr;
+    int r = 16, N = 2560, K = 10, n = 0;
+    int mode = 1;                       ///< 1 dynamic (flagged moves), 2 all (every fitted move)
+};
+
+/// Launch for this layer's rows on `stream` (no host sync).  Null members or n <= 0: nothing is launched.
+void subfit_apply(const SubfitApplyArgs& a, void* stream);
+
+/// Device tables for `slots` slots of N x r, `layers` layers.  The LUT is set to -1, orig to -1, flag to 0 (the caller passes its own
+/// buffers); the others zero.  Returns false (nothing kept) when one allocation fails.
+struct SubfitTables {
+    int16_t* lut = nullptr;      ///< subfit_learn::table_size(layers): [layers][512][512] pairs, [layers][512] experts, [layers] layers
+    uint16_t* A = nullptr;       ///< [layers][r][N]
+    uint16_t* B = nullptr;       ///< [slots][N][r]
+    float* c = nullptr;          ///< [slots]
+    float* resid = nullptr;      ///< [slots]
+    int32_t* nfit = nullptr;     ///< [layers]
+    int layers = 0, slots = 0, N = 0, r = 0;
+    void* host[6] = {};       ///< per table (lut, A, B, c, resid, nfit): its pinned host block when VRAM was full, else nullptr
+    size_t host_bytes = 0;    ///< bytes placed in pinned host memory (0: all in VRAM)
+};
+bool subfit_tables_alloc(SubfitTables& t, int layers, int slots, int N, int r);
+void subfit_tables_free(SubfitTables& t);
+
+}  // namespace strata::kernels
diff --git a/include/strata/kernels/subfit_capture.hpp b/include/strata/kernels/subfit_capture.hpp
new file mode 100644
index 000000000..1b428b221
--- /dev/null
+++ b/include/strata/kernels/subfit_capture.hpp
@@ -0,0 +1,48 @@
+// include/strata/kernels/subfit_capture.hpp - SPEC-substitute-fit stage 1a: the device side of STRATA_SUBFIT_LOG=1.
+//
+// Four predicated launches, all graph-safe (the flags are device ints set between windows; with the logger off none is launched):
+//   - subfit_capture_x: in a stand-in window (gate[0] == 1), each row whose first stand-in is at this layer copies its layer input
+//     (the normed row mixed_) into the x buffer.  Runs after the route-resident kernel, before the experts.
+//   - subfit_probe_pre / subfit_probe_post: in a probe window (gate[3] == 1) for row 0 only: the router's picks before the
+//     route-resident kernel (pre), then after it: flag[k] = the pick is still the router's (not replaced), resident, and row 0 had no
+//     stand-in before this layer (clean); x = row 0's layer input; w = the router weights of row 0.
+//   - subfit_probe_y: the raw expert outputs of row 0 (parts_, [K][N]) after the experts, before the combine (the host reads them after the window).
+#pragma once
+
+#include <cstdint>
+
+
+namespace strata::kernels {
+
+/// Device buffers of the probe (allocated only with the logger).  L = layers, K = routed experts per row (10), N = n_embd.
+struct SubfitProbeBufs {
+    float* x = nullptr;        ///< [L][N]: row 0's layer input at each layer
+    float* y = nullptr;        ///< [L][K][N]: row 0's raw expert outputs (before the router weight)
+    float* w = nullptr;        ///< [L][K]: row 0's router weights
+    int32_t* flag = nullptr;   ///< [L][K]: 1 = resident, exact pick of row 0 at a clean row
+    int32_t* pre = nullptr;    ///< [L][K]: row 0's router picks before the route-resident kernel
+    int32_t* clean = nullptr;  ///< [L]: 1 = row 0 had no stand-in before this layer
+};
+
+/// rows [0, n_rows): mixed (row-major [n_rows][N]) -> x for each row with rec[row*4] == layer while gate[0] == 1.
+void subfit_capture_x(const float* mixed, const int32_t* rec, const int32_t* gate, int layer, float* x, int64_t N, int n_rows,
+                      void* stream);
+/// Row 0's picks before the route-resident kernel: pre[layer][k] = ids[k]; clean[layer] = 1 when rec[0] (row 0's first stand-in layer) is -1;
+/// flag[layer][*] = 0 (a layer whose post did not run stays unsampled).
+void subfit_probe_pre(const int32_t* ids, const int32_t* rec, const int32_t* gate, int layer, int K, int32_t* pre, int32_t* clean,
+                      int32_t* flag, void* stream);
+/// After the route-resident kernel: flag, w and x of row 0 at this layer (see the header comment).  res: the layer's d_res [n_expert].
+void subfit_probe_post(const int32_t* ids, const float* w, const int32_t* res, const int32_t* pre, const int32_t* clean,
+                       const int32_t* gate, const float* mixed0, int layer, int K, int64_t N, float* x, float* w_out, int32_t* flag,
+                       void* stream);
+/// Row 0's K raw expert outputs (parts: [K][N]) into y (the layer's [K][N] slab), while gate[3] == 1.
+void subfit_probe_y(const float* parts, const int32_t* gate, int64_t K_N, float* y, void* stream);
+
+/// SPEC-substitute-fit stage 2, shadow samples: while gate[3] == 2 (the exact successor of a cut whose row listed its substitutions),
+/// row 0's picks (ids [K]) and MoE input (mixed0 [N]) of this layer into ids_out[layer][K] and x_out[layer][N] ...
+void subfit_shadow_xi(const int32_t* ids, const float* mixed0, const int32_t* gate, int layer, int K, int64_t N, int32_t* ids_out,
+                      float* x_out, void* stream);
+/// ... and its K raw expert outputs (parts [K][N]) into y_out[layer][K][N].
+void subfit_shadow_y(const float* parts, const int32_t* gate, int layer, int64_t K_N, float* y_out, void* stream);
+
+}  // namespace strata::kernels
