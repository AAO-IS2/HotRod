 //
 // Speculative rejection sampling (Leviathan et al. / Chen et al.) for the MTP drafts of a SAMPLED request.  Under
 // sampling the verify window used to accept a draft only when it EQUALS the token the target sampled for that row
diff --git a/include/strata/core/standin_pool.hpp b/include/strata/core/standin_pool.hpp
new file mode 100644
index 000000000..200469c5f
--- /dev/null
+++ b/include/strata/core/standin_pool.hpp
@@ -0,0 +1,179 @@
+// include/strata/core/standin_pool.hpp - STRATA_STANDIN_LEARN's host-side estimates (no CUDA).
+//
+// A pair (layer, true expert e, stand-in s) keeps decayed least-squares sums over its samples (num = y_s.y_e, den = y_s.y_s,
+// ee = y_e.y_e).  The same sums are kept per group: (layer, e) and per layer.  A pair's estimate adds a prior from its parent
+// group: the expert group when it has >= kReady samples, else the layer group, else no prior.  The prior is the parent's mean
+// sums (its sums over its decayed weight w) times a weight of K*K/(K+n) pseudo-samples, where n is the pair's own count: 16
+// pseudo-samples for a pair with one sample, fading as its own samples grow (with the decay the pair's own sums weigh at most
+// about 50, so a fixed 16 would keep a quarter of the parent's mean forever).
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace strata::standin {
+constexpr int kReady = 32;          // samples a pair (or a group) needs before its estimate is used
+constexpr double kShrinkK = 16.0;   // the prior's pseudo-samples at n = 0
+constexpr double kDecay = 0.98;     // every sum decays by this per sample
+constexpr int kPerLayer = 4096;     // pairs kept per layer (least recently used goes)
+constexpr uint32_t kMagic = 0x4C535453u;   // "STSL"
+constexpr int kExperts = 512;
+
+struct Pair {
+    double num = 0.0, den = 0.0, ee = 0.0;
+    int n = 0;                       // raw samples
+    float c = 1.0f;                  // the own estimate (as the corrections table used it before pooling)
+    uint64_t used = 0;               // LRU tick
+};
+
+// A group's decayed sums.  w is the decayed sample weight (the mean is the sums over w); n the raw sample count.
+struct Sums {
+    double num = 0.0, den = 0.0, ee = 0.0, w = 0.0;
+    int64_t n = 0;
+};
+
+inline uint64_t pair_key(int64_t l, int64_t e, int64_t s) {
+    return ((uint64_t) l << 40) | ((uint64_t) e << 20) | (uint64_t) s;
+}
+inline uint64_t expert_key(int64_t l, int64_t e) { return ((uint64_t) l << 20) | (uint64_t) e; }
+
+// One sample into a group (the same decay as a pair's sums).
+inline void add_sample(Sums& g, double sxy, double sxx, double syy) {
+    g.num = kDecay * g.num + sxy;
+    g.den = kDecay * g.den + sxx;
+    g.ee = kDecay * g.ee + syy;
+    g.w = kDecay * g.w + 1.0;
+    ++g.n;
+}
+
+// The decayed weight of n unit samples: what a pair (or a rebuilt group) holds for its count.
+inline double decayed_weight(int64_t n) { return (1.0 - std::pow(kDecay, (double) n)) / (1.0 - kDecay); }
+
+struct Est {
+    bool ready = false;    // usable: the parent group exists, or the pair's own count reached kReady (and ee > 0)
+    bool pooled = false;   // the estimate took a parent's prior
+    bool own_expert = false;   // the estimate rests on this expert's own data: its (layer, e) group or the pair itself has >= kReady
+    double c = 1.0;        // the measured least-squares scale num / den (9 Nov: no clip; >= 0, a mixture weight cannot be negative)
+    double err = 0.0;      // sqrt((ee - 2 c num + c^2 den) / ee) over the shrunk sums
+};
+
+// The pair's estimate.  expert: the (layer, e) group, layer: the layer group (either may be null).
+inline Est estimate(const Pair& p, const Sums* expert, const Sums* layer) {
+    Est r;
+    const Sums* par = nullptr;
+    if (expert != nullptr && expert->n >= kReady) par = expert;
+    else if (layer != nullptr && layer->n >= kReady) par = layer;
+    double num = p.num, den = p.den, ee = p.ee;
+    if (par != nullptr && par->w > 0.0) {
+        const double prior = kShrinkK * kShrinkK / (kShrinkK + (double) p.n);
+        num += prior * par->num / par->w;
+        den += prior * par->den / par->w;
+        ee += prior * par->ee / par->w;
+        r.pooled = true;
+    }
+    r.ready = (r.pooled || p.n >= kReady) && ee > 0.0;
+    r.own_expert = r.ready && (par == expert || p.n >= kReady);
+    r.c = std::max(0.0, num / std::max(den, 1e-30));
+    if (ee > 0.0) {
+        double e2 = (ee - 2.0 * r.c * num + r.c * r.c * den) / ee;
+        if (!(e2 > 0.0)) e2 = 0.0;
+        r.err = std::sqrt(e2);
+    }
+    return r;
+}
+
+// The groups from the pairs: each pair's sums go to its (layer, e) group and its layer.  Replaces the groups.
+template <class Map>
+inline void rebuild_groups(const Map& pairs, std::vector<Sums>& layer_g, std::unordered_map<uint64_t, Sums>& exp_g) {
+    for (auto& g : layer_g) g = Sums{};
+    exp_g.clear();
+    const int64_t nl = (int64_t) layer_g.size();
+    for (const auto& kv : pairs) {
+        const int64_t l = (int64_t) (kv.first >> 40), e = (int64_t) ((kv.first >> 20) & 0xFFFFFu);
+        if (l < 0 || l >= nl || e >= kExperts) continue;
+        const Pair& p = kv.second;
+        Sums add;
+        add.num = p.num;
+        add.den = p.den;
+        add.ee = p.ee;
+        add.w = decayed_weight(p.n);
+        add.n = p.n;
+        for (Sums* g : {&layer_g[(size_t) l], &exp_g[expert_key(l, e)]}) {
+            g->num += add.num;
+            g->den += add.den;
+            g->ee += add.ee;
+            g->w += add.w;
+            g->n += add.n;
+        }
+    }
+}
+
+// The balance's state step for every layer (one round).  best[i]: the best err of expert i's ready pairs (< 0: none ready);
+// use[i]: the table's use factor; miss_dec[i]: the decayed demand misses.  Layers with fewer than 10 ranked experts make no
+// decision.  Value = use x best err; cost = its misses + 1.  Top decile desires +1, bottom decile -1; a state moves one step a
+// round, and leaves +1 / -1 for 0 only after 2 rounds on the other side.  Experts outside the ranking keep their state.
+inline void balance_step(std::vector<int8_t>& state, std::vector<uint8_t>& opp, const std::vector<double>& best,
+                         const std::vector<float>& use, const std::vector<float>& miss_dec, int64_t layers) {
+    for (int64_t l = 0; l < layers; ++l) {
+        std::vector<std::pair<double, int>> rk;
+        for (int e = 0; e < kExperts; ++e) {
+            const int64_t i = l * kExperts + e;
+            if (best[(size_t) i] < 0.0 || !(use[(size_t) i] > 0.0f)) continue;
+            const double value = (double) use[(size_t) i] * best[(size_t) i];
+            rk.emplace_back(value / ((double) miss_dec[(size_t) i] + 1.0), e);
+        }
+        if (rk.size() < 10) continue;
+        std::sort(rk.begin(), rk.end(), [](const std::pair<double, int>& a, const std::pair<double, int>& b) {
+            return a.first != b.first ? a.first > b.first : a.second < b.second;
+        });
+        const size_t k = std::max<size_t>(1, rk.size() / 10);
+        for (size_t pos = 0; pos < rk.size(); ++pos) {
+            const int d = pos < k ? 1 : pos + k >= rk.size() ? -1 : 0;
+            const size_t i = (size_t) l * kExperts + (size_t) rk[pos].second;
+            int8_t& s = state[i];
+            uint8_t& op = opp[i];
+            if (d == 0 || d == s) op = 0;
+            else if (s == 0) { s = (int8_t) d; op = 0; }
+            else if (++op >= 2) { s = 0; op = 0; }   // the opposite side for 2 rounds: back to 0
+        }
+    }
+}
+
+struct Loaded {
+    uint64_t key = 0;
+    Pair p;
+};
+
+// The saved pairs: "STSL", layers, experts, count (u32 each), then per pair key (u64), num, den, ee (f64), n (u32), c (f32).
+// False when the header is not this model's (layers, 512 experts).  A record that does not fit the bytes, or whose ids or c
+// are out of range, is skipped (a short file stops at its last whole record).
+inline bool parse_table(const uint8_t* d, size_t size, int64_t layers, std::vector<Loaded>& out) {
+    if (size < 16) return false;
+    uint32_t hd[4] = {0, 0, 0, 0};
+    std::memcpy(hd, d, sizeof hd);
+    if (hd[0] != kMagic || (int64_t) hd[1] != layers || hd[2] != (uint32_t) kExperts) return false;
+    size_t pos = 16;
+    for (uint32_t i = 0; i < hd[3]; ++i) {
+        if (size - pos < 40) break;
+        Loaded L;
+        uint32_t n = 0;
+        std::memcpy(&L.key, d + pos, 8);
+        std::memcpy(&L.p.num, d + pos + 8, 8);
+        std::memcpy(&L.p.den, d + pos + 16, 8);
+        std::memcpy(&L.p.ee, d + pos + 24, 8);
+        std::memcpy(&n, d + pos + 32, 4);
+        std::memcpy(&L.p.c, d + pos + 36, 4);
+        pos += 40;
+        L.p.n = (int) n;
+        const int64_t l = (int64_t) (L.key >> 40), e = (int64_t) ((L.key >> 20) & 0xFFFFFu), s = (int64_t) (L.key & 0xFFFFFu);
+        if (l >= layers || e >= kExperts || s >= kExperts || !std::isfinite(L.p.c)) continue;
+        out.push_back(L);
+    }
+    return true;
+}
+
+}  // namespace strata::standin
diff --git a/include/strata/core/subfit_learn.hpp b/include/strata/core/subfit_learn.hpp
new file mode 100644
index 000000000..a17a47924
--- /dev/null
+++ b/include/strata/core/subfit_learn.hpp
@@ -0,0 +1,244 @@
+// include/strata/core/subfit_learn.hpp - SPEC-substitute-fit stage 2, step 1: the live learner of the per-pair corrections.  CPU only:
+// no CUDA here.  The device side (the apply kernel and the table upload) takes the Changes this learner returns, between windows.
+//
+// Per (layer l, missing expert e, substitute s) pair, from the samples standin_learn_settle gets (x = the row's MoE input, ys = the
+// substitute's output, ye = the exact output; all N wide):
+//   - features z = A_l x, A_l a fixed seeded Gaussian r x N matrix per layer (scaled 1/sqrt(N); recomputable, not saved);
+//   - scalar c = sxy / sxx of (ys, ye) over the training samples (recorded unclipped; used clipped to [-4, 4]);
+//   - residual target t = ye - c ys; ridge fit B (N x r) from the streaming sums (ZtZ double, ZtYe and ZtYs kept as float sums so
+//     the target is recomputed with the current c), lambda = 0.1 trace(ZtZ) / r, solved by Cholesky;
+//   - correction y = c ys + B z.
+// Held-out: every 4th sample of a pair (its seen count mod 4 == 3) is not trained on; with the pair's current fit it adds
+// E1 += |ye - (c ys + B z)|^2 and the baseline E0 = |ye - c ys|^2 (the scalar alone).  A pair is fitted when its last 32 held-out
+// samples give a gain 1 - E1/E0 >= 0.20, and revoked when that gain falls below 0.10.  The gate is evaluated at refit (the request end).
+// DEVIATION from the spec's E0 = |ye - ys|^2: that baseline credits a shrink toward zero, and an uncorrelated pair's scalar goes to ~0,
+// which halves its error - the gate then accepted a pure-noise pair (the test). The as-is gain is still kept and reported
+// (gain_as_is).
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace strata::core::subfit_learn {
+
+constexpr int kExperts = 512;                 ///< experts per layer (the LUT's side)
+constexpr int kDefaultRank = 16;              ///< STRATA_SUBFIT_RANK default
+constexpr int kDefaultPairs = 256;            ///< STRATA_SUBFIT_PAIRS default: pair groups (0.5 MB of statistics each on a 31 GB box)
+constexpr int kDefaultExperts = 256;          ///< (layer, expert) groups kept (the ladder's middle level; least recently sampled evicted)
+/// The fallback ladder (9 Nov): every sample also feeds its (layer, missing expert) group and its layer group.  A group is keyed
+/// like a pair with kAny in place of s (expert level) or of both e and s (layer level).  At apply time a substituted slot uses the
+/// most specific FITTED level: the pair's slot, else its (layer, e) slot, else its layer's slot, else none.
+constexpr int kAny = 1023;
+/// The one device table for the three levels: the pair LUT [L][512][512], then the expert slots [L][512], then the layer slots [L].
+inline size_t table_size(int n_layers) { return (size_t) n_layers * 512 * 512 + (size_t) n_layers * 512 + (size_t) n_layers; }
+inline size_t table_index(int n_layers, int layer, int e, int s) {
+    if (e == kAny) return (size_t) n_layers * 512 * 512 + (size_t) n_layers * 512 + (size_t) layer;
+    if (s == kAny) return (size_t) n_layers * 512 * 512 + (size_t) layer * 512 + (size_t) e;
+    return ((size_t) layer * 512 + (size_t) e) * 512 + (size_t) s;
+}
+inline int level_of(int e, int s) { return e == kAny ? 2 : s == kAny ? 1 : 0; }
+constexpr int kMaxFitted = 512;               ///< fitted pairs in the device table (the LUT's slots)
+constexpr int kHoldEvery = 4;                 ///< every 4th sample of a pair is held out
+constexpr int kHoldWindow = 32;               ///< held-out samples in the gate's window (and the minimum before any decision)
+constexpr double kGainFit = 0.20;             ///< gain needed to become fitted
+constexpr double kGainRevoke = 0.10;          ///< gain below which a fitted pair is revoked
+constexpr double kScalarClip = 4.0;           ///< the scalar used is clipped to [-kScalarClip, kScalarClip] (the record keeps the raw value)
+constexpr double kLambdaRel = 0.1;            ///< lambda = kLambdaRel * trace(ZtZ) / r
+
+/// The learner's switch (STRATA_SUBFIT_APPLY, read once at start): off, dynamic (the step-F cap's refusals are taken corrected), all.
+enum class Apply { Off = 0, Dynamic = 1, All = 2, Flip = 3 };
+/// "off", "dynamic", "all"; unset or anything else is dynamic (the default).
+Apply apply_env(const char* v);
+const char* apply_name(Apply a);
+/// STRATA_SUBFIT_RANK: default 16, clamped to [1, 32].
+int rank_env(const char* v);
+/// STRATA_SUBFIT_PAIRS: default 512, clamped to [1, 8192].
+int pairs_env(const char* v);
+bool ladder_env(const char* v);
+double gain_env(const char* v, double dflt);   ///< a gain bar from the environment (-1..1), else dflt
+
+/// IEEE half of a float (round to nearest even; overflow to infinity, tiny values to subnormal or zero).
+uint16_t f32_to_f16(float f);
+float f16_to_f32(uint16_t h);
+
+/// The layer's feature matrix A (r rows of n): splitmix64 uniforms, Box-Muller normals, scaled by 1/sqrt(n).  Deterministic in
+/// (layer, seed, r, n).
+void features(int layer, int n, int r, uint64_t seed, std::vector<float>& A);
+
+/// Solves (ZtZ + lambda I) M = I by Cholesky (lambda = lambda_rel * trace / r) and returns B = M * T where T[k][j] = ZtYe[k][j] - c ZtYs[k][j]
+/// (B is N x r: B[j * r + k]).  Returns false (B untouched) when the system has no positive pivot.
+bool ridge_solve(const double* ZtZ, const float* ZtYe, const float* ZtYs, double c, int r, int n, double lambda_rel, std::vector<float>& B);
+
+/// The learner's configuration (one per process; the tests use small n).
+struct Config {
+    int n = 2560;                   ///< the MoE input and output width
+    int rank = kDefaultRank;        ///< r
+    int max_pairs = kDefaultPairs;  ///< pair groups with statistics (least recently sampled evicted)
+    int max_experts = kDefaultExperts;   ///< (layer, expert) groups with statistics (least recently sampled evicted); layers: all
+    bool ladder = true;             ///< STRATA_SUBFIT_LADDER (=1 opt-in; the engine's default is off: pairs only): the pooled (layer, expert) and layer groups learn too
+    double gain_fit = kGainFit;     ///< STRATA_SUBFIT_GAIN_FIT: held-out gain needed to become fitted (default 0.20)
+    double gain_revoke = kGainRevoke;   ///< STRATA_SUBFIT_GAIN_REVOKE: below it a fitted group is revoked (default 0.10; kept < gain_fit)
+    int pair_min_seen = 1;          ///< STRATA_SUBFIT_PAIR_MIN_SEEN: a pair gets a group only after this many sightings (the slots go to pairs that recur)
+    int max_fitted = kMaxFitted;    ///< pairs with a device slot (the device table's rows)
+    uint64_t seed = 1;              ///< the feature seed (the layer index is mixed in)
+    int n_layers = 48;
+};
+
+/// One device slot change for the upload (between windows): the pair's scalar and its fp16 B (N x r), or the slot freed.
+struct SlotChange {
+    int slot = -1;
+    int layer = 0, e = 0, s = 0;
+    float c = 1.0f;
+    float resid = 1.0f;        ///< the held-out residual sqrt(E1/E0) of the pair (the shift accounting's factor for a corrected move)
+    std::vector<uint16_t> b;   ///< fp16 B, N x r (empty when the slot is freed)
+};
+/// One LUT entry change: (layer, e, s) -> slot, or -1 for none.
+struct LutChange {
+    int layer = 0, e = 0, s = 0;
+    int slot = -1;
+};
+struct Changes {
+    std::vector<SlotChange> slots;
+    std::vector<LutChange> lut;
+};
+
+/// The host side of the device upload (CPU only; the verifier copies the writes between windows).  It keeps the mirror of the LUT
+/// (n_layers x 512 x 512, -1 none) and the fitted count per layer (the apply kernel's launch check), and turns each Changes into the
+/// writes.  A fresh packer matches a device table filled with -1.
+struct LutWrite {
+    size_t index;    ///< (layer * 512 + e) * 512 + s
+    int16_t value;   ///< slot, or -1
+};
+struct SlotWrite {
+    int slot = -1;
+    bool freed = false;        ///< the slot is free: its LUT entries are written -1, its B is not written
+    float c = 1.0f;
+    float resid = 1.0f;
+    std::vector<uint16_t> b;   ///< fp16 B, N x r (empty when freed)
+};
+class UploadPacker {
+public:
+    explicit UploadPacker(int n_layers);
+    /// The writes of one Changes (LUT entries in order, then the slots); the mirror and the fitted counts are updated.  Entries out of
+    /// range are dropped (none come from the learner).
+    void pack(const Changes& ch, std::vector<LutWrite>& lut_out, std::vector<SlotWrite>& slot_out);
+    const std::vector<int16_t>& lut() const { return lut_; }
+    const std::vector<int32_t>& fit_n() const { return fit_n_; }
+    static size_t lut_index(int layer, int e, int s) { return ((size_t) layer * kExperts + (size_t) e) * kExperts + (size_t) s; }
+    size_t index(int layer, int e, int s) const { return table_index(n_layers_, layer, e, s); }
+
+private:
+    int n_layers_;
+    std::vector<int16_t> lut_;
+    std::vector<int32_t> fit_n_;
+};
+
+/// The request-end summary: pairs with statistics, fitted pairs, the gains of the fitted pairs (median, minimum), and the fitted pairs
+/// that had no device slot (the table is full).
+struct Summary {
+    size_t pairs = 0, fitted = 0, unslotted = 0;
+    double gain_median = 0.0, gain_min = 0.0;
+    size_t groups[3] = {0, 0, 0}, fitted_lv[3] = {0, 0, 0};   ///< per level (pair, expert, layer)
+    double gain_median_lv[3] = {0.0, 0.0, 0.0};
+    // every group with a full held-out window (fitted or not): how many per level and their held-out gain (median, best)
+    size_t ready_lv[3] = {0, 0, 0};
+    double ready_median_lv[3] = {0.0, 0.0, 0.0}, ready_best_lv[3] = {0.0, 0.0, 0.0};
+};
+
+class Learner {
+public:
+    explicit Learner(const Config& cfg);
+    Learner(const Learner&) = delete;
+    Learner& operator=(const Learner&) = delete;
+
+    const Config& config() const { return cfg_; }
+
+    /// One sample of pair (layer, e, s).  x, ys, ye: N floats each.  Non-finite samples are dropped.  Between windows only.
+    void add_sample(int layer, int e, int s, const float* x, const float* ys, const float* ye);
+    /// the level whose slot a (layer, e, s) slot would use (0 pair, 1 expert, 2 layer), -1 none (the host mirror)
+    int level_used(int layer, int e, int s) const;
+
+    /// The request end: every pair with new samples is refit; the fitted/revoked state is updated; the changes for the device are
+    /// returned (slots whose fit changed or were freed, and the LUT entries that moved).
+    Changes refit();
+
+    /// Every fitted pair with a slot, as changes (the device table's full upload, e.g. at start after load).
+    Changes all_fitted() const;
+
+    /// Layer `layer`'s feature matrix A as fp16 (r x n, the device copy the apply kernel reads); the same values features() gives.
+    std::vector<uint16_t> features_f16(int layer) const;
+
+    /// (layer, e, s) -> slot, or -1 (fitted with a device slot).  Out-of-range keys give -1.
+    int lookup(int layer, int e, int s) const;
+    bool fitted(int layer, int e, int s) const;
+    /// The record's gain of the pair as is (1 - E1/E0 with E0 = |ye - ys|^2 over the recent window), 0 when unknown.
+    double gain_as_is(int layer, int e, int s) const;
+    /// The pair's scalar c (used) and held-out gain (recent window, over the scalar-only baseline), or false when the pair is unknown.
+    bool pair_info(int layer, int e, int s, double& c_used, double& c_raw, double& gain, bool& is_fitted) const;
+
+    Summary summary() const;
+    size_t pair_count() const { return pairs_.size(); }
+    /// Pairs with at least `min_ho` held-out samples so far (the request-end line's count).
+    size_t pairs_with_holdout(int min_ho) const;
+    size_t slots_used() const;
+
+    /// Persistence per model fingerprint: stats and fits (the features are recomputed, not saved).
+    bool save(const std::string& path, uint64_t fp, std::string& err) const;
+    bool load(const std::string& path, uint64_t fp, std::string& err);
+
+    /// Test hooks: the pair's B (fitted or not, N x r floats; empty when none) and the LUT size.
+    const std::vector<float>* pair_b(int layer, int e, int s) const;
+
+private:
+    struct Pair {
+        int layer = 0, e = 0, s = 0;
+        uint64_t last_tick = 0;
+        uint64_t seen = 0, n_train = 0, n_ho = 0;
+        double sxy = 0.0, sxx = 0.0;
+        double c_raw = 1.0, c_used = 1.0;
+        bool dirty = false;
+        bool has_b = false;
+        bool is_fitted = false;
+        int slot = -1;
+        double E0 = 0.0, E1 = 0.0;     // cumulative held-out sums: E0 = |ye - ys|^2 (as is), E1 = |ye - (c ys + B z)|^2
+        // the last kHoldWindow held-out sums: as is (ring0, the record), the scalar-only baseline |ye - c ys|^2 (ring0s, the gate's E0)
+        // and E1 (ring1).  The gate uses the scalar-only baseline: the as-is error credits a pure shrink (c -> 0 on an uncorrelated pair
+        // halves it), which accepted noise pairs in the test.
+        double ring0[kHoldWindow] = {}, ring0s[kHoldWindow] = {}, ring1[kHoldWindow] = {};
+        int ring_pos = 0, ring_n = 0;
+        std::vector<double> zz;        // r x r
+        std::vector<float> zye, zys;   // r x n each
+        std::vector<float> B;          // n x r (empty until the first refit with enough samples)
+    };
+
+    uint64_t key(int layer, int e, int s) const { return ((uint64_t) layer << 20) | ((uint64_t) e << 10) | (uint64_t) s; }
+    Pair* find(int layer, int e, int s);
+    const Pair* find(int layer, int e, int s) const;
+    Pair& get_or_create(int layer, int e, int s, Changes* ch);
+    void evict_one(int level, Changes* ch);
+    void add_to(Pair& p, const std::vector<double>& z, const float* ys, const float* ye);
+    void free_slot(Pair& p, Changes* ch);
+    bool assign_slot(Pair& p, Changes* ch);
+    void set_lut(const Pair& p, int slot, Changes* ch);
+    const std::vector<float>& features_of(int layer);
+    double gain_recent(const Pair& p) const;
+    double gain_asis(const Pair& p) const;
+    void refit_pair(Pair& p, Changes* ch);
+    void push_ho(Pair& p, double e0, double e0s, double e1);
+    SlotChange slot_change(const Pair& p, int slot) const;
+
+    Config cfg_;
+    Changes pending_;                         // the device changes made by add_sample (evictions); refit() returns them
+    uint64_t tick_ = 0;
+    std::unordered_map<uint64_t, Pair> pairs_;
+    std::vector<std::vector<float>> A_;       // per layer, built on first use
+    std::vector<bool> slot_used_;             // cfg_.max_fitted slots
+    std::vector<int16_t> lut_;                // table_size(n_layers): the three levels' slots (or -1)
+    size_t level_n_[3] = {0, 0, 0};           // groups per level
+    std::unordered_map<uint64_t, uint32_t> sightings_;   // pair_min_seen > 1: how often each pair was sampled before it has a group
+};
+
+}  // namespace strata::core::subfit_learn
diff --git a/include/strata/core/subfit_rule.hpp b/include/strata/core/subfit_rule.hpp
new file mode 100644
index 000000000..948de76c7
--- /dev/null
+++ b/include/strata/core/subfit_rule.hpp
@@ -0,0 +1,54 @@
+// include/strata/core/subfit_rule.hpp - SPEC-substitute-fit stage 2, step 4/5: the shift cap's decision for one substitute move.
+//
+// One function, compiled for the device (native_router.cu, route_resident_warp and route_mask_warp) and for the CPU tests, so the
+// rule the tests check is the rule the kernels run.  No CUDA here: __host__ __device__ only when nvcc compiles it.
+//
+// A move is a substitution of a router pick e by a stand-in s with the move's shift `plain` (w x max(gap, 0) x the pair's factor).
+//   - fitted: the pair (e, s) has a fitted correction (its LUT entry has a slot), with the held-out residual `resid` = sqrt(E1/E0).
+//   - mode all: every fitted move is taken and corrected (no cap test); its shift counts as plain x resid.
+//   - mode dynamic: a move past the row's cap (shift_acc + plain > cap) is taken corrected when fitted (its shift counts as plain x resid),
+//     and refused otherwise (the router's pick stays).  A move under the cap is taken plain, as today.
+//   - mode flip: only in the flip re-check's exact window (flip_win) is a fitted move taken corrected (the router lets the move through
+//     the re-check's ~0 tail budget for it); in every other window the move is plain, as mode off.
+//   - mode off (or no fit): the cap refuses a move past the cap, exactly as before the learner existed.
+#pragma once
+
+#ifdef __CUDACC__
+#define STRATA_SUBFIT_HD __host__ __device__ __forceinline__
+#else
+#define STRATA_SUBFIT_HD inline
+#endif
+
+namespace strata::core::subfit_rule {
+
+constexpr int kModeOff = 0;
+constexpr int kModeDynamic = 1;
+constexpr int kModeAll = 2;
+constexpr int kModeFlip = 3;
+
+struct Move {
+    bool take;       ///< the move is made (false: refused, the router's pick stays)
+    bool corrected;  ///< the move is made with its fitted correction (the apply kernel corrects its slot)
+    float add;       ///< the shift this move adds to the row's accumulated shift (plain, or plain x resid when corrected)
+};
+
+/// The decision for one move.  capped: the row has a cap (cap < +inf); shift_acc: the row's shift so far; plain: this move's shift.
+STRATA_SUBFIT_HD Move decide(float shift_acc, float cap, bool capped, float plain, bool fitted, float resid, int mode,
+                             bool flip_win = false) {
+    Move d{true, false, plain};
+    if (fitted && (mode == kModeAll || (mode == kModeFlip && flip_win))) {
+        d.corrected = true;
+    } else if (capped && shift_acc + plain > cap) {
+        if (fitted && mode == kModeDynamic) {
+            d.corrected = true;
+        } else {
+            d.take = false;
+            d.add = 0.0f;
+            return d;
+        }
+    }
+    if (d.corrected) d.add = plain * resid;
+    return d;
+}
+
+}  // namespace strata::core::subfit_rule
diff --git a/include/strata/core/subfit_samples.hpp b/include/strata/core/subfit_samples.hpp
new file mode 100644
index 000000000..d68915ceb
--- /dev/null
+++ b/include/strata/core/subfit_samples.hpp
@@ -0,0 +1,98 @@
+// include/strata/core/subfit_samples.hpp - SPEC-substitute-fit stage 1a: the sample file the engine writes (STRATA_SUBFIT_LOG=1)
+// and tools/subfit_fit reads.  Nothing here touches CUDA; the device side is in kernels/subfit_capture.hpp.
+//
+// File layout (little endian):
+//   header: magic u32 ("STSB"), n_embd u32, n_layers u32, version u32 (1)
+//   then records, each starting with a tag u8:
+//     tag 1 (stand-in sample, cut window + exact successor): layer u16, e u16, s u16, rank u8, x[N] bf16, y_s[N] bf16, y_e[N] bf16
+//     tag 2 (probe sample, a resident exact pick at ranks 0-9 of row 0): layer u16, e u16, rank u8, w f32, x[N] bf16, y_e[N] bf16
+//       x    = the expert's input (the layer's normed input row), y_e = the expert's raw output before the router weight,
+//       w    = the pick's router weight (the combine multiplies y_e by it), e = the true expert, s = none (the tool chooses)
+// The file is capped at kSubfitCapBytes: once a record would pass the cap nothing more is written (logged once).
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <vector>
+
+namespace strata::core::subfit {
+
+constexpr uint32_t kMagic = 0x42535453u;   // bytes "STSB" in file order
+constexpr uint32_t kVersion = 1;
+constexpr uint64_t kCapBytes = 300ull * 1024ull * 1024ull;
+constexpr int kProbeEveryDefault = 64;
+
+/// STRATA_SUBFIT_LOG set to a non-zero integer (the logger's only switch).
+bool log_on_env(const char* v);
+/// STRATA_SUBFIT_PROBE_EVERY: decode windows per probe window (default 64, at least 1).
+int probe_every_env(const char* v);
+
+uint16_t f32_to_bf16(float f);
+float bf16_to_f32(uint16_t b);
+
+struct Header {
+    uint32_t magic = kMagic, n_embd = 0, n_layers = 0, version = kVersion;
+};
+
+/// One record read back (tag 1 fills s and ys; tag 2 fills w).
+struct Record {
+    uint8_t tag = 0;
+    uint16_t layer = 0, e = 0, s = 0;
+    uint8_t rank = 0;
+    float w = 0.0f;
+    std::vector<float> x, ys, ye;
+};
+
+/// Appends records to one sample file.  open() writes the header to a new file, or appends to a file whose header matches.
+class SampleWriter {
+public:
+    SampleWriter() = default;
+    ~SampleWriter();
+    SampleWriter(const SampleWriter&) = delete;
+    SampleWriter& operator=(const SampleWriter&) = delete;
+
+    bool open(const std::string& path, uint32_t n_embd, uint32_t n_layers, std::string& err);
+    void close();
+    bool is_open() const { return f_ != nullptr; }
+
+    /// Each returns false when nothing was written (the cap is reached, or the file is not open).
+    bool write_stand_in(uint16_t layer, uint16_t e, uint16_t s, uint8_t rank, const float* x, const float* ys, const float* ye);
+    bool write_probe(uint16_t layer, uint16_t e, uint8_t rank, float w, const float* x, const float* ye);
+
+    /// The file's size limit (default kCapBytes); tests lower it.
+    void set_cap(uint64_t bytes) { cap_ = bytes; }
+    uint64_t bytes() const { return bytes_; }
+    uint64_t samples_total() const { return total_; }
+    /// The samples written since the last call (the request-end line), then reset.
+    uint64_t take_request_count();
+    bool capped() const { return capped_; }
+
+private:
+    bool put_record(const std::vector<uint8_t>& rec);
+    FILE* f_ = nullptr;
+    uint32_t n_ = 0, layers_ = 0;
+    uint64_t bytes_ = 0, total_ = 0, req_ = 0, cap_ = kCapBytes;
+    bool capped_ = false, cap_logged_ = false;
+};
+
+/// Reads a sample file front to back.
+class SampleReader {
+public:
+    SampleReader() = default;
+    ~SampleReader();
+    SampleReader(const SampleReader&) = delete;
+    SampleReader& operator=(const SampleReader&) = delete;
+
+    bool open(const std::string& path, std::string& err);
+    const Header& header() const { return h_; }
+    /// false at the end of the file (or a truncated record: err is set then).
+    bool next(Record& r, std::string& err);
+
+private:
+    FILE* f_ = nullptr;
+    Header h_;
+};
+
+}  // namespace strata::core::subfit
diff --git a/include/strata/core/subfit_shadow.hpp b/include/strata/core/subfit_shadow.hpp
new file mode 100644
index 000000000..98e521b37
--- /dev/null
+++ b/include/strata/core/subfit_shadow.hpp
@@ -0,0 +1,84 @@
+// include/strata/core/subfit_shadow.hpp - SPEC-substitute-fit stage 2, shadow samples: the substitute's output on the exact input,
+// computed on the CPU in idle time.
+//
+// The exact successor of a cut gives, for every substitution its cut window listed (layer l, true pick e, stand-in s), the exact
+// input x of layer l and the true expert's output y_e.  The stand-in's output on that same x is what the learner needs as y_s; the GPU
+// does not compute it (the stand-in did not run on the exact x).  This queue computes it on a worker thread at idle priority (Linux:
+// SCHED_IDLE for the CPU, the idle I/O class for the expert reads), so the decode path keeps the CPU and the drive.  The learner takes
+// the finished samples at the request's end (take_done), on its own thread: the learner itself is never touched by the worker.
+//
+// The expert is evaluated by an `Eval` function (the engine passes one built on native_expert_forward over the pack's experts.bin;
+// the tests pass a fake), called only from the worker thread.
+#pragma once
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace strata::core::subfit_shadow {
+
+constexpr int kDefaultPerCut = 16;      ///< STRATA_SUBFIT_SHADOW default: substitutions listed per cut row (0 = no shadow samples)
+constexpr size_t kMaxQueued = 4096;     ///< items waiting for the CPU (the oldest dropped past it)
+constexpr size_t kMaxDone = 8192;       ///< finished samples waiting for the learner (the oldest dropped past it)
+
+int per_cut_env(const char* v);
+bool cpu_ye_env(const char* v);   ///< STRATA_SUBFIT_SHADOW_CPU_YE (opt-in, default off)
+
+struct Item {
+    int layer = 0, e = 0, s = 0;
+    std::vector<float> x;    ///< the exact input [n]
+    std::vector<float> ye;   ///< the true expert's output on it [n]
+    std::vector<float> ys;   ///< the stand-in's output on it [n] (filled by the worker)
+    bool need_ye = false;    ///< STRATA_SUBFIT_SHADOW_CPU_YE=1: the exact row did not pick e, so the worker computes y_e = e(x) too
+};
+
+/// eval(layer, s, x, ys_out): the stand-in's output on x; false when it cannot (the item is dropped)
+using Eval = std::function<bool(int layer, int s, const float* x, float* ys)>;
+
+struct Stats {
+    uint64_t queued = 0, evaluated = 0, dropped = 0, failed = 0;
+};
+
+class Queue {
+public:
+    Queue() = default;
+    ~Queue();
+    Queue(const Queue&) = delete;
+    Queue& operator=(const Queue&) = delete;
+
+    /// The worker starts on the first push after this (idle priority unless `idle_prio` is false: the tests).
+    void set_eval(Eval eval, bool idle_prio = true);
+    /// Paused while a request decodes (the verifier pauses at each decode window, the request's end resumes): the worker's CPU and
+    /// expert reads never overlap decoding.  An item in progress finishes; no new one starts while paused.
+    void set_paused(bool paused);
+    void push(Item&& it);
+    /// The finished samples since the last call (in finishing order).
+    std::vector<Item> take_done();
+    /// Waits until the queue is empty and the worker idle, or `ms` passed (the tests).
+    bool drain_for_tests(int ms);
+    /// This interval's counts (reset by the call).
+    Stats take_stats();
+    size_t pending() const;
+
+private:
+    void run();
+    Eval eval_;
+    bool idle_prio_ = true;
+    mutable std::mutex mu_;
+    std::condition_variable cv_;
+    std::deque<Item> in_;
+    std::deque<Item> done_;
+    Stats st_;
+    bool busy_ = false;
+    bool stop_ = false;
+    bool paused_ = false;
+    int last_layer_ = -1, last_s_ = -1;   // the previous item's stand-in (its blob is warm: the same one is taken next when queued)
+    std::thread th_;
+};
+
+}  // namespace strata::core::subfit_shadow
diff --git a/include/strata/core/tune_steps.hpp b/include/strata/core/tune_steps.hpp
new file mode 100644
index 000000000..6e2d01cb9
--- /dev/null
+++ b/include/strata/core/tune_steps.hpp
@@ -0,0 +1,105 @@
+// include/strata/core/tune_steps.hpp - SPEC-recheck-gated step G: the rotation of the paired tuner and the candidates of its two new tests
+// (the shift cap's multipliers, the prefetch count), header-only, no CUDA.  The decisions themselves are paired_test.hpp's (decide, the quality
+// veto, the cut guard) as the budget and mask tests use them; this header only says which test runs next and what its candidate is.
+//
+// Rotation: budget -> mask -> cap -> prefetch -> budget.  A kind that is off is skipped; the budget test is always on.
+#pragma once
+
+#include "strata/core/paired_test.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace strata::core::tune {
+
+// SPEC-recheck-gated step H2: KMult is the margin m of the cut threshold (k_eff = m x k_safe), the fifth kind of the rotation.
+enum Kind : int { Budget = 0, Mask = 1, Cap = 2, Prefetch = 3, KMult = 4 };
+
+/// The next test kind after `cur` in the rotation budget -> mask -> cap -> prefetch -> k -> budget, skipping the kinds that are off.
+/// Budget is always on, so this always returns one.
+inline int next_kind(int cur, bool mask_on, bool cap_on, bool prefetch_on, bool k_on = false) {
+    const bool on[5] = {true, mask_on, cap_on, prefetch_on, k_on};
+    for (int s = 1; s <= 5; ++s) {
+        const int k = (cur + s) % 5;
+        if (on[k]) return k;
+    }
+    return Budget;
+}
+
+// ---- the margin m (H2): candidates m x 1.25^d, range [0.6, 1.5], start 1.0
+
+constexpr double kKMultLo = 0.6;
+constexpr double kKMultHi = 1.5;
+
+/// The candidate of a margin test in direction d (+1 up, -1 down): m x step^d (step: the test's step factor, 1.25 at the start).  false when
+/// it clamps to m (at a bound): nothing to test.
+inline bool k_mult_candidate(double m, double step, int d, double& out) {
+    if (!(step > 0.0)) return false;
+    const double cand = std::max(kKMultLo, std::min(kKMultHi, m * std::pow(step, (double) (d < 0 ? -1 : 1))));
+    if (std::fabs(cand - m) < 1e-12) return false;
+    out = cand;
+    return true;
+}
+
+/// H2 quality veto (the explore cuts): the candidate arm's explore flip rate has a Wilson 90% lower bound above the larger of the control's
+/// upper bound and the base arm's explore upper bound (the rows it stopped re-checking flip above noise).  Needs >= min_rc explore cuts in
+/// the candidate arm; else not blocked.  Counts: flips and cuts per arm (base, candidate).
+inline bool explore_veto(long long xfl_base, long long xrc_base, long long xfl_cand, long long xrc_cand, double ctrl_hi, long long min_rc) {
+    if (xrc_cand < min_rc) return false;
+    double b_lo = 0.0, b_hi = 0.0, c_lo = 0.0, c_hi = 0.0;
+    paired::wilson90(xfl_base, xrc_base, b_lo, b_hi);
+    paired::wilson90(xfl_cand, xrc_cand, c_lo, c_hi);
+    return c_lo > std::max(ctrl_hi, b_hi);
+}
+
+// ---- the shift cap's multipliers (both move by the same factor: the ratio unc / none is kept; each stays in [0.25, 8] x the median)
+constexpr double kCapLo = 0.25;
+constexpr double kCapHi = 8.0;
+
+/// The candidate of a cap test: both multipliers times f = step^d, f limited so that both stay in [kCapLo, kCapHi].  false when the candidate
+/// is the base (f clamps to 1, or a multiplier is not positive): nothing to test.
+inline bool cap_candidate(double unc, double none, double step, int d, double& cand_unc, double& cand_none) {
+    if (!(unc > 0.0) || !(none > 0.0) || !(step > 0.0)) return false;
+    const double hi = std::min(kCapHi / unc, kCapHi / none);
+    const double lo = std::max(kCapLo / unc, kCapLo / none);
+    const double f = std::min(hi, std::max(lo, std::pow(step, (double) d)));
+    if (std::fabs(f - 1.0) < 1e-12) return false;
+    cand_unc = unc * f;
+    cand_none = none * f;
+    return true;
+}
+
+// ---- the prefetch count (per cut row, STRATA_RECHECK_PREFETCH_MAX): x or / 1.5, rounded, at least one step; 0 is a candidate; range 0-64
+
+constexpr long long kPrefetchLo = 0;
+constexpr long long kPrefetchHi = 64;
+
+/// The candidate of a prefetch test in direction d (+1 up, -1 down).  false when it equals n (at a bound): nothing to test.
+inline bool prefetch_candidate(long long n, int d, long long& out) {
+    const int dir = d < 0 ? -1 : 1;
+    long long m = std::llround((double) n * std::pow(1.5, (double) dir));
+    if (m == n) m = n + dir;
+    m = std::max(kPrefetchLo, std::min(kPrefetchHi, m));
+    if (m == n) return false;
+    out = m;
+    return true;
+}
+
+/// The persisted state of the two tests: the chosen values, their step and direction states (paired::BudgetStep, paired::DirState).
+struct Tune {
+    bool set = false;          ///< a test has been decided or the values were saved: the env values are no longer the start
+    double cap_unc = 1.5;      ///< the uncertain-row cap multiplier (x the running median)
+    double cap_none = 1.0;     ///< the none-row cap multiplier
+    float cap_step = 1.25f;    ///< the cap test's step factor
+    int cap_last_win = 0;
+    int cap_first = 1, cap_stage = 0;   ///< the cap test's direction state
+    long long prefetch = 12;   ///< the prefetch count per cut row
+    int pf_first = 1, pf_stage = 0;     ///< the prefetch test's direction state
+    double k_mult = 1.0;       ///< step H2: the margin m (k_eff = m x k_safe), range 0.6-1.5
+    float k_step = 1.25f;      ///< the margin test's step factor
+    int k_last_win = 0;
+    int k_first = 1, k_stage = 0;       ///< the margin test's direction state
+};
+
+}  // namespace strata::core::tune
