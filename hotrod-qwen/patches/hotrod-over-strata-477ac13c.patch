diff --git a/src/kernels/route_rows_parity.cu b/src/kernels/route_rows_parity.cu
new file mode 100644
index 000000000..f23f456c2
--- /dev/null
+++ b/src/kernels/route_rows_parity.cu
@@ -0,0 +1,440 @@
+// route_rows_parity - SPEC-recheck-cheap change 1: the fragile flag as a row count on the two routing kernels (GPU, synthetic, no model).
+//
+// route_fragile_rows(n): a row t of the window with t < n moves nothing (route_resident_k and the mask kernel return the router's own ids,
+// the weights as they were, row_shift 0); the rows t >= n are the flag-clear run's, bit for bit (a row is independent of the others: one
+// warp per token).  Checked for every n from 0 to the rows of the window and for n = a large value, which must equal the old control
+// window (route_fragile_control(true)) bit for bit, ids, weights, row_shift and counters.
+//
+// Run: route_rows_parity   (ctest: route_rows_parity; GPU, synthetic, no model)
+#include "strata/core/recheck_cheap.hpp"
+#include "strata/kernels/native_router.hpp"
+
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <string>
+#include <vector>
+
+namespace {
+void ck(cudaError_t e, const char* what) {
+    if (e != cudaSuccess) {
+        std::fprintf(stderr, "%s: %s\n", what, cudaGetErrorString(e));
+        std::exit(2);
+    }
+}
+
+constexpr int kExperts = 512;
+constexpr int kTop = 10;
+constexpr int kMaxTok = 8;
+constexpr int kMaskLo = 6;   // the mask's floor (route_mask_set): ranks lo-1 and up are the moves
+constexpr int kAll = strata::core::recheck::kAllRows;
+
+// The router's top-10 of a row, ties to the smallest index.
+void top10(const float* l, int32_t* out) {
+    for (int r = 0; r < kTop; ++r) {
+        float bv = -INFINITY;
+        int bi = -1;
+        for (int f = 0; f < kExperts; ++f) {
+            bool used = false;
+            for (int q = 0; q < r; ++q) used |= out[q] == f;
+            if (used) continue;
+            if (l[f] > bv) {
+                bv = l[f];
+                bi = f;
+            }
+        }
+        out[r] = bi;
+    }
+}
+
+// The softmax over the ten picks, as the kernels write their weights.
+void softmax_picks(const float* l, const int32_t* id, float* w) {
+    float m = -INFINITY;
+    for (int r = 0; r < kTop; ++r) m = std::max(m, l[id[r]]);
+    float ex[kTop], sum = 0.0f;
+    for (int r = 0; r < kTop; ++r) {
+        ex[r] = std::exp(l[id[r]] - m);
+        sum += ex[r];
+    }
+    for (int r = 0; r < kTop; ++r) w[r] = ex[r] / sum;
+}
+
+// One run's outputs (the device buffers read back).
+struct Out {
+    std::vector<int32_t> ids;
+    std::vector<float> w, rs;
+    unsigned long long st[4] = {0, 0, 0, 0};
+};
+
+bool same_bits(const float* a, const float* b, size_t n) { return std::memcmp(a, b, n * sizeof(float)) == 0; }
+
+}  // namespace
+
+int main() {
+    std::mt19937 rng(20261108u + 11u);
+    std::uniform_real_distribution<float> ud(-3.0f, 3.0f);
+    std::uniform_int_distribution<int> coin(0, 99);
+
+    std::vector<float> logits((size_t) kMaxTok * kExperts), w_in((size_t) kMaxTok * kTop, 0.0f);
+    std::vector<int32_t> ids_in((size_t) kMaxTok * kTop, -1), res(kExperts);
+    std::vector<uint8_t> mask(kExperts, 0);
+    std::vector<float> rs0((size_t) kMaxTok, 0.0f);
+
+    float *d_logits = nullptr, *d_w = nullptr, *d_rs = nullptr;
+    int32_t *d_ids = nullptr, *d_res = nullptr;
+    unsigned long long* d_stats = nullptr;
+    ck(cudaMalloc(&d_logits, logits.size() * sizeof(float)), "alloc logits");
+    ck(cudaMalloc(&d_w, w_in.size() * sizeof(float)), "alloc weights");
+    ck(cudaMalloc(&d_rs, rs0.size() * sizeof(float)), "alloc row_shift");
+    ck(cudaMalloc(&d_ids, ids_in.size() * sizeof(int32_t)), "alloc ids");
+    ck(cudaMalloc(&d_res, res.size() * sizeof(int32_t)), "alloc res");
+    ck(cudaMalloc(&d_stats, 4 * sizeof(unsigned long long)), "alloc stats");
+    cudaStream_t stream = nullptr;
+    ck(cudaStreamCreate(&stream), "stream");
+
+    if (!strata::kernels::route_fragile_control_alloc()) {
+        std::fprintf(stderr, "route_fragile_control_alloc: no host-mapped flag\n");
+        return 2;
+    }
+    if (!strata::kernels::route_shift_cap_alloc()) {   // SPEC-recheck-gated step F: the cap array and its counters
+        std::fprintf(stderr, "route_shift_cap_alloc: no host-mapped cap array\n");
+        return 2;
+    }
+    std::string msg;
+    std::vector<uint8_t> mask_host(kExperts, 0);
+    if (!strata::kernels::route_mask_set(mask_host.data(), 1, kExperts, kMaskLo, -1.0f, msg)) {
+        std::fprintf(stderr, "route_mask_set: %s\n", msg.c_str());
+        return 2;
+    }
+    const uint8_t* d_mask = strata::kernels::route_mask_layer(0, kExperts);
+    if (d_mask == nullptr) {
+        std::fprintf(stderr, "route_mask_layer: no device mask\n");
+        return 2;
+    }
+
+    // one run's inputs: the flag (a row count n, or the old control window when ctl), the router's picks, zero shift and counters
+    auto set_run = [&](int n, bool ctl) {
+        if (ctl) strata::kernels::route_fragile_control(true);
+        else strata::kernels::route_fragile_rows(n);
+        strata::kernels::route_cfg_init(0, kTop - 1, 1e30f, -1.0f);   // every non-resident pick would move if the flag were clear
+        ck(cudaMemcpy(d_ids, ids_in.data(), ids_in.size() * sizeof(int32_t), cudaMemcpyHostToDevice), "up ids");
+        ck(cudaMemcpy(d_w, w_in.data(), w_in.size() * sizeof(float), cudaMemcpyHostToDevice), "up w");
+        ck(cudaMemcpy(d_rs, rs0.data(), rs0.size() * sizeof(float), cudaMemcpyHostToDevice), "up rs");
+        ck(cudaMemset(d_stats, 0, 4 * sizeof(unsigned long long)), "zero stats");
+    };
+    auto launch_resident = [&](int n_tok) {
+        strata::kernels::native_route_resident(d_logits, d_ids, d_w, d_res, n_tok, d_stats, (void*) stream, nullptr, nullptr, nullptr,
+                                               nullptr, nullptr, nullptr, d_rs);
+    };
+    auto read_resident = [&](int n_tok, Out& o) {
+        ck(cudaStreamSynchronize(stream), "sync resident");
+        o.ids.assign((size_t) n_tok * kTop, 0);
+        o.w.assign((size_t) n_tok * kTop, 0.0f);
+        o.rs.assign((size_t) n_tok, 0.0f);
+        ck(cudaMemcpy(o.ids.data(), d_ids, o.ids.size() * sizeof(int32_t), cudaMemcpyDeviceToHost), "down ids");
+        ck(cudaMemcpy(o.w.data(), d_w, o.w.size() * sizeof(float), cudaMemcpyDeviceToHost), "down w");
+        ck(cudaMemcpy(o.rs.data(), d_rs, o.rs.size() * sizeof(float), cudaMemcpyDeviceToHost), "down rs");
+        ck(cudaMemcpy(o.st, d_stats, sizeof o.st, cudaMemcpyDeviceToHost), "down stats");
+    };
+
+    const int cases = 60;
+    int bad = 0;
+    long long rows_held = 0, rows_checked = 0, clear_swaps = 0, clear_mask_moves = 0, mask_rows_held = 0;
+    for (int c = 0; c < cases; ++c) {
+        const int n_tok = 1 + (c % kMaxTok);
+        const bool ties = coin(rng) < 50;
+        for (size_t i = 0; i < logits.size(); ++i) {
+            float v = ud(rng);
+            if (ties) v = std::round(v * 2.0f) * 0.5f;
+            logits[i] = v;
+        }
+        for (int t = 0; t < n_tok; ++t) {
+            int32_t* row = ids_in.data() + (size_t) t * kTop;
+            top10(logits.data() + (size_t) t * kExperts, row);
+            softmax_picks(logits.data() + (size_t) t * kExperts, row, w_in.data() + (size_t) t * kTop);
+        }
+        for (int e = 0; e < kExperts; ++e) res[e] = coin(rng) < 50 ? (int32_t) (e % 7) : -1;
+        for (int e = 0; e < kExperts; ++e) mask[e] = coin(rng) < 30 ? 1 : 0;
+        strata::kernels::route_mask_update(mask);
+        ck(cudaMemcpy(d_logits, logits.data(), logits.size() * sizeof(float), cudaMemcpyHostToDevice), "up logits");
+        ck(cudaMemcpy(d_res, res.data(), res.size() * sizeof(int32_t), cudaMemcpyHostToDevice), "up res");
+
+        // ---- route_resident_k: the flag-clear run (row count 0) is the reference of every row >= n
+        Out ref;
+        strata::kernels::route_mask_control(false);
+        set_run(0, false);
+        launch_resident(n_tok);
+        read_resident(n_tok, ref);
+        clear_swaps += (long long) ref.st[1];
+
+        // n = 0 is the flag-clear run (again, after a row count was set and cleared)
+        for (int n = 0; n <= n_tok + 1; ++n) {
+            Out got;
+            set_run(n, false);
+            launch_resident(n_tok);
+            read_resident(n_tok, got);
+            ++rows_checked;
+            for (int t = 0; t < n_tok; ++t) {
+                const int32_t* gi = got.ids.data() + (size_t) t * kTop;
+                const int32_t* ii = ids_in.data() + (size_t) t * kTop;
+                const float* gw = got.w.data() + (size_t) t * kTop;
+                const float* iw = w_in.data() + (size_t) t * kTop;
+                const float* rw = ref.w.data() + (size_t) t * kTop;
+                const bool held = t < n;
+                bool ok;
+                if (held) {
+                    // a held row: the router's picks, the weights untouched, no shift
+                    ok = std::memcmp(gi, ii, kTop * sizeof(int32_t)) == 0 && same_bits(gw, iw, kTop) && got.rs[(size_t) t] == 0.0f;
+                    ++rows_held;
+                } else {
+                    // a row past the count: the flag-clear run, bit for bit
+                    ok = std::memcmp(gi, ref.ids.data() + (size_t) t * kTop, kTop * sizeof(int32_t)) == 0 && same_bits(gw, rw, kTop) &&
+                         got.rs[(size_t) t] == ref.rs[(size_t) t];
+                }
+                if (!ok) {
+                    ++bad;
+                    std::printf("  case %d n_tok %d count %d row %d (%s): differs\n", c, n_tok, n, t, held ? "held" : "free");
+                }
+            }
+        }
+
+        // n = a large value is the old control window, bit for bit (ids, weights, row_shift, counters)
+        Out ctl, big;
+        set_run(0, true);
+        launch_resident(n_tok);
+        read_resident(n_tok, ctl);
+        set_run(kAll, false);
+        launch_resident(n_tok);
+        read_resident(n_tok, big);
+        const bool same_ctl = big.ids == ctl.ids && same_bits(big.w.data(), ctl.w.data(), big.w.size()) && big.rs == ctl.rs &&
+                              std::memcmp(big.st, ctl.st, sizeof big.st) == 0;
+        if (!same_ctl) {
+            ++bad;
+            std::printf("  case %d: a large row count is not the control window\n", c);
+        }
+        // the control window moves nothing: every pick is the router's
+        if (std::memcmp(big.ids.data(), ids_in.data(), (size_t) n_tok * kTop * sizeof(int32_t)) != 0 || big.st[1] != 0) {
+            ++bad;
+            std::printf("  case %d: the control window moved a pick\n", c);
+        }
+
+        // ---- the mask kernel: the same rule on its own (flags clear: the reference; a row count n keeps rows < n)
+        auto run_mask = [&](int n, bool ctl_flag, Out& o) {
+            strata::kernels::route_mask_control(ctl_flag);
+            strata::kernels::route_fragile_rows(n);
+            ck(cudaMemcpy(d_ids, ids_in.data(), ids_in.size() * sizeof(int32_t), cudaMemcpyHostToDevice), "up ids mask");
+            ck(cudaMemcpy(d_w, w_in.data(), w_in.size() * sizeof(float), cudaMemcpyHostToDevice), "up w mask");
+            ck(cudaMemcpy(d_rs, rs0.data(), rs0.size() * sizeof(float), cudaMemcpyHostToDevice), "up rs mask");
+            unsigned long long seen = 0, moved = 0;
+            strata::kernels::route_mask_read(seen, moved);   // drops the earlier counts
+            strata::kernels::native_route_mask(d_logits, d_ids, d_w, d_mask, n_tok, d_rs, (void*) stream);
+            ck(cudaStreamSynchronize(stream), "sync mask");
+            o.ids.assign((size_t) n_tok * kTop, 0);
+            o.w.assign((size_t) n_tok * kTop, 0.0f);
+            o.rs.assign((size_t) n_tok, 0.0f);
+            ck(cudaMemcpy(o.ids.data(), d_ids, o.ids.size() * sizeof(int32_t), cudaMemcpyDeviceToHost), "down ids mask");
+            ck(cudaMemcpy(o.w.data(), d_w, o.w.size() * sizeof(float), cudaMemcpyDeviceToHost), "down w mask");
+            ck(cudaMemcpy(o.rs.data(), d_rs, o.rs.size() * sizeof(float), cudaMemcpyDeviceToHost), "down rs mask");
+            strata::kernels::route_mask_read(seen, moved);
+            o.st[0] = seen;
+            o.st[1] = moved;
+        };
+        Out mref;
+        run_mask(0, false, mref);
+        clear_mask_moves += (long long) mref.st[1];
+        for (int n = 0; n <= n_tok + 1; ++n) {
+            Out got;
+            run_mask(n, false, got);
+            for (int t = 0; t < n_tok; ++t) {
+                const int32_t* gi = got.ids.data() + (size_t) t * kTop;
+                const float* gw = got.w.data() + (size_t) t * kTop;
+                bool ok;
+                if (t < n) {
+                    ok = std::memcmp(gi, ids_in.data() + (size_t) t * kTop, kTop * sizeof(int32_t)) == 0 &&
+                         same_bits(gw, w_in.data() + (size_t) t * kTop, kTop) && got.rs[(size_t) t] == 0.0f;
+                    ++mask_rows_held;
+                } else {
+                    ok = std::memcmp(gi, mref.ids.data() + (size_t) t * kTop, kTop * sizeof(int32_t)) == 0 &&
+                         same_bits(gw, mref.w.data() + (size_t) t * kTop, kTop) && got.rs[(size_t) t] == mref.rs[(size_t) t];
+                }
+                if (!ok) {
+                    ++bad;
+                    std::printf("  case %d mask n_tok %d count %d row %d: differs\n", c, n_tok, n, t);
+                }
+            }
+        }
+        // ---- SPEC-recheck-gated step F: the per-row shift cap (route_shift_cap_set).  No hold.  (a) a huge finite cap, (b) a cap equal to the
+        // uncapped row shift, are identical to the uncapped reference; (c) a random finite cap is never exceeded by the row's shift; (d) cap 0
+        // refuses every move with a positive shift, so the row shift is 0.  Both kernels.  Caps are reset to +inf after the section.
+        {
+            strata::kernels::route_fragile_hold(0u);
+            float capv[32];
+            auto set_caps = [&](float fill_v, bool use_ref, bool use_mref, bool random_frac) {
+                for (int i = 0; i < 32; ++i) capv[i] = INFINITY;
+                for (int t = 0; t < n_tok; ++t) {
+                    if (random_frac) capv[t] = std::uniform_real_distribution<float>(0.0f, 1.0f)(rng) * ref.rs[(size_t) t];
+                    else if (use_ref) capv[t] = ref.rs[(size_t) t];
+                    else if (use_mref) capv[t] = mref.rs[(size_t) t];
+                    else capv[t] = fill_v;
+                }
+                strata::kernels::route_shift_cap_set(capv, 32);
+            };
+            Out rcap;
+            auto resident_run = [&](Out& o) {
+                set_run(0, false);
+                launch_resident(n_tok);
+                read_resident(n_tok, o);
+            };
+            // reference of the mask kernel (flag clear, uncapped): mref is computed above for this case
+            auto same_run = [&](const Out& a, const Out& b, const char* what) {
+                for (int t = 0; t < n_tok; ++t) {
+                    const size_t o = (size_t) t * kTop;
+                    if (std::memcmp(a.ids.data() + o, b.ids.data() + o, kTop * sizeof(int32_t)) != 0 || !same_bits(a.w.data() + o, b.w.data() + o, kTop) ||
+                        a.rs[(size_t) t] != b.rs[(size_t) t]) {
+                        ++bad;
+                        std::printf("  case %d %s row %d: differs\n", c, what, t);
+                    }
+                }
+            };
+            // (a) a huge finite cap, resident and mask
+            set_caps(1e30f, false, false, false);
+            resident_run(rcap);
+            same_run(rcap, ref, "shift cap 1e30 (resident)");
+            Out mcap;
+            run_mask(0, false, mcap);
+            same_run(mcap, mref, "shift cap 1e30 (mask)");
+            // (b) each row's cap is its uncapped shift: no move passes it
+            set_caps(0.0f, true, false, false);
+            resident_run(rcap);
+            same_run(rcap, ref, "shift cap = the uncapped shift (resident)");
+            set_caps(0.0f, false, true, false);
+            run_mask(0, false, mcap);
+            same_run(mcap, mref, "shift cap = the uncapped shift (mask)");
+            // (c) a random finite cap per row: the row's shift never exceeds it
+            set_caps(0.0f, false, false, true);
+            resident_run(rcap);
+            for (int t = 0; t < n_tok; ++t)
+                if (rcap.rs[(size_t) t] > capv[t]) {
+                    ++bad;
+                    std::printf("  case %d shift cap (resident) row %d: shift %.6f above the cap %.6f\n", c, t, rcap.rs[(size_t) t], capv[t]);
+                }
+            run_mask(0, false, mcap);
+            for (int t = 0; t < n_tok; ++t)
+                if (mcap.rs[(size_t) t] > capv[t]) {
+                    ++bad;
+                    std::printf("  case %d shift cap (mask) row %d: shift %.6f above the cap %.6f\n", c, t, mcap.rs[(size_t) t], capv[t]);
+                }
+            // (d) cap 0: no move with a positive shift; the row shift stays 0 (rows with only zero-gap moves may still move)
+            set_caps(0.0f, false, false, false);
+            resident_run(rcap);
+            for (int t = 0; t < n_tok; ++t)
+                if (rcap.rs[(size_t) t] != 0.0f) {
+                    ++bad;
+                    std::printf("  case %d cap 0 (resident) row %d: shift %.6f\n", c, t, rcap.rs[(size_t) t]);
+                }
+            run_mask(0, false, mcap);
+            for (int t = 0; t < n_tok; ++t)
+                if (mcap.rs[(size_t) t] != 0.0f) {
+                    ++bad;
+                    std::printf("  case %d cap 0 (mask) row %d: shift %.6f\n", c, t, mcap.rs[(size_t) t]);
+                }
+            // the caps are reset: every later section sees +inf
+            for (int i = 0; i < 32; ++i) capv[i] = INFINITY;
+            strata::kernels::route_shift_cap_set(capv, 32);
+        }
+        // ---- SPEC-recheck-gated step A: the row bitmask (route_fragile_hold).  Bit r holds row r: its picks, weights and row_shift stay the
+        // router's; every other row is the flag-clear run's, bit for bit.  0xFFFFFFFF is the control window (checked above as a count).
+        {
+            std::uniform_int_distribution<uint32_t> ub(0u, 0xFFFFFFFFu);
+            const uint32_t rows_mask = (1u << n_tok) - 1u;
+            for (int m = 0; m < 4; ++m) {
+                const uint32_t bits = m == 0 ? 0xFFFFFFFFu : (m == 1 ? 0u : (ub(rng) & rows_mask));
+                // the resident kernel
+                strata::kernels::route_fragile_hold(bits);
+                ck(cudaMemcpy(d_ids, ids_in.data(), ids_in.size() * sizeof(int32_t), cudaMemcpyHostToDevice), "up ids bits");
+                ck(cudaMemcpy(d_w, w_in.data(), w_in.size() * sizeof(float), cudaMemcpyHostToDevice), "up w bits");
+                ck(cudaMemcpy(d_rs, rs0.data(), rs0.size() * sizeof(float), cudaMemcpyHostToDevice), "up rs bits");
+                ck(cudaMemset(d_stats, 0, 4 * sizeof(unsigned long long)), "zero stats bits");
+                Out got;
+                launch_resident(n_tok);
+                read_resident(n_tok, got);
+                for (int t = 0; t < n_tok; ++t) {
+                    const bool held = t < 32 ? ((bits >> t) & 1u) != 0u : bits == 0xFFFFFFFFu;
+                    const int32_t* gi = got.ids.data() + (size_t) t * kTop;
+                    const float* gw = got.w.data() + (size_t) t * kTop;
+                    bool ok;
+                    if (held) {
+                        ok = std::memcmp(gi, ids_in.data() + (size_t) t * kTop, kTop * sizeof(int32_t)) == 0 &&
+                             same_bits(gw, w_in.data() + (size_t) t * kTop, kTop) && got.rs[(size_t) t] == 0.0f;
+                        ++rows_held;
+                    } else {
+                        ok = std::memcmp(gi, ref.ids.data() + (size_t) t * kTop, kTop * sizeof(int32_t)) == 0 &&
+                             same_bits(gw, ref.w.data() + (size_t) t * kTop, kTop) && got.rs[(size_t) t] == ref.rs[(size_t) t];
+                    }
+                    if (!ok) {
+                        ++bad;
+                        std::printf("  case %d resident bits 0x%08x row %d (%s): differs\n", c, bits, t, held ? "held" : "free");
+                    }
+                }
+                // the mask kernel
+                strata::kernels::route_mask_control(false);
+                strata::kernels::route_fragile_hold(bits);
+                ck(cudaMemcpy(d_ids, ids_in.data(), ids_in.size() * sizeof(int32_t), cudaMemcpyHostToDevice), "up ids mask bits");
+                ck(cudaMemcpy(d_w, w_in.data(), w_in.size() * sizeof(float), cudaMemcpyHostToDevice), "up w mask bits");
+                ck(cudaMemcpy(d_rs, rs0.data(), rs0.size() * sizeof(float), cudaMemcpyHostToDevice), "up rs mask bits");
+                strata::kernels::native_route_mask(d_logits, d_ids, d_w, d_mask, n_tok, d_rs, (void*) stream);
+                ck(cudaStreamSynchronize(stream), "sync mask bits");
+                Out gm;
+                gm.ids.assign((size_t) n_tok * kTop, 0);
+                gm.w.assign((size_t) n_tok * kTop, 0.0f);
+                gm.rs.assign((size_t) n_tok, 0.0f);
+                ck(cudaMemcpy(gm.ids.data(), d_ids, gm.ids.size() * sizeof(int32_t), cudaMemcpyDeviceToHost), "down ids mask bits");
+                ck(cudaMemcpy(gm.w.data(), d_w, gm.w.size() * sizeof(float), cudaMemcpyDeviceToHost), "down w mask bits");
+                ck(cudaMemcpy(gm.rs.data(), d_rs, gm.rs.size() * sizeof(float), cudaMemcpyDeviceToHost), "down rs mask bits");
+                for (int t = 0; t < n_tok; ++t) {
+                    const bool held = t < 32 ? ((bits >> t) & 1u) != 0u : bits == 0xFFFFFFFFu;
+                    const int32_t* gi = gm.ids.data() + (size_t) t * kTop;
+                    const float* gw = gm.w.data() + (size_t) t * kTop;
+                    bool ok;
+                    if (held) {
+                        ok = std::memcmp(gi, ids_in.data() + (size_t) t * kTop, kTop * sizeof(int32_t)) == 0 &&
+                             same_bits(gw, w_in.data() + (size_t) t * kTop, kTop) && gm.rs[(size_t) t] == 0.0f;
+                        ++mask_rows_held;
+                    } else {
+                        ok = std::memcmp(gi, mref.ids.data() + (size_t) t * kTop, kTop * sizeof(int32_t)) == 0 &&
+                             same_bits(gw, mref.w.data() + (size_t) t * kTop, kTop) && gm.rs[(size_t) t] == mref.rs[(size_t) t];
+                    }
+                    if (!ok) {
+                        ++bad;
+                        std::printf("  case %d mask bits 0x%08x row %d (%s): differs\n", c, bits, t, held ? "held" : "free");
+                    }
+                }
+            }
+        }
+        Out mbig, mctl;
+        run_mask(kAll, false, mbig);
+        run_mask(0, true, mctl);   // the old control window (the mask's own flag)
+        if (mbig.ids != mctl.ids || !same_bits(mbig.w.data(), mctl.w.data(), mbig.w.size()) || mbig.rs != mctl.rs) {
+            ++bad;
+            std::printf("  case %d: a large mask row count is not the mask control window\n", c);
+        }
+    }
+    strata::kernels::route_mask_control(false);
+    strata::kernels::route_fragile_rows(0);
+
+    std::printf("route_rows_parity: %d cases, %lld row counts, %lld held resident rows, %lld held mask rows; flag-clear swaps %lld, "
+                "flag-clear mask moves %lld\n",
+                cases, rows_checked, rows_held, mask_rows_held, clear_swaps, clear_mask_moves);
+    if (clear_swaps == 0 || clear_mask_moves == 0) {
+        std::printf("route_rows_parity: the flag-clear runs moved nothing - the test proved nothing\n");
+        return 1;
+    }
+    std::printf(bad ? "route_rows_parity: %d FAILURES\n" : "route_rows_parity OK\n", bad);
+    return bad ? 1 : 0;
+}
diff --git a/src/kernels/router_fuse_parity.cu b/src/kernels/router_fuse_parity.cu
new file mode 100644
index 000000000..2e0ee8811
--- /dev/null
+++ b/src/kernels/router_fuse_parity.cu
@@ -0,0 +1,321 @@
+// router_fuse_parity - SPEC-router-fuse step 1: the look-ahead's fused path against today's per-distance chain, bit for bit.
+//
+// Today's chain, per dist d in {1, 2, 4} of a layer l: bf16_gemv_fp32_mmvf_multi (the target layer's router on layer l's MoE input),
+// la_learn_forward (only when the learner is on), native_router_top10_multi, native_route_mask (the target layer's mask, resident-aware
+// or not), route_pred_edge_skip, route_pred_tail_read.  The fused path: bf16_gemv_fp32_mmvf_multi3 (all dists in one launch), the
+// learner per dist, route_pred_select (all dists' top-10 / mask / edge / tail in one launch).
+// Checked on synthetic router-shaped inputs (random activations, weights at router scale, residency ~30%, the mask on the last 128 experts):
+// the logits (after the learner) bitwise, the weights bitwise, the ids exactly, the edge-skip and tail-read counters equal.
+// Exact float ties are counted and reported (a row whose top-11 logits hold two equal values): a tie is the one place an id could
+// legitimately differ between two correct orders, so it is reported, and an id mismatch on a row without a tie fails the test.
+//
+// Run: router_fuse_parity   (GPU, synthetic, no model; needs ~40 MB)
+#include "strata/kernels/bf16_gemv.hpp"
+#include "strata/kernels/native_router.hpp"
+
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <functional>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <string>
+#include <vector>
+
+namespace K = strata::kernels;
+
+namespace {
+constexpr int kL = 8, kNE = 512, kK = 10, kMaxN = 8, kN = 2560;
+constexpr int kLo = 3, kHi = 9;
+
+void ck(cudaError_t e, const char* what) {
+    if (e != cudaSuccess) { std::fprintf(stderr, "%s: %s\n", what, cudaGetErrorString(e)); std::exit(2); }
+}
+uint16_t bf16(float f) { uint32_t u; std::memcpy(&u, &f, 4); return (uint16_t) ((u + 0x7fff + ((u >> 16) & 1)) >> 16); }
+
+struct Config {
+    const char* name;
+    float margin, edge;
+    bool learn;     // the learner's forward per dist
+    bool mres;      // the mask is resident-aware (its res / ring / cheap slices)
+    int tail_all;   // route_pred_tail_read's all_ranks
+};
+
+// the host table's index of (target layer, slot, row, rank): route_pred_dev's slab order
+size_t slab(int64_t target, int slot) { return ((size_t) target * K::kRoutePredDists + (size_t) slot) * 80; }
+}  // namespace
+
+// ---- step 2: the layer's own post-routing stages, the separate calls against native_route_post (bit for bit) ----
+// The own routing of layer l: the router GEMV and the top-10 (the same ids and weights start both chains), then the mask, the resident
+// stage and (with the learner) the label copy: the separate calls, or the one launch.  Compared: ids exact, weights and row_shift bitwise,
+// the resident counters and the mask's seen / moved counts equal, the label bitwise.
+int run_post_checks(const float* dx, const uint16_t* dwall, const int32_t* dres, bool learner_ok, const Config& cfg, cudaStream_t s,
+                    int n, int l) {
+    const size_t nl = (size_t) kMaxN * kNE;
+    float *dlog, *dw_a, *dw_b, *dsh_a, *dsh_b;
+    int32_t *dids_a, *dids_b;
+    unsigned long long *dst_a, *dst_b;
+    ck(cudaMalloc((void**) &dlog, nl * 4), "post logits");
+    ck(cudaMalloc((void**) &dw_a, kMaxN * kK * 4), "post w a");
+    ck(cudaMalloc((void**) &dw_b, kMaxN * kK * 4), "post w b");
+    ck(cudaMalloc((void**) &dsh_a, kMaxN * 4), "post shift a");
+    ck(cudaMalloc((void**) &dsh_b, kMaxN * 4), "post shift b");
+    ck(cudaMalloc((void**) &dids_a, kMaxN * kK * 4), "post ids a");
+    ck(cudaMalloc((void**) &dids_b, kMaxN * kK * 4), "post ids b");
+    ck(cudaMalloc((void**) &dst_a, 16 * 8), "post stats a");
+    ck(cudaMalloc((void**) &dst_b, 16 * 8), "post stats b");
+    ck(cudaMemsetAsync(dsh_a, 0, kMaxN * 4, s), "z");
+    ck(cudaMemsetAsync(dsh_b, 0, kMaxN * 4, s), "z");
+    ck(cudaMemsetAsync(dst_a, 0, 16 * 8, s), "z");
+    ck(cudaMemsetAsync(dst_b, 0, 16 * 8, s), "z");
+    K::bf16_gemv_fp32_mmvf_multi(dx, kN, dwall + (size_t) l * kNE * kN, dlog, kNE, kN, kNE, n, s);
+    K::native_router_top10_multi(dlog, dids_a, dw_a, n, s);
+    ck(cudaMemcpyAsync(dids_b, dids_a, kMaxN * kK * 4, cudaMemcpyDeviceToDevice, s), "ids copy");
+    ck(cudaMemcpyAsync(dw_b, dw_a, kMaxN * kK * 4, cudaMemcpyDeviceToDevice, s), "w copy");
+    ck(cudaStreamSynchronize(s), "post start");
+    const bool label_on = cfg.learn && learner_ok;
+    const uint8_t* mask_l = K::route_mask_layer(l, kL);
+    const int32_t* res_l = dres + (size_t) l * kNE;
+    const int32_t* mres = cfg.mres ? dres + (size_t) l * kNE : nullptr;
+    unsigned long long seen = 0, moved = 0;
+    K::route_mask_read(seen, moved);   // (reset the counters)
+
+    // ---- the separate calls ----
+    if (label_on) K::la_learn_label(l, dlog, n, s);
+    K::native_route_mask(dlog, dids_a, dw_a, mask_l, n, dsh_a, s, nullptr, l, 0, mres, nullptr, nullptr);
+    K::native_route_resident(dlog, dids_a, dw_a, res_l, n, dst_a, s, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, dsh_a, nullptr,
+                             nullptr, l, nullptr, nullptr, 0);
+    ck(cudaStreamSynchronize(s), "post ref");
+    unsigned long long ref_seen = 0, ref_moved = 0;
+    K::route_mask_read(ref_seen, ref_moved);
+    std::vector<float> lab_ref((size_t) n * kNE, 0.f), lab_fus((size_t) n * kNE, 0.f);
+    if (label_on) ck(cudaMemcpy(lab_ref.data(), K::la_learn_label_dev(l, n), lab_ref.size() * 4, cudaMemcpyDeviceToHost), "lab ref");
+
+    // ---- the one launch ----
+    K::RoutePostArgs pa{};
+    pa.logits = dlog; pa.ids = dids_b; pa.weights = dw_b; pa.n_tok = n; pa.layer = l; pa.row_base = 0;
+    pa.mask = mask_l; pa.mres = mres; pa.row_shift = dsh_b; pa.res = res_l; pa.rstats = dst_b;
+    pa.label = label_on ? K::la_learn_label_dev(l, n) : nullptr;
+    K::native_route_post(pa, s);
+    ck(cudaStreamSynchronize(s), "post fused");
+    unsigned long long fus_seen = 0, fus_moved = 0;
+    K::route_mask_read(fus_seen, fus_moved);
+    if (label_on) ck(cudaMemcpy(lab_fus.data(), K::la_learn_label_dev(l, n), lab_fus.size() * 4, cudaMemcpyDeviceToHost), "lab fus");
+
+    // ---- compare ----
+    std::vector<int32_t> ia(kMaxN * kK), ib(kMaxN * kK);
+    std::vector<float> wa(kMaxN * kK), wb(kMaxN * kK), sa(kMaxN), sb(kMaxN);
+    unsigned long long ta[16], tb2[16];
+    ck(cudaMemcpy(ia.data(), dids_a, ia.size() * 4, cudaMemcpyDeviceToHost), "ia");
+    ck(cudaMemcpy(ib.data(), dids_b, ib.size() * 4, cudaMemcpyDeviceToHost), "ib");
+    ck(cudaMemcpy(wa.data(), dw_a, wa.size() * 4, cudaMemcpyDeviceToHost), "wa");
+    ck(cudaMemcpy(wb.data(), dw_b, wb.size() * 4, cudaMemcpyDeviceToHost), "wb");
+    ck(cudaMemcpy(sa.data(), dsh_a, sa.size() * 4, cudaMemcpyDeviceToHost), "sa");
+    ck(cudaMemcpy(sb.data(), dsh_b, sb.size() * 4, cudaMemcpyDeviceToHost), "sb");
+    ck(cudaMemcpy(ta, dst_a, sizeof ta, cudaMemcpyDeviceToHost), "ta");
+    ck(cudaMemcpy(tb2, dst_b, sizeof tb2, cudaMemcpyDeviceToHost), "tb");
+    int id_bad = 0, w_bad = 0, sh_bad = 0, lab_bad = 0, ties = 0;
+    for (int r = 0; r < n; ++r) {
+        bool same = true;
+        for (int k = 0; k < kK; ++k) same &= ia[r * kK + k] == ib[r * kK + k];
+        if (!same) ++id_bad;
+        if (std::memcmp(&wa[r * kK], &wb[r * kK], kK * 4) != 0) ++w_bad;
+        if (std::memcmp(&sa[r], &sb[r], 4) != 0) ++sh_bad;
+    }
+    if (label_on && std::memcmp(lab_ref.data(), lab_fus.data(), lab_ref.size() * 4) != 0) lab_bad = 1;
+    for (int i = 0; i < 16; ++i)
+        if (ta[i] != tb2[i]) { ++id_bad; break; }
+    if (ref_seen != fus_seen || ref_moved != fus_moved) ++id_bad;
+    // the ties of the own logits (as above): reported only
+    for (int r = 0; r < n; ++r) {
+        std::vector<float> row(kNE);
+        ck(cudaMemcpy(row.data(), dlog + (size_t) r * kNE, kNE * 4, cudaMemcpyDeviceToHost), "row");
+        std::partial_sort(row.begin(), row.begin() + 11, row.end(), std::greater<float>());
+        for (int q = 0; q + 1 < 11; ++q)
+            if (row[q] == row[q + 1]) { ++ties; break; }
+    }
+    const bool ok = id_bad == 0 && w_bad == 0 && sh_bad == 0 && lab_bad == 0;
+    std::printf("%s post  %-58s n=%d  ids-diff %d  weights-diff %d  shift-diff %d  label-diff %d  mask seen/moved %llu/%llu vs %llu/%llu  stats %s  ties(top11) %d\n",
+                ok ? "PASS" : "FAIL", cfg.name, n, id_bad, w_bad, sh_bad, lab_bad, ref_seen, ref_moved, fus_seen, fus_moved,
+                std::memcmp(ta, tb2, sizeof ta) == 0 ? "equal" : "DIFFER", ties);
+    cudaFree(dlog); cudaFree(dw_a); cudaFree(dw_b); cudaFree(dsh_a); cudaFree(dsh_b); cudaFree(dids_a); cudaFree(dids_b);
+    cudaFree(dst_a); cudaFree(dst_b);
+    return ok ? 0 : 1;
+}
+
+int main() {
+    std::setvbuf(stdout, nullptr, _IONBF, 0);
+    int bad = 0;
+    std::mt19937 rng(17);
+    std::normal_distribution<float> nd(0.f, 1.f);
+
+    // weights: one router per target layer (bf16 [512 x N]) at router scale, activations ~N(0,1)
+    std::vector<uint16_t> wh((size_t) kL * kNE * kN);
+    for (auto& v : wh) v = bf16(0.05f * nd(rng));
+    uint16_t* dwall;
+    ck(cudaMalloc((void**) &dwall, wh.size() * 2), "weights");
+    ck(cudaMemcpy(dwall, wh.data(), wh.size() * 2, cudaMemcpyHostToDevice), "weights up");
+    std::vector<float> xh((size_t) kMaxN * kN);
+    for (auto& v : xh) v = nd(rng);
+    float* dx;
+    ck(cudaMalloc((void**) &dx, xh.size() * 4), "x");
+    ck(cudaMemcpy(dx, xh.data(), xh.size() * 4, cudaMemcpyHostToDevice), "x up");
+
+    std::vector<int32_t> res((size_t) kL * kNE);
+    std::vector<uint8_t> mask((size_t) kL * kNE);
+    for (int l = 0; l < kL; ++l)
+        for (int e = 0; e < kNE; ++e) {
+            res[(size_t) l * kNE + e] = (rng() % 10) < 3 ? (int32_t) (e % 64) : -1;
+            mask[(size_t) l * kNE + e] = e >= kNE - 128 ? 1 : 0;
+        }
+    int32_t* dres;
+    ck(cudaMalloc((void**) &dres, res.size() * 4), "res");
+    ck(cudaMemcpy(dres, res.data(), res.size() * 4, cudaMemcpyHostToDevice), "res up");
+
+    std::string msg;
+    if (!K::route_mask_set(mask.data(), kL, kNE, kLo, 1.0f, msg, kLo)) { std::fprintf(stderr, "route_mask_set: %s\n", msg.c_str()); return 2; }
+    // SPEC-recheck-gated: the hold bitmask and the per-row shift caps the post-routing comparison runs with (their third pass, below)
+    if (!K::route_fragile_control_alloc() || !K::route_shift_cap_alloc()) { std::fprintf(stderr, "hold / cap flags: no host-mapped memory\n"); return 2; }
+    K::route_pred_alloc(kL);
+    K::route_pred_edge_skip_alloc();
+    K::route_pred_tail_read_alloc();
+    const bool learner_ok = K::la_learn_alloc(kL, kN, kLo, false, msg);
+    if (!learner_ok) std::printf("note: learner not allocated (%s); the learner configs are skipped\n", msg.c_str());
+
+    cudaStream_t s;
+    ck(cudaStreamCreate(&s), "stream");
+    unsigned long long* dstat;   // route_resident is not part of this step; the mask's counters take a scratch
+    ck(cudaMalloc((void**) &dstat, 16 * 8), "stats");
+    ck(cudaMemset(dstat, 0, 16 * 8), "stats zero");
+
+    const Config cfgs[] = {
+        {"open rule (margin 1e30), edge 1, tail ranks >= lo", 1e30f, 1.0f, false, false, 0},
+        {"finite margin, learner, mask resident-aware, tail all ranks", 1.0f, 1.0f, true, true, 1},
+        {"margin 0.5, no edge (edge skip off), tail ranks >= lo", 0.5f, -1.0f, false, false, 0},
+    };
+    const int ns[] = {1, 2, 3, 5, 8};
+    const int l = 0;
+    const int dists[3] = {1, 2, 4};
+    for (const Config& cfg : cfgs) {
+        if (cfg.learn && !learner_ok) continue;
+        K::route_cfg_init(kLo, kHi, cfg.margin, cfg.edge, 0.f, 0, 1.f, 0.f, 0.f, 0.f, 0.f);
+        for (int n : ns) {
+            // ---- today's chain (dists sequential, the one route scratch) ----
+            std::vector<float> ref_logits(3 * (size_t) kMaxN * kNE), ref_w(3 * (size_t) kMaxN * kK);
+            std::vector<int32_t> ref_ids(3 * (size_t) kMaxN * kK);
+            ck(cudaDeviceSynchronize(), "sync");
+            K::route_pred_edge_skips_take();
+            K::route_pred_tail_read_take();
+            for (int di = 0; di < 3; ++di) {
+                const int dist = dists[di], t = l + dist;
+                K::bf16_gemv_fp32_mmvf_multi(dx, kN, dwall + (size_t) t * kNE * kN, K::route_pred_logits(), kNE, kN, kNE, n, s);
+                if (cfg.learn) K::la_learn_forward(l, dist, dx, n, s);
+                ck(cudaStreamSynchronize(s), "sync l");
+                ck(cudaMemcpy(ref_logits.data() + (size_t) di * kMaxN * kNE, K::route_pred_logits(), (size_t) n * kNE * 4, cudaMemcpyDeviceToHost), "cp l");
+                K::native_router_top10_multi(K::route_pred_logits(), K::route_pred_dev(t, dist), K::route_pred_weights(), n, s);
+                K::native_route_mask(K::route_pred_logits(), K::route_pred_dev(t, dist), K::route_pred_weights(),
+                                     K::route_mask_layer(t, kL), n, nullptr, s, nullptr, t, 0,
+                                     cfg.mres ? dres + (size_t) t * kNE : nullptr, nullptr, nullptr);
+                if (cfg.edge >= 0.f) K::route_pred_edge_skip(K::route_pred_logits(), K::route_pred_dev(t, dist), dres + (size_t) t * kNE, n, s);
+                K::route_pred_tail_read(dres + (size_t) t * kNE, K::route_pred_dev(t, dist), n, s, cfg.tail_all);
+                ck(cudaStreamSynchronize(s), "sync chain");
+                const int32_t* hslab = K::route_pred_host() + slab(t, K::route_pred_slot(dist));
+                for (int r = 0; r < n; ++r)
+                    for (int k = 0; k < kK; ++k) ref_ids[((size_t) di * kMaxN + r) * kK + k] = hslab[r * kK + k];
+                ck(cudaMemcpy(ref_w.data() + (size_t) di * kMaxN * kK, K::route_pred_weights(), (size_t) n * kK * 4, cudaMemcpyDeviceToHost), "cp w");
+            }
+            const unsigned long long ref_edge = K::route_pred_edge_skips_take(), ref_tail = K::route_pred_tail_read_take();
+
+            // ---- fused: the same slabs cleared on the host (the mapped table), then the one GEMV and the one selection ----
+            for (int di = 0; di < 3; ++di) {
+                const int t = l + dists[di];
+                int32_t* host_table = const_cast<int32_t*>(K::route_pred_host());   // (mapped memory: the test's own reset)
+                for (size_t i = 0; i < 80; ++i) host_table[slab(t, K::route_pred_slot(dists[di])) + i] = -1;
+            }
+            const uint16_t* w3[3] = {dwall + (size_t) (l + 1) * kNE * kN, dwall + (size_t) (l + 2) * kNE * kN, dwall + (size_t) (l + 4) * kNE * kN};
+            const bool gemv_ok = K::bf16_gemv_fp32_mmvf_multi3(dx, kN, w3, 7u, K::route_pred_logits(), kNE, (int64_t) 8 * kNE, kN, kNE, n, s);
+            if (!gemv_ok) {
+                std::printf("FAIL %s n=%d: bf16_gemv_fp32_mmvf_multi3 declined\n", cfg.name, n);
+                ++bad;
+                continue;
+            }
+            if (cfg.learn)
+                for (int di = 0; di < 3; ++di)
+                    K::la_learn_forward_at(l, dists[di], dx, n, s, K::route_pred_logits_at(K::route_pred_slot(dists[di])));
+            K::RoutePredDist pd[3];
+            for (int di = 0; di < 3; ++di) {
+                const int t = l + dists[di], slot = K::route_pred_slot(dists[di]);
+                pd[di].logits = K::route_pred_logits_at(slot);
+                pd[di].ids = K::route_pred_dev(t, dists[di]);
+                pd[di].w = K::route_pred_weights_at(slot);
+                pd[di].mask = K::route_mask_layer(t, kL);
+                pd[di].mres = cfg.mres ? dres + (size_t) t * kNE : nullptr;
+                pd[di].ring = nullptr;
+                pd[di].cheap = nullptr;
+                pd[di].res = dres + (size_t) t * kNE;
+                pd[di].layer = t;
+                pd[di].edge_on = cfg.edge >= 0.f;
+                pd[di].tail_on = true;
+            }
+            K::route_pred_select(pd, n, cfg.tail_all, s);
+            ck(cudaStreamSynchronize(s), "sync fused");
+            const unsigned long long fused_edge = K::route_pred_edge_skips_take(), fused_tail = K::route_pred_tail_read_take();
+
+            // ---- compare ----
+            int id_bad = 0, w_bad = 0, l_bad = 0, ties = 0, tie_rows_id_diff = 0;
+            for (int di = 0; di < 3; ++di) {
+                const int t = l + dists[di], slot = K::route_pred_slot(dists[di]);
+                std::vector<float> fl((size_t) n * kNE), fw((size_t) n * kK);
+                ck(cudaMemcpy(fl.data(), K::route_pred_logits_at(slot), fl.size() * 4, cudaMemcpyDeviceToHost), "cp fl");
+                ck(cudaMemcpy(fw.data(), K::route_pred_weights_at(slot), fw.size() * 4, cudaMemcpyDeviceToHost), "cp fw");
+                const int32_t* hslab = K::route_pred_host() + slab(t, slot);
+                for (int r = 0; r < n; ++r) {
+                    const float* rl = ref_logits.data() + ((size_t) di * kMaxN + r) * kNE;
+                    const float* fr = fl.data() + (size_t) r * kNE;
+                    if (std::memcmp(rl, fr, kNE * 4) != 0) ++l_bad;
+                    // exact ties in the top 11 of the row's logits (the boundary and any pair inside the ten)
+                    std::vector<float> top(rl, rl + kNE);
+                    std::partial_sort(top.begin(), top.begin() + 11, top.end(), std::greater<float>());
+                    bool tie = false;
+                    for (int q = 0; q + 1 < 11; ++q) tie |= top[q] == top[q + 1];
+                    if (tie) ++ties;
+                    bool row_id = true;
+                    for (int k = 0; k < kK; ++k)
+                        if (ref_ids[((size_t) di * kMaxN + r) * kK + k] != hslab[r * kK + k]) row_id = false;
+                    if (!row_id) {
+                        ++id_bad;
+                        if (tie) ++tie_rows_id_diff;
+                    }
+                    if (std::memcmp(ref_w.data() + ((size_t) di * kMaxN + r) * kK, fw.data() + (size_t) r * kK, kK * 4) != 0) ++w_bad;
+                }
+            }
+            const bool counters = ref_edge == fused_edge && ref_tail == fused_tail;
+            const bool ok = l_bad == 0 && w_bad == 0 && id_bad == 0 && counters;
+            std::printf("%s %-58s n=%d  logits-diff %d  weights-diff %d  id-rows-diff %d (on exact ties %d)  edge %llu/%llu  tail %llu/%llu  ties(top11) %d\n",
+                        ok ? "PASS" : "FAIL", cfg.name, n, l_bad, w_bad, id_bad, tie_rows_id_diff, ref_edge, fused_edge, ref_tail, fused_tail,
+                        ties);
+            if (!ok) ++bad;
+            bad += run_post_checks(dx, dwall, dres, learner_ok, cfg, s, n, l);
+            // SPEC-recheck-gated: the same comparison with the hold (rows 0 and 2 held) and the finite per-row shift caps (small, so many moves are
+            // refused): the fused post kernel against the separate calls, both reading the same device flags.  Then the flags are reset.
+            {
+                K::route_fragile_hold(0x5u);
+                float caps[32];
+                for (int i = 0; i < 32; ++i) caps[i] = i < 8 ? 0.02f * (float) (1 + i) : INFINITY;
+                K::route_shift_cap_set(caps, 32);
+                const int held_bad = run_post_checks(dx, dwall, dres, learner_ok, cfg, s, n, l);
+                bad += held_bad;
+                std::printf("%s %-58s n=%d  hold 0x5 and shift caps: %s\n", held_bad == 0 ? "PASS" : "FAIL", cfg.name, n,
+                            held_bad == 0 ? "fused == separate" : "MISMATCH");
+                K::route_fragile_hold(0u);
+                K::route_shift_cap_set(nullptr, 0);
+            }
+        }
+    }
+    std::printf("router_fuse_parity (step 1 look-ahead, step 2 post-routing): %s (%d failing cases)\n",
+                bad == 0 ? "all bit-identical" : "MISMATCH", bad);
+    return bad == 0 ? 0 : 1;
+}
diff --git a/src/kernels/router_stage_bench.cpp b/src/kernels/router_stage_bench.cpp
new file mode 100644
index 000000000..6a6ec90fe
--- /dev/null
+++ b/src/kernels/router_stage_bench.cpp
@@ -0,0 +1,242 @@
+// router_stage_bench - what each kernel of the router stage costs at the live shapes (SPEC-router-fuse, step 0).
+//
+// The stage per decode layer: the layer's own routing (the router GEMV, the top-10, the layer's mask, route_resident_k) and the
+// look-ahead node (for dists 1 and 2: the next layers' router GEMV, top-10, the mask of the target layer, route_pred_edge_skip,
+// route_pred_tail_read; with STRATA_LA_LEARN also the learner's forward, and the drafter's forward on its source layer).
+// Each kernel is timed alone: 48 launches (48 layers' pointers, 8 distinct weight copies) captured in one CUDA graph, median of
+// `reps` graph launches, microseconds per launch.  Then the two per-layer sequences are timed as one graph each.
+//
+// The config is the one of the 8095 defaults as far as they are known: lo 3, hi 9, the open margin (1e30, route-resident on),
+// edge 1, the mask on, the residency table ~30% resident.  The look-ahead's residency and the mask are synthetic (no model here).
+// A kernel with a prerequisite that cannot be had here (the learner, the drafter) prints why and is skipped.
+// The edge-skip and tail-read rows reset their ids (a device copy from a golden slab, a graph node of its own, printed as
+// "reset ids" so it can be subtracted).
+//
+//     build/router_stage_bench [N=2560] [reps=20]
+#include "strata/kernels/bf16_gemv.hpp"
+#include "strata/kernels/native_router.hpp"
+
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <string>
+#include <vector>
+
+namespace K = strata::kernels;
+
+#define CK(x) do { cudaError_t e_ = (x); if (e_ != cudaSuccess) { std::fprintf(stderr, "%s: %s\n", #x, cudaGetErrorString(e_)); std::exit(1); } } while (0)
+
+namespace {
+constexpr int L = 48, NE = 512, KK = 10, NW = 8;
+int g_N = 2560;
+
+uint16_t bf16(float f) {
+    uint32_t u;
+    std::memcpy(&u, &f, 4);
+    return (uint16_t) ((u + 0x7fff + ((u >> 16) & 1)) >> 16);
+}
+
+// one timed kernel: `body(l, n, s)` launches it for layer l; 48 of them in one graph
+template <class Body>
+float time_graph(cudaStream_t s, cudaEvent_t e0, cudaEvent_t e1, int reps, Body body) {
+    cudaGraph_t g;
+    cudaGraphExec_t ge;
+    CK(cudaStreamBeginCapture(s, cudaStreamCaptureModeThreadLocal));
+    for (int l = 0; l < L; ++l) body(l, s);
+    CK(cudaStreamEndCapture(s, &g));
+    CK(cudaGraphInstantiate(&ge, g, nullptr, nullptr, 0));
+    for (int i = 0; i < 3; ++i) CK(cudaGraphLaunch(ge, s));
+    CK(cudaStreamSynchronize(s));
+    std::vector<float> ms;
+    for (int r = 0; r < reps; ++r) {
+        CK(cudaEventRecord(e0, s));
+        CK(cudaGraphLaunch(ge, s));
+        CK(cudaEventRecord(e1, s));
+        CK(cudaEventSynchronize(e1));
+        float m = 0;
+        CK(cudaEventElapsedTime(&m, e0, e1));
+        ms.push_back(m);
+    }
+    std::sort(ms.begin(), ms.end());
+    CK(cudaGraphExecDestroy(ge));
+    CK(cudaGraphDestroy(g));
+    return 1e3f * ms[ms.size() / 2] / L;   // us per layer
+}
+}  // namespace
+
+int main(int argc, char** argv) {
+    setvbuf(stdout, nullptr, _IONBF, 0);
+    g_N = argc > 1 ? std::atoi(argv[1]) : 2560;
+    const int reps = argc > 2 ? std::atoi(argv[2]) : 20;
+    const int N = g_N;
+    std::mt19937 rng(11);
+    std::normal_distribution<float> nd(0.f, 1.f);
+
+    // weights: 8 distinct router copies (the router is [512 x N] bf16), the rest of the layers reuse them round-robin
+    std::vector<uint16_t> wh((size_t) NE * N);
+    for (auto& v : wh) v = bf16(0.05f * nd(rng));
+    std::vector<uint16_t*> dw(NW);
+    for (int i = 0; i < NW; ++i) {
+        CK(cudaMalloc((void**) &dw[i], wh.size() * 2));
+        CK(cudaMemcpy(dw[i], wh.data(), wh.size() * 2, cudaMemcpyHostToDevice));
+    }
+    // activations, logits, ids, weights, row shift (device, max 8 rows)
+    std::vector<float> xh((size_t) 8 * N);
+    for (auto& v : xh) v = nd(rng);
+    float *dx, *dlog, *dw_out, *dshift, *dbias, *dgold_logits;
+    int32_t *dids, *dgold_ids;
+    CK(cudaMalloc((void**) &dx, xh.size() * 4));
+    CK(cudaMemcpy(dx, xh.data(), xh.size() * 4, cudaMemcpyHostToDevice));
+    CK(cudaMalloc((void**) &dlog, (size_t) 8 * NE * 4));
+    CK(cudaMalloc((void**) &dw_out, (size_t) 8 * KK * 4));
+    CK(cudaMalloc((void**) &dids, (size_t) 8 * KK * 4));
+    CK(cudaMalloc((void**) &dshift, 8 * 4));
+    CK(cudaMalloc((void**) &dbias, NE * 4));
+    CK(cudaMemset(dbias, 0, NE * 4));
+    CK(cudaMalloc((void**) &dgold_logits, (size_t) 8 * NE * 4));
+    CK(cudaMalloc((void**) &dgold_ids, (size_t) 8 * KK * 4));
+    CK(cudaMemset(dshift, 0, 8 * 4));
+
+    // residency per layer (~30% resident: slot >= 0), mask per layer (the last 128 experts, the least used, are masked)
+    std::vector<int32_t> res((size_t) L * NE);
+    std::vector<uint8_t> mask((size_t) L * NE);
+    for (int l = 0; l < L; ++l)
+        for (int e = 0; e < NE; ++e) {
+            res[(size_t) l * NE + e] = (rng() % 10) < 3 ? (int32_t) (e % 64) : -1;
+            mask[(size_t) l * NE + e] = e >= NE - 128 ? 1 : 0;
+        }
+    int32_t* dres;
+    CK(cudaMalloc((void**) &dres, res.size() * 4));
+    CK(cudaMemcpy(dres, res.data(), res.size() * 4, cudaMemcpyHostToDevice));
+
+    std::string msg;
+    if (!K::route_mask_set(mask.data(), L, NE, 3, 1.0f, msg, 3)) { std::fprintf(stderr, "route_mask_set: %s\n", msg.c_str()); return 1; }
+    K::route_cfg_init(3, 9, 1e30f, 1.0f, 0.f, 0, 1.f, 0.f, 0.f, 0.f, 0.f);
+    K::route_pred_alloc(L);
+    K::route_pred_edge_skip_alloc();
+    K::route_pred_tail_read_alloc();
+    unsigned long long* dstats;
+    CK(cudaMalloc((void**) &dstats, 16 * 8));
+    CK(cudaMemset(dstats, 0, 16 * 8));
+    if (!K::la_learn_alloc(6, N, 3, false, msg)) std::printf("SKIP learner forward (la_learn_alloc: %s)\n", msg.c_str());
+    const bool learner = K::la_learn_active();
+    if (learner && !K::la_mtp_alloc(N, false, msg)) std::printf("SKIP drafter forward (la_mtp_alloc: %s)\n", msg.c_str());
+    const bool drafter = K::la_mtp_active();
+
+    cudaStream_t s;
+    CK(cudaStreamCreate(&s));
+    cudaEvent_t e0, e1;
+    CK(cudaEventCreate(&e0));
+    CK(cudaEventCreate(&e1));
+    CK(cudaMemcpy(dgold_ids, dids, 8 * KK * 4, cudaMemcpyDeviceToDevice));
+
+    const int ns[] = {1, 2, 4, 8};
+    struct Row { const char* name; float us[4]; bool ok; };
+    std::vector<Row> rows;
+    auto run_row = [&](const char* name, auto body) {
+        Row r{name, {0, 0, 0, 0}, true};
+        for (int i = 0; i < 4; ++i) {
+            const int n = ns[i];
+            r.us[i] = time_graph(s, e0, e1, reps, [&](int l, cudaStream_t st) { body(l, n, st); });
+        }
+        rows.push_back(r);
+    };
+    // the look-ahead's pred logits and ids: dist 1 (slot 0) at layer l -> target l+1
+    auto pred_ids = [&](int l, int dist) { return K::route_pred_dev((l + dist) % L, dist); };
+    auto gemv = [&](int l, int n, cudaStream_t st) {
+        K::bf16_gemv_fp32_mmvf_multi(dx, N, dw[l % NW], dlog, NE, N, NE, n, st);
+    };
+
+    run_row("router GEMV (512 x N)", [&](int l, int n, cudaStream_t st) { gemv(l, n, st); });
+    run_row("top-10 (multi)", [&](int l, int n, cudaStream_t st) { K::native_router_top10_multi(dlog, dids, dw_out, n, st); });
+    run_row("layer mask (native_route_mask)", [&](int l, int n, cudaStream_t st) {
+        K::native_route_mask(dlog, dids, dw_out, K::route_mask_layer(l, L), n, dshift, st, nullptr, l, 0,
+                             dres + (size_t) l * NE, nullptr, nullptr);
+    });
+    run_row("route_resident_k (open margin)", [&](int l, int n, cudaStream_t st) {
+        K::native_route_resident(dlog, dids, dw_out, dres + (size_t) l * NE, n, dstats, st, nullptr, nullptr, nullptr, nullptr, nullptr,
+                                 nullptr, dshift, nullptr, nullptr, l, nullptr, nullptr, 0);
+    });
+    run_row("look-ahead: pred GEMV (dist 1 slot)", [&](int l, int n, cudaStream_t st) {
+        K::bf16_gemv_fp32_mmvf_multi(dx, N, dw[(l + 1) % NW], K::route_pred_logits(), NE, N, NE, n, st);
+    });
+    run_row("look-ahead: pred top-10 (dist 1)", [&](int l, int n, cudaStream_t st) {
+        K::native_router_top10_multi(K::route_pred_logits(), pred_ids(l, 1), K::route_pred_weights(), n, st);
+    });
+    run_row("look-ahead: pred mask (dist 1)", [&](int l, int n, cudaStream_t st) {
+        const int t = (l + 1) % L;
+        K::native_route_mask(K::route_pred_logits(), pred_ids(l, 1), K::route_pred_weights(), K::route_mask_layer(t, L), n, nullptr, st,
+                             nullptr, t, 0, dres + (size_t) t * NE, nullptr, nullptr);
+    });
+    run_row("look-ahead: edge skip (dist 1)", [&](int l, int n, cudaStream_t st) {
+        const int t = (l + 1) % L;
+        K::route_pred_edge_skip(K::route_pred_logits(), pred_ids(l, 1), dres + (size_t) t * NE, n, st);
+    });
+    run_row("look-ahead: tail read (dist 1)", [&](int l, int n, cudaStream_t st) {
+        const int t = (l + 1) % L;
+        K::route_pred_tail_read(dres + (size_t) t * NE, pred_ids(l, 1), n, st, 0);
+    });
+    run_row("reset ids (pred slab, the edge/tail rows' input)", [&](int l, int n, cudaStream_t st) {
+        const int t = (l + 1) % L;
+        CK(cudaMemcpyAsync(pred_ids(l, 1), dgold_ids, (size_t) n * KK * 4, cudaMemcpyDeviceToDevice, st));
+        (void) t;
+    });
+    if (learner) {
+        run_row("look-ahead: learner forward (dist 1)", [&](int l, int n, cudaStream_t st) {
+            K::la_learn_forward(l % 6, 1, dx, n, st);
+        });
+    }
+    if (drafter) {
+        run_row("drafter forward (la_mtp)", [&](int l, int n, cudaStream_t st) {
+            (void) l;
+            K::la_mtp_forward(dx, n, st);
+        });
+    }
+
+    std::printf("router_stage_bench N=%d NE=%d K=%d layers=%d reps=%d learner=%d drafter=%d\n", N, NE, KK, L, reps, learner ? 1 : 0,
+                drafter ? 1 : 0);
+    std::printf("%-52s %10s %10s %10s %10s   (us per launch)\n", "kernel", "n=1", "n=2", "n=4", "n=8");
+    for (const auto& r : rows)
+        std::printf("%-52s %10.2f %10.2f %10.2f %10.2f\n", r.name, r.us[0], r.us[1], r.us[2], r.us[3]);
+
+    // the per-layer sequences as one graph each (us per layer)
+    auto own_seq = [&](int l, int n, cudaStream_t st) {
+        gemv(l, n, st);
+        K::native_router_top10_multi(dlog, dids, dw_out, n, st);
+        K::native_route_mask(dlog, dids, dw_out, K::route_mask_layer(l, L), n, dshift, st, nullptr, l, 0, dres + (size_t) l * NE, nullptr,
+                             nullptr);
+        K::native_route_resident(dlog, dids, dw_out, dres + (size_t) l * NE, n, dstats, st, nullptr, nullptr, nullptr, nullptr, nullptr,
+                                 nullptr, dshift, nullptr, nullptr, l, nullptr, nullptr, 0);
+    };
+    auto la_seq = [&](int l, int n, cudaStream_t st) {
+        for (int dist : {1, 2}) {
+            const int t = (l + dist) % L;
+            K::bf16_gemv_fp32_mmvf_multi(dx, N, dw[t % NW], K::route_pred_logits(), NE, N, NE, n, st);
+            K::native_router_top10_multi(K::route_pred_logits(), pred_ids(l, dist), K::route_pred_weights(), n, st);
+            K::native_route_mask(K::route_pred_logits(), pred_ids(l, dist), K::route_pred_weights(), K::route_mask_layer(t, L), n, nullptr, st,
+                                 nullptr, t, 0, dres + (size_t) t * NE, nullptr, nullptr);
+            K::route_pred_edge_skip(K::route_pred_logits(), pred_ids(l, dist), dres + (size_t) t * NE, n, st);
+            K::route_pred_tail_read(dres + (size_t) t * NE, pred_ids(l, dist), n, st, 0);
+        }
+    };
+    std::printf("\nper-layer sequences (us per layer, one graph of %d layers):\n", L);
+    std::printf("%-52s %10s %10s %10s %10s\n", "sequence", "n=1", "n=2", "n=4", "n=8");
+    auto seq_row = [&](const char* name, auto body) {
+        float us[4];
+        for (int i = 0; i < 4; ++i) us[i] = time_graph(s, e0, e1, reps, [&](int l, cudaStream_t st) { body(l, ns[i], st); });
+        std::printf("%-52s %10.2f %10.2f %10.2f %10.2f\n", name, us[0], us[1], us[2], us[3]);
+    };
+    seq_row("own routing: GEMV + top-10 + mask + resident", [&](int l, int n, cudaStream_t st) { own_seq(l, n, st); });
+    seq_row("look-ahead: dists 1, 2 (GEMV, top-10, mask, edge, tail)", [&](int l, int n, cudaStream_t st) { la_seq(l, n, st); });
+    seq_row("whole stage (own + look-ahead), today's chain", [&](int l, int n, cudaStream_t st) {
+        own_seq(l, n, st);
+        la_seq(l, n, st);
+    });
+    (void) gemv;
+    return 0;
+}
diff --git a/src/platform/direct_file.cpp b/src/platform/direct_file.cpp
index b09536c28..824b33902 100644
